            ^"Aura of Ennobled Presence"
            TECHNIQUE "Muto" FORM "Imaginem" LEVEL 10 CASTING_TOTAL 8
            ^"Piercing the Faerie Veil"
            TECHNIQUE "Intellego" FORM "Vim" LEVEL 20 CASTING_TOTAL 18
            ^"Piercing the Magical Veil"
            TECHNIQUE "Intellego" FORM "Vim" LEVEL 20 CASTING_TOTAL 18
            ^"Unraveling the Fabric of Imaginem"
            TECHNIQUE "Perdo" FORM "Vim" LEVEL 20 CASTING_TOTAL 16
            ^"Wind of Mundane Silence"
            TECHNIQUE "Perdo" FORM "Vim" LEVEL 20 CASTING_TOTAL 16
            ^"Circular Ward Against Demons"
            TECHNIQUE "Rego" FORM "Vim" LEVEL 20 CASTING_TOTAL 16
        }
        CHOICES {
            "The Criamon does not have her maximum allowance of Flaws, so could take an additional Major Flaw or three Minor Flaws, with corresponding Virtues, if desired. Her Charm and Folk Ken scores could be moved into other Abilities available in the first five years of life (see the Detailed Character Creation rules, page 43), possibly also moving her good Presence score as well."
        }
    }
