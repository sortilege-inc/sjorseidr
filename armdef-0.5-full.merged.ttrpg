    #tXW8JhWbmdta0e2L9PdI71SA ^"Poorly Trained Gruagach" DEF {
        EXTENDS ^"Flaw"
        PROPERTIES {
            ^"Size" STRING "Minor" FIXED
            ^"Category" STRING "Supernatural" FIXED
            ^"Source" STRING "Hedge Magic [Revised Edition]"
        }
