            ^"Magi" LIST [#t54fbbd57f4e793107a0c5c ^"Aoede of House Ex Miscellanea", #tb8a9de6aa17a68bc8953cb ^"Alexander of House Ex Miscellanea", #t84feddfecb1413a2a82469 ^"Nikola of House Ex Miscellanea", #t75df4258456714ac3b3274 ^"Herakles of House Merinita", #t13d4bc7fae6d0b0d55bdd8 ^"Ariane of House Jerbiton", #t833e8674f1a140fc4ca61e ^"William of Normandy: House Flambeau"]
