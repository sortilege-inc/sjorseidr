            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "The ability to propel yourself through water quickly and efficiently."
    }

    #tsdxZZeuPpaoMdpdh882PPDj ^"Teaching" DEF {
        EXTENDS ^"Ability"
        PROPERTIES {
            ^"Ability Type" STRING "General" FIXED
            ^"Specialties" LIST OF STRING ["a particular Ability", "particular kinds of student"]
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "The ability to teach an Ability to someone else."
    }

    #tIMTi1yIZ0vGIF36yCXcX8CE ^"Theology: Christian" DEF {
        EXTENDS ^"Ability"
        PROPERTIES {
            ^"Ability Type" STRING "Academic" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Specialties" LIST OF STRING ["biblical knowledge", "heresy", "history"]
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "Theology is the study of God and his work in the world. The auctores are the Bible and Peter the Lombard's Sententiae, the Bible having theoretical primacy, being infallible, and the Sentences being most studied. The speculations of theology are very abstruse, and many theologians are accused of heresy. Sometimes those accused recant, and sometimes they convince the Church that they were right after all."
    }

    #tABZOPAtqtUKaqL995MkQaYI ^"Theology: Islam" DEF {
        EXTENDS ^"Ability"
        PROPERTIES {
            ^"Ability Type" STRING "Academic" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Specialties" LIST OF STRING ["the Qur'an", "debates", "history", "prophets"]
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "This is the Islamic equivalent of Theology: Christian. The major sources for Islamic theology are the Qur'an and the Sunna."
    }

    #tywoELkx1nx86iHu5TOk242I ^"Theology: Judaism" DEF {
        EXTENDS ^"Ability"
        PROPERTIES {
            ^"Ability Type" STRING "Academic" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Specialties" LIST OF STRING ["the Torah", "creation", "history", "prophecies"]
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "This is the Jewish equivalent of Theology: Christian. The major sources for Jewish theology are the Torah, the Nevi'im, and the Kutuvim."
    }

