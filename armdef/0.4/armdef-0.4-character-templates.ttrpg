            ^"Warping Points" INTEGER 0
            ^"Confidence Score" INTEGER 1
            ^"Confidence Points" INTEGER 3
            ^"Hermetic Arts" DEF {
                ^"Creo" INTEGER 0
                ^"Intellego" INTEGER 1
                ^"Muto" INTEGER 10
                ^"Perdo" INTEGER 3
                ^"Rego" INTEGER 1
                ^"Animal" INTEGER 8
                ^"Aquam" INTEGER 0
                ^"Auram" INTEGER 0
