                ^"Dexterity" INTEGER 5
                ^"Quickness" INTEGER 2
            }
            ^"Virtues and Flaws" LIST ["Lightning Reflexes", "Ways of the Forest Fire", "Poor Memory", "Short Attention Span", "Simple Minded"]
            ^"Soak" INTEGER 4
            ^"Wound Penalties" STRING "–1 & 1 Might point (1–5), –3 & 3 Might points (6–10), –5 & 5 Might points (11–15), Incapacitated & 5 Might points (16–20), Dead & all Might points (21+)"
            ^"Vis" STRING "3 pawns of Ignem, in body."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Forest Fire" +3
        }
        COMBAT {
            "Burn Power" INIT 3 ATTACK 12
        }
        ABILITIES {
            "Athletics" SCORE 3 SPECIALTY "leaping between fuel sources"
            "Brawl" SCORE 3 SPECIALTY "Burn Power"
            "Charm" SCORE 3 SPECIALTY "small animals"
            "Penetration" SCORE 3 SPECIALTY "Fascination Power"
        }
        POWERS {
            ^"Burn" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "See insert for details."
            }
            ^"Fascination" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "+6"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See insert for details."
            }
            ^"Enliven the Gross Fire" DEF {
                PROPERTIES {
                    ^"Cost" STRING "6 points"
                    ^"Initiative" STRING "–10"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "This ritual-like power rarefies (creates) a fire elemental from a sufficient amount of raw elemental matter. The elemental can have any Might less than that of the creature using this power. The elemental is automatically under the control of the creature; this power can also be used to control elementals which are not of the creature's own making, but in this case must Penetrate the elemental's Might. When the creature has no further use for the elemental, its control lapses but the elemental remains."
            }
        }
        DESCRIPTION "Recovers Might points in one quarter of the normal time, which for an elemental means 3 weeks rather than a season. For a Might 15 elemental this is approximately 2 Might points every 3 days. Born of a lightning strike hitting a magically tainted tree (perhaps a vis source), this elemental has the frightening power to spawn more fire elementals, which it does if fought with water."
    }

    #tamtoMQeWP8ijBdlaCFWIo4W ^"Ghostly Warder" DEF {
        EXTENDS ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 10
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Mentem"
            ^"Size" INTEGER 0
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 1
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER 0
            }
            ^"Virtues and Flaws" LIST ["None (may take Virtues and Flaws as a grog, if desired by the troupe.)"]
            ^"Reputations" LIST ["None"]
            ^"Vis" STRING "None. Magi cannot render other characters' Ghostly Warders down for vis."
            ^"Appearance" STRING "An older peasant woman, rather gaunt, dressed in simple but well-repaired clothes and carrying the tools used in some part of daily life. This may be a distaff and spindle, or a pot, or a broom; it changes from time to time. Note that she is invisible to characters without an appropriate Virtue."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Protective" +3
        }
        ABILITIES {
            "Area Lore" SCORE 5 SPECIALTY "places children get lost"
            "Awareness" SCORE 5 SPECIALTY "where her children are"
            "Church Lore" SCORE 1 SPECIALTY "funerals"
            "Divine Lore" SCORE 1 SPECIALTY "after death"
            "Folk Ken" SCORE 4 SPECIALTY "people lying to her children"
            "Living Language" SCORE 5 SPECIALTY "scolding"
            "Magic Lore" SCORE 2 SPECIALTY "ghosts"
            "Profession (housewife)" SCORE 5 SPECIALTY "cleaning"
        }
        POWERS {
            ^"Kinesis" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "The ghost can move an object as if she were still physically present. One expenditure of Might allows her to move one object until she puts it down again. She has no combat Abilities, so she cannot fight wielding an object as a weapon."
            }
        }
        DESCRIPTION "The ghost is non-physical, and so cannot be harmed by combat or harm others in combat. Two additional Personality Traits are chosen by the player. This Ghostly Warder (see the Magical Warder Virtue, page 93) was the character's mother, aunt, or possibly grandmother. She still gives him all the advice he received as a child, such as to wear warm clothes and stay away from the river, but she is also quite perceptive, both about people and about mundane events."
    }

    #tMebeN5F0u5en9fBZctRtrnB ^"A Typical Giant" DEF {
        EXTENDS ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 12
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Corpus"
            ^"Size" INTEGER 5
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -3
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER -3
                ^"Strength" INTEGER 12
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER -2
            }
            ^"Virtues and Flaws" LIST ["Tough", "Warrior", "Wrathful (minor)", "Weak-Willed"]
            ^"Soak" INTEGER 9
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–10), –3 (11–20), –5 (21–30), Incapacitated (31–40), Dead (41+)"
            ^"Vis" STRING "3 Corpus in skull"
            ^"Appearance" STRING "The common giant is an enormous, ugly man with bulging eyes, an oversized, squarish head, and a shapeless gash of a mouth full of crooked teeth. He stands about 20 feet tall and wears a crude garment stitched together from bear skins."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Oafish" +3
        }
        COMBAT {
            "Cudgel" INIT -2 ATTACK 12 DEFENSE 5 DAMAGE 19
            "Kick" INIT -3 ATTACK 6 DEFENSE 1 DAMAGE 15
            "Stone" INIT -3 ATTACK 7 DEFENSE 2 DAMAGE 14
        }
        ABILITIES {
            "Brawl" SCORE 4 SPECIALTY "kick"
            "Great Weapon" SCORE 5 SPECIALTY "cudgel"
            "Living Language" SCORE 4 SPECIALTY "coarse expressions"
            "Thrown Weapon" SCORE 3 SPECIALTY "stone"
        }
        DESCRIPTION "These statistics are for a typical giant of the sort found throughout the British Isles. Such giants have been known to form alliances with hedge wizards or faeries. Unlike many magical creatures, giants need to eat, drink, and breathe, and get old and die."
    }

    #t6YOzXaHBWEvX3meW0mWFHQP ^"Sir Giles, a Ghostly Knight" DEF {
        EXTENDS ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 16
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Mentem"
            ^"Size" INTEGER 0
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -1
                ^"Perception" INTEGER -1
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER 2
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 2
            }
            ^"Virtues and Flaws" LIST ["Knight", "Puissant Single Weapon", "Self-Confident", "Proud (Major)", "Baneful Circumstances (during the day)"]
            ^"Reputations" LIST ["Proud 3 (local)"]
            ^"Soak" INTEGER 10
            ^"Fatigue Levels" STRING "OK, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1(1–5), –3 (6–10), –5 (11–15), Incapacitated (16+)"
            ^"Vis" STRING "4 Mentem in lance"
            ^"Appearance" STRING "Sir Giles is a Magical apparition — a ghostly knight in black mail, riding a fearsome black destrier. His shield and surcoat are solid black without any heraldic device, and atop his helm is a crest shaped like a cockerel. If he removes his helm, he appears to be a rather handsome, well-groomed knight whose face shows an expression of fierce pride."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Proud" +6
            "Belligerent" +2
            "Brave" +2
        }
        COMBAT {
            "Lance & Heater, mounted" INIT 2 ATTACK 17 DEFENSE 16 DAMAGE 7
            "Lance, dismounted" INIT 3 ATTACK 9 DEFENSE 7 DAMAGE 9
            "Long Sword & Heater, mounted" INIT 2 ATTACK 17 DEFENSE 17 DAMAGE 8
            "Long Sword & Heater" INIT 2 ATTACK 14 DEFENSE 14 DAMAGE 8
            "Long Sword only" INIT 2 ATTACK 13 DEFENSE 10 DAMAGE 8
        }
        ABILITIES {
            "Area Lore" SCORE 3 SPECIALTY "nobles"
            "Animal Handling" SCORE 3 SPECIALTY "horses"
            "Athletics" SCORE 2 SPECIALTY "running"
            "Awareness" SCORE 3 SPECIALTY "in battle"
            "Brawl" SCORE 2 SPECIALTY "fist"
            "Concentration" SCORE 1 SPECIALTY "remaining invisible"
            "Charm" SCORE 1 SPECIALTY "ladies"
            "Etiquette" SCORE 3 SPECIALTY "nobles"
            "Great Weapon" SCORE 3 SPECIALTY "long spear"
            "Hunt" SCORE 2 SPECIALTY "deer"
            "Intrigue" SCORE 1 SPECIALTY "noble courts"
            "Leadership" SCORE 3 SPECIALTY "soldiers"
            "Ride" SCORE 5 SPECIALTY "in battle"
            "Single Weapon" SCORE 5 SPECIALTY "heater shield"
        }
        POWERS {
            ^"Donning the Corporeal Veil" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Sir Giles can assume material form."
            }
            ^"Riding the Phantom Steed" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Animal"
                    ^"Range" STRING "Touch"
                    ^"Duration" STRING "Sun"
                    ^"Target" STRING "Ind"
                    ^"Spell Equivalent" STRING "Cr(Re)An 40"
                    ^"Design" STRING "Base 15, +1 Touch, +2 Sun, +1 Rego requisite, +1 Size"
                }
                DESCRIPTION "When Sir Giles takes physical form, he can also materialize his war horse for an additional Might cost. He can dissolve the horse at will due to the Rego requisite. Use the statistics for a destrier."
            }
            ^"Invisibility" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Imaginem"
                    ^"Range" STRING "Touch"
                    ^"Duration" STRING "Conc"
                    ^"Target" STRING "Group"
                    ^"Spell Equivalent" STRING "PeIm 20"
                    ^"Design" STRING "Base 4, +1 Touch, +1 Conc, +2 Group"
                }
                DESCRIPTION "Even in material form, Sir Giles and his horse can become invisible when he wishes (though they can still be seen by Second Sight)."
            }
            ^"Ride in Dreams" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                    ^"Range" STRING "Touch"
                    ^"Duration" STRING "Sun"
                    ^"Target" STRING "Ind"
                    ^"Spell Equivalent" STRING "CrMe 15"
                    ^"Design" STRING "Base 4, +1 Touch, +2 Sun"
                }
                DESCRIPTION "When in spirit form, Sir Giles can enter the dreams of a sleeping person whose name he knows, tormenting him with nightmares of a furious, dark knight. The victim must make a Stamina roll against an Ease Factor of Sir Giles' Presence + Leadership or lose a Long-Term Fatigue Level."
            }
        }
        DESCRIPTION "Not all ghosts belong to the Magic realm; there are Infernal and Faerie ghosts as well. Magical ghosts remain tied to the world through some overwhelming emotion or personal need. If its connection is somehow resolved, the ghost passes from the world, never to return."
    }

    #tlfl7LrbAgffEppYBpnaFv0j ^"A Magical Wolf" DEF {
