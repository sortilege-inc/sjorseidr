            "Carouse"
            SCORE 3
            SPECIALTY "wine"
            "Charm"
            SCORE 2
            SPECIALTY "forest folk"
            "Faerie Speech"
            SCORE 5 "Folk Ken"
            SCORE 3
            SPECIALTY "forest folk"
            "Forest Lore"
            SCORE 9
            SPECIALTY "locations"
            "Guile"
            SCORE 2
            SPECIALTY "about woodland dangers"
            "Leadership"
            SCORE 9
            SPECIALTY "woodland creatures"
            "Swim"
            SCORE 3
            SPECIALTY "streams"
        }
        POWERS {
            ^"Extended Glamour" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Constantly in touch with the forest."
            }
            ^"Focus Power (Manifestation)" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "–5*"
                    ^"Form" STRING "Animal or Herbam"
                }
                DESCRIPTION
            }
            ^"Focus Power (Woodland Change)" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
