            "Auram" "wind, sweet smells"
            "Corpus" "disease, hearing, hunger, sight, taste, veins"
            "Imaginem" "hearing, sight"
            "Mentem" "affection, attraction, creativity, pleasure"
            "Terram" "copper, emeralds"
            "Vim" "auras, sensing magical effects"
            "Other" "cleanliness, harmony"
        }
        DESCRIPTION "Iaó is Apollo’s sensitivity, delight in pleasure, and his beauty. Through Iaó, Apollo attracts both men and women, revels in the world’s luxuries, and creates beauty, whether music, poetry, or song."
    }
    #t3940950caac9908d6bcaaa ^"Óai (Light Breather)" DEF {
        EXTENDS #t90c095c9b38d9aeacee505 ^"Beautiful Name of Light"
