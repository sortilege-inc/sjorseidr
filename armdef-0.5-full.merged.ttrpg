    #txSsvkKF4EZs3P0Yh3Z4e2Xf ^"Elementalist Water" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor" FIXED
            ^"Category" STRING "Supernatural" FIXED
            ^"Source" STRING "Hedge Magic [Revised Edition]"
        }
        FORMULAS {
            "Phlegmatic Personality Trait" "Warping Score + (Elementalist Water / 5)"
        }
        DESCRIPTION "This power combines with the Elementalist Techniques to affect the element of water. Taking this Virtue gives the character an initial score of 0 in Elementalist Water (see Elementalist Forms, below), and a Phlegmatic Personality Trait (see Elemental Warping, below) equal to his Warping Score + (Elementalist Water / 5)."
        REFERENCES {
            "Personality Trait" -> #tcBZnRedWJ5vEcmMkio8kULU ^"Personality Trait"
