                "Artes Liberales" XP 10
                "Latin" XP 10
                "Profession: Scribe" XP 25
            }
        }
        DESCRIPTION "You may replace Latin with any Living or Dead Language that the scribe might be using."
    }
    #tRB3EIff4kkRijQzNRoLNCiF ^"Lord of the Manor" DEF {
        EXTENDS #tJMx7GGcZQSwkg6F9xkYyCyf ^"Companion"
