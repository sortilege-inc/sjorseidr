    #t9vigGczYuUkSOXcDpShGAdU ^"Ghula" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 20
            ^"Might Realm" STRING "Faerie" FIXED
            ^"Size" INTEGER 0
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 5
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER 1
                ^"Stamina" INTEGER 0
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER 1
            }
            ^"Soak" INTEGER 0
            ^"Wound Penalties" STRING "–1 (1-4), –3 (5-8), –5 (9-12), Incapacitated (13–16), Dead (17+)"
            ^"Vis" STRING "4 pawns Imaginem, rat skulls"
            ^"Appearance" STRING "Ghula usually look like beautiful women. To attract husbands, ghula pretend to be wealthy widows or orphans of good families, in need of husbands. Ghulas often pretend to be members of communities displaced by war, as it gives their story verisimilitude. The eyes and the insides of the mouths of Arabic ghula are always green. Male ghuls exist, but are the servants of the ghula, and rarely play the role of seducer."
            ^"Source" STRING "Realms of Power: Faerie"
