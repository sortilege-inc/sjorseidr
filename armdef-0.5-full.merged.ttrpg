            ^"Initiative" STRING "Init –4"
            ^"Form" STRING "Mentem"
            ^"Source" STRING "Realms of Power: Faerie"
        }
        DESCRIPTION "Causes the person touched to forget his mortal life until he sees a particular object, or class of object, associated with his home.

Costs 40 spell levels (Base 15 +1 Touch +4 Until)"
    }
    #tNRJ8EXo4F6Z0BrLjUKrYbGD ^"Kiss of Frost" DEF {
        EXTENDS #t84d15c61569668f6f97c5a ^"Faerie Power"
