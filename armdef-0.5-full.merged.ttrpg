            ^"Source" STRING "Hedge Magic [Revised Edition]"
        }
        DESCRIPTION "Due to the quality of her induction into the folk witch tradition, the character receives an extra 50 experience points to spend during apprenticeship. This Virtue can be taken several times."
    }
    #tFlWS2NNxHoemGMlixbTTOgs ^"Life-Linked Folk Witch Magic" DEF {
        EXTENDS ^"Virtue"
