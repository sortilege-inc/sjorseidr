            ^"Form" STRING "Imaginem"
            ^"Source" STRING "Realms of Power: Faerie"
        }
        DESCRIPTION "This power allows the faerie to send short verbal messages to beings to which it has Arcane Connections.

Costs 15 spell levels. (CrMe Base 3, +4 Arcane)"
        REFERENCES {
            "Arcane Connections" -> #t5LSSCbSbvKL2YDR91taIlVC ^"Arcane Connections"
        }
    }
    #tb5io6GQnmuJWz3czvmoJ5Dn ^"Spirit Away" DEF {
        EXTENDS #t84d15c61569668f6f97c5a ^"Faerie Power"
        PROPERTIES {
