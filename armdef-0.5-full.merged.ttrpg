    #t9ba52348594cf3a2a10cf2 ^"Lebor Liathanach (Longmist Library)" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "Lebor Liathanach"
            ^"Author" STRING "Brea Mac Boru"
            ^"Kind" STRING "Tractatus"
