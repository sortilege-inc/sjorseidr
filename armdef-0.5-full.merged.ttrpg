            ^"Initiative" STRING "n/a"
            ^"Form" STRING "Vim"
            ^"Source" STRING "Realms of Power: Faerie"
        }
        DESCRIPTION "Allows the faerie to act as a threshold guardian, as described in the Chapter 2: Faerie Realm.

Costs 50 spell levels (Special)"
    }
    #tuNP1YRuzjEbdtKfdjEA4sma ^"Spreading a Mantle of Snow" DEF {
        EXTENDS #t84d15c61569668f6f97c5a ^"Faerie Power"
        PROPERTIES {
