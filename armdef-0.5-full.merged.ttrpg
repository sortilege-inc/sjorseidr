            ^"Redcaps" LIST [#tce88396a54d5ab3fca15aa ^"Évrard de Tours, Redcap", #t3654cc133979d935eeca19 ^"Hervé filius Évrard, Follower of Mercere"]
            ^"Library" LIST [#t2fa1c6141717b513885f49 ^"Legends of Brittany", #t2e9635179822b2715727f1 ^"Arthur Among the Britons", #ted1487f0583ea55805b1ac ^"The Llancarfan Saints’ Lives", #t5590fb703219de3b9134d4 ^"History of the Britons", #td0aa17aa6d908139a8b1aa ^"History of the Kings of Britain", #tacf8bceffcd8b651fb5448 ^"The Lais of Marie de France", #tf14b5aa8268f833194fddc ^"Arthurian Romances", #tbfb7a5435509d9e574cdaa ^"Perceval", #t07d1ff4c610b8efb73b434 ^"Joseph d’Arimethie", #tac7f1c6624d10fc459ed2d ^"Parsifal"]
