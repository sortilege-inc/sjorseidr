            ^"Virtues and Flaws" STRING "Magical Human, Surface Form (female torso), Tough (fish scales), Voice of the Ocean; Magical Monster; Monstrous Appearance; Exiled Atlantean, Obsessed (returning to sea)."
            ^"Personality Trait" STRING "Aloof +4, Fish +3"
            ^"Reputations" STRING "Drowner of sailors (local) 2"
            ^"Combat" STRING "Dodge: Init 0, Attack n/a, Defense +3, Damage n/a"
            ^"Soak" STRING "+3"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1-5), –3 (6-10), –5 (11-15), Incapacitated (16-20)"
            ^"Abilities" STRING "Awareness 2 (ships), Brawl 2 (dodging), Hunt 4 (fish), Survival 3 (ocean), Swim 5 (ocean)"
            ^"Vis" STRING "Aquam vis in blood."
            ^"Source" STRING "Realms of Power: Magic"
        }
