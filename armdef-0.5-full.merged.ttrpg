            "Claws" INIT 0 ATTACK 11 DEFENSE 10 DAMAGE 5
            "Fangs" INIT 1 ATTACK 10 DEFENSE 8 DAMAGE 4
        }
        ABILITIES {
            "Charm" SCORE 6 SPECIALTY "men"
            "Brawl" SCORE 6 SPECIALTY "in dark areas"
            "Stealth" SCORE 9 SPECIALTY "urban areas"
        }
        POWERS {
            ^"Cause Drowsiness" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "–2"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "(Touch Range, Until Duration, 1 intricacy point spent on cost)"
