EXTENSION "ARMDef_Character_Templates" {
    NAME "Ars Magica Definitive Edition - Character Templates"
    VERSION "0.4"
    SPEC_VERSION "0.4"
    RELEASE_DATE "2026-07-14"
    DEPENDS_ON "ARMDef_Core_Base"

    #tXCauTdW6hZs9x4tg2H4Mr1J TEMPLATE "The Berserker" DEF {
        EXTENDS ^"Grog"
        PROPERTIES {
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -2
                ^"Perception" INTEGER -1
                ^"Presence" INTEGER -1
                ^"Communication" INTEGER -1
                ^"Strength" INTEGER 3
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 1
            }
            ^"Size" INTEGER 1
            ^"Age" INTEGER 15
            ^"Apparent Age" INTEGER 15
            ^"Decrepitude" INTEGER 0
            ^"Warping Score" INTEGER 0
            ^"Warping Points" INTEGER 0
            ^"Virtues" LIST ["Covenfolk", "Berserk", "Large"]
            ^"Flaws" LIST ["Short Attention Span", "Wrathful (Minor)"]
            ^"Soak" INTEGER 9 NOTE "Stamina, full metal scale armor"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–6), –3 (7–12), –5 (13–18), Incapacitated (19–24)"
            ^"Equipment" LIST ["Pole Axe", "Full metal scale armor", "pack containing gear to care for weapons and armor and establish camps when traveling."]
            ^"Encumbrance" STRING "0 (3)"
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Angry" +3
            "Brave" +3
            "Loyal" +1
        }
        COMBAT {
            "Pole Axe" INIT 2 ATTACK 13 DEFENSE 7 DAMAGE 14
            "Kick" INIT 0 ATTACK 6 DEFENSE 4 DAMAGE 6
        }
        ABILITIES {
            "Area Lore" SCORE 1 SPECIALTY "streams"
            "Athletics" SCORE 2 SPECIALTY "running"
            "Awareness" SCORE 3 SPECIALTY "attackers"
            "Brawl" SCORE 3 SPECIALTY "kicking"
            "Guile" SCORE 1 SPECIALTY "apologizing"
            "Great Weapons" SCORE 5 SPECIALTY "pole axe"
            "Native Language" SCORE 5 SPECIALTY "insults"
            "Single Weapon" SCORE 1 SPECIALTY "heater shield"
            "Survival" SCORE 3 SPECIALTY "hills"
        }
        CHOICES {
            "The Berserker's Large Virtue could be swapped out for an Affinity or Puissant Ability with Great Weapons. In addition he could have another Flaw, and take one of those Virtues to balance it. Other than that, he is young, so most of his Abilities are dictated by the concept. The Abilities at 1 or 2 can be swapped around, though."
        }
    }

    #tkmJS94XLXXsCtqV566FZ7oU TEMPLATE "The Grizzled Veteran" DEF {
        EXTENDS ^"Grog"
        PROPERTIES {
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER -1
                ^"Communication" INTEGER -1
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 1 AGING_POINTS 1
                ^"Dexterity" INTEGER 2 AGING_POINTS 2
                ^"Quickness" INTEGER 2 AGING_POINTS 2
            }
            ^"Size" INTEGER 0
            ^"Age" INTEGER 45
            ^"Apparent Age" INTEGER 45
            ^"Decrepitude" INTEGER 1
            ^"Decrepitude Points" INTEGER 2
            ^"Warping Score" INTEGER 0
            ^"Warping Points" INTEGER 0
            ^"Virtues" LIST ["Covenfolk", "Warrior"]
            ^"Flaws" LIST ["Weakness (talking back to magi)"]
            ^"Soak" INTEGER 8 NOTE "full metal scale armor"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Equipment" LIST ["Axe", "Heater Shield", "Full Metal Scale Armor", "pack containing gear to care for weapons and armor and establish camps when traveling."]
            ^"Encumbrance" STRING "4 (4)"
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Loyal" +3
            "Cheeky" +2
            "Brave" +1
        }
        COMBAT {
            "Axe & Heater Shield" INIT -1 ATTACK 15 DEFENSE 14 DAMAGE 6
            "Kick" INIT -3 ATTACK 6 DEFENSE 5 DAMAGE 3
        }
        ABILITIES {
            "Area A Lore" SCORE 4 SPECIALTY "monsters"
            "Area B Lore" SCORE 2 SPECIALTY "monsters"
            "Awareness" SCORE 5 SPECIALTY "in combat"
            "Bows" SCORE 5 SPECIALTY "longbow"
            "Brawl" SCORE 3 SPECIALTY "kicking"
            "Carouse" SCORE 3 SPECIALTY "with fighting friends"
            "Folk Ken" SCORE 1 SPECIALTY "magi"
            "Great Weapon" SCORE 5 SPECIALTY "pole axe"
            "Guile" SCORE 2 SPECIALTY "getting extra rations"
            "Leadership" SCORE 3 SPECIALTY "in combat"
            "Living Language" SCORE 5 SPECIALTY "military talk"
            "Order of Hermes Lore" SCORE 3 SPECIALTY "grogs"
            "Single Weapon" SCORE 8 SPECIALTY "heater shield"
            "Stealth" SCORE 3 SPECIALTY "when armored"
            "Survival" SCORE 1 SPECIALTY "when in a group"
            "Thrown Weapon" SCORE 4 SPECIALTY "knife"
        }
        CHOICES {
            "The Grizzled Veteran has been around the covenant for years, but has never reached a formal position of leadership, because he has a tendency to talk back to the magi. On the other hand, he makes a good informal leader of the grogs. Age hasn't really slowed him down yet, but it is about to, and the years have already reduced his Presence and Communication to –1 each."
            "He could take another two Flaws and a corresponding number of Virtues if desired, and his Ability scores can be moved around. The high set should probably be kept in combat, but he could specialize in a different sort of combat (you would have to recalculate Combat Totals), and the secondary abilities can be moved around at will."
        }
    }

    #tXzK6OctGA7azAIj3Us9ZHKz TEMPLATE "The Hunter" DEF {
        EXTENDS ^"Grog"
        PROPERTIES {
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER -2
                ^"Communication" INTEGER -2
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 2
            }
            ^"Size" INTEGER 0
            ^"Age" INTEGER 20
            ^"Apparent Age" INTEGER 20
            ^"Decrepitude" INTEGER 0
            ^"Warping Score" INTEGER 0
            ^"Warping Points" INTEGER 0
            ^"Virtues" LIST ["Covenfolk", "Warrior"]
            ^"Flaws" LIST ["Pessimistic"]
            ^"Soak" INTEGER 3 NOTE "partial leather armor, Stamina"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Equipment" LIST ["Partial heavy leather", "short bow", "arrows", "survival kit."]
            ^"Encumbrance" STRING "2 (2)"
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Brave" +3
            "Loyal" +1
            "Pessimistic" +3
        }
        COMBAT {
            "Short Bow" INIT -1 ATTACK 9 DEFENSE 6 DAMAGE 6
        }
        ABILITIES {
            "Area Lore" SCORE 4 SPECIALTY "game trails"
            "Athletics" SCORE 1 SPECIALTY "climbing"
            "Awareness" SCORE 5 SPECIALTY "woodlands"
            "Bows" SCORE 4 SPECIALTY "shooting from cover"
            "Hunt" SCORE 5 SPECIALTY "deer"
            "Native Language" SCORE 5 SPECIALTY "talking about forests"
            "Stealth" SCORE 2 SPECIALTY "hunting"
            "Survival" SCORE 4 SPECIALTY "woodlands"
        }
        CHOICES {
            "The hunter is extremely useful in the wilderness, and can guide the party as well as take part in missile combat. He can also help to support the covenant by bringing in food. He doesn't work well in social situations, though. Note that the character's Bows score uses the bonus XP from Warrior, and thus cannot go below 4, but otherwise the values of his Abilities, apart from his Native Language, can be swapped freely."
        }
    }

    #tk0qAZFOO0ApcwILfg3ERTbu TEMPLATE "The Specialist" DEF {
        EXTENDS ^"Grog"
        PROPERTIES {
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -1
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER -1
                ^"Communication" INTEGER -4
                ^"Strength" INTEGER 2
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 2
            }
            ^"Size" INTEGER 0
            ^"Age" INTEGER 19
            ^"Apparent Age" INTEGER 19
            ^"Decrepitude" INTEGER 0
            ^"Warping Score" INTEGER 0
            ^"Warping Points" INTEGER 0
            ^"Virtues" LIST ["Covenfolk", "Affinity with Single Weapon", "Puissant Ability (Single Weapon)", "Warrior"]
            ^"Flaws" LIST ["Afflicted Tongue (stammer)", "Obsessed (improving Single Weapon ability)", "Poor Communication"]
            ^"Soak" INTEGER 9 NOTE "full metal scale armor"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Equipment" LIST ["Axe", "Heater Shield", "Full metal scale armor", "pack containing gear to care for weapons and armor and establish camps when traveling."]
            ^"Encumbrance" STRING "2 (4)"
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Brave" +3
            "Loyal" +2
            "Quiet" +1
        }
        COMBAT {
            "Axe & Heater Shield" INIT 1 ATTACK 17 DEFENSE 15 DAMAGE 8
            "Fist" INIT 0 ATTACK 8 DEFENSE 7 DAMAGE 2
        }
        ABILITIES {
            "Area Lore" SCORE 3 SPECIALTY "warriors"
            "Athletics" SCORE 3 SPECIALTY "running"
            "Awareness" SCORE 4 SPECIALTY "in combat"
            "Bargain" SCORE 2 SPECIALTY "weapons"
            "Bows" SCORE 1 SPECIALTY "short bow"
            "Brawl" SCORE 5 SPECIALTY "dodging"
            "Carouse" SCORE 1 SPECIALTY "drinking"
            "Living Language" SCORE 5 SPECIALTY "talking about fighting"
            "Single Weapon" SCORE 7 SPECIALTY "Heater Shield"
        }
        CHOICES {
            "The Specialist can easily focus on a different Ability, although you might want to swap the Characteristics around as well if he does, and probably change Warrior for one of the other experience-point-granting Virtues, such as Educated or Well-Traveled. You can change Personality Traits freely, and assign the Ability scores to other Abilities. Similarly, the Flaws can be changed without changing the central concept of the character."
        }
    }

    #tUpjyKZigfcCatJyGSqsNmJc TEMPLATE "The Standard Soldier" DEF {
        EXTENDS ^"Grog"
        PROPERTIES {
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -1
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER 1
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 2
            }
            ^"Size" INTEGER 0
            ^"Age" INTEGER 25
            ^"Apparent Age" INTEGER 25
            ^"Decrepitude" INTEGER 0
            ^"Warping Score" INTEGER 0
            ^"Warping Points" INTEGER 0
            ^"Virtues" LIST ["Covenfolk", "Warrior"]
            ^"Flaws" LIST ["Weakness"]
            ^"Soak" INTEGER 8 NOTE "full metal scale armor"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Equipment" LIST ["Axe", "Heater Shield", "Full metal scale armor", "pack containing gear to care for weapons and armor and establish camps when traveling"]
            ^"Encumbrance" STRING "3 (4)"
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Brave" +3
            "Loyal" +2
            "Garrulous" +1
        }
        COMBAT {
            "Axe & Heater Shield" INIT 0 ATTACK 12 DEFENSE 11 DAMAGE 7
            "Fist" INIT -1 ATTACK 7 DEFENSE 7 DAMAGE 1
        }
        ABILITIES {
            "Area Lore" SCORE 3 SPECIALTY "taverns"
            "Athletics" SCORE 3 SPECIALTY "running"
            "Awareness" SCORE 3 SPECIALTY "in combat"
            "Bows" SCORE 4 SPECIALTY "short bow"
            "Brawl" SCORE 4 SPECIALTY "punching"
            "Carouse" SCORE 3 SPECIALTY "drinking"
            "Charm" SCORE 2 SPECIALTY "opposite sex"
            "Etiquette" SCORE 2 SPECIALTY "magi"
            "Great Weapon" SCORE 4 SPECIALTY "pole axe"
            "Guile" SCORE 2 SPECIALTY "avoiding duties"
            "Native Language" SCORE 5 SPECIALTY "rude words"
            "Single Weapon" SCORE 5 SPECIALTY "heater shield"
            "Survival" SCORE 1 SPECIALTY "for a short period"
        }
        CHOICES {
            "The standard soldier's Weakness can be chosen freely, and he makes a good base for creating a slightly non-standard grog, by adding Virtues and Flaws and rearranging his Abilities."
        }
    }

    #tT4o2G3t6tS2chQb0IlgzlPN TEMPLATE "The Tough Guy" DEF {
        EXTENDS ^"Grog"
        PROPERTIES {
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -1
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER -1
                ^"Strength" INTEGER 1
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER 1
            }
            ^"Size" INTEGER 1
            ^"Age" INTEGER 19
            ^"Apparent Age" INTEGER 19
            ^"Decrepitude" INTEGER 0
            ^"Warping Score" INTEGER 0
            ^"Warping Points" INTEGER 0
            ^"Virtues" LIST ["Covenfolk", "Large", "Tough", "Warrior"]
            ^"Flaws" LIST ["No Sense of Direction", "Overconfident (thinks he can't really be hurt)", "Weakness (drinking)"]
            ^"Soak" INTEGER 13 NOTE "full metal scale armor + Tough"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–6), –3 (7–12), –5 (13–18), Incapacitated (19–24)"
            ^"Equipment" LIST ["Axe", "Heater Shield", "Full metal scale armor", "pack containing gear to care for weapons and armor and establish camps when traveling"]
            ^"Encumbrance" STRING "3 (4)"
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Brave" +3
            "Loyal" +2
            "Overconfident" +3
        }
        COMBAT {
            "Axe & Heater Shield" INIT -1 ATTACK 10 DEFENSE 10 DAMAGE 7
            "Fist" INIT -2 ATTACK 3 DEFENSE 4 DAMAGE 1
        }
        ABILITIES {
            "Area Lore" SCORE 2 SPECIALTY "brewers"
            "Athletics" SCORE 1 SPECIALTY "running"
            "Awareness" SCORE 3 SPECIALTY "in combat"
            "Bows" SCORE 1 SPECIALTY "shortbow"
            "Brawl" SCORE 3 SPECIALTY "grappling"
            "Carouse" SCORE 4 SPECIALTY "drinking"
            "Charm" SCORE 3 SPECIALTY "when drunk"
            "Folk Ken" SCORE 1 SPECIALTY "magi"
            "Great Weapon" SCORE 3 SPECIALTY "pole axe"
            "Guile" SCORE 1 SPECIALTY "lying to magi"
            "Living Language" SCORE 5 SPECIALTY "talking about fighting"
            "Music" SCORE 1 SPECIALTY "drinking songs"
            "Single Weapon" SCORE 5 SPECIALTY "heater shield"
            "Survival" SCORE 1 SPECIALTY "on rivers"
            "Thrown Weapon" SCORE 2 SPECIALTY "axe"
        }
        CHOICES {
            "The Tough Guy works well as a defender for a magus, because he can take a lot of punishment before dropping and making the magus vulnerable. The Virtues depend on the concept, but the Flaws can be changed freely, and his combat Ability scores can be swapped freely between the combat Abilities he has."
        }
    }

    #tlOGmpCxLK7nU9oXbONDwWR8 TEMPLATE "The Female Scholar" DEF {
        EXTENDS ^"Companion"
        PROPERTIES {
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 5
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER -1
                ^"Stamina" INTEGER -1
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER 1
            }
            ^"Size" INTEGER 0
            ^"Age" INTEGER 20
            ^"Apparent Age" INTEGER 20
            ^"Decrepitude" INTEGER 0
            ^"Warping Score" INTEGER 0
            ^"Warping Points" INTEGER 0
            ^"Confidence Score" INTEGER 1
            ^"Confidence Points" INTEGER 3
            ^"Virtues" LIST ["Clerk", "Apt Student", "Book Learner", "Good Teacher", "Great Intelligence (x2)", "Improved Characteristics"]
            ^"Flaws" LIST ["Black Sheep", "Driven (Major) (prove herself a greater scholar than any man)", "Social Handicap (outspoken advocate of the abilities of women)"]
            ^"Soak" INTEGER -1 NOTE "Stamina"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Equipment" LIST ["Clothes", "a slate or wax tablet for writing on"]
            ^"Encumbrance" STRING "0 (0)"
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Scholarly" +3
            "Independent" +1
            "Trusting" -2
        }
        REPUTATIONS {
            "Selfish shrew" SCORE 2 TYPE "Local"
        }
        COMBAT {
            "Dodging" INIT 1 DEFENSE 1
        }
        ABILITIES {
            "Arabic" SCORE 1 SPECIALTY "medical terms"
            "Area Lore" SCORE 2 SPECIALTY "nunneries"
            "Artes Liberales" SCORE 3 SPECIALTY "rhetoric"
            "Charm" SCORE 2 SPECIALTY "scholars"
            "Church Lore" SCORE 2 SPECIALTY "scholars"
            "Civil and Canon Law" SCORE 1 SPECIALTY "rights of women"
            "Folk Ken" SCORE 2 SPECIALTY "scholars"
            "Guile" SCORE 2 SPECIALTY "lying to authority figures"
            "Latin" SCORE 5 SPECIALTY "academic debate"
            "Living Language" SCORE 5 SPECIALTY "debate"
            "Medicine" SCORE 1 SPECIALTY "women's illnesses"
            "Philosophiae" SCORE 3 SPECIALTY "moral philosophy"
            "Teaching" SCORE 3 SPECIALTY "Artes Liberales"
            "Theology" SCORE 2 SPECIALTY "status of women"
        }
        CHOICES {
            "Her current Virtues are very focused on scholarship, so changing one or two for Virtues that emphasize a different aspect of her life would be fine. Similarly, the emphasis of her studies could be moved to a different subject, as long as she still has a score of at least one in Artes Liberales, so that she is literate."
        }
        DESCRIPTION "The female scholar has estranged herself from her family by refusing to marry a suitable man, and instead pursuing her bizarre interest in academia. She has probably come to the covenant because it is the only place where she can study freely, and she wants access to the covenant library if she doesn't already have it."
    }

    #teXvhnbRgXdqpUuKDsoFus9v TEMPLATE "The Knight" DEF {
        EXTENDS ^"Companion"
        PROPERTIES {
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER 1
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 2
            }
            ^"Size" INTEGER 0
            ^"Age" INTEGER 25
            ^"Apparent Age" INTEGER 25
            ^"Decrepitude" INTEGER 0
            ^"Warping Score" INTEGER 0
            ^"Warping Points" INTEGER 0
            ^"Confidence Score" INTEGER 1
            ^"Confidence Points" INTEGER 3
            ^"Virtues" LIST ["Knight", "Wealthy", "Improved Characteristics", "Puissant Single Weapon", "Relic"]
            ^"Flaws" LIST ["Oath of Fealty", "Proud (Major)", "Overconfident (Minor)"]
            ^"Soak" INTEGER 10 NOTE "chain mail, Stamina"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Equipment" LIST ["Full chain mail", "long sword", "heater shield", "great sword"]
            ^"Encumbrance" STRING "2 (3)"
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Brave" +3
            "Overconfident" +3
            "Proud" +6
        }
        COMBAT {
            "Long sword and heater shield (mounted)" INIT 2 ATTACK 17 DEFENSE 17 DAMAGE 7
            "Long sword and heater shield (on foot)" INIT 2 ATTACK 14 DEFENSE 14 DAMAGE 7
            "Great sword (mounted)" INIT 2 ATTACK 16 DEFENSE 13 DAMAGE 10
            "Great sword (on foot)" INIT 2 ATTACK 13 DEFENSE 10 DAMAGE 10
            "Fist" INIT 0 ATTACK 5 DEFENSE 5 DAMAGE 1
        }
        ABILITIES {
            "Animal Handling" SCORE 2 SPECIALTY "falconry"
            "Area Lore" SCORE 3 SPECIALTY "nobles"
            "Athletics" SCORE 2 SPECIALTY "running"
            "Awareness" SCORE 3 SPECIALTY "battle"
            "Brawl" SCORE 2 SPECIALTY "punching"
            "Chirurgy" SCORE 1 SPECIALTY "sword wounds"
            "Etiquette" SCORE 3 SPECIALTY "noble"
            "Great Weapon" SCORE 5 SPECIALTY "great sword"
            "Hunt" SCORE 2 SPECIALTY "deer"
            "Intrigue" SCORE 1 SPECIALTY "noble courts"
            "Leadership" SCORE 4 SPECIALTY "soldiers"
            "Music" SCORE 1 SPECIALTY "singing"
            "Native Language" SCORE 5 SPECIALTY "giving orders"
            "Ride" SCORE 5 SPECIALTY "in combat"
            "Single Weapon" SCORE 5 SPECIALTY "heater shield"
            "Survival" SCORE 1 SPECIALTY "forests"
        }
        CHOICES {
            "The Knight's Wealthy Virtue gives him a lot of experience points, and so cannot be changed without effectively recreating the character from scratch. Oath of Fealty can be swapped for True Love and still be appropriate. In fact, both are so appropriate to a knight that the troupe may allow you to take both, as the character can still take three more points of Flaws. Note that the character regards himself as superior to just about anyone, unless you change the Major Personality Flaw, and doesn't have the Abilities to interact well with equals."
        }
    }

    #t5AXrq2oM0eqL1TrxSbJaCdw TEMPLATE "The Priest" DEF {
        EXTENDS ^"Companion"
        PROPERTIES {
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 1
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 0
                ^"Dexterity" INTEGER -1
                ^"Quickness" INTEGER 0
            }
            ^"Size" INTEGER 0
            ^"Age" INTEGER 33
            ^"Apparent Age" INTEGER 33
            ^"Decrepitude" INTEGER 0
            ^"Warping Score" INTEGER 0
            ^"Warping Points" INTEGER 0
            ^"Confidence Score" INTEGER 1
            ^"Confidence Points" INTEGER 3
            ^"Virtues" LIST ["Priest", "Inspirational", "Lesser Immunity (lightning)", "Relic", "Sense Holiness and Unholiness", "Social Contacts (minor clergy)", "Student of the Divine", "Well-Traveled", "Plagued by Angel"]
            ^"Flaws" LIST ["Compassionate (Major)", "Clumsy", "Vow of Celibacy"]
            ^"Soak" INTEGER 0 NOTE "Stamina"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Equipment" LIST ["Priest's clothes", "a missal"]
            ^"Encumbrance" STRING "0 (0)"
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Compassionate" +3
            "Pious" +3
            "Loyal" +2
        }
        COMBAT {
            "Dodging" INIT 0 DEFENSE 2
        }
        ABILITIES {
            "Area Lore" SCORE 5 SPECIALTY "churches"
            "Artes Liberales" SCORE 2 SPECIALTY "rhetoric"
            "Brawl" SCORE 1 SPECIALTY "dodging"
            "Charm" SCORE 5 SPECIALTY "parishioners"
            "Church Lore" SCORE 3 SPECIALTY "local diocese"
            "Civil and Canon Law" SCORE 1 SPECIALTY "regulations for the clergy"
            "Dominion Lore" SCORE 5 SPECIALTY "angels"
            "Etiquette" SCORE 3 SPECIALTY "Church"
            "Folk Ken" SCORE 6 SPECIALTY "people he knows very well"
            "Intrigue" SCORE 1 SPECIALTY "parishes"
            "Latin" SCORE 4 SPECIALTY "the Bible"
            "Leadership" SCORE 3 SPECIALTY "preaching"
            "Living Language" SCORE 5 SPECIALTY "preaching"
            "Sense Holiness and Unholiness" SCORE 4 SPECIALTY "angels"
            "Theology" SCORE 2 SPECIALTY "angelology"
        }
        CHOICES {
            "The Priest could take another two Minor Flaws and corresponding Virtues, if desired. He may be unaware of his immunity, or being struck by lightning and remaining completely unharmed may have been a central event in his past. If it happened, it should be. The nature of his Lesser Immunity can easily be changed, and even boosted to a Greater Immunity if you take two more Minor Flaws."
        }
    }

    #tGs3EuKzDJPXvpG912C4EZkE TEMPLATE "The Rogue" DEF {
        EXTENDS ^"Companion"
        PROPERTIES {
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER -1
                ^"Stamina" INTEGER 0
                ^"Dexterity" INTEGER 4
                ^"Quickness" INTEGER 4
            }
            ^"Size" INTEGER 0
            ^"Age" INTEGER 20
            ^"Apparent Age" INTEGER 20
            ^"Decrepitude" INTEGER 0
            ^"Warping Score" INTEGER 0
            ^"Warping Points" INTEGER 0
            ^"Confidence Score" INTEGER 1
            ^"Confidence Points" INTEGER 3
            ^"Virtues" LIST ["Wanderer", "Great Dexterity", "Great Quickness", "Improved Characteristics (x2)", "Light Touch", "Perfect Balance", "Puissant Legerdemain", "Puissant Stealth"]
            ^"Flaws" LIST ["Avaricious (Major)", "Dark Secret", "Compulsion", "Night Terrors"]
            ^"Soak" INTEGER 0 NOTE "Stamina"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Equipment" LIST ["Clothes", "secret stash of money that he never spends"]
            ^"Encumbrance" STRING "0 (0)"
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Avaricious" +6
            "Daring" +2
            "Sociable" +2
        }
        COMBAT {
            "Fist" INIT 4 ATTACK 7 DEFENSE 7 DAMAGE -1
        }
        ABILITIES {
            "Area Lore" SCORE 1 SPECIALTY "rich people's homes"
            "Athletics" SCORE 3 SPECIALTY "climbing"
            "Awareness" SCORE 3 SPECIALTY "noticing whether he is observed"
            "Brawl" SCORE 3 SPECIALTY "getting away"
            "Charm" SCORE 2 SPECIALTY "people who think he's exciting"
            "Folk Ken" SCORE 1 SPECIALTY "people in authority"
            "Guile" SCORE 1 SPECIALTY "when caught red-handed"
            "Legerdemain" SCORE 7 SPECIALTY "picking pockets"
            "Native Language" SCORE 5 SPECIALTY "being polite"
            "Stealth" SCORE 7 SPECIALTY "being quiet"
        }
        CHOICES {
            "The Rogue's Dark Secret can be almost anything, but is most likely to be a particularly vile crime that he committed in the past, and now, probably, feels guilty about. The compulsion should be to commit some sort of minor criminal act, such as thievery, or to take risks to prove he can. This character is fundamentally fast and stealthy, although he can turn on the charm to a certain extent. By moving the numbers in Characteristics and Abilities, you can turn him into a charmer with some ability in stealth. Don't forget to change the Great Characteristic and Puissant Ability Virtues if you do this."
        }
    }

