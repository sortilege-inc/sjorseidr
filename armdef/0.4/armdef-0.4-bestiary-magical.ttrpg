        }
        POWERS {
            ^"Pack of One" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "+10"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION "The wolf can create five duplicates of himself, who can then fight as a trained group. For these purposes, treat the wolf as having a Leadership score of 5, so that he can get the full +15 group bonus to his attacks. The power lasts until the pack brings down its opponent, which may be a group, or disengages from the fight. As the pack is really all one creature, the nomination of a vanguard is arbitrary. Further, the group does not need to disengage and reform when the vanguard is killed; it can seamlessly transfer the role to another wolf. Finally, the wolf only dies if all the copies are killed. When the duplicates vanish, the least wounded wolf remains."
            }
            ^"Terrifying Howl" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Anyone who hears the wolf's howl is struck with fear of the wolf and of wilderness places away from the haunts of men. Someone already in a house will merely not want to leave. Overcoming this fear completely requires a Brave roll against an Ease Factor of 12. Acting sensibly while responding to it, such as heading back to the village carefully, requires a Brave roll against an Ease Factor of 6. Those who fail the easier roll simply flee in panic."
            }
            ^"Wolf Lord" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION "Any wolf the magical wolf strikes in deadly combat dies instantly. In addition, the magical wolf can make mundane wolves follow his instructions even when he is not around, as long as the instructions are quite simple."
            }
        }
        DESCRIPTION "The magical wolf does not care for such human niceties as names, and isn't particularly interested in human beings. Instead, he watches over all the wolves in his range, doing what he can to ensure their safety, health, and food supply. Sometimes, this means hunting wolves down himself, to keep population down, and in that case he removes the weak from the packs. While he has no interest in human beings, he does see that they are important, and might be willing to negotiate with a village. On the other hand, he might decide to drive them out. This magical wolf has the same reactions to The Gift as a mundane animal, although other magical wolves may not."
    }

    #tAVFaOUlFmLGyQ2LEh5jC4dk ^"Adranus, the Spirit of Mount Etna" DEF {
        EXTENDS ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 50
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Ignem"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER 2
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 3
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER -1
                ^"Quickness" INTEGER -2
            }
            ^"Virtues and Flaws" LIST ["Ways of the Mountains", "Improved Characteristics x5", "Fury, Wrathful"]
            ^"Reputations" LIST ["Bringer of Death and Destruction 5 (Local)"]
            ^"Vis" STRING "10 pawns of Ignem vis; 5 pawns per year can also be harvested from the crater at the volcano's summit."
            ^"Appearance" STRING "Mount Etna is a conical and blasted peak that rises ten thousand feet above the eastern end of the island of Sicily."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Wrathful" +6
            "Slumbering" +3
        }
        ABILITIES {
            "Sicily Lore" SCORE 6 SPECIALTY "mountains"
            "Magic Lore" SCORE 8 SPECIALTY "underworld"
        }
        POWERS {
            ^"Crafter of Fire" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "-2 – Might cost"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "Duplicates any non-Ritual Creo Ignem or Rego Ignem spell no greater than 50th level at a cost of 1 Might point per magnitude of the effect."
            }
            ^"Crafter of Earth" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "-2 – Might cost"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "Duplicates any non-Ritual Creo Terram or Rego Terram spell no greater than 50th level at a cost of 1 Might point per magnitude of the effect."
            }
            ^"Grant Visions" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "-12"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "The target gains the Visions Flaw. Adranus can grant the Flaw temporarily, in which case it does not recover the Might Points spent until it withdraws the Flaw, or permanently, in which case its Might Score is reduced by 5."
            }
            ^"Grant Simple-Minded" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "-12"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "The target gains the Simple-Minded Flaw. Adranus can grant the Flaw temporarily, in which case it does not recover the Might Points spent until it withdraws the Flaw, or permanently, in which case its Might Score is reduced by 5."
            }
            ^"Grant Wrathful" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "-12"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "The target gains the Wrathful Flaw. Adranus can grant the Flaw temporarily, in which case it does not recover the Might Points spent until it withdraws the Flaw, or permanently, in which case its Might Score is reduced by 5."
            }
            ^"Hibernation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "15 points"
                    ^"Initiative" STRING "-32"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "The spirit remains completely inactive for a year (spending no other Might points); the 15 points spent on this power are saved and added to the Might Pool for the first year out of hibernation. In this fashion, the Might Pool may exceed the permanent Might score (50). Using this power, the volcano can save up Might points over many years in succession and have a great amount to spend in the single year in which it awakens."
            }
            ^"Manifestation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 or more points"
                    ^"Initiative" STRING "equal to (Qik – Might points spent)"
                    ^"Form" STRING "Animal"
                    ^"Range" STRING "Touch"
                    ^"Duration" STRING "Conc"
                    ^"Target" STRING "Ind or Group"
                    ^"Spell Equivalent" STRING "ReHe 20 or more or ReAn 25 or more"
                    ^"Design" STRING "(Base 10, +1 Touch, +1 Conc) or (Base 15, +1 Touch, +1 Conc)"
                }
                DESCRIPTION "Manifests the spirit's consciousness among animals it touches, temporarily granting them a Might score equal to the Might points spent, and controlling their actions. It is a Rego Herbam effect of Level 20 to control a plant that is a pace in diameter (costing 4 Might points), and a Rego Animal of Level 25 to control a single creature of Size +1 (costing 5 Might points). For an extra 2 Might points, a group of ten standard creatures (or the equivalent mass) can be controlled. For each additional 2 Might points spent, the mass of creatures controlled is multiplied by 10. The spirit cannot spend more Might points on this power than the magnitude of its Magic Might. Humans and other sentient beings cannot be controlled by this power. Adranus is considered to be touching any animal on the mountain."
            }
            ^"Master of Earth" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "-2 – Might cost"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "Duplicates any non-Ritual Muto Terram or Perdo Terram spell no greater than 50th level at a cost of 1 Might point per magnitude of the effect."
            }
            ^"Presence" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Imaginem"
                    ^"Range" STRING "Arc"
                    ^"Duration" STRING "Sun"
                    ^"Target" STRING "Ind"
                    ^"Spell Equivalent" STRING "InIm 30"
                    ^"Design" STRING "(Base 2, +4 Arc, +2 Sun, +1 constant effect, +1 non-Hermetic effects)"
                }
                DESCRIPTION "Grants awareness of everything that happens within the bounds of Mount Etna. In essence, the spirit is coterminous with its associated landscape feature, so it is present simultaneously everywhere within its boundaries. The area controlled by the spirit can produce a yearly harvest of 5 pawns of Ignem vis, which manifests as physical objects within the controlled region. Harvesting this vis does not erode the spirit's Might."
            }
            ^"Regio" DEF {
                PROPERTIES {
                    ^"Cost" STRING "15 points"
                    ^"Initiative" STRING "-32"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "By permanently spending Might, the spirit can add levels to the regio around the volcano's crater."
            }
            ^"Ruler of Lava" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "-2 – Might cost"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "Duplicates any non-Ritual spell pertaining to lava no greater than 50th level, at a cost of 1 Might point per magnitude of the effect."
            }
            ^"Ruler of Smoke" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "-2 – Might cost"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "Duplicates any non-Ritual spell pertaining to smoke no greater than 50th level, at a cost of 1 Might point per magnitude of the effect."
            }
        }
    }

    #tJMEUj1sEYbkziMROZhlsRNy ^"Revenant, Corpse-Like Form" DEF {
