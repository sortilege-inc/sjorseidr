        }
        DESCRIPTION "This power gives the automaton a Strength of +1 as per the description in Houses of Hermes: Mystery Cults, page 130. (Effect: Base 10, +2 Sun, +1 Part; Modifications: +1 for 2/day, +3 triggered at sunrise/set)"
    }
    #t90040d45c61caf1a0560fa ^"The Master At Work" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
