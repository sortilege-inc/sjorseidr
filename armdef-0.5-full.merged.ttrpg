    #tSfpzXq6CuvYABRlzxoX1wbR ^"Adhere" DEF {
        EXTENDS #t84d15c61569668f6f97c5a ^"Faerie Power"
        PROPERTIES {
            ^"Group" STRING "Greater and Lesser" FIXED
            ^"Might Cost" STRING "1 point, Init –1, Corpus"
            ^"Might Cost Value" INTEGER 1
            ^"Initiative" STRING "Init –1"
            ^"Form" STRING "Corpus"
            ^"Source" STRING "Realms of Power: Faerie"
        }
        DESCRIPTION "Takes control of the muscles of the lower body of the target. He cannot dismount the faerie animal unless it wishes, which is of aid when riding friendly flying animals, but is dangerous with animal-like kelpies.

Costs 5 spell levels (ReCo Base 3 +1 Touch +1 Conc.)"
    }
    #tN1GaLuGLRLzye1jdo3aoQuK ^"Allure" DEF {
