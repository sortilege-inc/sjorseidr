                        "Folk Ken" SCORE 4 SPECIALTY "peasants"
                        "Guile" SCORE 4 SPECIALTY "concealing his past"
                        "Hunt" SCORE 2 SPECIALTY "rabbits"
                        "Intrigue" SCORE 2 SPECIALTY "people interested in him"
                        "Living Language" SCORE 5
                        "Organization Lore: Covenant" SCORE 2 SPECIALTY "jobs that need doing"
                        "Profession: Brewer" SCORE 4 SPECIALTY "saving materials"
                        "Profession: Farmer" SCORE 4 SPECIALTY "harvest"
                        "Profession: Laborer" SCORE 4 SPECIALTY "digging"
                        "Profession: Tinker" SCORE 4 SPECIALTY "tin"
