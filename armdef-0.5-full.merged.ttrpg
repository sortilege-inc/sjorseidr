                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "–3"
                    ^"Form" STRING "Imaginem"
                }
                DESCRIPTION "(4 intricacy points on cost): variant that has a constant effect on a structure."
            }
            ^"Transform Into Human" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION "(3 intricacy points on cost, 2 on initiative): This power transforms the character between human and feasting form. It is treated as a Personal level 25 MuCo(An) effect."
