            "Athletics" SCORE 2 SPECIALTY "running"
            "Bargain" SCORE 1 SPECIALTY "corpses"
            "Brawl" SCORE 3 SPECIALTY "getting away"
            "Concentration" SCORE 2 SPECIALTY "at night"
            "Chirurgy" SCORE 2 SPECIALTY "crushing injuries"
            "Craft Poppets" SCORE 2 PUISSANT 5 SPECIALTY "wizards"
            "Folk Ken" SCORE 2 SPECIALTY "customers"
            "Guile" SCORE 3 SPECIALTY "feigning innocence"
            "Legerdemain" SCORE 2 SPECIALTY "acquiring locks of hair"
            "Magic Lore" SCORE 3 SPECIALTY "undead"
