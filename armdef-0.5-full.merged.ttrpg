            "Finesse" SCORE 6 SPECIALTY "Rego"
            "Folk Ken" SCORE 2 SPECIALTY "customs of surrounding area"
            "Guile" SCORE 3 SPECIALTY "men"
            "Intrigue" SCORE 4 SPECIALTY "against magi"
            "Leadership" SCORE 6 SPECIALTY "in warfare"
            "Order of Hermes Lore" SCORE 5 SPECIALTY "conflicts"
            "Penetration" SCORE 6 SPECIALTY "using Arcane Connections"
            "Swim" SCORE 9 SPECIALTY "home waters"
        }
        POWERS {
            ^"Extended Glamor" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "constant"
                }
                DESCRIPTION ""
            }
            ^"Focus Power (Water within her realm)" DEF {
                PROPERTIES {
                    ^"Cost" STRING "up to 10 points"
                    ^"Initiative" STRING "–9"
                    ^"Form" STRING "Aquam"
                }
                DESCRIPTION "Some of the Ladies have other focuses. This is the most common. They have been known to kill with versions of Ice of Drowning, Mighty Torrent of Water, Pull of the Watery Grave, and Tower of Whirling Water using this power. Note that in character creation, the same focus power has been selected twice to gain this higher level."
            }
            ^"Touch of the Mermaid" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "–2"
                    ^"Form" STRING "Aquam"
                }
                DESCRIPTION "Kiss of the Mermaid, for characters too regal to kiss a magus for ease of transport."
                REFERENCES {
                    "Kiss of the Mermaid" -> #tG7vzPI3lGkclU3bN3tu6psY ^"Kiss of the Mermaid"
                }
            }
            ^"Torrent from the Lungs" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "–2"
                    ^"Form" STRING "Aquam"
                }
                DESCRIPTION "The Ladies often live in kingdoms of salt water, where this spell and a skin of potable water can be used as negotiating tools."
            }
            ^"Transform into (one of Current/Wave)" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "–4"
                    ^"Form" STRING "Aquam"
                }
                DESCRIPTION "(Until Duration) (3 intricacy points to reduce cost)"
            }
            ^"Transform Victim into (one of Seagull/Crab/Salmon)" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "–3"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION "(2 intricacy points to reduce cost)"
            }
        }
        DESCRIPTION "Faerie Might: 40+10 (Aquam). They prefer to use magical effects rather than weapons. Each lady also has distinct, individual powers. Pine Away is the most common of these, but Enthrall and Spirit Away are also common. These have not been included in the Virtue section. Equipment: A small kingdom of faerie servants. Mystical artifacts which at a minimum include a scrying pool. Centuries of shipwreck treasure. Clothed in white wool, with flowers in her long hair. Often carries a comb and mirror.

“White Lady” is a euphemism used in the Normandy Tribunal, much as “good neighbours” or “wee folk” are used in other places, to refer to the faeries without offending them."
        REFERENCES {
            "Pine Away" -> #t0bXXL3syKsyO0K7zoTYJk2o ^"Pine Away"
            "Spirit Away" -> #tb5io6GQnmuJWz3czvmoJ5Dn ^"Spirit Away"
        }
    }
    #tjbUJr9k6wBn3M1AXiIdcu6E ^"Faerie Noble: The Privy Counselor" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 35
            ^"Might Realm" STRING "Faerie" FIXED
            ^"Form" STRING "Imaginem"
            ^"Size" INTEGER 0
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 2
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 0
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER 0
            }
            ^"Soak" INTEGER 0
            ^"Wound Penalties" STRING "–1 (1-5), –3 (6-10), –5 (11-15), Incapacitated (16-20), Dead (21+)"
            ^"Vis" STRING "7 pawns, in hat (External Vis Virtue)."
            ^"Appearance" STRING "The privy counselor looks like a young nobleman, and often claims to be the bastard of a duke who sent him away, but set him up in business. He uses his powers to maintain an apparently sumptuous home, after finding a site in a city where the Dominion is weaker than usual. He gains real money to fund his role, by stealing it using shapeshifting and enthrallment."
            ^"Source" STRING "Realms of Power: Faerie Bestiary"
        }
        VIRTUES {
            ^"External Vis"
            OF "Venus’ Blessing, his signet ring"
            ^"Greater Faerie Powers"
            TIMES 3
            ^"Increased Faerie Might"
            TIMES 6
            ^"Faerie Sight"
            ^"Faerie Speech"
            ^"Humanoid Faerie"
            ^"Improved Characteristic"
            TIMES 2
            ^"Personal Faerie Powers"
            TIMES 3
        }
        FLAWS {
            ^"Restricted Might"
            SIZE "Major" NOTE "in the presence of honest people"
            ^"Sovereign Ward"
            OF "places or objects sacred to Saint Thaddeus, the patron of penitent thieves"
            ^"Sovereign Ward"
            OF "crossing the Aegis of the Hearth"
            ^"Oath of Fealty"
            OF "monarch"
            ^"Incognizant"
            ^"Traditional Ward"
            OF "keys"
        }
        PERSONALITY_TRAITS {
            "Charming" +3
            "Sarcastic" +3
        }
        COMBAT {
            "Brawl (bludgeon)" INIT 0 ATTACK 2 DEFENSE 0 DAMAGE 2
            "Long Sword" INIT 2 ATTACK 5 DEFENSE 2 DAMAGE 6
        }
        ABILITIES {
            "Awareness" SCORE 1 SPECIALTY "amusing things"
            "Carouse" SCORE 3 SPECIALTY "feasts"
            "Charm" SCORE 1 SPECIALTY "criminals"
            "Brawl" SCORE 1 SPECIALTY "when surprised"
            "Etiquette" SCORE 4 SPECIALTY "merchants"
            "Faerie Speech" SCORE 6 SPECIALTY "speeches"
            "Intrigue" SCORE 3 SPECIALTY "against magi"
            "Order of Hermes Lore" SCORE 3 SPECIALTY "covenant administration"
            "Penetration" SCORE 1 SPECIALTY "Enthrallment"
            "Ride" SCORE 1 SPECIALTY "horses"
            "Single Weapon" SCORE 1 SPECIALTY "dirty fighting"
        }
        POWERS {
            ^"Enthrallment" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "-1"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "(3 points on Initiative +1 point for Penetration)"
            }
            ^"Illusionary Home" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "–4"
                    ^"Form" STRING "Imaginem"
                }
                DESCRIPTION "(Room or structure variant depending on role)"
            }
            ^"Image Phantom" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "–2"
                    ^"Form" STRING "Imaginem"
                }
                DESCRIPTION "Image Phantom."
            }
            ^"Steal Judgment" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "–2"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Steal Judgment."
            }
            ^"Allure" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "(1 intricacy point on cost)"
            }
            ^"Invisibility" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "–2"
                    ^"Form" STRING "Imaginem"
                }
                DESCRIPTION "(2 intricacy points on cost)"
            }
            ^"Shift Human Shapes" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "(1 intricacy point on cost and Initiative)"
            }
            ^"Transform into Coin" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "–4"
                    ^"Form" STRING "as form of object"
                }
                DESCRIPTION "the faerie often takes the shape of a coin to spy on its enemies. (This example does not use the Extend Glamour power, but it is recommended for principal faeries of minor courts.)"
                REFERENCES {
                    "Extend Glamour" -> #t7122890525a87b968f208f ^"Extend Glamour"
                }
            }
        }
        DESCRIPTION "Equipment: Sumptuous clothing, and effortless wealth. Faerie nobles vary widely in appearance and power. They serve as the monarchs of lesser faerie courts, or as the principal agents of great monarchs or pagan gods. Faerie nobles can superficially be mistaken for their human counterparts, particularly by the poor, who rarely see mortal nobles. The Privy Counselor is a trickster and saboteur that an angered faerie monarch sends to strike at the covenant’s interests in the mortal world. It lacks the cognizance to change its role. This prevents the Privy Counselor parleying with the magi to change sides and strike at its monarch."
    }
    #taxqliKXt9qRVaOftSTIODe3 ^"Champion: Sir Excelsis" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 25
            ^"Might Realm" STRING "Faerie" FIXED
            ^"Form" STRING "Ignem, in this case, but usually Corpus or Terram depending on what’s under the armor"
            ^"Size" INTEGER 2
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 1
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER 9
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 0
            }
            ^"Soak" INTEGER 10
            ^"Wound Penalties" STRING "–1 (1-7), –3 (8-14), –5 (15-21), Incapacitated (22-28), Dead (29+)"
            ^"Vis" STRING "5 pawns Ignem, a rusty piece from human–sized armor. For other champions, storyguides might consider a rusty weapon, and add the External Vis virtue."
            ^"Appearance" STRING "An immense human figure clad in scaled armor of metal fern fronds, that can turn into a huge, but superficially charming man. His fastidious chivalry exceeds that of the humans he impersonates, and he enjoys challenging humans to duels over minor shortfalls."
            ^"Source" STRING "Realms of Power: Faerie Bestiary"
        }
        VIRTUES {
            ^"Huge"
            ^"Increased Faerie Might"
            TIMES 4
            ^"Cognizant within Role"
            ^"Faerie Sight"
            ^"Faerie Speech"
            ^"Great Characteristic"
            TIMES 2
            ^"Humanoid Faerie"
            ^"Observant"
            ^"Improved Characteristic"
            TIMES 3
            ^"Improved Damage"
            OF "sword"
            ^"Personal Faerie Powers"
            TIMES 2
            ^"Puissant Pretense"
        }
        FLAWS {
            ^"Enemies"
            OF "other knights who want this role"
            ^"Puissant Militant Pretense"
            ^"Sovereign Ward"
            OF "spilled blood of a noblewoman"
            ^"Sovereign Ward"
            OF "The Dominion"
        }
        PERSONALITY_TRAITS {
            "Loyal" +3
            "Proud" +3
        }
        COMBAT {
            "Brawl (gauntlets)" INIT 0 ATTACK 2 DEFENSE 4 DAMAGE 11
            "Greatsword" INIT 2 ATTACK 18 DEFENSE 13 DAMAGE 23
            "Lance and Heater Shield" INIT 2 ATTACK 17 DEFENSE 14 DAMAGE 23
            "Great Sword and Heater Shield" INIT 2 ATTACK 17 DEFENSE 15 DAMAGE 20
            "Mace and Heater Shield" INIT 1 ATTACK 16 DEFENSE 14 DAMAGE 17
        }
        ABILITIES {
            "Area Lore" SCORE 3 SPECIALTY "hunting spots"
            "Awareness" SCORE 5 SPECIALTY "enemies"
            "Brawl" SCORE 6 SPECIALTY "knights"
            "Carouse" SCORE 4 SPECIALTY "feasts"
            "Charm" SCORE 3 SPECIALTY "ladies"
            "Etiquette" SCORE 5 SPECIALTY "faerie court"
            "Faerie Speech" SCORE 6 SPECIALTY "boasting"
            "Folk Ken" SCORE 3 SPECIALTY "surrounding humans"
            "Hunt" SCORE 5 SPECIALTY "humans"
            "Intrigue" SCORE 3 SPECIALTY "against other knights"
            "Leadership" SCORE 9 SPECIALTY "tournaments"
            "Ride" SCORE 6 SPECIALTY "horses"
            "Single Weapon" SCORE 9 SPECIALTY "tourney field (9+2)"
        }
        POWERS {
            ^"Damaging Effect" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "–6"
                    ^"Form" STRING "Terram or Herbam"
                }
                DESCRIPTION "Terram (supernaturally sharp) or Herbam (poisoned), 2 intricacy points spent on cost. This is designed as a Lesser Power. More mystically endowed knights may have this as a Greater Power (Cost 2, Initiative –2, possibly with the cost adjusted down using intricacy) and may stack it with Improved Damage."
                REFERENCES {
                    "Lesser Power" -> #trycp5AY4LCEmvmCP10xvgWb ^"Lesser Power"
                    "Greater Power" -> #tO5XFGkxH39d8IsuOBi2cXBp ^"Greater Power"
                    "Improved Damage" -> #thH1bCzoiitnhPpJ0mq02EIG ^"Improved Damage"
                }
            }
            ^"Glide" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "A renaming of the Flight power, this allows Sir Excelsis to move through the waters of the subaquatic kingdom as a flier would through air. This enables him to swim and fight at the same time, for example. It does, technically, still allow him to fly."
            }
            ^"Shift Human Shapes" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Allows the champion to don or remove armor simply by willing it. (1 intricacy point to reduce cost)"
            }
        }
        DESCRIPTION "* Various weapons have been described here to speed customization. Unusual weapons that suit the motif or the court may use the scores above, with slicing weapons in lieu of swords and bashing weapons in lieu of maces. These statistics do not include the +5 Damage bonus the champion gains when using the Damaging Effect power, or the bonus of +3 to Attack and Defense gained when fighting mounted, or the +1 for fighting on the tourney field. They do include the effect of the Puissant Pretense Virtue in all cases, so if the champion is forced to swap away from his preferred weapon, he suffers a –2 penalty on the Attack and Defense scores listed above. ** Also includes +5 for Improved Damage. Equipment: Armor of magical scales of faerie iron. Lance with pennant and other weapons. Attendant as squire. Trappings marked with the burning fern motif. The champion’s glamor produces a faerie horse for him, which has the statistics given below for faerie horses, except that it shares his vis, Might, and Magic Resistance. As it is an extension of his glamor, the champion’s mount flies when he does. Sir Excelsis is the most powerful faerie knight in the White Lady’s kingdom. He is treated as a noble by the other faeries, despite his lack of Might. He is less physically imposing than her gigantic guards, due to his human appearance, but he has greater magical resistance, better equipment, and more Intelligence than they do."
        REFERENCES {
            "Damaging Effect" -> #t885Vlj2jC9rqq8xEP0AI5tP ^"Damaging Effect"
            "Puissant Pretense" -> #tJSsV9IueYlOnEBhX5Hga7R7 ^"Puissant Pretense"
            "Improved Damage" -> #thH1bCzoiitnhPpJ0mq02EIG ^"Improved Damage"
            "Magic Resistance" -> #tmM1uJVBdvXpEsg4iImNPyjr ^"Magic Resistance"
        }
    }
    #tS6UU2fIOUfOeleanexEVpzX ^"Sprites" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 5
            ^"Might Realm" STRING "Faerie" FIXED
            ^"Form" STRING "Corpus"
            ^"Size" INTEGER -10
            ^"Characteristics" DEF {
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER -20
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 10
            }
            ^"Soak" INTEGER 6
            ^"Wound Penalties" STRING "Dead (1+)"
            ^"Vis" STRING "1 pawn Ignem, dead bug. In many other courts this would be Corpus."
            ^"Appearance" STRING "These faeries are tiny humanoid figures that can fly, a power they use to perform interesting feasts of gymnastics for their lords. They are armed with tiny bows, and prefer to attack in confusing swarms."
            ^"Source" STRING "Realms of Power: Faerie Bestiary"
        }
        VIRTUES {
            ^"Greater Faerie Power"
            ^"Faerie Sight"
            ^"Faerie Speech"
            ^"Humanoid Faerie"
            ^"Personal Power"
            OF "Flight" NOTE "or Faerie Ally"
        }
        FLAWS {
            ^"Narrowly Cognizant"
            ^"Little"
            TIMES 2
            ^"Oath of Fealty"
            ^"Traditional Ward"
            OF "smoke, in this case, or as per court"
        }
        PERSONALITY_TRAITS {
            "Loyal" +3
        }
        COMBAT {
            "Bow" INIT 8 ATTACK 12 DEFENSE 15 DAMAGE -12
        }
        ABILITIES {
            "Area Lore (court)" SCORE 5 SPECIALTY "intruders"
            "Athletics" SCORE 3 SPECIALTY "flight"
            "Awareness" SCORE 5 SPECIALTY "intruders"
            "Bow" SCORE 5 SPECIALTY "intruders"
            "Carouse" SCORE 1 SPECIALTY "feasts"
            "Charm" SCORE 1 SPECIALTY "as ambassadors"
            "Etiquette" SCORE 2 SPECIALTY "faerie"
            "Faerie Speech" SCORE 5
            "Hunt" SCORE 1 SPECIALTY "humans"
        }
        POWERS {
            ^"Cause Sickness" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+9"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "(3 intricacy points spent on cost, 2 on initiative): This power usually causes strokes when used by sprites, but in this court, fevers are caused instead. The strike of a messenger’s arrow can cause this effect. Strokes have an Ease Factor of 6, but cause a Heavy wound. The fevers caused by these sprites have an Ease Factor of 9 and cause a Light wound."
            }
            ^"Flight" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "constant"
                }
                DESCRIPTION "2 intricacy points reducing Might cost. (See Sir Excelsis for modifications to this power for the White Lady’s court.)"
            }
            ^"Damaging Effect Lesser Power" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+4"
                }
                DESCRIPTION "(2 intricacy points on cost), Provides a mystical effect based on the court’s motif, that increases the damage of the messenger’s arrows by +5 for 2 minutes. Optional selection for a faerie that wishes to use magical arrows often, traded for its Greater Power (also Improved Damage Virtue +5 Damage and Improved Soak Virtue +2 Soak, retaining Personal Power (Flight))."
                REFERENCES {
                    "Greater Power" -> #tO5XFGkxH39d8IsuOBi2cXBp ^"Greater Power"
                    "Improved Damage" -> #thH1bCzoiitnhPpJ0mq02EIG ^"Improved Damage"
                    "Improved Soak" -> #tH0x5tzyFFTxltyTlq6NrgCR ^"Improved Soak"
                    "Personal Power" -> #twVnpmKsGJtg08QxdZoxyf5O ^"Personal Power"
                }
            }
        }
        DESCRIPTION "* Often used in conjunction with Grant Flaw, some other power, or poison. Equipment: Bow, jerkin with the mark of the burning fern. Some faeries of this type fly using mounts, purchased as the Faerie Ally Virtue, in lieu of the Fly power. They have Pretenses of 2 in Ride and 1 in Animal Handling, and lower their Athletics to 2 and their Etiquette to 1. The nobles of the court use these tiny faeries as envoys and saboteurs. Sprites also pose a danger when they attack in swarms."
        REFERENCES {
            "Animal Handling" -> #teWrQcCWtN9DNBmHrm2qAE9c ^"Animal Handling"
        }
    }
    #tE9tvZCsLwNtcYpFFe5Gj8Fr ^"Cailleach Bheur (Cally Berry)" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 40
            ^"Might Realm" STRING "Faerie" FIXED
            ^"Form" STRING "Auram"
            ^"Size" INTEGER 3
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER -3
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 5
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER -1
            }
            ^"Soak" INTEGER 1
            ^"Wound Penalties" STRING "–1 (1-8), –3 (9-16), –5 (17-24), Incapacitated (25-32), Dead (33+)"
            ^"Vis" STRING "8 or 10 Auram, a rotten plaid"
            ^"Appearance" STRING "The Cailleach Bheur has blueblack skin, like a corpse, and is hideously ugly. In some areas she turns to stone during the summer months."
            ^"Source" STRING "Realms of Power: Faerie Bestiary"
        }
        VIRTUES {
            ^"Focus Power"
            TIMES 3
            ^"Greater Faerie Powers"
            ^"Increased Faerie Might"
            TIMES 7
            ^"Faerie Sight"
            ^"Faerie Speech"
            ^"Humanoid Form"
            ^"Large"
            ^"Time of Power"
            OF "winter"
        }
        FLAWS {
            ^"Restricted Might"
            OF "summer" SIZE "Major"
            ^"Improved Powers"
            ^"Incognizant"
            ^"Sovereign Ward"
            NOTE "summer turns her to stone"
        }
        PERSONALITY_TRAITS {
            "Cruel" +2
        }
        COMBAT {
            "Brawl (razor sharp fingernails)" INIT -1 ATTACK 7 DEFENSE 7 DAMAGE 7
        }
        ABILITIES {
            "Scotland Under The Snows Lore" SCORE 9 SPECIALTY "faerie auras"
            "Awareness" SCORE 6 SPECIALTY "distant events"
            "Bargain" SCORE 5 SPECIALTY "with questioners"
            "Brawl" SCORE 5 SPECIALTY "when ambushed"
            "Charm" SCORE 3 SPECIALTY "those who come with questions"
            "Faerie Speech" SCORE 5 SPECIALTY "gullible people"
            "Guile" SCORE 3 SPECIALTY "answering questions"
            "Penetration" SCORE 2 SPECIALTY "Focus Power (Ice)"
        }
        POWERS {
            #t7122890525a87b968f208f ^"Extend Glamour" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "the Cailleach Bheur's glamour is unusual in that it covers far more than a Boundary."
            }
            ^"Focus Power (Ice)" DEF {
                PROPERTIES {
                    ^"Cost" STRING "up to 5 points"
                    ^"Initiative" STRING "–6"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "(3 points on Penetration)"
            }
            ^"Focus Power (Storms)" DEF {
                PROPERTIES {
                    ^"Cost" STRING "up to 10 points"
                    ^"Initiative" STRING "–11"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION ""
            }
            ^"Spreading a Mantle of Snow" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–4"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "(2 intricacy points spent on cost). The hag pounds her staff — or mallet, in some areas — onto the ground so that it becomes hard and coated in ice."
            }
            ^"Conjuration of the Indubitable Cold" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "–4"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "(3 intricacy points spent on cost). As the spell of the same name on ArM5 page 142."
            }
        }
        DESCRIPTION "In some areas, single creatures represent summer and winter. In many parts of Ireland and Scotland, for example, the winter is represented by the blue hag, the Cailleach Bheur. The blue hag is the guardian of the streams and wells, and the protectress of wolves, goats, deer, cattle, and many other animals. She washes her plaid at a particular spot until it is pure white, then spreads it over the land until summer, when her power passes to a rival. In ancient times this was often the goddess Brigid, but in other areas she keeps the summer as her prisoner. The Cailleach Bheur's glamour extends to much of the land, so she is aware of many important things happening in distant places. This ability makes her unsuitable as a player character in most sagas, but makes her a valuable ally to magi. Her equipment: Her plaid, which covers the land."
    }
