            "Baraqijal & Kokabel" "Intellego, Mentem, Imaginem"
            "Ezeqeel" "Muto, Aquam, Auram"
            "Sariel" "Perdo, Mentem, Ignem"
            "Semyaza" "Creo, Corpus, Herbam"
            "Shamsiel" "Rego, Ignem, Vim"
        }
    }
    # The chapter's virtues flaws, structured; each DESCRIPTION the source's text, verbatim.
    #tb70aa280ff268595434505 ^"Araquiel’s Secret" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Supernatural (Divine)"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 67
        }
        DESCRIPTION "Some say that what the Grigori taught their students was the basis of Hermetic magic. Sadly, as there are no living practitioners of these arts, it is difficult to say with certainty. There are definitely links between the two, however, as this Virtue demonstrates. Araquiel’s Secret allows anyone who possesses it and who can use the Arts of Creo, Corpus, and Terram to use vis for any of these Arts interchangeably. When using vis in this way in either a Divine or Infernal aura, however, the wielder must roll double the usual number of botch dice. Araquiel’s Secret also allows the possessor to ignore Creo, Corpus, or Terram requisites for any spell that uses another of these three Arts."
    }
    #tb7253a73ed7fcea22defe6 ^"Araquiel’s Legacy" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Hermetic"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 67
        }
        DESCRIPTION "Any magus who possess this Virtue may used Creo, Corpus, and Herbam vis interchangeably. Araquiel’s Legacy also allows the possessor to ignore Creo, Corpus, or Terram requisites for any spell that uses another of these three Arts."
    }
    # The chapter's abilities, structured; each DESCRIPTION the source's text, verbatim.
    #tda990424b7c21dd8cdc181 ^"Mechanica of Heron (Ability)" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Printed Name" STRING "Ability Mechanica of Heron"
            ^"Ability Type" STRING "Supernatural" FIXED
            ^"Specialties" LIST OF STRING ["Inventing Mechanica", "Constructing Anima", "working with a particular material"]
            ^"Printed Specialties" STRING "Specialties: Inventing Mechanica, Constructing Anima, working with a particular material. (Supernatural)"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 76
        }
        DESCRIPTION "Knowledge of what mechanica are, how to construct them, and how to use them. Primarily used in the laboratory to construct mechanica (see above)."
    }
    # The chapter's breakthroughs, structured; each DESCRIPTION the source's text, verbatim.
    #tf195338e5e221941e9bb5c ^"Mutable Device" DEF {
        EXTENDS #tHoHTL05BreakthroughTypeAA ^"Breakthrough"
        PROPERTIES {
            ^"Printed Name" STRING "Major Breakthrough: Mutable Device"
            ^"Scale" STRING "Major"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 79
        }
        DESCRIPTION "A mutable item is created like a Lesser Enchanted Device with the new Mutable Device property adding +10 to the device’s level of effect. If applicable, the Lab Total gains bonuses from the item’s shape and material (see ArM5, page 110). Any magus with the Craft Mutable Device Virtue can subsequently alter the device’s enchantment at need. With a week’s work in the laboratory and the expenditure of a pawn of Vim vis, he can alter the device’s invested effect to another one having the same Form and Technique. Any modifications such as conditions or uses per day may also be changed so long as the final level of effect remains the same or lower (including the +10 for the Mutable Device property). For example, a wand instilled with *Heat of the Searing Forge,* used continually, could be altered to one containing *Flash of the Scarlet Flames,* usable 12 times per day with a +5 Penetration."
    }
    #t76dacbdca8d67e8910fdbd ^"Integrating Mutable Device" DEF {
        EXTENDS #t60051c4d8aa56491728169 ^"Breakthrough Requirement"
        PROPERTIES {
            ^"Integrates" STRING "Mutable Device"
            ^"Breakthrough Points" INTEGER 45
            ^"Breakthrough" STRING "Mutable Device"
            ^"Printed Requirement" STRING "To Integrate Mutable Device into Hermetic Theory: Suggested accumulated breakthrough points > 45"
            ^"Rules Section" STRING "Major Breakthrough: Mutable Device"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 79
        }
    }
    #t8409d0704e8774bdbf92bd ^"Awakened Device" DEF {
        EXTENDS #tHoHTL05BreakthroughTypeAA ^"Breakthrough"
        PROPERTIES {
            ^"Printed Name" STRING "Major Breakthrough: Awakened Device"
            ^"Scale" STRING "Major"
