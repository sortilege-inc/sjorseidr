    #tEl9f52mweJDVTncOh8Psl7s ^"Mystic" DEF {
        EXTENDS ^"Career Training Package"
        PROPERTIES {
            ^"Ability Types" LIST ["Arcane"]
            ^"Printed Name" STRING "Mystic (Arcane)"
