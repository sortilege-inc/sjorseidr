                "Boiling Water" "+3"
                "Boiling Oil" "+6"
                "Molten Lead" "+9"
                "Molten Iron" "+12"
                "Ice" "+1"
                "Lye" "+3"
                "Quicklime" "+6"
                "Vitriol" "+9"
            }
            DESCRIPTION ""
        }
        #tB0se0vDd0DIk2D3d5mR1A1Z ^"Impact" DEF {
            APPLIES TO [^"Character"]
            PROPERTIES {
                ^"Source" STRING "Core Rules"
            }
            DESCRIPTION "Characters may also take damage from falling, or having things fall on them. This damage is taken once."
        }
        #tdkgMBilAfxAlfA7yUs78Ra4 ^"Impact Table" DEF {
