        PROPERTIES {
            ^"Magnitude" STRING "Minor" FIXED
            ^"Group" STRING "Structure" FIXED
            ^"Repeatable" BOOLEAN false
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "The lab is fitted with an interior gallery or platform, designed to allow someone to view the whole of the lab without disturbing it. +1 Safety, +1 Aesthetics; +1 Teaching."
    }
    #tb7MZJPRD5ZOPdeFtgvXnQ7L ^"Lesser Feature" DEF {
        EXTENDS #tYwoQHJhsRianV3Iui1tcZOt ^"Laboratory Virtue"
        PROPERTIES {
            ^"Magnitude" STRING "Minor" FIXED
            ^"Group" STRING "Structure" FIXED
            ^"Repeatable" BOOLEAN true
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "The lab features a unique structure that aids certain types of lab work — see the list of possible Features below. +1 Aesthetics; 1 point on an appropriate Specialization."
    }
    #tddQ33rZ3CU7OQhwmIWWcgPR ^"Spacious" DEF {
