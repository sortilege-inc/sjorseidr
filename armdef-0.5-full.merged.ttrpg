    # Found by evidence: a section whose first paragraph OPENS with the source's
    # own "*Size, Category*" note, run in ahead of the body. Size and Category are
    # classified by value, not by position; a parenthesised qualifier becomes its
    # own field. The kind comes from the "New Virtues" / "New Flaws" heading the
    # record sits under.
    #t3ca9a56619c834127770f0 ^"Pack Mentality / Follower" DEF {
        EXTENDS ^"Flaw"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Personality"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "The character is a follower, not a leader. He rarely takes the initiative, but is usually happy to follow the direction of a forthright and decisive person. If he finds a leader, he tends to stick with her."
    }
    # Houses of Hermes: Mystery Cults is an EXTENSION on the arm5e edition,
    # loaded alongside the core rulebook (spec S13 composition). It details four
    # of the twelve Hermetic Houses - Bjornaer, Criamon, Merinita, Verditius -
    # each already defined as a mechanical ^"House X" DEF in
    # armdef-0.5-houses.ttrpg. This book's records point at those canonical House
    # DEFs; it does not redefine them.
    # 
    # Not declared, deliberately, matching the True Lineages and Societates
    # precedent: Virtues and Flaws fit the core ^"Virtue"/^"Flaw" types
    # unchanged; spells fit ^"Formulaic Spell"; narrative goes to .lore.
    # The book's signature mechanic, and one no core type holds: a ritual by
    # which a Mystagogue Initiates a character into a Mystery Virtue. The source
    # prints all three fields as its own bolded labels, for 18 scripts book-wide.
    #tMCInitiationScriptTypeAAAA ^"Initiation Script" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Ease Factor" STRING
            ^"Script Bonus" STRING
            ^"Mystery" STRING
            ^"House" STRING
            ^"Source" STRING DEFAULT "Houses of Hermes: Mystery Cults"
        }
    }
    # A named cult or tradition inside a House that teaches Mysteries.
    #tMCMysteryCultTypeAAAAAAAAA ^"Mystery Cult" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"House" STRING
            ^"Source" STRING DEFAULT "Houses of Hermes: Mystery Cults"
        }
    }
    # House Bjornaer's clans and septs are mechanical: membership carries a
    # Virtue, a political stance and its own Initiations.
    #tMCHouseClanTypeAAAAAAAAAAA ^"House Clan" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"House" STRING
            ^"Political Stance" STRING
            ^"Source" STRING DEFAULT "Houses of Hermes: Mystery Cults"
        }
    }
    # Carries a spell's printed stat line verbatim next to the parsed fields
    # (decision S-11): parsing alone destroys the line's own tokens.
    #tSocPrintedStatLineTypeAAAA ^"Printed Stat Line" DEF {
        APPLIES TO [^"Formulaic Spell"]
        PROPERTIES {
            ^"Source" STRING DEFAULT "Houses of Hermes: Societates"
        }
    }
    # A named rules practice a House teaches or uses.
    #tSocHermeticPracticeTypeAAA ^"Hermetic Practice" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"House" STRING
            ^"Source" STRING DEFAULT "Houses of Hermes: Societates"
        }
    }
    # Initiation Scripts, found by evidence: a section that prints the source's own
    # **Ease Factor** / **Script Bonus** / **Script Details** labels. The parsed
    # fields sit beside the full printed text, which is kept verbatim as the
    # DESCRIPTION so none of the line's own tokens are lost (decision S-11).
