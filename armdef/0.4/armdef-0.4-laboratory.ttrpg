                ^"Modifiers" STRING "–1 Aesthetics."
                ^"Source" STRING "Core Rules"
            }
            DESCRIPTION "The sanctum marker is not prominently displayed, and is thus easy to miss, or it is missing altogether. Hermetic magi might (unwittingly or knowingly) intrude. It does not take a season to remove this Flaw."
        }
        #tEoe1NGWgCpcebj2NmAXBiRp ^"Wrecked (Lab Flaw)" DEF {
