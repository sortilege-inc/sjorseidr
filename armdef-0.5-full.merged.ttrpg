    #tcQhPjZCLYgoezHVL5hjkuLQ ^"Reduced Fatigue" DEF {
        EXTENDS ^"Magic Inferiority"
        PROPERTIES {
            ^"Magnitude" STRING "Minor" FIXED
            ^"Source" STRING "Realms of Power: Magic"
        }
