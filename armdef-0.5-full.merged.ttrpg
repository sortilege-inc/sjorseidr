    # The chapter's creatures, structured; each DESCRIPTION the source's text, verbatim.
    #t7004ab333efc430a3d9ad2 ^"The Nekuomanteioi, Hyperborean Priests of Apollo" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Magic" FIXED
            ^"Might" INTEGER 15
            ^"Form" STRING "Mentem"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 2
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 0
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER 0
            }
            ^"Printed Size" STRING "0 (non-physical)"
            ^"Age" STRING "n/a (35–40)"
            ^"Decrepitude" STRING "n/a"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Ceremony, Hyperborean Descent (Minor), Hyperborean Hymnist x3, Premonitions, Second Sight"
            ^"Combat" STRING "Fist: Init +1, Atk +2, Dfn +2, Dam +0 When manifested only"
            ^"Soak" STRING "+0 (plus Hymn Ability scores where relevant)"
            ^"Fatigue Levels" STRING "n/a"
            ^"Wound Penalties" STRING "n/a"
            ^"Powers" STRING "Courage of the Python Slayer, 4 points, Init +0, Mentem: As per the Psyrinpheu Power. False Dream of Aktióphis, 4 points, Init +0, Mentem: As per the Eloure power. Manifest, 1 point, Init +0, Mentem: The nekuomanteioi may manifest as a physical being, either in a human or crow form, as if it were using Radiant Mantle of the Night Wanderer. Oracle of the Dead, 10 points, Init +0, Imaginem: The nekuomanteioi may see into the past or future if it possesses an Arcane Connection to the person or location it is examining. The information it receives is indistinct and transmitted in a confusing manner, filled with strange symbols. Its visions of the future are not what will happen, but what may happen, and are typically even more vague. Possession, 3 points, Init +0, Mentem: The nekuomanteioi may attempt to control the living by possessing a person’s spirit. Spending 3 Might points allows the ghost to possess a person (or animal) for at least a few minutes (Diameter Duration), and gain control over his body, assuming the ghost penetrates any Magic Resistance the person may have. The possessed person may attempt to resist the possession by making a Stamina + Concentration roll against an Ease Factor of 9. If this roll fails, then the nekuomanteioi is able to possess the person for a full day, after which the person may resist again. This roll may be repeated every day. The ghost may be exorcised as normal, through Perdo or Rego Mentem spells, or through other Supernatural Powers such as the Adjuration Divine Power (Realms of Power: The Divine, page 49). While possessing a person, the ghost may use any Powers or magic the host has (except Divine Powers). Slaying of Niobe’s Children, 6 points, Init +0, Corpus/Ignem: As per the Psyrinpheu power. Many of the Powers once possessed by the nekuomanteioi through his Hyperborean hymns are no longer available in death."
            ^"Vis" STRING "3 pawns Mentem."
            ^"Appearance" STRING "The nekuomanteioi appears as a middle-aged man, dressed in elaborate clothes that resemble a mix of ancient Greek and Celtic dress, or as a large black crow. Unless using its Manifest Power, the nekuomanteioi appears translucent and indistinct, and during the day it is completely invisible. The nekuomanteioi may use its Premonition Ability and other Supernatural Abilities as it wishes."
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 126
        }
        PERSONALITY_TRAITS {
            "Honest" +3
            "Selfserving" -1
        }
        ABILITIES {
            "Ancient Greek" SCORE 5 SPECIALTY "songs"
            "Area Lore Balkans" SCORE 3 SPECIALTY "Hyperborean relics"
            "Artes Liberales" SCORE 4 SPECIALTY "astronomy"
            "Athletics" SCORE 2 SPECIALTY "running"
            "Awareness" SCORE 3 SPECIALTY "spirits"
            "Bargain" SCORE 3 SPECIALTY "spirits"
            "Brawl" SCORE 1 SPECIALTY "fist"
            "Ceremony" SCORE 4 SPECIALTY "Hymn Psyrinpheu"
            "Folk Ken" SCORE 3
            "Hymn Pentiterouni" SCORE 3
            "Hymn Psyrinpheu" SCORE 2
            "Hymn Eloure" SCORE 2
            "Hyperborean" SCORE 5 SPECIALTY "hymns"
            "Magic Lore" SCORE 6 SPECIALTY "spirits"
            "Premonitions" SCORE 7 SPECIALTY "good fortune"
            "Second Sight" SCORE 4 SPECIALTY "ghosts"
            "Sing" SCORE 4 SPECIALTY "prayer"
            "Teaching" SCORE 4 SPECIALTY "Hyperborean hymns"
        }
        DESCRIPTION "The *nekuomanteioi *(“oracles of the dead”) are ghosts that can recite prophecies and oracles. Wizards who summon or control these ghosts are known as *psuchagôgoi* (“prophets of the soul”). Many of the murdered Apollonian priests still remain, and some may be much more powerful than the ghost below (with Might scores as high as 40); they are likely to be hostile towards, or at least wary of, Hermetic magi.

In the presence of a *nekuomanteioi* (who may be summoned through *Incantation of Summoning the Dead*), a necromancer may use the ghost as an Arcane Connection for Intellego spells (in particular, Intellego Imaginem) in order to look into the past or future. This increases the magnitude of the spell by 4 if looking into the past, or 5 if looking into the hazy and indistinct future. Either option also makes the spell a Ritual. Casting spells in this manner is very dangerous, and inflicts upon the magus a number of Warping Points equal to the total magnitude of the spell (which may cause Twilight). If a *nekuomanteioi *were captured or otherwise persuaded to assist, a Hermetic researcher (with the storyguide’s blessing) could use it as a source for a Hermetic Breakthrough."
    }
    #tbd21739efd93ca0a87b95b ^"Aktióphis’s Displeasure" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Magic" FIXED
            ^"Might" INTEGER 10
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER 2
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER 2
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER 1
            }
            ^"Size" INTEGER 0
            ^"Confidence Score" STRING "3 (9)"
            ^"Virtues and Flaws" STRING "Greater Immunity (animal attacks, and weapons made of plant matter or lead); Piercing Gaze,"
            ^"Combat" STRING "Coil: Init +1, Attack +10, Defense +0, Damage +9 When manifested only"
            ^"Soak" INTEGER 8
            ^"Fatigue Levels" STRING "n/a"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20) When manifested only"
            ^"Vis" STRING "1 pawn of Perdo vis, 1 pawn of Corpus vis."
            ^"Appearance" STRING "Aktióphis herself normally appears as a shining and beautiful woman, illuminated by a sparkling internal radiance, arrayed in the formal dress of a Ptolemaic princess. On her feet are fiery sandals, and about her head is a garland of bright hissing snakes that spit white fire. Her voice is the roar of a bull, her eyes shoot darts like lightning and her hands hold three baskets woven from the hair of adulterers."
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 127
        }
        PERSONALITY_TRAITS {
            "Merciless" +3
            "Adamant" +2
        }
        ABILITIES {
            "Area Lore Spirit World" SCORE 8 SPECIALTY "Hyperborean spirits"
            "Bargain" SCORE 6 SPECIALTY "pacts"
            "Etiquette" SCORE 6 SPECIALTY "celestial courts"
            "Guile" SCORE 5 SPECIALTY "misleading promises"
            "Magic Lore" SCORE 10 SPECIALTY "spirits"
            "Penetration" SCORE 4 SPECIALTY "ill-fortune"
            "Teaching" SCORE 5 SPECIALTY "secrets"
        }
        POWERS {
            #t46782e973c2e47d9dd252e ^"Augur of the Illuminated Revelation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Aktióphis is privy to certain truths, and from her starry throne resplendent in the heavenly firmament, her gaze is wide and all-encompassing. Aktióphis can give the true answer to any question to a character standing beside her, but she demands that a price be paid: the supplicant must swallow a hot coal from a fire at moonrise (see ArM5, page 181). Aktióphis must be summoned in order to use this power."
            }
            #t6bb53406bc5898100ff7f4 ^"Drawing the Undeserved Breath" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "This is the most potent of Aktióphis’s rebukes, for it makes the target unable to breathe for two hours. Should he survive being unable to draw breath for that amount of time (such as by having air magically moved into his lungs), he forever remains unmolested by Aktióphis. To date, no mortal has survived."
            }
            #t89ed97bd5a8bbdb1b6741a ^"Banish the Nighttime Respite" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "This Power denies its target the gift of sleep. The target is unable to sleep for one week, and suffers extreme effects of fatigue, and the other concomitant effects of sleep deprivation."
            }
            #tdccbbf410831afc03d8d5f ^"Gather the Dark Clouds" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "By removing her good will, Aktióphis makes it known to the other denizens of the spirit world that the target is spiritually unprotected. Spirits of sickness, illness, bad luck, and other misfortune are drawn to the target like moths to a flame. Within seven hours of this power being exercised, a terrible illness or disease strikes the target. Spirits of disease may add +3 to their Penetration if attempting to enervate or sicken the target. If the target has explicit protection from another powerful entity (for example, characters with True Faith), this Power fails automatically."
            }
            #t7f73bd6d429c5430023491 ^"Loosen the False Dream" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Aktióphis coerces and empowers a dream spirit to travel to the sleeping target and implant a false dream (chosen by the character who bargained with her, or by Aktióphis herself) in his mind. If the target is awake when the spirit arrives, it hovers nearby, unseen, until the target falls asleep. The spirit uses Aktióphis’s Penetration."
            }
        }
        DESCRIPTION "Aktióphis’s Displeasure is one of the four earthly manifestations of the Goddess of the Heavenly Vault. Aktióphis herself is the bride of Tem, and is sister to Helios and Selene. Her Displeasure is a groan from the deepest depth of the nighttime void, manifesting as a sepulchral menace that can be physically felt, and seen as a writhing morass of solid, dark grief. Aktióphis is a highly sensitive goddess and takes great offense at even the smallest slights. Her Displeasure is her most powerful semi-autonomous manifestation, and the most active. (Note: References to Aktióphis below refer only to her Displeasure — Aktióphis herself is much more powerful.)"
    }
    #td97ff292fa3fb3738f5980 ^"Triple-Formed Méné Marzouné" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Magic" FIXED
            ^"Might" INTEGER 40
            ^"Form" STRING "Vim"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 2
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER 3
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER 2
            }
            ^"Size" INTEGER 1
            ^"Confidence Score" STRING "3 (12)"
            ^"Virtues and Flaws" STRING "Greater Immunity (damage from animals, fire, light, and heat)"
            ^"Combat" STRING "Fist: Init +7, Attack +9, Defense +6, Damage +5 Dart: Init +5 Attack +10, Defense +1, Damage +10 Toneless Scream: Init +9, Attack +10, Defense +0, Damage +10 Horn Charge: Init +10, Attack +11, Defense +6, Damage +15 Four-named Fire: Init +5, Attack +6, Defense +0, Damage +15 When manifested only See Power description"
            ^"Soak" INTEGER 12
            ^"Fatigue Levels" STRING "n/a"
            ^"Wound Penalties" STRING "–1 (1–6), –3 (7–12), –5 (13–18), Incapacitated (19–24) When manifested only"
            ^"Vis" STRING "2 pawns of Mentem vis in eyes, 2 pawns of Perdo vis in each horn, 2 pawns of Corpus vis in tongue"
            ^"Appearance" STRING "Méné Marzouné appears in a constantly changing guise of hideous proportions, always a combination of all her three forms. Her most majestic form is that of a great three-headed black bull, with lightning-flecked eyes. Her human form appears to be a black-clad maiden carrying a basket woven from snakes. Her face cannot be seen, for under her hood is an unending void as dark and deep as night. Her final form is a hybrid, with a distorted human form transfigured with the head of a mare, the skin of a vulture, the eyes of a goat, the calves of a lion, and the ankles of a wolf."
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 128
        }
        PERSONALITY_TRAITS {
            "Hostile" +2
            "Volatile" +3
            "Cheerful" -3
        }
        ABILITIES {
            "Area Lore Spirit World" SCORE 8 SPECIALTY "Hyperborean spirits"
            "Bargain" SCORE 6 SPECIALTY "pacts"
            "Brawl" SCORE 7 SPECIALTY "horn charge"
            "Magic Lore" SCORE 10 SPECIALTY "Spirits"
            "Penetration" SCORE 5 SPECIALTY "void"
        }
        POWERS {
            #tf22ca938add3e044ce8fd6 ^"Burning Heat of the Soul" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "+2"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Méné Marzouné may ignite a soul’s yearning for an ecstatic reunification with its lost spiritual self. While under the effect of this Power, the target seeks to extinguish his worldly desire by having sex with his spiritual double; most people do not know who this is, and so may spend years searching. This is not an overpowering carnal desire, but a deeply spiritual longing; asking the advice of oracles or saints may help the target find his soul mate. This Power cannot affect anyone with True Faith, or the True Love Virtue or Flaw."
            }
            #t5ef4fecd8a033cf9c71cd5 ^"Four-named Fire of the Burning River" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+5"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "The fiery waters of the Lethe issue from Méné Marzouné’s mouth in great burning gouts, igniting whatever they touch. When wounded by this Power, the target thenceforth suffers from the effects of *Pains of Perpetual Worry* (although the Duration is Year instead of Month)."
            }
            #t12ef8a4dc4c744f07d9919 ^"Toneless Scream of the Black-clad Abyss" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "+9"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "If the target is damaged by Méné Marzouné’s Toneless Scream, he suffers from the effects of *Weight of a Thousand Hells* (although the Duration is Year instead of Month)."
            }
        }
        DESCRIPTION "Méné Marzouné is the triplenamed, horn-faced goddess of eternity, source of the Primal Aphrodite, and dread lamp-bearer from the depths. From her toneless throat come unworldly cries drawn from the shining chasm of Tartarus, from her mouth spits the burning water of Lethe."
    }
    #t105fdf66a8010ff07b220f ^"Queen Brimo Trimorphos" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Magic" FIXED
            ^"Might" INTEGER 25
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 2
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER 4
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER 2
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 0
            }
            ^"Size" INTEGER 0
            ^"Confidence Score" STRING "4 (14)"
            ^"Virtues and Flaws" STRING "None"
            ^"Combat" STRING "Fist: Init +0, Attack +3, Defense +3, Damage +2 Bow: Init –1, Attack +10, Defense +0, Damage +8 When manifested only"
            ^"Soak" INTEGER 4
            ^"Fatigue Levels" STRING "n/a"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (2–10), –5 (11–15), Incapacitated (16–20) When manifested only"
            ^"Vis" STRING "5 pawns of Perdo vis in hair."
            ^"Appearance" STRING "Brimo appears as a naked, tormented teenaged girl with muddied feet, garlanded by 50 fearsome snakes and accompanied by a pack of terrible underworld hounds. Her other two forms are of a beautiful queen in saffron veils with a bleeding womb, and of a maiden huntress whose hands have been torn by bears. The ground trembles beneath her feet, while thousands of twinkling torch lights sparkle around her. She is often accompanied by Hekuba, the queen of Troy, who was transformed into a terrifying bitch-hound."
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 129
        }
        PERSONALITY_TRAITS {
            "Furious" +4
            "Tormented" +2
        }
        ABILITIES {
            "Area Lore Spirit World" SCORE 8 SPECIALTY "Hyperborean spirits"
            "Brawl" SCORE 3 SPECIALTY "fists"
            "Bows" SCORE 7 SPECIALTY "hunting"
            "Etiquette" SCORE 6 SPECIALTY "the Underworld"
            "Magic Lore" SCORE 10 SPECIALTY "spirits"
        }
        POWERS {
            #t503ea7104fa024756db94a ^"Harvest of the Golden Heart" DEF {
                PROPERTIES {
                    ^"Cost" STRING "10 points"
                    ^"Initiative" STRING "+5"
                    ^"Form" STRING "Herbam"
                }
                DESCRIPTION "Queen Brimo can intervene with either Persephone or Demeter to grant a small community a bountiful harvest that season, or stave off a famine."
            }
            #tc304bf5895a1dc63e471f9 ^"Rejuvenation of Nyx" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "This Power grants the target a +18 to his Recovery rolls, which lasts until her wounds are all healed."
            }
            #t3eb1792c8a7e777c695a3d ^"The Company of the Miserable Man" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "For someone (typically a woman) who sacrifices a black dog in her honor, Queen Brimo uses this Power, which creates a bittersweet longing for each other in the hearts of both supplicant and the Power’s target. For every moment they are not together, both suffer a pain in their breasts and deep despondence, until they are reunited. This Power ends after the couple have eaten a meal and had sex with each other three times, or until either of them hears the sound of a bull-roarer (a kind of toy). The affection becomes permanent after nine months if the Power’s effect has not ended, and at the troupe’s discretion, may grant the True Love Virtue or Flaw."
            }
            #t788fc4d321d914783b25c5 ^"The Stygian Firebrand" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+4"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "When threatened or filled with wrath, Queen Brimo’s scream can ignite the air with baleful liquid fire, inflicting +25 damage to all those in her path (equivalent to Range Voice and Target Group)."
            }
        }
        DESCRIPTION "Queen Brimo (also known as Daeria, Brimo means “mighty” or “furious”), adopted daughter of Hekate, is a lesser monarch of Hades and attendant of Demeter. She was honored at Eleusis every September where the hierophant and priestess of Demeter would represent Brimo’s birthing of the Sacred Child, Brimos the Mighty (a personification of agricultural wealth). The child would be conceived through a mystic union, where the hierophant symbolized the holy Dionysus Iacchos and the priestess symbolized Brimo.

Queen Brimo was the daughter of Perseus and Medea, and lost her virginity when she was raped by Hermes on the banks of Boibeis Lake in Thessaly. The result of the rape was Eleusos, the patron goddess of the town of Eleusis and home of the Eleusinian Mysteries. Brimo was invoked by both her parents before her birth to honor Hekate, her sacred mother. Queen Brimo is likely to be hostile to followers of Hermes, such as Hermetic wizards."
    }
    # The chapter's hymn powers, structured; each DESCRIPTION the source's text, verbatim.
    #tac9fa52229513b8433c5cc ^"Apollo’s Luminescent Blessing" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Azai"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Ignem"]
            ^"Penetration" STRING "+4"
            ^"Uses" STRING "6 uses/day"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +1 Conc, +2 levels for Penetration)"
            ^"Ease Factor" STRING "5"
            ^"Level Cost" STRING "15"
            ^"Principle" STRING "Light"
            ^"Printed Stat Line" STRING "R: Touch, D: Conc, T: Ind Ignem, Pen +4, 6 uses/day"
            ^"Printed Totals" STRING "Ease Factor: 5 Level Cost: 15 Principle: Light"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "Causes the touched character to glow with light that is as bright as daylight on a cloudy day. Looking directly at the light is possible, but uncomfortable (unless the character has Magic Resistance)."
    }
    #t362d7fa29f6d1bd3bbe0af ^"Sovereignty of Phoebus Apollo" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Azai"
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Mentem"]
            ^"Penetration" STRING "+(user’s total)"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 5, +3 Sight, +2 Sun, +4 levels for Penetration)"
            ^"Ease Factor" STRING "12"
            ^"Level Cost" STRING "34"
            ^"Principle" STRING "Authority, ghosts, leadership"
            ^"Printed Stat Line" STRING "R: Sight, D: Sun, T: Ind Mentem, Pen +(user’s total), 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 12 Level Cost: 34 Principle: Authority, ghosts, leadership"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "This Power invokes deep respect for your character in all spiritual beings, so long as he Penetrates their Magic Resistance. Spirits, elementals, and ghosts from all realms treat your character with great respect and are inclined to obey him."
    }
    #t31f1d539d3eccb37bacf39 ^"Defy the Hound Cerebus" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Azai"
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Mentem"]
            ^"Penetration" STRING "+10"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 15, +4 Arc, +1 Conc, +5 levels for Penetration)"
            ^"Ease Factor" STRING "15"
            ^"Level Cost" STRING "45"
            ^"Principle" STRING "Ghosts"
            ^"Printed Stat Line" STRING "R: Arc, D: Conc, T: Ind Mentem, Pen +10, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 15 Level Cost: 45 Principle: Ghosts"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "This Power summons a ghost to whom your character has an Arcane Connection, or who is haunting an area (should your character possess its full name), and allows it to possess a body. The body is animated by the ghost, but may be directed by your character’s commands. If the ghost has a Might score, you must successfully penetrate its Magic Resistance for the Power to work. The bodies and ghosts of people buried by a Divine rite are not affected by this Power."
    }
    #t0a2d1a2cbe6d80245fb46f ^"The Swan-Drawn Chariot" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Azai"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Mentem"]
            ^"Penetration" STRING "+(user’s total)"
            ^"Uses" STRING "2 uses/day"
            ^"Effect Design" STRING "(Base: General guideline, +2 Sun, +4 levels for Penetration, +1 uses/day)"
            ^"Ease Factor" STRING "variable"
            ^"Level Cost" STRING "variable"
            ^"Principle" STRING "Authority, leadership"
            ^"Printed Stat Line" STRING "R: Per, D: Sun, T: Ind Mentem, Pen +(user’s total), 2 uses/day"
            ^"Printed Totals" STRING "Ease Factor: variable Level Cost: variable Principle: Authority, leadership"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "This Power infuses your character with ethereal energies, which can only be detected by spiritual creatures, such as daimons and faeries, or angels and demons (who are rarely deceived). It magically brightens your character’s “soul-spark,” the liminal glow that is visible to many spiritual beings. It also makes your character appear to spirits as though he possesses a Magic Might equal to (the level of this power – 15) / 2."
    }
    #tfd0104f55265a4b7c22f74 ^"False Dream" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Eloure"
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Mentem"]
            ^"Penetration" STRING "+4"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 2, +4 Arc, +2 Sun, +2 levels for Penetration)"
            ^"Ease Factor" STRING "8"
            ^"Level Cost" STRING "22"
            ^"Principle" STRING "Dreams"
            ^"Printed Stat Line" STRING "R: Arc, D: Sun, T: Ind Mentem, Pen +4, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 8 Level Cost: 22 Principle: Dreams"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 111
        }
        DESCRIPTION "Changes the target’s dreams to be anything the hymnist may desire. The target must be asleep and the hymnist must possess an Arcane Connection to the dreamer."
    }
    #t03803b3c472b3e0fe0113e ^"Demeter’s Blessing" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Eloure"
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Bound"
            ^"Forms" LIST OF STRING ["Aquam"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 1, +1 Touch, +4 Year, +4 Bound, +1 Size [for a total of +4 Size])"
            ^"Ease Factor" STRING "12"
            ^"Level Cost" STRING "35"
            ^"Principle" STRING "Rain"
            ^"Printed Stat Line" STRING "R: Sight, D: Sun, T: Bound Aquam, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 12 Level Cost: 35 Principle: Rain"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 111
        }
        DESCRIPTION "Causes nourishing rain to fall upon a designated area up to 6 miles across."
    }
    #t209783ec265aed1649e23a ^"Bestow Fecundity" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Eloure"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Animal", "Corpus"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 30, +1 Touch)"
            ^"Ease Factor" STRING "12"
            ^"Level Cost" STRING "35"
            ^"Principle" STRING "Fertility"
            ^"Printed Stat Line" STRING "R: Touch, D: Mom, T: Ind Animal, Corpus, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 12 Level Cost: 35 Principle: Fertility"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 111
        }
        DESCRIPTION "This Power allows a touched person or animal to conceive a child, even if one of the partners is sterile (although not magically sterile, such as from the Longevity Ritual). The offspring of this Power may be magically Warped or possess Flaws such as Age Quickly, Magical Air, or Offensive to Animals. (For more information on the consequences of magically interfering with fertility, see Chapter 4: Fertility Magic)."
    }
    #tcc766b48e1d8b35bae63d6 ^"The Gift of Far-sighted Apollo" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Iaó"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Vision"
            ^"Forms" LIST OF STRING ["Imaginem"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 3, +2 Sun, +4 Vision)"
            ^"Ease Factor" STRING "9"
            ^"Level Cost" STRING "25"
            ^"Principle" STRING "Sight"
            ^"Printed Stat Line" STRING "R: Per, D: Sun, T: Vision Imaginem, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 9 Level Cost: 25 Principle: Sight"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 111
        }
        DESCRIPTION "This Power allows your character to see clearly great distances, as if the area were only a few feet away. Your character can also judge distances well."
    }
    #t0e2a10af2fc5d1be19853b ^"Opening the Hidden Eyes" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Iaó"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Sight"
            ^"Forms" LIST OF STRING ["Vim"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 5, +1 Conc, +5 Vision, +2 extra detail)"
            ^"Ease Factor" STRING "15"
            ^"Level Cost" STRING "45"
            ^"Principle" STRING "Auras"
            ^"Printed Stat Line" STRING "R: Touch, D: Conc, T: Sight Vim, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 15 Level Cost: 45 Principle: Auras"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 111
        }
        DESCRIPTION "By this Power, the touched character is able to see the fluid vis of an area, the nature and strength of an aura, the presence of nearby regiones, and even elementals, spirits, and magical effects. This Power completely replaces the character’s normal sight, so he cannot see the normal, mundane world. This Power cannot detect non-Magic auras or creatures. The target may also see into and enter magical regiones, and lead other people into them. Specific Abilities, such as Magic Theory or Magic Lore, may be required to interpret the information."
    }
    #t6a9e7f081b269ddf998f64 ^"Cleansing Libation of the Sybil of Cumae" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Iaó"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "19 Years"
            ^"Target" STRING "Bound"
            ^"Forms" LIST OF STRING ["Corpus"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 5, +5 19 Years, + 4 Bound)"
            ^"Ease Factor" STRING "18"
            ^"Level Cost" STRING "55"
            ^"Principle" STRING "Disease"
            ^"Printed Stat Line" STRING "R: Touch, D: 19 Years, T: Bound Corpus, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 18 Level Cost: 55 Principle: Disease"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 111
        }
        DESCRIPTION "This Power grants all those within the boundary a +12 bonus to resisting or recovering from the effects of illness and disease. Note that this may cause Warping if a person is exposed for a long period of time."
    }
    #t456c61deeb141e4b60e08a ^"The Unseen Traveler" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Óai"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Imaginem"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 4, +2 Sun, +1 changing image)"
            ^"Ease Factor" STRING "5"
            ^"Level Cost" STRING "15"
            ^"Principle" STRING "Secrecy"
            ^"Printed Stat Line" STRING "R: Per, D: Sun, T: Ind Imaginem, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 5 Level Cost: 15 Principle: Secrecy"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 112
        }
        DESCRIPTION "Like a spirit, your character become completely invisible and undetectable (except by Intellego magic, Second Sight, or an equivalent), regardless of what the character does."
    }
    #t872f0de591d7cc4c28d779 ^"Turn to Lofty Heights" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Óai"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Spec"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Mentem", "Vim"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Ease Factor" STRING "12"
            ^"Level Cost" STRING "35"
            ^"Principle" STRING "Intellect, spirits"
            ^"Printed Stat Line" STRING "R: Per, D: Spec, T: Ind Mentem, Vim, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 12 Level Cost: 35 Principle: Intellect, spirits"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 112
        }
        DESCRIPTION "This Power allows the hymnist’s spirit to leave his body and travel free of its mortal flesh. While using this Power, the hymnist is completely insubstantial, can move through material barriers and items, and may travel as fast as a flying bird. Other spiritual creatures can see the character and interact with him, and can be deceived into believing that he is a native inhabitant of the spirit worlds through a Communication + Guile stress roll versus an Ease Factor equal to the spirit’s Perception + (Might / 2). The hymnist’s physical body is completely immobile and helpless while this power is in effect, does not respond to external stimuli, and may die if not looked after. The hymnist’s spiritual body is vulnerable to control by Mentem and Vim spells, although it is invisible and intangible. If the physical body dies while the hymnist is using this Power, he is permanently stuck in spirit form, and may eventually die, or transform into a spirit or ghost (at the storyguide or troupe’s discretion). If the character does not return from the spirit world in short order, he may begin to accrue Warping Points.

(Non-Hermetic)"
    }
    #t7ee9eb7a9582f7dc34dbd1 ^"Ride the Arrow of Abaris" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Óai"
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Corpus"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 35, +3 Sight)"
            ^"Ease Factor" STRING "17"
            ^"Level Cost" STRING "50"
            ^"Principle" STRING "Travel"
            ^"Printed Stat Line" STRING "R: Sight, D: Mom, T: Ind Corpus, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 17 Level Cost: 50 Principle: Travel"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 112
        }
        DESCRIPTION "This Power instantly transports your character to any place she can see. Most hymnists, before using this Power, fly to a great height (normally after turning invisible) and use other magic to see a great distance. Remote scrying, at the troupe or storyguide’s option, could also work."
    }
    #t03129fc4a84dda7c80d97f ^"Punishment of Marsyas" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Pentiterouni"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Animal", "Corpus"]
            ^"Penetration" STRING "+(user’s total)"
            ^"Uses" STRING "2 uses/day"
            ^"Effect Design" STRING "(Base 20, +1 Touch, + 4 levels Penetration, +1 level uses/day)"
            ^"Ease Factor" STRING "10"
            ^"Level Cost" STRING "30"
            ^"Principle" STRING "Skin"
            ^"Printed Stat Line" STRING "R: Touch, D: Mom, T: Ind Animal, Corpus, Pen +(user’s total), 2 uses/day"
            ^"Printed Totals" STRING "Ease Factor: 10 Level Cost: 30 Principle: Skin"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 112
        }
        DESCRIPTION "When Apollo was challenged by the satyr Marsyas to a reed-pipe competition, he grievously punished the satyr’s impertinence by tearing off his skin. This Power tears the skin off the whole surface of a touched person’s body, dealing an Incapacitating Wound (regardless of Soak). It is very unlikely that anyone can survive this Power without immediate supernatural aid."
    }
    #t69a3aca3ee430b6627dc13 ^"Radiant Mantle of the Night-Wanderer" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Pentiterouni"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Spec"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Vim"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Ease Factor" STRING "15"
            ^"Level Cost" STRING "45"
            ^"Principle" STRING "Skin, flesh"
            ^"Printed Stat Line" STRING "R: Per, D: Spec, T: Ind Vim, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 15 Level Cost: 45 Principle: Skin, flesh"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 112
        }
        DESCRIPTION "This Power, when used with the Óai Power Turn to Lofty Heights, allows the hymnist’s spirit to take on pseudo-flesh and appear in the mundane world. This phantasmal body appears exactly like the character’s true body, may wear clothes, and is real enough that it can handle light objects, touch people, and otherwise appear real. If the shell suffers any damage at all, it dissolves, ending the Power’s effect and pushing the character’s spirit back into the spirit world, although there are no other ill effects.

While clothed in pseudo-flesh the character can see the mundane world clearly. Close examination of the character, with a Perception + Awareness stress roll against an Ease Factor of 9, reveals that there is something not quite right about the pseudo-flesh — that it is merely a fabrication. This Power has no effect if the character casts it when his spirit is connected to his body. Note that if the character possesses The Gift, then people still react to it as normal.

(Non-Hermetic design)"
    }
    #t321974e8fe07485021de74 ^"Fortitude of Cadmus" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Psyrinpheu"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Corpus"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 5, +2 Sun)"
            ^"Ease Factor" STRING "5"
            ^"Level Cost" STRING "15"
            ^"Principle" STRING "Stamina, willpower"
            ^"Printed Stat Line" STRING "R: Per, D: Sun, T: Ind Corpus, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 5 Level Cost: 15 Principle: Stamina, willpower"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 113
        }
        DESCRIPTION "Your character becomes filled with stamina and endurance, gaining a +1 bonus that can be used for either

Soak or to resist Fatigue (see ArM5, page 178)."
    }
    #t65ca30a42d0570e6632438 ^"Victory of the Lapiths" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Psyrinpheu"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Corpus"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 10, +1 Diam)"
            ^"Ease Factor" STRING "5"
            ^"Level Cost" STRING "15"
            ^"Principle" STRING "Stamina, conflict"
            ^"Printed Stat Line" STRING "R: Per, D: Diam, T: Ind Corpus, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 5 Level Cost: 15 Principle: Stamina, conflict"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 113
        }
        DESCRIPTION "The Lapiths were a tribe guarded by Apollo in their victorious battle against the centaurs. This Power allows your character to endure any wound (short of death) or fatigue without penalty. Keep track of all wounds and Fatigue levels lost, as they immediately affect your character once the Power wears off."
    }
    #t375be899da9ce512413389 ^"Courage of the Python Slayer" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Psyrinpheu"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Mentem"]
            ^"Penetration" STRING "+2"
            ^"Uses" STRING "12 uses/day"
            ^"Effect Design" STRING "(Base 4, +2 Voice, +2 Sun, +1 for Penetration, +4 uses/day)"
            ^"Ease Factor" STRING "9"
            ^"Level Cost" STRING "25"
            ^"Principle" STRING "Aggression, willpower"
            ^"Printed Stat Line" STRING "R: Voice, D: Sun, T: Ind Mentem, Pen +2, 12 uses/day"
            ^"Printed Totals" STRING "Ease Factor: 9 Level Cost: 25 Principle: Aggression, willpower"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 114
        }
        DESCRIPTION "This Power grants resolute courage and determination in a person who hears the consecration. Supernatural effects that inspire fear must have a greater level than this Power in order to work."
    }
    #tb7ed3f300d645c9c0aafff ^"Slaying of Niobe’s Children" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Psyrinpheu"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Corpus"]
            ^"Penetration" STRING "+4"
            ^"Uses" STRING "6 uses/day"
            ^"Effect Design" STRING "(Base 20, +2 Voice, +2 levels for Penetration, +3 levels uses/day)"
            ^"Ease Factor" STRING "12"
            ^"Level Cost" STRING "35"
            ^"Principle" STRING "Conflict, fever"
            ^"Printed Stat Line" STRING "R: Voice, D: Mom, T: Ind Corpus, Pen +4, 6 uses/day"
            ^"Printed Totals" STRING "Ease Factor: 12 Level Cost: 35 Principle: Conflict, fever"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 114
        }
        DESCRIPTION "Your character may shoot unseen bolts, which infect the target with a deadly disease. The disease causes the equivalent of a Heavy Wound, has an Ease Factor of 9 to resist (see ArM5, page 180), and is not contagious."
    }
    #t8c43d120b7320e75416f29 ^"Eternal Youth of the Sun" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Psyrinpheu"
            ^"Range" STRING "Per"
            ^"Duration" STRING "19 Years"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Corpus"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 40 [non-Hermetic], + 5 19 Years)"
            ^"Ease Factor" STRING "22"
            ^"Level Cost" STRING "65"
            ^"Principle" STRING "Youth"
            ^"Printed Stat Line" STRING "R: Per, D: 19 Years, T: Ind Corpus, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 22 Level Cost: 65 Principle: Youth"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 114
        }
        DESCRIPTION "One of the most powerful hymns of Apollo Phoebus, this Power allows the hymnist to ignore the debilitating effects of aging for the duration of the power, up to and including terminal Aging Crises. This, of course, inflicts 1 Warping Point per year of its effect, and aging continues normally once the Power wears off (i.e., as though the character did not age for the duration)."
    }
    #tb86de2242cb98a161bd145 ^"Thalia’s Relief" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Semesilam"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Mentem"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +2 Sun)"
            ^"Ease Factor" STRING "5"
            ^"Level Cost" STRING "15"
            ^"Principle" STRING "Optimism"
            ^"Printed Stat Line" STRING "R: Touch, D: Sun, T: Ind Mentem, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 5 Level Cost: 15 Principle: Optimism"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 114
        }
        DESCRIPTION "Thalia is the Muse of comedy, and this Power relieves the touched character’s worry, anxiety, or grief, filling him with good cheer and delight."
    }
    #ta314cb1627106662be1e3c ^"Divination of True Intent" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Semesilam"
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Mentem"]
            ^"Penetration" STRING "+4"
            ^"Uses" STRING "6 uses/day"
            ^"Effect Design" STRING "(Base 15, +1 Eye, +2 levels for Penetration, +3 uses/day)"
            ^"Ease Factor" STRING "9"
            ^"Level Cost" STRING "25"
            ^"Principle" STRING "Justice"
            ^"Printed Stat Line" STRING "R: Eye, D: Mom, T: Ind Mentem, Pen +4, 6 uses/day"
            ^"Printed Totals" STRING "Ease Factor: 9 Level Cost: 25 Principle: Justice"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 114
        }
        DESCRIPTION "Your character may divine the true intent of a single action or thought of the target. This is done by asking the storyguide a question as to the truth or sincerity of the target, who remains oblivious to the use of this Power unless it fails to penetrate her Magic Resistance (although she almost certainly notices the character’s praying or singing, and eye contact). Note that this only detects what the target believes, and so may be inaccurate."
    }
    #te1a7bfc536dd36810d9468 ^"Numina of Apollo [Hymn]" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Vim"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base Gen, +1 Sun)"
            ^"Ease Factor" STRING "variable"
            ^"Level Cost" STRING "variable"
            ^"Principle" STRING "All"
            ^"Printed Stat Line" STRING "R: Per, D: Sun, T: Ind Vim, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: variable Level Cost: variable Principle: All"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "This hymn grants Magic Resistance against magical effects connected to the hymn’s principles, equal to the (level of the Power – 5)."
    }
    # The chapter's hymns, structured; each DESCRIPTION the source's text, verbatim.
    #tb6f14e9bf33542abaddd39 ^"Azai (Beautiful Light)" DEF {
        EXTENDS #t90c095c9b38d9aeacee505 ^"Beautiful Name of Light"
        PROPERTIES {
            ^"Table Columns" LIST ["Form", "Principles"]
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 110
        }
        TABLE {
            "Animal" "birth"
            "Corpus" "birth, the heart, vitality"
            "Herbam" "growth"
            "Ignem" "daytime, light, sunshine"
            "Mentem" "authority, ghosts, love, respect, spirits"
            "Terram" "gold"
            "Other" "defense, leadership, understanding"
        }
        DESCRIPTION "Through Azai, Apollo gives and governs life and self. The beautiful light is the seat of authority, by which Apollo leads and rules. Azai is the wellspring of energy and vitality from which all things draw sustenance."
    }
    #t0d4be3a422560c487c3a44 ^"Eloure (Fire Delighter)" DEF {
