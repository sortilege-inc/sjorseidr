        }
        LEVEL_CALCULATION {
            BASE 4
            MODIFIERS {
            +3 "Sight"
            +1 "Conc"
            +2 "Group"
            +2 "size"
            }
        }
        DESCRIPTION "As for Clouds of Thunderous Might, but the storm is larger, possibly covering the entire visible sky. Again, it is under the caster's control."
    }
