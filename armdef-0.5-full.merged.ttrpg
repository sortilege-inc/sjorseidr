            ^"Might" INTEGER 20
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER 4
                ^"Stamina" INTEGER 4
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER 2
