            ^"Grogs" LIST [#t9492be0eba609663fe4229 ^"Marcel the Mercenary", #t8004b1595617888c56b9e2 ^"Magarethe: Archon and Servant of Ariane"]
            ^"Familiars" LIST [#tda5d50da966d6e17705d59 ^"Mileta: Alexander’s Snake Familiar", #t484ed57a8f0596ad73c5b7 ^"Chloris the Curious: Ariane’s Cat Familiar", #t588a6e0ccaff97c3ea4ce0 ^"Torvus: William’s Falcon Familiar"]
            ^"Statted Beings" LIST [#t9370871aca3a2ef3c48981 ^"Sphinx (Through the Aegis)", #t9bfb1ca8c935523cafc58d ^"Agamenoth: Prince of the Moving Earth"]
