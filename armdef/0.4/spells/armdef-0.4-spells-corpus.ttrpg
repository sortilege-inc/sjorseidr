            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 20
            MODIFIERS {
            +2 "Voice"
            }
        }
        DESCRIPTION "Blinds a target, leaving the eyes milky with cataracts. This heals as a Heavy Wound."
    }

    #tVkNMEMhIAdl1uCnks2XUdy0 ^"Twist of the Tongue" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo" FIXED
            ^"Form" STRING "Corpus" FIXED
            ^"Level" INTEGER 30 FIXED
            ^"Range" STRING "Voice"
