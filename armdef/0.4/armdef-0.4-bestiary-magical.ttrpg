            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -2
                ^"Perception" INTEGER -2
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER -2
                ^"Strength" INTEGER 3
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 0
            }
            ^"Virtues and Flaws" LIST ["Baneful Circumstances (in daylight)"]
            ^"Soak" INTEGER 11
            ^"Wound Penalties" STRING "–1(1–5), –3 (6–10), –5 (11–15), –5 (16–20), Destroyed (21+)"
            ^"Vis" STRING "2 Corpus in eyes (1 per eye)"
            ^"Appearance" STRING "A shriveled, leathery corpse; its eyes blaze with unnatural fury."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Vengeful" +6
        }
