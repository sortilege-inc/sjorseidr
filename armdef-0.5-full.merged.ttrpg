    }
    #tM7dljUvWr77p0Wl8SoYvWSm ^"Whistle Up The Wind" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Major" FIXED
            ^"Category" STRING "Supernatural" FIXED
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "You can create winds by whistling. This Virtue grants a score of 1 in the Supernatural Ability Whistle Up The Wind."
    }
    #t9f6LKEvepiEOnlDNjri90yS ^"Wilderness Sense" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor" FIXED
            ^"Category" STRING "Supernatural" FIXED
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "You are mystically attuned to the ways of the wilderness. Choosing this Virtue confers the Ability Wilderness Sense 1 (page 172)."
    }
    #tsIjsmSHV4YNtgJygHtghbEp ^"Craft" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PARAMETERS {
            ^"type"
            OF STRING
        }
        PROPERTIES {
            ^"Ability Type" STRING "General" FIXED
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "A general term for countless Abilities, all dealing with handiwork of some type. In general, Craft Abilities are distinguished by the material they work with, although you may also take a Craft Ability that allows the character to work with several materials in one specific way. You may purchase Craft more than once, choosing a different one each time. Skill in one Craft does not imply skill in any others. City and Guild contains more detailed information about Craft Abilities and their use, in Chapter 4. Specialties : as appropriate to the craft."
    }
    #t1PUskgg9A3nDJqnU9igxJYF ^"Profession" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PARAMETERS {
            ^"type"
            OF STRING
        }
        PROPERTIES {
            ^"Ability Type" STRING "General" FIXED
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "The ability to do a job which does not involve making something. Examples include jongleur, marshal, reeve, sailor, steward, teamster, and washerwoman. Specialties depend on the profession."
    }
    #tpVjwIM28qoc7jZdFaYRQ39i ^"Living Language" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PARAMETERS {
            ^"language"
            OF STRING
        }
        PROPERTIES {
            ^"Ability Type" STRING "General" FIXED
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "Fluency in a particular living language. Rather than a die roll modifier, your score in this Knowledge measures your ability to communicate. When two people speak to each other, the lower Ability score determines how well they communicate. Characters who speak related languages can communicate at a penalty to their scores (assigned by SCORE FLUENCY 0 Point and grunt. With one or more experience points, you know 'please', 'thank you', and a few other words. Basic questions and answers: 'Where is the church?', 'Do you sell food?'. Constant mistakes, and an atrocious accent. People must speak slowly and often repeat themselves, and you cannot string a conversation together. 1 2 Basic conversation. You can sustain a short conversation on a common topic. You still make many mistakes, and often"
    }
    #tAEXILgaQw5Vk2GUp9iAjQo6 ^"Dead Language" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PARAMETERS {
            ^"language"
            OF STRING
        }
        PROPERTIES {
            ^"Ability Type" STRING "Academic" FIXED
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "This skill is similar to all other (Language) Abilities, but it is only available to educated characters. It grants the ability to speak a language which is no longer used as a native language in the areas the character has lived in. The most important example is Latin, the language of formal education in the West. It is also the common language of the Church and Order of Hermes. In other areas of the world, Arabic, Greek and Hebrew fill similar functions, although of these only Hebrew is a dead language."
    }
    #tcB2h14VQ7pxqVTU9Q5EPzkF ^"Area Lore" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PARAMETERS {
            ^"area"
            OF STRING
        }
        PROPERTIES {
            ^"Ability Type" STRING "General" FIXED
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "Knowledge of one particular region, covenant, or even a village. It includes knowing where things are in the immediate area, local history and legends, and the centers of power in the region. The smaller the region, the more detailed your knowledge."
    }
    #tmLCqaou1tqN1pDLIDgpWM5N ^"Organization Lore" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PARAMETERS {
            ^"organization"
            OF STRING
        }
        PROPERTIES {
            ^"Ability Type" STRING "General" FIXED
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "Knowledge of the legends, history, structure, operation, and goals of the specified organization. Organizations can be as large as the Church, or as small as a local craft guild. The smaller the organization, the more detailed your knowledge. Order of Hermes Lore is particularly important to most magi."
    }
    #t17125904f08844c51c6752 ^"Gabriel, the Archangel of Prophecy" DEF {
        EXTENDS #ta3872b60ee4dd02a88e718 ^"Angel"
        PROPERTIES {
            ^"Might Realm" STRING "Divine" FIXED
            ^"Might" INTEGER 100
            ^"Form" STRING "Mentem"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 10
                ^"Perception" INTEGER 10
                ^"Presence" INTEGER 10
                ^"Communication" INTEGER 10
                ^"Strength" INTEGER 8
                ^"Stamina" INTEGER 8
                ^"Dexterity" INTEGER 8
                ^"Quickness" INTEGER 8
            }
            ^"Size" INTEGER 0
            ^"Age" STRING "n/a"
            ^"Confidence Score" STRING "7 (50)"
            ^"Virtues and Flaws" STRING "Good Teacher, Inspirational"
            ^"Reputations" LIST ["Messenger of God 5 (among Jews, Christians and Muslims) Combat: Fist: Init +8", "Attack +19", "Defense +19", "Damage +8"]
            ^"Soak" INTEGER 8
            ^"Fatigue Levels" STRING "OK, 0/0/0, –1/–1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1-5), –3 (6-10), –5 (11-15), Incapacitated (16-20)"
            ^"Equipment" STRING "Robes"
            ^"Encumbrance" STRING "0 (0)"
            ^"Vis" STRING "20 pawns of Mentem in head."
            ^"Appearance" STRING "Gabriel usually takes the form of a compassionate, gentle man, sometimes with wings growing from his shoulders or arms."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 29
        }
        PERSONALITY_TRAITS {
            "Compassionate" +3
            "Intellectual" +3
            "Just" +3
            "Love of God" +5
            "Patient" +3
        }
        ABILITIES {
            "Awareness" SCORE 10 SPECIALTY "the uneducated"
            "Charm" SCORE 10 SPECIALTY "pupils"
            "Brawl" SCORE 10 SPECIALTY "fist"
            "Leadership" SCORE 10 SPECIALTY "calling attention"
            "Teaching" SCORE 15 SPECIALTY "Theology"
            "all Knowledge at a score of" SCORE 15
        }
        POWERS {
            #t6679e64fcddfa59329be56 ^"Enlighten" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Gabriel can implant any Knowledge into the mind of another, at a cost of 1 Might for every experience point implanted. He may not give any character knowledge that takes his Ability score over 15."
            }
            #t56c7423da237fdc6a947ba ^"Spirit Form" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+30"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Gabriel can become a creature of pure spirit as he wishes. This means that he is unable to affect things physically, or be affected physically."
            }
            #tb6f59cedaa63d12a2fc905 ^"Subtle Form" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Gabriel can change his appearance to look like any human being. His statistics do not change."
            }
        }
        DESCRIPTION "Say (O Muhammad, to mankind): Who is an enemy to Jibril! For he it is who hath revealed (this Scripture) to thy heart by Allah’s leave, confirming that which was (revealed) before it, and a guidance and glad tidings to believers.

*— Qur’an* 2:97

More approachable and intellectually minded than his fellows, the Archangel Gabriel (Jibril or Jabra’il in Islam) is the chief messenger of God, best known for his teaching of the prophet Daniel, his announcing of the incarnation of Christ to the Virgin Mary, and his bringing of the revelation of the *Qur’an* to Muhammad, for whom he also acted as a constant counsellor. He may be encountered by characters who are seeking wisdom, particularly if this wisdom is of a religious nature. He is most likely to be encountered in the form described here; in his natural form he is a 600-winged figure who is large enough to stand astride the horizon."
    }
    #t5d2876d4eed2107a41eacf ^"Kolazonta, the Chastiser" DEF {
        EXTENDS #ta3872b60ee4dd02a88e718 ^"Angel"
        PROPERTIES {
            ^"Might Realm" STRING "Divine" FIXED
            ^"Choir" STRING "Angel"
            ^"Might" INTEGER 30
            ^"Form" STRING "Ignem"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER 3
                ^"Communication" INTEGER 3
                ^"Strength" INTEGER 2
                ^"Stamina" INTEGER 5
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 1
            }
            ^"Size" INTEGER 0
            ^"Confidence Score" STRING "2 (15)"
            ^"Virtues and Flaws" STRING "Greater Immunity (Fire)"
            ^"Reputations" LIST ["Scourge of the Impious 3 (among Jews) Combat: Flaming Fist: Init +1", "Attack +6", "Defense +6", "Damage +7 This fire is natural and ignores magic resistance", "although not Soak from Arts."]
            ^"Soak" INTEGER 5
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1-5), –3 (6-10), –5 (11-15), Incapacitated (16-20)"
            ^"Equipment" STRING "None."
            ^"Encumbrance" STRING "0 (0)"
            ^"Vis" STRING "4 pawns Corpus throughout body, 2 pawns Ignem in veins."
            ^"Appearance" STRING "Kolazonta most often appears as a dark, ominous cloud, but may rarely manifest as a man made of white fire, with veins of flame and eyes of lightning."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 30
        }
        PERSONALITY_TRAITS {
            "Love of God" +5
            "Grim" +4
            "Remorseless" +3
        }
        ABILITIES {
            "Brawl" SCORE 4 SPECIALTY "fists"
            "Dominion Lore" SCORE 6 SPECIALTY "angels"
            "Theology" SCORE 6 SPECIALTY "sin"
        }
        POWERS {
            #t7a917913f4c916942a2b67 ^"Chastise the Sinful" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "As *Curse of the Unportended Plague*."
            }
            #t5a4702fc8f3dda558162b1 ^"Cloud form" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+30"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "Can take on the form of a cloud at will, making him immune to all physical attacks (although he may be targeted by Auram spells)."
            }
            #tf8458d9b974d5626373e90 ^"Fiery Form" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+30"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "May become a fiery man at will, doing +5 damage to anyone who approaches within 5 feet."
            }
        }
        DESCRIPTION "…our father Aaron, armed with the censer, ran through the multitude of the people and conquered the fiery angel … *4 Maccabees 7:11*

Kolazonta is one of the angels tasked by the lord to chastise His faithful for their failings, and as such he is a servant of Uriel, the Angel of Punishment. Kolazonta was the angel who brought the plague upon the Israelites (in Numbers 16:46-50) for rebelling against Moses. Aaron defeated Kolazonta after Moses told him it was lifted. Kolazonta is a grim angel who executes the chastisement of the Lord without fear or favor. He is often present amid armies or cities under siege, waiting for the Lord’s command to inflict a plague upon the sinful."
    }
    #tC7qDfCmsSKtd3YkuwsYkbdR ^"Lupersus" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 20
            ^"Might Realm" STRING "Divine" FIXED
            ^"Form" STRING "Animal"
            ^"Size" INTEGER -1
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER 3
                ^"Communication" INTEGER -2
                ^"Strength" INTEGER 2
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 2
            }
            ^"Soak" INTEGER 7
            ^"Fatigue Levels" STRING "OK, 0/0/0/0/0/0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–4), –3 (5–8), –5 (9–12), Incapacitated (13–16)"
            ^"Vis" STRING "4 pawns of Animal, in the whole body."
            ^"Appearance" STRING "A silver-gray wolf, with a noble bearing. No matter what terrain he runs through, Lupersus never gets dirty."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Loyal" +3
            "Patient" +2
            "Helpful" +2
        }
        COMBAT {
            "Bite" INIT 8 ATTACK 11 DEFENSE 16 DAMAGE 8
        }
        ABILITIES {
            "Area Lore" SCORE 5 SPECIALTY "food sources"
            "Awareness" SCORE 5 SPECIALTY "threats to his charge"
            "Brawl" SCORE 4 SPECIALTY "bite"
            "Divine Lore" SCORE 5 SPECIALTY "saints"
            "Hunt" SCORE 8 SPECIALTY "rabbits"
            "Stealth" SCORE 8 SPECIALTY "hiding from humans"
            "Survival" SCORE 8 SPECIALTY "hills"
        }
        POWERS {
            ^"Perfect Defender" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+20"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION "If Lupersus is acting as a defender to another character in combat, he can use this power to get a +10 bonus to Defense for the duration of the combat. For these purposes, the combat lasts until Lupersus is disengaged."
            }
        }
        DESCRIPTION "Lupersus has been sent by God to guard a holy hermit, provide him with food, and, occasionally, lead those in need of advice to the hermit who can provide it. He cannot speak, and has no wish to do so. While his main focus is on the hermit, Lupersus is generally compassionate, and helps those in trouble whom he finds within his range. Sometimes he leads them to safety, but most people do not trust a wolf. In those cases, he chases them to safety. Lupersus is not an angel, but rather a divine creature, and does not have the powers shared by all angels."
    }
    #t8e8bb60f68ed7a3d59b835 ^"Nasir, the Helper" DEF {
        EXTENDS #ta3872b60ee4dd02a88e718 ^"Angel"
        PROPERTIES {
            ^"Might Realm" STRING "Divine" FIXED
            ^"Choir" STRING "Angel"
