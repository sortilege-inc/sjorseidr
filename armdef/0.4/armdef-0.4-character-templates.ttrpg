                ^"Ignem" INTEGER 0
                ^"Imaginem" INTEGER 0
                ^"Mentem" INTEGER 0
                ^"Terram" INTEGER 0
                ^"Vim" INTEGER 0
            }
            ^"Virtues" LIST ["The Gift", "Hermetic Magus", "Ways of the Forest", "Heartbeast*", "Inoffensive to Animals", "Quiet Magic (x2)", "Subtle Magic"]
            ^"Flaws" LIST ["Blatant Gift", "Tormenting Master", "Deficient Form (Ignem)"]
            ^"Soak" INTEGER 1
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Twilight Scars" STRING "None"
            ^"Equipment" LIST ["Wizardly robes"]
            ^"Encumbrance" STRING "0 (0)"
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Brave" +2
            "Status-seeking" +2
            "Obedient" +1
        }
        COMBAT {
            "Dodging" INIT 1 DEFENSE 4
        }
        ABILITIES {
            "Area Lore" SCORE 1 SPECIALTY "forests"
            "Artes Liberales" SCORE 1 SPECIALTY "grammar"
            "Athletics" SCORE 2 SPECIALTY "endurance"
            "Awareness" SCORE 2 SPECIALTY "people"
            "Brawl" SCORE 2 SPECIALTY "dodge"
            "Finesse" SCORE 1 SPECIALTY "targeting"
            "Folk Ken" SCORE 1 SPECIALTY "hunters"
            "Guile" SCORE 1 SPECIALTY "pretending to know less than you do"
            "Heartbeast" SCORE 2 SPECIALTY "changing into a wolf"
            "Hunt" SCORE 2 SPECIALTY "small animals"
            "Latin" SCORE 4 SPECIALTY "Hermetic terms"
            "Living Language" SCORE 5 SPECIALTY "talking about the wilderness"
            "Magic Theory" SCORE 3 SPECIALTY "Animal"
            "Parma Magica" SCORE 1 SPECIALTY "Animal"
            "Penetration" SCORE 1 SPECIALTY "Muto"
            "Order of Hermes Lore" SCORE 1 SPECIALTY "Bjornaer"
            "Second Area Lore" SCORE 1 SPECIALTY "forests"
            "Survival" SCORE 3 SPECIALTY "forests"
        }
        SPELLS_KNOWN {
            ^"Transformation of the Ravenous Beast to the Torpid Toad" TECHNIQUE "Muto" FORM "Animal" LEVEL 25 CASTING_TOTAL 19
            ^"Agony of the Beast" TECHNIQUE "Perdo" FORM "Animal" LEVEL 15 CASTING_TOTAL 12
            ^"Circle of Beast Warding" TECHNIQUE "Rego" FORM "Animal" LEVEL 5 CASTING_TOTAL 10
            ^"Viper's Gaze" TECHNIQUE "Rego" FORM "Animal" LEVEL 15 CASTING_TOTAL 10
            ^"Eyes of the Cat" TECHNIQUE "Muto" FORM "Corpus" REQUISITE "An" LEVEL 5 CASTING_TOTAL 19
            ^"Gift of the Bear's Fortitude" TECHNIQUE "Muto" FORM "Corpus" LEVEL 25 CASTING_TOTAL 19
            ^"The Wound that Weeps" TECHNIQUE "Perdo" FORM "Corpus" LEVEL 15 CASTING_TOTAL 12
            ^"Lifting the Dangling Puppet" TECHNIQUE "Rego" FORM "Corpus" LEVEL 15 CASTING_TOTAL 10
        }
        CHOICES {
            "The Bjornaer is much more comfortable with animals than with people, and may think of him or herself as just as much animal as human. The combination of Blatant Gift and Inoffensive to Animals means that she gets along better with animals than with people. Ways of the Forest should be changed to a terrain appropriate to the actual heartbeast; a wolf is assumed for the example. Both Major Flaws can be changed freely, and while Deficient Form (Ignem) is very common in House Bjornaer, there is no particular reason for your character to have it. Note that Quiet and Subtle Magic allow the magus to cast in his heartbeast form without any penalty."
        }
    }

