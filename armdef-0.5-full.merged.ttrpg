            ^"Group" STRING "Structure" FIXED
            ^"Repeatable" BOOLEAN false
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "The building is partially exposed to the elements. For example, it is unroofed or poorly roofed, or wind blows through large cracks. –1 Safety, +1 Upkeep, –2 Health, –1 Aesthetics; +1 Au."
    }
    #tqJPNDf46H5jrS9wx5kaOvNr ^"Uneven Floor" DEF {
        EXTENDS ^"Laboratory Flaw"
        PROPERTIES {
            ^"Magnitude" STRING "Free" FIXED
            ^"Group" STRING "Structure" FIXED
            ^"Repeatable" BOOLEAN false
