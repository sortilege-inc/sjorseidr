            PROPERTIES {
                ^"Magnitude" STRING "Minor" FIXED
                ^"Category" STRING "Structure" FIXED
                ^"Modifiers" STRING "–1 General Quality, –1 Upkeep, –2 Safety, –1 Aesthetics; 1 point on an activity Specialization."
                ^"Source" STRING "Core Rules"
            }
            DESCRIPTION "The lab equipment is packed a little too close together for comfort, due to lack of space. This slightly hampers all but one type of lab activity, which is taken as a Specialization. The lab can be reconfigured to change the Specialization with a season of work. (This can be done at the same time as working to increase the Refinement.)"
        }
        #trcSwGc33rlcWQiTC3Adh4YE ^"Lesser Focus (Lab Flaw)" DEF {
            EXTENDS ^"Laboratory Flaw"
            PROPERTIES {
                ^"Magnitude" STRING "Minor" FIXED
                ^"Category" STRING "Structure" FIXED
                ^"Modifiers" STRING "–1 General Quality; 2 points among Specializations provided by the Feature."
                ^"Source" STRING "Core Rules"
            }
            DESCRIPTION "An existing Lesser Feature is the central focus of the lab, enhancing the Feature, but making activities that do not involve its use more difficult."
        }
        #tryavVgnVxnSXoCBER2SsMEX ^"No Stores (Lab Flaw)" DEF {
            EXTENDS ^"Laboratory Flaw"
            PROPERTIES {
                ^"Magnitude" STRING "Minor" FIXED
                ^"Category" STRING "Structure" FIXED
                ^"Modifiers" STRING "–2 Safety."
                ^"Source" STRING "Core Rules"
            }
            DESCRIPTION "The lab has nowhere to store supplies, and so it cannot withstand any shortages (in the case of a lack of funds, compulsory Flaw(s) to reduce the Upkeep are taken immediately, instead of after the usual two seasons). Vis and dangerous materials cannot be stored very safely."
        }
        #tLx9os1riiVlUArTeicssLtb ^"Greater Focus (Lab Flaw)" DEF {
            EXTENDS ^"Laboratory Flaw"
            PROPERTIES {
                ^"Magnitude" STRING "Major" FIXED
                ^"Category" STRING "Structure" FIXED
                ^"Modifiers" STRING "–2 General Quality; 4 points among Specializations provided by the Feature."
                ^"Source" STRING "Core Rules"
            }
            DESCRIPTION "An existing Greater Feature is the overwhelming focus of the lab, enhancing the Feature, but making activities that do not involve its use more difficult."
        }
