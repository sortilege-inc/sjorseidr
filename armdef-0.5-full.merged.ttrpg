            ^"Uses" STRING "1/day"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 2, +2 metal, +1 Diameter; Modifications: +3 triggered by Divine the Heavens’ Aspect)"
            ^"Printed Effect Line" STRING "ReTe 8 Pen +0, 1/day R: Personal, D: Diameter, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 122
        }
        DESCRIPTION "This effect tolls the bell at each significant phase of the moon, such as new, quarter, and full moons."
    }
    #t6c9f22483cf71febbf7259 ^"Toll the Equinoxes and the Solstices" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Observance Bell"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 8
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 2, +2 metal, +1 Diameter; Modifications: +3 triggered by Divine the Heavens’ Aspect)"
            ^"Printed Effect Line" STRING "ReTe 8 Pen +0, 1/day R: Personal, D: Diameter, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 122
        }
        DESCRIPTION "This effect tolls the bell at each equinox and solstice through the year."
    }
    #te045f76706844d7c063f3d ^"Shard of Iron" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Gifted Blacksmith"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 14
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 4, +2 Sun; Modifications: +1 for 2/day, +3 triggered at sunrise/set)"
            ^"Printed Effect Line" STRING "CrIg 14 Pen +0, constant effect R: Personal, D: Sun, T: Ind"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 129
        }
        DESCRIPTION "As per the Heat of the Searing Forge spell in ArM5, page 140."
    }
    #tbf401fe3377ebd6bf92e8a ^"The Floating Stones of Maghera (effect)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "The Floating Stones of Maghera"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 14
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 3, +2 Sun, +1 Stone; Modifications: +1 for 2/day, +3 triggered at sunrise/set)"
            ^"Printed Effect Line" STRING "ReTe 14 Pen +0, constant effect R: Personal, D: Sun, T: Ind"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 130
        }
        DESCRIPTION "Each stone has a power similar to the Unseen Porter spell in ArM5, page 154, that affects the stone itself. The stones are seemingly not impeded by objects placed above it, and they have the power to hold things aloft. It takes a strong man to move one of the stones but once moved it remains where it was put, without any visible means of support."
    }
    # Éamonn Cruittire (Chapter Five: The Covenant of Longmist, p113): one character, its stat lines verbatim fields.
    #t3450265358ac4387e69790 ^"Éamonn Cruittire" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Companion"
            ^"Covenant" LIST [#ta1a53a5b77da0fd4b2083d ^"Longmist"]
            ^"Characteristics" STRING "Int +1, Per 0, Pre +2, Com +3, Str –1, Sta 0, Dex 0, Qik 0"
            ^"Size" STRING "0"
            ^"Age" STRING "27 (27)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (4)"
            ^"Confidence" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Bard; Bardic Education, Enchanting Storytelling, Free Expression, Sidhe Blood; Dependent; Carefree"
            ^"Personality Trait" STRING "Confident +3, Friendly +2, Extroverted +1"
            ^"Combat" STRING "Dodge: Init +0, Attack n/a, Defense +2, Damage n/a Fist: Init +0, Attack +3, Defense +3, Damage –1 Knife: Init +0, Attack +3, Defense +2, Damage +1 Bludgeon: Init –1, Attack +4, Defense +2, Damage +1"
            ^"Soak" STRING "0"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Area Lore: Ulaid 3 (personalities), Art of Memory 3 (poetry), Awareness 3 (alertness), Brawl 2 (fist), Carouse 2 (drinking songs), Charm 4 (first impressions), Enchanting Storytelling 5 (love), Folk Ken 3 (peasants), Gaelic 5 (storytelling), Legerdemain 4 (“magic” tricks), Organization Lore: Covenant of Longmist 1 (personalities), Organization Lore: Uí hEódhasa 1 (history), Poet 2 (The Ulaidh Cycle), Storyteller 5 (heroic battles), Survival 1 (roadside)"
            ^"Equipment" STRING "Good quality clothes"
            ^"Encumbrance" STRING "1 (1)"
            ^"Appearance" STRING "Éamonn is a handsome young man who clearly carries the refinement of the Sidhe in his blood. With his sparkling blue eyes, bouncy blond hair, and easy smile, he is every father’s nightmare and every husband’s fear. The Contested Isle: The Hibernian Tribunal, page 117 The Contested Isle: The Hibernian Tribunal, page 116 The Contested Isle: The Hibernian Tribunal, page 116. Functionally identical to Enchanting Music, but using stories instead of music. His mother has depended on Éamonn for money since an illness left her weak some years ago, so without Éamonn she may lose her home."
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 113
        }
    }
    # Eochaid Dubh (Chapter Five: The Covenant of Longmist, p109): one character, its stat lines verbatim fields.
    #t9ee340c6cb87f0504d7dc2 ^"Eochaid Dubh" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#ta1a53a5b77da0fd4b2083d ^"Longmist"]
            ^"Characteristics" STRING "Int +2, Per 0, Pre 0, Com 0, Str 0, Sta +1, Dex +2, Qik 0"
            ^"Size" STRING "0"
            ^"Age" STRING "32 (32)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "2 (3)"
            ^"Confidence" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "The Gift; Hermetic Magus; Major Magical Focus (visual images); Affinity with Imaginem, Faerie Magic, Inoffensive to Animals; Difficult Longevity Ritual; Animal Companion, Weakness (Carousing) House Virtue"
            ^"Personality Trait" STRING "Convivial +3, Ambitious –1, Honest +2"
            ^"Reputations" STRING "Carouser 2 (Longmist covenfolk), Disobedient 2 (Longmist magi), Drunkard 1 (magi of Hibernia) Combat: Dodge: Init +0, Attack n/a, Defense +0, Damage n/a Fist: Init +0, Attack +2, Defense +0, Damage +0"
            ^"Soak" STRING "+1"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Artes Liberales 2 (ritual magic), Awareness 2 (determining effect), Carouse 2 (drinking songs), Code of Hermes 1 (Tribunal procedures), Concentration 3 (spell concentration), Faerie Lore 3 (Túatha Dé Danann), Faerie Magic 4 (Imaginem), Finesse 2 (Imaginem), Folk Ken 2 (the opposite sex), Guile 2 (lying to authority), Gaelic 5 (storytelling), Latin 4 (Hermetic usage), Magic Lore 2 (creatures), Magic Theory 4 (Imaginem), Music 2 (sing), Organization Lore: Covenant of Longmist 2 (politics), Organization Lore: Order of Hermes 1 (politics), Parma Magica 1 (Corpus), Philosophiae 2 (ceremonial magic) Arts: Cr 5, In 5, Mu 5, Pe 5, Re 5, An 0, Aq 0, Au 0, Co 5, He 0, Ig 0, Im 14, Me 0, Te 0, Vi 0"
            ^"Equipment" STRING "Often squirrels food scraps into a pouch at his belt for his magpie companion. Usually found experimenting with various might-be wouldbe talismans, never the same one twice, to see what feels right."
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "Eochaid has pale skin but very black hair and dark eyes. He is always ready with a smile, though his normal expression around magi is one of apologetic contrition."
            ^"Casting Sigil" STRING "Mist seeps through the ground in the area around the caster."
            ^"Voting Sigil" STRING "A disk of lead and iron inscribed with a horseshoe on the leaden side."
            ^"Spells Known" STRING "Phantasmal Animal (CrIm 20) +25 Phantasm of the Human Form (CrIm 25) +25 Prying Eyes (InIm 5) +25 Summoning the Distant Image (InIm 25) +25 Notes of a Delightful Sound (MuIm 10) +20 Disguise of the Transformed Image (MuIm 15) +25 Veil of Invisibility (PeIm 20) +25 Wizard’s Sidestep (ReIm 10) +25 Wizard’s Communion (MuVi 10) +6 Major Magical Focus applied"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 109
        }
    }
    # The chapter's laboratories, structured; each DESCRIPTION the source's text, verbatim.
    #t23b32866a484ddc75a13bf ^"Lugh-éccnaid’s Laboratory" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
        PROPERTIES {
            ^"Size" INTEGER 0
            ^"Refinement" INTEGER 5
            ^"General Quality" INTEGER 3
            ^"Upkeep" INTEGER 8
            ^"Safety" INTEGER 8
            ^"Warping" INTEGER 0
            ^"Health" INTEGER 1
            ^"Aesthetics" INTEGER 7
            ^"Names Added to Sanctum Marker" STRING "None"
            ^"Characteristics" STRING "Size +0 (0), Refinement +5, General Quality +3, Upkeep +8 (36 Mythic Pounds per year), Safety +8, Warping +0, Health +1, Aesthetics +7"
            ^"Virtues & Flaws" STRING "Greater Feature (Cauldron), Highly Organized, Priceless Ingredients, Spotless, Spacious, Gallery, Elevated, Greater Expansion; Greater Focus (Cauldron)"
            ^"Specializations" STRING "Longevity Rituals +11, Teaching +1; Creo +1; Auram +1"
            ^"Features" STRING "Cauldron"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 116
        }
        DESCRIPTION "Lugh-éccnaid’s laboratory occupies the upper-most levels of the hidden tower of Longmist, having been expanded in the past so that it spans two floors. Much of the work is done on the lower level where a great cauldron has been installed, but the gallery formed from the upper level provides areas for contemplation, writing, and space for Lugh’s personal library and stores.

This laboratory is highly specialized toward the development of Longevity Rituals.

These enhancements cost 60 Build Points."
    }
    #t962b750461d35052ec1620 ^"The Cailleach’s Laboratory" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
        PROPERTIES {
            ^"Size" INTEGER 0
            ^"Refinement" INTEGER 2
            ^"General Quality" INTEGER -1
            ^"Upkeep" INTEGER 0
            ^"Safety" INTEGER 3
            ^"Warping" INTEGER 0
            ^"Health" INTEGER 0
            ^"Aesthetics" INTEGER 2
            ^"Names Added to Sanctum Marker" STRING "Conchobor Crosach, Lugh-éccnaid"
            ^"Characteristics" STRING "Size +0 (–2), Refinement +2, General Quality –1, Upkeep +0 (1 Mythic Pound per year), Safety +3, Warping +0, Health +0, Aesthetics +2"
            ^"Virtues & Flaws" STRING "Greater Feature (Forge), Highly Organized, Superior Tools; Greater Focus (Forge)"
            ^"Specializations" STRING "Enchanting Items +8"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "A forge dominates the Cailleach’s laboratory and the external walls have are punctured by iron hollows and chimneys through which air is pulled and smoke expelled. The sound of the bellows reverberates as the fires reach magically high temperatures: perfect for forging and welding raw magic to devices. Her superior tools are made and maintained by Cathal Gobha and so do not increase the Upkeep cost of this laboratory.

These enhancements cost 20 Build Points."
    }
    #tf5d15e4bc99023d22180a5 ^"Dara’s Laboratory" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
        PROPERTIES {
            ^"Size" INTEGER 0
            ^"Refinement" INTEGER 0
            ^"General Quality" INTEGER -2
            ^"Upkeep" INTEGER 0
            ^"Safety" INTEGER 0
            ^"Warping" INTEGER 1
            ^"Health" INTEGER 0
            ^"Aesthetics" INTEGER 1
            ^"Names Added to Sanctum Marker" STRING "Conchobor Crosach, Lugh-éccnaid"
            ^"Characteristics" STRING "Size +0 (0), Refinement +0, General Quality –2, Upkeep +0 (1 Mythic Pound per year), Safety +0, Warping +1 Health +0, Aesthetics +1"
            ^"Virtues & Flaws" STRING "Greater Feature (Summoning Circle); Greater Focus (Summoning Circle), Haunted"
            ^"Specializations" STRING "Inventing Spells +5; Rego +2; Mentem +2"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "This laboratory is dominated by the summoning circle built into a raised circular dais in the center of the chamber. The laboratory equipment lines the walls and Dara has made efficient use of his space.

However, the laboratory, or something in it, appears to be haunted. Dara has not seen anything, and his magic has not yet detected a rogue presence, but he is certain that his equipment and notes are interfered with while his back is turned. Given his Dark Secret, Dara is particularly fearful of what the presence may in fact be.

These enhancements cost 20 Build Points."
    }
    #te709c4d9d819600763129d ^"Eochaid’s Laboratory" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
        PROPERTIES {
            ^"Size" INTEGER 0
            ^"Refinement" INTEGER 1
            ^"General Quality" INTEGER -1
            ^"Upkeep" INTEGER 2
            ^"Safety" INTEGER -1
            ^"Warping" INTEGER 0
            ^"Health" INTEGER 0
            ^"Aesthetics" INTEGER 2
            ^"Names Added to Sanctum Marker" STRING "Conchobor Crosach, Lugh-éccnaid"
            ^"Characteristics" STRING "Size +0 (0), Refinement +1, General Quality –1, Upkeep +2 (3 Mythic Pounds per year), Safety –1, Warping +0, Health +0, Aesthetics +2"
            ^"Virtues & Flaws" STRING "Greater Feature (Mirror), Lesser Feature (Window), Excessive Lighting, Highly Organized; Greater Focus (Mirror), Awkward Shape"
            ^"Specializations" STRING "Imaginem +10"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "Unlike the other laboratories and chambers within Longmist, this room is stark brilliant white. The walls have been plastered smooth and then painted with the most unnatural white that the covenant could acquire. The curved outer tower wall has a large round window that reaches almost floor to ceiling. The images visible through this window are reflected onto a series of hand-sized mirrors mounted against the inner wall, each at a slightly different angle or depth.

The whole room is highly illuminated by scores of candles and Eochaid has promised to find a cheaper solution to lighting his sanctum. All the equipment must be kept away from the walls for fear of blemishing their purity, so the laboratory may seem a little awkward to some.

These enhancements cost 40 Build Points."
    }
    #t7913c20ebc569e89275073 ^"Mícheál’s Laboratory" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
        PROPERTIES {
            ^"Size" INTEGER 0
            ^"Refinement" INTEGER 2
            ^"General Quality" INTEGER 1
            ^"Upkeep" INTEGER 0
            ^"Safety" INTEGER 2
            ^"Warping" INTEGER 0
            ^"Health" INTEGER 0
            ^"Aesthetics" INTEGER 2
            ^"Names Added to Sanctum Marker" STRING "Conchobor Crosach, Lugh-éccnaid"
            ^"Characteristics" STRING "Size +0 (0), Refinement +2, General Quality +1, Upkeep +0 (1 Mythic Pound per year), Safety +2, Warping +0, Health +0, Aesthetics +2"
            ^"Virtues & Flaws" STRING "Auspicious Shape, Highly Organized, Lesser Feature (Summoning Circle)"
            ^"Specializations" STRING "Inventing Spells +1; Vim +1"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "Mícheál has spent a year enhancing his laboratory, refining it across two seasons and then creating an Auspicious Shape by turning his chambers into a pentagon, and further by engraving a Summoning Circle into the floor.

He has plans to extend his laboratory further to add both an Antechamber and a Balcony.

These enhancements cost 20 Build Points."
    }
    #te13b1a48c183ce2bcecb51 ^"The Remaining Laboratories (Longmist)" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
        PROPERTIES {
            ^"Printed Name" STRING "The Remaining Laboratories"
            ^"Size" INTEGER 0
            ^"Refinement" INTEGER 0
            ^"General Quality" INTEGER -1
            ^"Upkeep" INTEGER -2
            ^"Safety" INTEGER -1
            ^"Warping" INTEGER 0
            ^"Health" INTEGER 0
            ^"Aesthetics" INTEGER -2
            ^"Names Added to Sanctum Marker" STRING "No Sanctum Marker"
            ^"Characteristics" STRING "Size +0 (–1), Refinement +0, General Quality –1, Upkeep –2 (1/2 Mythic Pound per year), Safety –1, Warping +0, Health +0, Aesthetics –2"
            ^"Virtues & Flaws" STRING "Missing Equipment, Decaying, Missing Sanctum Marker"
            ^"Specializations" STRING "+2 Perdo Impossible Activities: Enchanting Items"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "There are three other laboratories that are currently unoccupied. Much of the valuable equipment has been reused elsewhere, and what has been left is decaying. They each have the following statistics.

These extra laboratories costs the covenant 150 Build Points."
    }
    #t56707104fb50c319642131 ^"Mobile Laboratories (Longmist)" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
        PROPERTIES {
            ^"Printed Name" STRING "Mobile Laboratories"
            ^"Size" INTEGER 0
            ^"Refinement" INTEGER 0
            ^"General Quality" INTEGER 0
            ^"Upkeep" INTEGER -1
            ^"Safety" INTEGER -2
            ^"Warping" INTEGER 0
            ^"Health" INTEGER -5
            ^"Aesthetics" INTEGER -3
            ^"Names Added to Sanctum Marker" STRING "None"
            ^"Characteristics" STRING "Size +0 (0), Refinement +0, General Quality +0, Upkeep –1, Safety –2, Warping +0, Health –5, Aesthetics –3"
            ^"Virtues & Flaws" STRING "Lesser Feature (cauldron), Living Quarters, Mobile, Specimens, Servant; Hovel"
            ^"Specializations" STRING "+1 Animal, +2 Experimentation, +1 Mentem The servant (with Intelligence +2) is a learned clerk who sees to the needs of the magi in their laboratories. He does a good job for the magi but his loyalty is born of fear rather than attachment."
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 120
        }
        DESCRIPTION "Each of the Mac Tire magi has a similar laboratory designed to be packed away for easy transport by the team of servants and soldiers in their employ. As these laboratories usually include the magus’ living quarters they have significant downsides, something that the younger magi in the covenant frequently complain about."
    }
