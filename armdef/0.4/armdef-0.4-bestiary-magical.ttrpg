                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+2"
                    ^"Form" STRING "Auram"
                    ^"Range" STRING "Special"
                    ^"Duration" STRING "Mom"
                    ^"Target" STRING "Ind"
                    ^"Spell Equivalent" STRING "CrAu 20"
                    ^"Design" STRING "(Base 10, +2 Range equivalent to Voice)"
                }
                DESCRIPTION "The walking corpse can exhale foul humors, infecting a person within 2 paces with a disease (Ease Factor 9, effect as a Medium wound)."
            }
            ^"Rise from the Grave" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "-1"
                    ^"Form" STRING "Terram"
                    ^"Range" STRING "Touch"
                    ^"Duration" STRING "Diameter"
                    ^"Target" STRING "Part"
                    ^"Spell Equivalent" STRING "ReTe 5"
                    ^"Design" STRING "(Base 2, +1 Touch, +1 Diameter, +1 Part)"
                }
                DESCRIPTION "The revenant can cause the earth over its grave to open for one Diameter so it may enter or leave. The ground then seals, leaving no trace of disturbance."
            }
        }
    }

