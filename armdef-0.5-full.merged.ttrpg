    #txFN9C7F7esR5Cbs2Yho1OHD ^"Perceive the Distant Truth" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Warder of Mystery" FIXED
            ^"Page" INTEGER 96
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "0 points, Init (Qik – 3), Imaginem R: Arc, D: Conc, T: Room The character can see and hear what transpires at any place to which he has an Arcane Connection, perceiving images and events from the perspective of the target. InIm 30 (base 3, +4 Arc, +1 Conc, +2 Room): Greater Power (30 levels, –3 Might cost, +5 xp Penetration)"
        REFERENCES {
