    #tIqhPP41OCkIaBGm03JIukWk ^"Wilderness Sense" DEF {
        EXTENDS ^"Ability"
        PROPERTIES {
            ^"Ability Type" STRING "Supernatural" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Specialties" LIST OF STRING ["direction", "weather", "hazards", "resources"]
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "You are mystically attuned to the ways of the wilderness. A Perception + Wilderness Sense roll against an Ease Factor of 9 lets you determine the direction of north, the upcoming weather, or the presence of natural hazards or resources. One roll will only reveal one piece of information."
    }
}
