            "Awareness" SCORE 3 SPECIALTY "noises"
            "Brawl" SCORE 3 SPECIALTY "predators"
        }
        POWERS {
            ^"Adhere" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
