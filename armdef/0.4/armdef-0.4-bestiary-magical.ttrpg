            }
            ^"Virtues and Flaws" LIST ["Baneful Circumstances (in daylight)", "Weak Characteristics (x2)"]
            ^"Soak" INTEGER 9
            ^"Wound Penalties" STRING "–1 (1–3), –3 (4–6), –5 (7–9), –5 (10–12), Destroyed (13+)"
            ^"Vis" STRING "1 Corpus in skull"
            ^"Appearance" STRING "A leering skeleton whose bony fingers are as sharp as claws."
