            MODIFIERS {
                +1 "Touch"
                +4 "Year"
                +4 "Boundary"
            }
            NOTES ["no increase for requisite"]
        }
        DESCRIPTION "Causes a drought over the surrounding area. Only one-tenth the normal rain falls, streams dry up, and rivers dwindle."
    }
    #tcs6g63NmNOxxkxFx16uLdD9 ^"Ward Against Faeries of the Waters" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Aquam" FIXED
            ^"General Level" BOOLEAN true
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            NOTES ["Base spell"]
        }
        DESCRIPTION "No water faerie whose Faerie Might is equal to or less than the level of the spell can affect those targeted by the spell. Faeries cannot directly or indirectly break the magic circle, nor can they use ranged attacks or magic to affect those within it.

Seen from certain angles at night, the ring appears as a light blue dome."
    }
    #t2wSRkNoG5ra0OeLIm49dqje ^"Cloak of the Duck's Feathers" DEF {
