            ATTACK 8
            DEFENSE 8
            DAMAGE 2
        }
        ABILITIES {
            "Brawl"
            SCORE 3
            SPECIALTY "claws"
        }
        POWERS {
            ^"Rise from the Grave" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "+2"
                    ^"Form" STRING "Terram"
                    ^"Range" STRING "Touch"
                    ^"Duration" STRING "Diameter"
                    ^"Target" STRING "Part"
                    ^"Spell Equivalent" STRING "ReTe 10"
                    ^"Design" STRING "(Base 3, +1 Touch, +1 Diameter, +1 Part)"
                }
                DESCRIPTION "The skeleton can cause the earth over its grave to open for one Diameter so it may enter or leave. The earth then seals, leaving no trace of disturbance."
