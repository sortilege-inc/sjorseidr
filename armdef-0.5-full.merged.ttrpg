            "H" "ᚻ" "Haegl" "HIGH-gull" "Hail"
            "N" "ᚾ" "Nyd" "NID" "Need"
            "I" "ᛁ" "Is" "EYE-ss" "Ice"
            "J" "ᛄ" "Ger" "GEAR" "Year"
            "Y" "ᛇ" "Eoh" "EE-oh" "Yew"
            "P" "ᛈ" "Peordh" "POHR-th" "Cup"
