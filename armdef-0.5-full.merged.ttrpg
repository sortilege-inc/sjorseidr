            }
            #t5e86b5fe4257d36e567cfa ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Jealousy, Suspicion. See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t0315afd32761f2b6398dac ^"Change Form" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus or Animal"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Spirits of Deceit."
            }
            #t627eac0448ab91fa172503 ^"Trust of the Innocent" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Spirits of Deceit."
            }
            #t811178d9ad4b53051bd322 ^"Forked Tongue of the Serpent" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Spirits of Deceit."
            }
            #tc3909eddb5b8dfb1fce147 ^"The Serpent’s Oracle" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "–3"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Spirits of Deceit."
            }
        }
        DESCRIPTION "Ataf’s special province is in separating a husband from his wife. He does not target those whose marriages are already on shaky ground; instead he victimizes those couples who have an apparently happy marriage. His usual modus operandi is to impersonate one half of the couple and be seen conspicuously by neighbors and friends acting in an inappropriate manner. Ataf prefers to allow suspicion, jealousy, and recrimination to drive husband and wife apart, feelings that he reinforces with his Obsessions. To his eternal frustration, his Powers do not work on those with True Love; they never mistake his shapechanged form for their beloved (but merely see someone who looks vaguely similar to them), and his other Powers are similarly affected. However, he is unable to recognize True Love until his Powers fail; more than one of his “projects” has been brought low by True Lovers, and when he encounters them, he often abandons his usual subtlety and lashes out against them with uncharacteristic violence."
    }
    #t0aef5fccca103c5adca3af ^"Berith the Ennobler" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Spirits of Deceit"
            ^"Might" INTEGER 25
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER 5
                ^"Stamina" INTEGER 5
                ^"Dexterity" INTEGER -3
                ^"Quickness" INTEGER 0
            }
            ^"Size" INTEGER 3
            ^"Confidence Score" STRING "2 (6 points)"
            ^"Virtues and Flaws" STRING "Landed Noble, Long–Winded Not a true title, but he is treated as such."
            ^"Reputations" LIST ["Ennobler of Riches 3 (Infernal)", "Teacher of Alchemists 1 (Infernal)"]
            ^"Hierarchy" INTEGER 3
            ^"Combat" STRING "Great sword: Init +2, Attack +11, Defense +11, Damage +14 Hooves: Init +2, Attack +5, Defense +8, Damage +6 Includes a +3 bonus for being mounted."
            ^"Soak" INTEGER 15
            ^"Fatigue Levels" STRING "OK, 0/0/0, –1/–1, –3/–3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–8), –3 (9–16), –5 (17–24), Incapacitated (25–32)"
            ^"Weakness" STRING "Protected Group (noblemen who meet all of their obligations)"
            ^"Vis" STRING "5 pawns of Imaginem, in tin crown."
            ^"Appearance" STRING "Berith appears as a soldier, dressed completely in red, and riding a red horse. He always wears a crown. Berith may look like a mounted man, but his humanoid portion does not detach from his equine portion."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 59
        }
        PERSONALITY_TRAITS {
            "Arrogant" +6
            "Deceitful" +6
            "Trustworthy" -5
        }
        ABILITIES {
            "Athletics" SCORE 6 SPECIALTY "galloping"
            "Brawl" SCORE 6 SPECIALTY "hooves"
            "Folk Ken" SCORE 6 SPECIALTY "noble land claims"
            "Great Weapon" SCORE 6 SPECIALTY "great sword"
            "Guile" SCORE 6 SPECIALTY "ennobling things"
            "Intrigue" SCORE 8 SPECIALTY "mortal nobles"
        }
        POWERS {
            #t80b29edc7ec58f9edff798 ^"Ennoble the Base" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Makes any one target see a situation, argument, idea, or object as more noble than it is. *Face of the Count*, 5 points, Init 0, Corpus*: * Transforms a volunteer into a facsimile of a particular nobleman. This transformation does not change the memories or personality of the target, and is dispelled by participation in any sacrament."
            }
            #tfa08fc607c78488a5bf2b4 ^"Seven Leagues in One Night" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–3"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION "This Power allows Berith to travel at tremendous speed, three times faster than any normal horse. He can cross water as if it were dry land. He can carry anyone who voluntarily sits upon his back."
            }
            #t527b7fa11412eb43282899 ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t0d8c25280f708002876eba ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Pretensions to Greatness. See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t495086801a5c7a5e706226 ^"Change Form" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus or Animal"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Spirits of Deceit."
            }
            #tc0bbbda461352e9d8d435f ^"Trust of the Innocent" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Spirits of Deceit."
            }
            #t6d960116c2246a7201f092 ^"Forked Tongue of the Serpent" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Spirits of Deceit."
            }
            #t62c32625571c2c16a53218 ^"The Serpent’s Oracle" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "–3"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Spirits of Deceit."
            }
        }
        DESCRIPTION "Berith can transform the way that things seem, so that they appear nobler than they are. Berith is a consummate liar because he can make ideas seem noble. He is popular with alchemists, because he can make base metals seem valuable, and offers valueless instruction that seems wise. Berith’s arrogance prevents him from transforming himself: his demonic nature is always apparent, and he never chooses to manifest in any other shape.

Berith’s favorite ploy is the production of unworthy noblemen. Sometimes, he arranges for a landowner to be slain, and then substitutes a magically altered servant. Such imposters do not have the memories or personalities of the people they replace and must work diligently to forestall discovery. Berith’s illusion cannot survive the sacraments, so his servants usually pretend to take communion privately. Berith also often helps usurpers to claim honors. His greatest success, helping Abimelech to rule over Israel of three years as if he were its king, is recorded in the Book of Judges."
    }
    #t636d39acf88f80c95ddd94 ^"Forcas" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Duke of the Deluders (Watchers)"
            ^"Might" INTEGER 40
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 4
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 1
                ^"Stamina" INTEGER 4
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 6
            }
            ^"Size" INTEGER 3
            ^"Confidence Score" STRING "2 (6 points)"
            ^"Virtues and Flaws" STRING "Debauchery, Effusion, Phantasm; Good Teacher, Puissant Artes Liberales, Puissant Guile; Noncombatant"
            ^"Reputations" LIST ["Duke of Rhetoric 7 (Infernal)"]
            ^"Hierarchy" INTEGER 7
            ^"Soak" INTEGER 4
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–8), –3 (9–16), –5 (17–24), Incapacitated (25–32)"
            ^"Weakness" STRING "Ordering"
            ^"Vis" STRING "7 pawns of Mentem"
            ^"Appearance" STRING "His natural form is that of a Watcher, although by using his Unholy Power of Phantasm (see Chapter 10: The Maleficia: Phantasm) he usually takes the form of an aged man who leans on a gnarled staff carved with many watching eyes. Like all Watchers he is mute, but communicates directly with the minds of his targets while pretending to speak by moving his mouth in the appropriate manner."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 61
        }
        PERSONALITY_TRAITS {
            "Arrogant" +4
            "Credible" +3
            "Sly" +2
            "Wise Demeanor" +2
        }
        COMBAT {
            "Dodge" INIT 6 DEFENSE 10
        }
        ABILITIES {
            "Artes Liberales" SCORE 8 BONUS 2 SPECIALTY "mathematics"
            "Brawl" SCORE 3 SPECIALTY "dodge"
            "Debauchery" SCORE 10 SPECIALTY "Phantasm"
            "Effusion" SCORE 12
            "Guile" SCORE 7 BONUS 2 SPECIALTY "hedge wizards"
            "Infernal Lore" SCORE 6 SPECIALTY "hierarchies"
            "Intrigue" SCORE 4 SPECIALTY "academic"
            "Magic Lore" SCORE 4 SPECIALTY "herbalism"
            "Phantasm" SCORE 8 SPECIALTY "changing appearance"
            "Philosophiae" SCORE 6 SPECIALTY "natural sciences"
            "Profession: Actor" SCORE 4 SPECIALTY "lip movements"
            "Teaching" SCORE 6 SPECIALTY "Artes Liberales"
            "Theology" SCORE 4 SPECIALTY "heresy disguised as doctrine"
        }
        POWERS {
            #t413821245418043128a0d5 ^"Hide from Mortal Sight" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "+6"
                    ^"Form" STRING "Imaginem"
                }
                DESCRIPTION "Forcas can render anyone he can see invisible, although they are never hidden from his sight. This is true invisibility, as it cannot be revealed with Hermetic magic, due to its Infernal nature. The invisibility lasts until the next Sunday, or until Forcas decides to cancel it."
            }
            #t582ead44202f3773d16b67 ^"Retrieve That Which is Lost" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "+6"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "Forcas can locate any object to which he has an Arcane Connection, or a sympathetic connection such as its true owner. Once located, he can cause the item to disappear from its current location and appear in close proximity to himself. This Power must penetrate the Magic Resistance of anyone holding or wearing the summoned object."
            }
            #t27d83f942c8fae9447e2e2 ^"The Wordless Conversation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Watchers."
            }
            #tde9b15ec3ac64cc2bba777 ^"Corrupted Knowledge" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "–3"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Watchers."
            }
            #tb9839f0f94e6331709f998 ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t7e133288e75f28c533c855 ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Arrogance. See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t5c56df9cdf84c3c66fcd37 ^"Delusion" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 or 5 points"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Imaginem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Deluders."
            }
            #te5a482315a17d52b8ec49e ^"Duplicate the Magi’s Perception" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "variable Form"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Deluders."
            }
            #te1e02059567b5f46998b59 ^"Duplicate the Magi’s Transformation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "variable Form"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Deluders."
            }
        }
        DESCRIPTION "Forcas is well known among natural magicians and other educated hedge wizards; he devotes his time to teaching them rhetoric, logic, and mathematics, as well as the Unholy Powers he knows. Like many Deluders, he claims to be an airy spirit (aligned to the Magic realm, rather than the Infernal realm), and seemingly teaches his lore out of goodwill. He usually acquires a famulus (see Chapter 5: Demons as Corrupters, Famuli) for any of his students who have magical abilities, so that the famulus can hide his Infernal nature. He can render people invisible, and can restore lost property. However, he claims to his students that he teaches them to become invisible, whereas in reality it is Forcas who enacts the illusion, hidden from sight in his discorporate form."
    }
    #t41241b205725f0390bedf0 ^"Miser’s Pot, Bane of the Hoarder" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Accusers"
            ^"Might" INTEGER 5
            ^"Form" STRING "Terram"
            ^"Characteristics" STRING "Int +1, Per +1, Pre n/a, Com 0, Str +1, Sta 0, Dex +1, Qik +2"
            ^"Size" INTEGER -2
            ^"Reputations" LIST ["None"]
            ^"Hierarchy" INTEGER 0
            ^"Soak" STRING "+18 (made of solid brass, no vital organs)"
            ^"Fatigue Levels" STRING "Tireless"
            ^"Wound Penalties" STRING "–1 (1–3), –3 (4–6), –5 (7–9), Incapacitated (10–12)"
            ^"Weakness" STRING "Protected group (poor people)"
            ^"Vis" STRING "1 pawn of Terram, in body"
            ^"Appearance" STRING "The Miser’s Pot looks like a small, three–legged cooking cauldron made of brass. Its outer surface is usually shiny and smooth, but it is able to tarnish itself or scribe designs on its face at will. When it speaks, its voice is hollow and tinny."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 62
        }
        PERSONALITY_TRAITS {
            "Loquacious" +3
        }
        COMBAT {
            "Dodge" INIT 2 DEFENSE 5
        }
        ABILITIES {
            "Athletics" SCORE 5 SPECIALTY "when pursued"
            "Brawl" SCORE 2 SPECIALTY "dodge"
            "Charm" SCORE 4 SPECIALTY "misers"
            "Folk Ken" SCORE 4 SPECIALTY "rich people"
        }
        POWERS {
            #te0855512ebb80bbced24dd ^"Body of Brass" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+6"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "The Pot does not have a living body, and thus it is immune to fatigue, disease, deprivation, and some spells. The Pot moves on jointless, boneless legs, and can sprint at the pace of a running horse. It usually does this just after a rich person places treasure inside it."
            }
            #t3d0638d2818add1c2b4f3a ^"Seize the Miser’s Hoard" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "+5"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "This Power allows the demon to reshape its inner surface, so that it flows around any object inside the lip of the cauldron, creating an unbreakable grip. This includes the hand of a rich person whom the pot wishes to drag away to Hell."
            }
            #t8a5641706bfd145a2cf38e ^"Idea" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "The Pot can silently suggest, to its victim, that it would be a good place to store valuables. The victim can resist this suggestion with a Personality Trait roll against an Ease Factor of 9, modified by circumstances. For example, if the rich person already owns a strongbox, he is unlikely to want to store his valuables in a cauldron, and so might gain a 3-point bonus on the roll. If this Power fails, the Pot usually tries again, but with a different target commodity. For example, a rich person refusing to fill it with gold might be encouraged to fill it with coal, or flour, or cook a meal in it. This Power is often used in conjunction with the pot’s Obsession Power."
            }
            #td565988d378a3e71ffc538 ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #tf14b4c8b168b0254d419d6 ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Hoarding. See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t4221dad97608371214ec1b ^"Betrayal of the Heart" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Accusers."
            }
            #t163898a102435e462d6b4e ^"Whispers Behind the Back" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Accusers."
            }
        }
        DESCRIPTION "The Miser’s Pot claims its mission is to punish the greedy rich. It does this by removing some of their wealth and then, if they do not demonstrate a suitable change of attitude, inflicts them with its Obsession Power to ensure that they arrive in Hell. The Pot is able to speak, and it tells both the rich person from whom it steals, and the poor person whom it patronizes, that its acts are a punishment for greed and mistreatment of the poor."
    }
    #tcf395b799a7c59dc5a4b05 ^"Nithael, the Great Leveller" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Master of the Accusers"
            ^"Might" INTEGER 25
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 2
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER 6
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 1
            }
            ^"Size" INTEGER 0
            ^"Confidence Score" STRING "1 (3 points)"
            ^"Reputations" LIST ["Captain of a Legion of Corrupt Priests 3 (Infernal)"]
            ^"Hierarchy" INTEGER 3
            ^"Soak" INTEGER 5
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Weakness" STRING "Abhorrent Material (topaz)"
            ^"Vis" STRING "5 pawns of Rego, in fingers"
            ^"Appearance" STRING "Nithael takes the appearance of an emaciated man, with blue-green skin and a face that looks like it has been drawn outwards from the head with a pair of pliers. His legs end with the claws of a bird. He is hairless and eschews clothing."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 63
        }
        PERSONALITY_TRAITS {
            "Cruel" +6
        }
        COMBAT {
            "Punch" INIT 1 ATTACK 7 DEFENSE 7 DAMAGE 6
        }
        ABILITIES {
            "Brawl" SCORE 5 SPECIALTY "punch"
            "Charm" SCORE 6 SPECIALTY "pandering"
            "Folk Ken" SCORE 8 SPECIALTY "worthlessness"
            "Guile" SCORE 6 SPECIALTY "removing self-worth"
            "Leadership" SCORE 5 SPECIALTY "weak willed"
            "Profession: Actor" SCORE 6 SPECIALTY "petitioner"
        }
        POWERS {
            #t747bfb2804588ee5eb8954 ^"Form of Man" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "The demon can assume the shape of any human being."
            }
            #t3d4f286cd04a057472ed2b ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #tf74bba04feeade6ae94691 ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Self-loathing. See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t89889ee9831e54510a2f48 ^"Betrayal of the Heart" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Accusers."
            }
            #tde4a9822329b5ee53955c7 ^"Whispers Behind the Back" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Accusers."
            }
        }
        DESCRIPTION "Nithael’s interests are in those who abuse their positions of power. He takes great delight in visiting both secular and ecclesiastical princes who govern for the love of power, but he does not restrict himself to such luminaries. All who use the power of their offices — whether granted by birth, by man, or by God — are his prey.

He tests those whom he accuses, going to them with a legitimate complaint, and woe betide those to whom he takes a dislike. His main weapons are his obsessions: he spends weeks or months working on increasing the self-importance of his victim, inflating her own opinion of herself and causing her to abuse her power even more. He then switches to self-loathing, and crushes her ego. She is tormented in her sleep though the use of his Envisioning until she is a different woman altogether, stripped of confidence and weakly trembling. Once he is done with her, suicide seems the only way out."
    }
    #t390b6a15f5b5ba494efef7 ^"Premnenosyne, False Prophetess" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Spirits of Deceit (Men of Good Intent)"
            ^"Might" INTEGER 5
            ^"Form" STRING "Mentem"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 2
                ^"Perception" INTEGER -1
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 1
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER 1
            }
            ^"Size" INTEGER 0
            ^"Confidence Score" STRING "1 (3 points)"
            ^"Virtues and Flaws" STRING "Premonitions, Puissant Guile, Social Contacts"
            ^"Reputations" LIST ["Prophetess 1 (Infernal)"]
            ^"Hierarchy" INTEGER 1
            ^"Soak" INTEGER 2
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Weakness" STRING "Protected Group (those who can actually see the future, for example, those with the Premonitions Virtue, or those trained in Astrological Mysteries)"
            ^"Vis" STRING "1 pawns of Intellego, in eyes"
            ^"Appearance" STRING "This demoness always looks like a Wise One, but as is common to her demon family, her actual appearance varies to suit the preconceptions of the viewer."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 64
        }
        PERSONALITY_TRAITS {
            "Deceitful" +6
            "Acedia" +1
            "Trustworthy" -5
        }
        COMBAT {
            "Dodge" INIT 1 DEFENSE 1
        }
        ABILITIES {
            "Charm" SCORE 4 SPECIALTY "the gullible"
            "Europe Lore" SCORE 3 SPECIALTY "superstitions"
            "Folk Ken" SCORE 6 SPECIALTY "fortune-telling"
            "Guile" SCORE 5 BONUS 2 SPECIALTY "about future events"
            "Premonitions" SCORE 4 SPECIALTY "non-urgent events"
            "Survival" SCORE 2 SPECIALTY "on the road"
        }
        POWERS {
            #t922a30a061b92287a8fa09 ^"The Abandoned Corpse" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+5"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Premnemosyne can create a corpse as she converts to spiritual form, appearing to leave a body behind. This body rots quicker than a real human cadaver, disappearing entirely within a month."
            }
            #t6788d29188e428acf2b14c ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #tb17953d82ac6cfc29b5dd4 ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Acedia (spiritual sloth). See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t751684465350f74aee01c3 ^"Change Form" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus or Animal"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Spirits of Deceit."
            }
            #t67274444d87a90afb42ddb ^"Trust of the Innocent" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Spirits of Deceit."
            }
            #t7b72e094353d0b444d70cb ^"Forked Tongue of the Serpent" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Spirits of Deceit."
            }
            #t9c257cc081b5f16d732cd8 ^"The Serpent’s Oracle" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "–3"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Spirits of Deceit."
            }
        }
        DESCRIPTION "Premnemosyne is a demon of acedia, the spiritual version of the sin of sloth. She harms by spreading false prophecies. The events she predicts are always precipitous: they encourage characters to avoid involvement in situations that they might correct, since, she assures them, everything will turn out alright in the end. Premnemosyne encourages people to trust in Providence, beyond all limits of caution. She often serves other demons. Her skill at predicting the pattern of future events is highly developed, and she advises diabolists concerning the future. She is not a warrior and never fights, but she occasionally maneuvers people into appearing to kill her, so that she can have them charged with murder.

Premnemosyne is currently active in a small town in the Rhineland, ruled by a nobleman under diabolic influence. She spreads folktales about a hero who will come to cast him down, so that people are tempted to wait for a savior who will never come."
    }
    # The chapter's families, structured; each DESCRIPTION the source's text, verbatim.
    #t314f50ef5999972b29920c ^"Enervators" DEF {
        EXTENDS #t8ab0f71b78642f7ff10696 ^"Demon Family"
        PROPERTIES {
            ^"Order" STRING "Deluders"
            ^"Might" INTEGER 20
            ^"Form" STRING "Vim"
            ^"Weakness" STRING "Salt"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 61
        }
        POWERS {
            #tbbc184e8458052a4e4e09b ^"Deceiver’s Boost" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 or more points"
                    ^"Initiative" STRING "+5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "When a demon uses this Power, its target is a spell cast by a mortal. The demon must spend at least one Might Point on the effect, but can choose to spend more. The demon must also penetrate the Magic Resistance of the spellcaster, if any. For every point of Might spent by the demon, the magus gets +2 to his Casting Total. However, spells enhanced by this Power may be manipulated in minor ways by the demon, such as changing the target of the spell, ending concentration at the whim of the demon, and the like. The spell must remain within the rules for Similar Spells (ArM5, page 101), and can’t be more powerful than the spell level + Might Points spent, but the demon is free to manipulate any one aspect of the spell otherwise. If a spellcaster’s player rolls a zero while being influenced by this Power, he must roll an extra botch die."
            }
        }
        DESCRIPTION "These demons lurk around magicians and make their magic appear to be stronger than it really is. They promote overconfidence. This surge of power is often used to negate the usual draining effect on magic-affiliated Powers in an Infernal aura, and sometimes to even mimic the effects of a Magical aura. Enervators appear as typical Deluders — slashes of darkness filled with eyes and teeth — but also have disembodied, clawed hands floating around in the darkness."
    }
    #te12ea79b94b518a9473e84 ^"Infernal Dragons" DEF {
        EXTENDS #t8ab0f71b78642f7ff10696 ^"Demon Family"
        PROPERTIES {
            ^"Order" STRING "Masters of the Spirits of Deceit"
            ^"Might" INTEGER 35
            ^"Form" STRING "Animal"
            ^"Weakness" STRING "Protected Group (the pure of heart)"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 62
        }
        POWERS {
            #tfe0568763c51a04f98039d ^"Venom" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Aquam"
                }
                DESCRIPTION "The spittle of an Infernal Dragon is a hideous venom that rots flesh and other organic material. Anyone bitten by one of these creatures, even if the bite damage was fully Soaked, must make a Stamina roll against an Ease Factor of 9 or suffer a Medium Wound. If the saliva comes into contact with wood or any softer organic material (such as leather armor, or the leather straps of metal armor), it dissolves it in one round."
            }
            #t740cfcaae96248272f8f1d ^"Poison the Air" DEF {
                PROPERTIES {
                    ^"Cost" STRING "8 points"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "The demon can exhale a cloud of poisonous smoke which pollutes the air for up to a league (depending upon the prevailing wind). Plants coming into contact with this smoke wither and die, and creatures take +15 corrosion damage."
            }
        }
        DESCRIPTION "These hideous demons can be found haunting isolated patches of wilderness, often mountains and swamps. They take the form of dragons of at least Size +5, with corroded scales of a disgusting green-black hue and immense, tooth-filled maws. Infernal dragons rarely have wings. Each dragon has at least one human form that it regularly adopts, and may take an interest in the local human population, often exploiting them and causing misery. Many use their powers of deceit to provoke wars between neighboring lands, to slake their hunger for corpses. They may only be safely confronted by the pure of heart, whom they cannot harm; to claim this protection a character must have either True Faith or at least two noble Personality Traits at +3 or higher, and no sins on her conscience which have not been absolved."
    }
    #t34bf7a5ac15b7994791dc7 ^"Men of Good Intent" DEF {
        EXTENDS #t8ab0f71b78642f7ff10696 ^"Demon Family"
        PROPERTIES {
            ^"Order" STRING "Spirits of Deceit"
            ^"Might" INTEGER 5
            ^"Form" STRING "Mentem"
            ^"Weakness" STRING "Protected Group (those already given to their vice)"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 62
        }
        DESCRIPTION "Men of Good Intent are minor demons that encourage spiritual laxity, usually through excesses of virtue. They encourage the idea that the Church is too strict in its interpretation of the Bible, or too lax. They suggest that minor vices are harmless, and so are not really vices. Men of Good Intent usually appear otherwise upright in their views, peddling only a single vice.
In their natural material form, they are human-sized snakes with a man’s head. When using the Form of Man Power from their order, they can only take a single form, that of a generic human being of a particular type (merchant, soldier, nobleman, priest, etc.) However, every viewer sees them differently, according to the viewer’s preconceptions of that group of individuals. If a victim describes a specific Man of Good Intent to a group, the rest of that group see the demon as they expect to, that is, suiting the description given.
An example Man (or rather, Woman) of Good Intent is **Premnemosyne**"
    }
    #t0541ec17db9a8f656c2278 ^"Spirits of Solomon" DEF {
        EXTENDS #t8ab0f71b78642f7ff10696 ^"Demon Family"
        PROPERTIES {
            ^"Order" STRING "Deluders"
            ^"Might" INTEGER 20
            ^"Form" STRING "Corpus"
            ^"Weakness" STRING "Abhorrent Material (gemstone inscribed with the Seal of Solomon)"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 63
        }
        POWERS {
            #tce4b0156952c548991ebf4 ^"The Worst You Can Be" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "The Spirits of Solomon can inflict upon a victim one of the seven curses for which they are named. The Curse of Deception prevents the victim from speaking the truth. The Curse of Strife makes the victim quarrelsome over the slightest issue. The Curse of Battle causes others to fight over the victim. The Curse of Envy causes others to envy the victim, and work evil against him. The Curse of Power causes the victim to be filled with an overwhelming ambition and obsession for raw power. The Curse of Error causes the victim to misinterpret anything he is told in earnest. The Curse of Corruption amplifies the worst trait of the victim to tragic proportions. Each curse should be treated as a Lesser Malediction, and is permanent unless the spirits are forced to retract it, or it is removed by some Divine agency."
            }
        }
        DESCRIPTION "The mighty Wizard-king Solomon commanded many demons in the service of God. Among those whom he summoned were seven female spirits, who appeared together and spoke with one voice. They called themselves Deception, Strife, Battle, Envy, Power, Error, and Corruption. Each threatened King Solomon with her powers, but his holiness was too great and he put them to work in building his temple.
Although Solomon bound the demons to the power of his seal, they have since escaped his control and roam the earth once more. These demons never appear singly, and they may indeed be seven reflections of the same, more powerful demon.
The Seven Spirits of Solomon take the form of beautiful women with long, fair hair, clothed in fine silk apparel. However, their hands are bound with wire, behind their backs and to each other, and their eyes are blank holes. This appearance is actually the inside of their bodies; if they turn themselves inside out they reveal their true forms, which is seven columns of darkness filled with eyes and weapons."
    }
    #t1a92ce3238e4afd3bae646 ^"Watchers" DEF {
        EXTENDS #t8ab0f71b78642f7ff10696 ^"Demon Family"
        PROPERTIES {
            ^"Order" STRING "Dukes of the Deluders"
            ^"Might" INTEGER 40
            ^"Form" STRING "Corpus"
            ^"Weakness" STRING "Ordering"
            ^"Example" STRING "Forcas"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 64
        }
        POWERS {
            #tb61f9ae705e819c44fe205 ^"The Wordless Conversation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Watchers may speak directly into the mind of any creature whom they can see (assuming Magic Resistance is penetrated), and may choose to hear any mental or verbal response that the target may make."
            }
            #t8c50c9a3b2736904ea34c0 ^"Corrupted Knowledge" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "–3"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "When a Watcher spends a season teaching an Ability (of any kind, including Supernatural), he uses this Power to corrupt the knowledge that he teaches, granting the Flaw Corrupted (Ability) (see Chapter 9: Infernal Characters, New Flaws). The Power only inflicts the Flaw if the character being schooled acquires an increase in the Ability score because of the teaching supplied by the demon. Those affected by this Power soon learn that they get greater rewards if they use their Ability for selfish or sinful purposes."
            }
        }
        DESCRIPTION "The legend of the Watchers states that there were once angels (collectively called the Grigori) sent to earth by God to instruct mankind. However, some of these Grigori started to cohabit with the daughters of men. They became corrupted and fell from God’s grace, joining the ranks of the Deluders and teaching mankind the secrets of Supernatural Powers. The Watchers are among the most powerful members of the order, and are highly sought after by those who would practice magic. Because there are some holy Watchers (see *Realms of Power: The Divine,* page 26), many do not realize that these creatures teach “magic” from an unholy source. Unlike the other Deluders, the unholy Grigori are human-shaped, although solid black and taller than giants; no details of their shape can be made out other than the hundreds of eyes which cover their featureless skin. They are eternally silent, communicating their teaching directly into the minds of their pupils. All of these high-status demons have the rank of Duke.
An example of a Watcher is **Forcas**."
    }
    # The chapter's demons, structured; each DESCRIPTION the source's text, verbatim.
    #t2d05d64a68e7ab75dcd4b0 ^"Architectus, Demon Builder" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Master of the Furies"
            ^"Might" INTEGER 25
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER 2
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 5
            }
            ^"Size" INTEGER 1
            ^"Confidence Score" STRING "2 (6 points)"
            ^"Virtues and Flaws" STRING "Berserk, Lesser Malediction (discomfort from sunlight)"
            ^"Reputations" LIST ["Easily Tricked 3 (local)"]
            ^"Hierarchy" INTEGER 3
            ^"Soak" INTEGER 6
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–6), –3 (7–12), –5 (13–18), Incapacitated (19–24)"
            ^"Weakness" STRING "Architectus must always fulfill any agreement he makes."
            ^"Vis" STRING "5 pawns of Rego, in whip hand"
            ^"Appearance" STRING "Architectus’s natural form is a large, bat-winged man, with goat’s horns, hooves, and beard. In this form he carries an enormous, oily whip, which he cracks thunderously toward each of the four directions before commanding his host of servants. The whip’s four thongs end in flaming weights. His most commonly used human shape looks like a powerfully built man. He uses this form when making initial contact with his victims. In this form, he has sometimes claimed that his family comes from Sicily, and one entrance to the regio in which he makes is home is found there."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 66
        }
        PERSONALITY_TRAITS {
            "Wrathful" +4
            "Self-controlled" +2
        }
        COMBAT {
            "Whip" INIT 7 ATTACK 10 DEFENSE 12 DAMAGE 14
            " Claws" INIT 9 ATTACK 7 DEFENSE 9 DAMAGE 4
        }
        ABILITIES {
            "Brawl" SCORE 1 SPECIALTY "claws"
            "Charm" SCORE 6 SPECIALTY "those he intends to trick into deals"
            "Craft" SCORE 2 SPECIALTY "masonry"
            "Guile" SCORE 3 SPECIALTY "daughters"
            "Infernal Lore" SCORE 6 SPECIALTY "great physical works of demons"
            "Intrigue" SCORE 5 SPECIALTY "geopolitics"
            "Leadership" SCORE 3 SPECIALTY "laborers"
            "Profession" SCORE 9 SPECIALTY "architecture"
            "Single Weapon" SCORE 7 SPECIALTY "mace and chain — weighted whip"
        }
        POWERS {
            #t22ec3a12a71418434a560f ^"Command the Four Hosts of Builders" DEF {
                PROPERTIES {
                    ^"Cost" STRING "10 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "This demon can command a swarm of lesser creatures. These are usually ordered to seek out materials and then construct buildings under his direction, but they may be given many other tasks. These tiny demons work with extraordinary speed, and are able to create complicated structures within a single evening. Architectus cracks his whip to the four directions to summon his swarms, but this is an affectation rather than a requirement — the whip is merely a prop."
            }
            #tfd9402547b40671bcfdab1 ^"Form of Man" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Architectus can assume the shape of any human being."
            }
            #t82e1f6adbb1ee220afaa8e ^"Eyes of Stone Demons" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "Architectus’s minor demons act as spies and messengers. Flocks of tiny demons, visible as decorative gargoyles to Second Sight, nest in his constructions and monitor the surrounding area, informing him of opportunities for mischief."
            }
            #tc9c92ded2134e3c56cafa2 ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t1846346d405672e10fc964 ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Vainglory. See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t4fa4e868332333162c649e ^"Waxing Tide of Humors" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "+2"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Furies."
            }
            #t8e32974904017fbfe136f5 ^"Berserker Rage" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Furies."
            }
            #t8800619d78933d1657c7e9 ^"Endurance of the Enraged" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Furies."
            }
        }
        DESCRIPTION "Architectus commands a host of lesser creatures, and uses them to build roads and bridges overnight. Architectus often builds a structure after making a deal with a mortal. As an example, he often agrees that in exchange for his labor, he will take the first being to cross a bridge. He is usually cheated of his fee by mortal cunning. Architectus welcomes this process, for over time, each bridge or road harms those who live near it. Villages previously separated by ravines are able to raid each other’s flocks. Traders develop routes through the area, and bring wealth and vice. Generals use them to move their armies, and their foraging soldiers ravage the countryside. This harm usually consumes the person who made the initial agreement with Architectus. Myths about how Architectus was tricked into building a road or bridge never include this detail.

Architectus seems, to his victims, to be a Fury. He has the ability to halt his Berserker Rage at will, and his preference for schemes requiring decades to develop makes him difficult to classify. He often pretends that daylight, or the cock’s crow, repels him, but they do not. He finds sunlight unpleasant, but can tolerate it if necessary. His servants find sunlight painful, but are more frightened of his whip than the sun, and so can be forced to work during the day in exceptional cases."
    }
    #t2c495765f11dd310841863 ^"Bael, Destroyer of Nations" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Lord of the Furies"
            ^"Might" INTEGER 30
            ^"Form" STRING "Animal"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER -6
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 6
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 4
                ^"Quickness" INTEGER -2
            }
            ^"Size" INTEGER 2
            ^"Confidence Score" STRING "1 (3 points)"
            ^"Virtues and Flaws" STRING "Berserk"
            ^"Reputations" LIST ["Destroyer of Nations 5 (Infernal)"]
            ^"Hierarchy" INTEGER 5
            ^"Combat" STRING "Claws: Init –2, Attack +15, Defense +4, Damage +10 Long sword: Init 0, Attack +14, Defense +5, Damage +12 when using his Form of Man Power"
            ^"Soak" INTEGER 9
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–7), –3 (8–14), –5 (15–21), Incapacitated (22–28)"
            ^"Weakness" STRING "Vulnerability (stale bread)"
            ^"Vis" STRING "2 pawns of Animal, in the cat’s head; 2 pawns of Vim, in the human head; 2 pawns of Perdo, in the toad’s head."
            ^"Appearance" STRING "Bael appears as a creature who has three heads, those of a toad, a cat, and a man. His body is like that of a lion, but hairless and tailless."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 67
        }
        PERSONALITY_TRAITS {
            "Rebellious" +6
            "Wrathful" +4
            "Self–Controlled" -6
        }
        ABILITIES {
            "Brawl" SCORE 5 SPECIALTY "claws"
            "Folk Ken" SCORE 6 SPECIALTY "nobility"
            "Leadership" SCORE 9 SPECIALTY "slaves"
            "Profession: Battle Tactician" SCORE 5 SPECIALTY "assault"
            "Single Weapon" SCORE 5 SPECIALTY "long sword"
        }
        POWERS {
            #t728de7837f48b065af41a7 ^"Form of Man" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Bael can assume the shape of any human being. He often takes the form of a military adviser to the Crown."
            }
            #tf46c0a10a21667d8152fce ^"Seething Resentment" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Bael can magnify any feelings of annoyance, or resentment towards a particular person, into an all-consuming hatred which threatens to boil over in a fit of rage. The victim must make appropriate Personality Trait rolls against an Ease Factor of 9 to avoid lashing out at the object of his hatred, whether this is a physical attack, a vicious verbal assault, or even a declaration of war. The effect lasts until the victim succumbs to the passions, although the hatred takes an hour to dissipate. If the victim manages to control his hatred until Sunday morning, the hatred vanishes."
            }
            #t8dbe76568f55c5a390510f ^"Worm of the Mind" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Bael’s toad head can spit a venom into the mouth of a sleeping victim, which burrows into his mind and destroys all volition. The victim becomes a mindless automaton, obedient to Bael’s mental commands, but unable to otherwise think for himself. Bael can control a number of these slaves at any one time equal to his Leadership Ability, but can create many more than this if he wishes."
            }
            #t2cf1eb2a7c70a89ad0d2c6 ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t6089a1be25e7e0dfce3d82 ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Resentment. See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t3fc80434abce1d1609611f ^"Waxing Tide of Humors" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "+2"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Furies."
            }
            #t72d0eb8cd9953e818d9e0f ^"Berserker Rage" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Furies."
            }
            #t524cc53b884faae8ce1b75 ^"Endurance of the Enraged" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Furies."
            }
        }
        DESCRIPTION "Bael is one of the most terrible of his demonic order. He claims the title of King, which is clearly ironic, for he seeks to provoke wars between nations and destroy kingdoms. Under his direction, lesser demons cause petty troubles to flare up between adjoining territories, while Bael lurks in the court of one or other of the rulers and uses his power to prompt his victim into rash actions. He prefers not to turn his royal targets into slaves (see his Worm of the Mind Power), for by bypassing free will, it wins no souls for Hell."
    }
    #t94bae8babc0f4a9aff833b ^"Gavi, a Dibbuk" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Furies (Dibbukim)"
            ^"Might" INTEGER 15
            ^"Form" STRING "Mentem"
            ^"Characteristics" STRING "Int +1, Per +2, Pre 0, Com +1, Str n/a, Sta n/a, Dex n/a, Qik n/a"
            ^"Size" INTEGER 0
            ^"Virtues and Flaws" STRING "Berserk"
            ^"Reputations" LIST ["None"]
            ^"Hierarchy" INTEGER 0
            ^"Weakness" STRING "Compulsiveness"
            ^"Vis" STRING "None — Gavi has no ability to form a body, thus cannot leave behind a corpse."
            ^"Appearance" STRING "None; if seen with Second Sight, Gavi appears as he did in life, a wealthy Jew, but with feral eyes containing a glint of madness. His hands are hooked into claws and his mouth contains sharp, dagger-like teeth."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 69
        }
        PERSONALITY_TRAITS {
            "Profigate with Money" +8
            "Wrathful" +4
            "Frantic" +3
            "Self-Controlled" -6
        }
        ABILITIES {
            "Awareness" SCORE 3 SPECIALTY "sinners"
            "Bargain" SCORE 3 SPECIALTY "possessions"
            "Profession: Merchant" SCORE 5 SPECIALTY "wool"
        }
