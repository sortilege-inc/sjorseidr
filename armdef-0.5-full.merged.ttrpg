    #tb44fceed37915e58bfd599 ^"Baggage (Enemy)" DEF {
        EXTENDS #t9a849435d76530f6eb84fd ^"Battlefield Event Option"
        PROPERTIES {
            ^"Printed Name" STRING "Baggage"
            ^"Option Of" STRING "Enemy"
            ^"Bonus" INTEGER 4
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 106
        }
        DESCRIPTION "Attacking the baggage may swing the battle either way. It can stave off defeat by drawing troops or can seal victory by crushing morale. Characters choosing this Enemy option gain 1 experience point towards a bad Reputation. The baggage is normally guarded by inexpensive troops."
    }
    # The chapter's rules, structured; each DESCRIPTION the source's text, verbatim.
    #te2b9a188d1f11de7ded18c ^"Deployment Total" DEF {
        APPLIES TO [^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Territorial Advantage"
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 104
        }
        FORMULAS {
            "Deployment Total" "Intelligence + Area Lore + Stress Die"
        }
    }
    #t0a52fed716c5030cf43b42 ^"Territorial Advantage" DEF {
        APPLIES TO [^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Territorial Advantage"
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 104
        }
        FORMULAS {
            "Territorial Advantage" "Deployment Total – Enemy Deployment Total"
        }
    }
    #t917cc62d573d515f1dca8f ^"Event Total" DEF {
