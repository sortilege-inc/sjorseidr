                ^"Presence" INTEGER 1
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER -2
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 0
            }
            ^"Printed Size" STRING "0 (non-physical)"
            ^"Age" STRING "n/a (30)"
            ^"Virtues and Flaws" STRING "Mechanica of Heron; Offensive to Animals, Puissant Ability (Mechanica of Heron), Second Sight; Strong Willed"
            ^"Reputations" LIST ["Wise Scholar 4 (Ancient Alexandria)", "Pagan Harlot 3 (Alexandrian Christians)"]
            ^"Soak" INTEGER 1
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Inc. (16–20)"
            ^"Equipment" STRING "Apparent clothing, jewelry, and a small dagger, but they are all ghostly and really part of her."
            ^"Vis" STRING "5 Mentem in a scroll case."
            ^"Appearance" STRING "Hypatia was once a beautiful woman, but all that remains of her now is a tortured wreck. Her long, black hair is the only remnant of her famous looks. Red-rimmed eyes glare from her mutilated face. Her olive skin hangs in strips where her attackers tore it with oyster shells. Hypatia wears a long bloodstained white robe and sandals in the ancient Alexandrian style."
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 86
        }
        PERSONALITY_TRAITS {
            "Prideful" +3
            "Vengeful" +4
            "Compassionate" -2
        }
        COMBAT {
            "Dagger" INIT 0 ATTACK 6 DEFENSE 3 DAMAGE 2
        }
        ABILITIES {
            "Artes Liberales" SCORE 5 SPECIALTY "rhetoric"
            "Awareness" SCORE 2 SPECIALTY "alertness"
            "Brawl" SCORE 2 SPECIALTY "dagger"
            "Commanding" SCORE 3 SPECIALTY "ghosts"
            "Mechanica of Heron" SCORE 9 SPECIALTY "delicate"
            "Etiquette" SCORE 3 SPECIALTY "scholarly"
            "Folk Ken" SCORE 3 SPECIALTY "students"
            "Greek" SCORE 5 SPECIALTY "Ancient Alexandria"
            "Intrigue" SCORE 3 SPECIALTY "plotting"
            "Latin" SCORE 4 SPECIALTY "Ancient Roman"
            "Leadership" SCORE 3 SPECIALTY "intimidation"
            "Local Area Lore" SCORE 4 SPECIALTY "Rome"
            "Magic Lore" SCORE 3 SPECIALTY "constructs"
            "Philosophiae" SCORE 6 SPECIALTY "metaphysics"
            "Second Sight" SCORE 3 SPECIALTY "details"
            "Teaching" SCORE 4 SPECIALTY "metaphysics"
            "Theology" SCORE 2 SPECIALTY "debate"
        }
        POWERS {
            #t4dfd5f6dc10b3345cd3772 ^"Ghostly Body" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Hypatia knows she is a ghost and can turn invisible, pass through solid objects, ignore physical attacks, and otherwise take advantage of her non-corporeal form."
            }
            #tec8e5faf95efd5150cf72a ^"Command Mechanica" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+10"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Hypatia may command any mechanica in her presence to do her bidding. These discharge their effects or physically attack as best they can. The mechanica remain under her control while they remain in her presence."
            }
            #tb61461f3413fff6f19f870 ^"Death Agony" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 point"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Hypatia can inflict her deaththroes upon a victim. The victim takes a Light Wound and can do nothing except writhe in agony until he succeeds in a Stamina stress roll against an Ease Factor of 12."
            }
            #t3712a53c7b55cb4dfc6a71 ^"Mastery of Forces" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "+10"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "The ghost redirects a spell or attack against another target. The original attacker must make a Strength check against an Ease Factor of 6 to stop a physical attack. Magi must make a Finesse check against an Ease Factor of 6 to abort their re-targeted spell. If the check fails, the original attacker must roll normally to see if his original attack hits the new target."
            }
            #ta34aaa063907532e0ad997 ^"Refute" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Hypatia can nullify a magical effect. This cancels the effect of any one spell or magical effect chosen by Hypatia with a level less than or equal to her current Magic Might Pool plus a stress die. The effect must have a Creo, Rego, Perdo, or Muto Technique or an Aruam, Aquem, Ignem, Mentem, or Terram Form for her to refute it."
            }
        }
        DESCRIPTION "Some decades after her death, the violent cataclysms of Alexandrian politics destroyed what remained of the Library, waking Hypatia from her rest. She found herself trapped within the temple, only able to leave when the Dominion ebbs enough to expose the temple’s Magical aura. In time, madness became a blessing.

Intellect gone, the spirit of the once-beautiful scholar prowls the temple, seeking any target for her pain. Her first priority is those carrying Christian symbols. Others, such as the scholars who failed to save her, the mob who killed her, and the soldiers who betrayed her, are all victims for the vengeful ghost."
    }
    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.
    #tf9d983390af5f35c3db8f5 ^"Quench the Flames" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 19
            ^"Penetration" STRING "0"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Printed Effect Line" STRING "PeIg 19 Pen 0, 12/day R: Voice, D: Mom, T: Group"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 81
        }
        DESCRIPTION "The bulky cart makes this difficult to deploy, requiring two mules or cart horses to move.

So long as the water tank is full, the pump can extinguish any flames its water jet is directed upon. It quenches an area five paces across with a Perdo Ignem Level 20 effect. Even magical flames are affected.

(Effect: Base 3, +2 Voice, +2 Group; Modifications: 12/day +4)

(Level: 7)"
    }
    #t56fed2e29da47bbf72edc0 ^"Beguile the Gathering" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 33
            ^"Penetration" STRING "6"
            ^"Uses" STRING "3/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Group"
            ^"Printed Effect Line" STRING "CrMe 33 Pen 6, 3/day R: Voice, D: Conc, T: Group"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 81
        }
        DESCRIPTION "The Aeolipile requires an extensive set up. Bringing the properly prepared water in the cauldron to a boil and bringing the whirling device up to speed takes about 15 minutes. Once started, the Aeolipile functions until the water boils dry or the user’s concentration is broken.

Those entering the area of effect become curious and stay to watch for the duration of the effect. A stress roll against an Ease Factor of 9 using an appropriate Personality Trait (like Impatient) can break the hold.

(Effect: Base 4, +2 Voice, +1 Conc, +2 Group; Modifications: +3 Pen, 3/day +5)

(Level: 13)"
    }
    #tc22deb62e1de9f510c8bb3 ^"Theurge’s Trumpet" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Auram"
            ^"Level" INTEGER 19
            ^"Penetration" STRING "0"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Room"
            ^"Printed Effect Line" STRING "CrAu 19 Pen 0, 12/day R: Voice, D: Mom, T: Room"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 81
        }
        DESCRIPTION "The device requires at least 15 minutes to recharge after each use.

At its maximum effect, the targets must make a Stamina stress roll against an Ease Factor of 9 or be unable to act in the next round. A target who fails may make additional Stamina simple rolls each round thereafter against the same Ease Factor, and recovers if successful. If the first roll botches, the sound knocks the victim unconscious.

(Effect: Base 3, +2 Voice, +2 Room; Modifications: 12/day +4)

(Level: 9)"
    }
    #t7bc0654813706584b843c2 ^"The Web of Mnemosyne" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 60
            ^"Penetration" STRING "+20"
            ^"Uses" STRING "1/month"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Group"
            ^"Printed Effect Line" STRING "InIm 60 Pen +20, 1/month R: Voice, D: Conc, T: Group"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 87
        }
        DESCRIPTION "Once per month, Heron’s Theater can predict the future of someone associated with it. The target must be among those watching the play, and the effects last for the duration of the play, which usually takes about an hour. The effect is non-Hermetic and apparently breaks the Limit of Time. As such, investigating it is remarkably difficult.

The play is often highly allegorical, based on the mythic figures and archetypes available in the theater’s assembly of puppets and figurines. Interpreting what a play means might be an adventure in itself as characters consult with scholars, seers, and holy men."
    }
