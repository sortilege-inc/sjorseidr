            ^"Form" STRING "Corpus" FIXED
            ^"Level" INTEGER 15 FIXED
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 4
            MODIFIERS {
                +2 "Voice"
                +1 "Conc"
            }
        }
        DESCRIPTION "Lifts a person of Size +1 or less vertically into the air. Generally, you can make the target rise or descend as fast as smoke rises, but a heavier person rises more slowly and falls more quickly."
    }
    #tTGGJl9hmMXiqlmJ9wi1S8sb ^"The Gift of Vigor" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Corpus" FIXED
            ^"Level" INTEGER 20 FIXED
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 15
            MODIFIERS {
                +1 "Touch"
            }
        }
        DESCRIPTION "Transfers bodily energy from you to any target who is at a lower Fatigue level than you. You are thus at the target's current Fatigue level, and he or she assumes your previous level. If you lose a Fatigue level from casting this spell, the loss comes after the transfer. Magi have long looked for a way to restore their energy in order to cast more spells. This is the closest they've come."
    }
    #tUSfRxxD5gSNxSV51rnDR1Zc ^"Awaken the Slumbering Corpse" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Corpus" FIXED
            ^"Level" INTEGER 25 FIXED
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 10
            MODIFIERS {
                +2 "Voice"
                +1 "Conc"
            }
        }
        DESCRIPTION "Causes a corpse to function at your verbal command. Commands have to be very simple, like \"attack anyone who comes through here.\" The corpse used cannot have been buried by Church ceremony."
    }
    #tNaZBpMm3nfO7gNBSmuRUMho ^"Strings of the Unwilling Marionette" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Corpus" FIXED
            ^"Level" INTEGER 25 FIXED
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 10
            MODIFIERS {
                +2 "Voice"
                +1 "Conc"
            }
        }
        DESCRIPTION "You can control the physical movements of a person, such as walking, standing, and turning. If the target resists the control, the movements are jerky. The target can yell, but you can prevent intelligible speech by controlling the target's mouth. The target must be conscious to be moved about."
    }
    #tReYLpIOCTfvBfYqTa8X8AIe ^"Seven-League Stride" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Corpus" FIXED
            ^"Level" INTEGER 30 FIXED
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 30
        }
        DESCRIPTION "Transports you to any place within seven leagues either that you can see or that you have an Arcane Connection with. If you fail an Intelligence + Finesse stress roll against an Ease Factor of 9, your arrival goes slightly awry. For instance, you might fall when you appear, or just be facing the wrong way. A botch means you appear in the wrong place, perhaps even in a wall.

Praefactus of Bonisagus's version of this spell always allows him to appear in a safe, unembarrassing place (assuming he doesn't fail his Finesse roll). All Praefactus's spells make him seem as dignified as possible — manifesting his wizard's sigil."
        REFERENCES {
            "Ease Factor" -> #tGQufzy8y8Qc3foo2n9p7nMU ^"Ease Factor"
        }
    }
    #t15KzQBV8xBVD2oN7GonsKrl ^"The Leap of Homecoming" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Corpus" FIXED
            ^"Level" INTEGER 35 FIXED
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 35
        }
        DESCRIPTION "Transports you to any place to which you have an Arcane Connection. Most magi use this to return to their laboratories."
    }
    #tMrOnzA0PouoXvHEkX3qZa3p ^"The Walking Corpse" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Corpus" FIXED
            ^"Level" INTEGER 35 FIXED
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Year"
            ^"Target" STRING "Individual"
            ^"Ritual" BOOLEAN true
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 10
            MODIFIERS {
                +1 "Touch"
                +4 "Year"
            }
        }
        DESCRIPTION "Turns a corpse into a nearly mindless servant that can follow your simple verbal commands faithfully but unimaginatively. Unless the corpse is preserved with Charm Against Putrefaction or the equivalent, the body decays normally, but even a skeleton can be animated."
        REFERENCES {
            "Charm Against Putrefaction" -> #tcqSgViAevr7JPCgRyf47OuK ^"Charm Against Putrefaction"
        }
    }
    #tWf2uKj8iZvZVOv7gUcQUp0u ^"Conjure the Sturdy Vine" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo" FIXED
            ^"Form" STRING "Herbam" FIXED
            ^"Level" INTEGER 5 FIXED
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 1
            MODIFIERS {
                +2 "Voice"
                +2 "Sun"
            }
        }
        DESCRIPTION "Grows 10 paces of vine from a moderate quantity of wood, or from fertile soil. The vine is extremely strong and pliable, suitable for use as rope."
    }
    #tSCIj21c9nqpyAPOelPwaGTi ^"Trap of the Entwining Vines" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo" FIXED
            ^"Form" STRING "Herbam" FIXED
            ^"Level" INTEGER 15 FIXED
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 1
            MODIFIERS {
                +2 "Voice"
                +2 "Sun"
                +2 "Group"
            }
        }
        DESCRIPTION "Causes strong, woody vines to grow rapidly from fertile earth. The vines cover a circle 2 paces across and reach 6 feet high. Anything caught within them is immobilized. To avoid the vines, the target must make a Quickness – Encumbrance stress roll against an Ease Factor of 9. To break out requires a Strength stress roll against an Ease Factor of 12 (allowed once a round). Someone not trapped can cut a trapped person free in two rounds, assuming proper tools. The vines weaken and wither to dust at sunrise or sunset."
        REFERENCES {
            "Ease Factor" -> #tGQufzy8y8Qc3foo2n9p7nMU ^"Ease Factor"
            "Ease Factor" -> #tGQufzy8y8Qc3foo2n9p7nMU ^"Ease Factor"
        }
    }
    #tFaj4GNJiqXBhVzJliH7OGmc ^"Bridge of Wood" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
