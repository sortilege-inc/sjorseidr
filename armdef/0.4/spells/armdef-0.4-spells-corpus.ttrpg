        }
        LEVEL_CALCULATION {
            BASE 30
            MODIFIERS {
            +2 "Voice"
            }
        }
        DESCRIPTION "When casting this spell, you make a clenching motion with your hand. The victim doubles over and dies at once."
    }

    #tgu2i2u1dDp3NRevMAeLplqr ^"The Kiss of Death" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo" FIXED
            ^"Form" STRING "Corpus" FIXED
            ^"Level" INTEGER 45 FIXED
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 30
            MODIFIERS {
            +1 "Touch"
            +2 "no words"
            }
        }
        DESCRIPTION "The person you kiss dies a sudden death. The only mark on the corpse is the black imprint of your lips. You do not need to speak when casting this spell, and thus gain no penalty from silence. (This is why the spell is higher level than the guidelines would indicate.)"
    }

    #t3IDJkHDg98HzZgywdKysoGS ^"Curse of the Unportended Plague" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo" FIXED
            ^"Form" STRING "Corpus" FIXED
            ^"Level" INTEGER 55 FIXED
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Boundary"
            ^"Ritual" BOOLEAN true
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 20
            MODIFIERS {
            +3 "Sight"
            +4 "Bound"
            }
        }
        DESCRIPTION "Starts a plague in a city or other Boundary. Everyone within the boundary is afflicted with the disease when the ritual is complete, and suffers as described under Curse of the Leprous Flesh, on the previous page. The conditions causing the disease last but a moment, so people entering the area after the spell is cast are safe. Using, or even transcribing, this spell is rigorously discouraged by most of the Order of Hermes. (Note: the disease caused by this spell is not the later Bubonic Plague, which is unknown in Europe in 1220.)"
    }

    #tKS5EFgauqKg2WOLETsDTV0t ^"Curse of the Unruly Tongue" DEF {
