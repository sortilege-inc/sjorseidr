                ^"Vim" INTEGER 0
            }
            ^"Virtues" LIST ["The Gift", "Hermetic Magus", "Affinity with Intellego", "Clear Thinker", "Great Perception", "Hermetic Prestige*", "Improved Characteristics", "Puissant Intellego", "Side Effect (lying is hard)"]
            ^"Flaws" LIST ["Curse of Venus", "Restriction (no magic for Sun duration after lying)"]
            ^"Soak" INTEGER 0
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Twilight Scars" STRING "None"
