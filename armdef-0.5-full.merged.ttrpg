            ^"Category" STRING "Supernatural" FIXED
            ^"Modifiers" STRING "+3 Size, +1 Warping."
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "The interior of the lab is in a regio, and there is an another regio level, which the owner can navigate easily. If there are further regio levels, this Virtue may be taken more than once."
    }
    #t6gWHHExOCHpMWDqS5uK3ICn ^"Abyss (Lab Flaw)" DEF {
        EXTENDS ^"Laboratory Flaw"
        PROPERTIES {
            ^"Magnitude" STRING "Free" FIXED
            ^"Category" STRING "Supernatural" FIXED
            ^"Modifiers" STRING "–2 Safety; +2 Pe."
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "The lab contains some kind of magical void, such as a bottomless well. This may be made into a Void Feature (purchased as usual)."
    }
    #trbajmKKfK5zHPCqmr5dqOvF ^"Haunted (Lab Flaw)" DEF {
        EXTENDS ^"Laboratory Flaw"
        PROPERTIES {
            ^"Magnitude" STRING "Free" FIXED
            ^"Category" STRING "Supernatural" FIXED
            ^"Modifiers" STRING "+1 Warping, –1 Aesthetics; +2 Me."
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "The lab is home to a haunting spirit, who occasionally disturbs the current owner."
    }
    #tIGWj6D194x0BXPRN8Jl5ulm ^"Impregnable (Lab Flaw)" DEF {
        EXTENDS ^"Laboratory Flaw"
        PROPERTIES {
            ^"Magnitude" STRING "Free" FIXED
            ^"Category" STRING "Supernatural" FIXED
            ^"Modifiers" STRING "–2 Aesthetics."
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "The lab is completely inaccessible, except through reasonably powerful magic. For example, it is blocked off by a stone wall and requires a Muto Terram spell to access. While the owner is much less likely to be disturbed, fewer people will ever get to see the lab, or they may assume that the owner is rather paranoid."
    }
    #tBKS2XPd6eatNg2JbQpbdK9M ^"Inhabitants (Lab Flaw)" DEF {
        EXTENDS ^"Laboratory Flaw"
        PROPERTIES {
            ^"Magnitude" STRING "Free" FIXED
            ^"Category" STRING "Supernatural" FIXED
            ^"Modifiers" STRING "–1 Safety, –1 Aesthetics; 1 point on an appropriate Art Specialization."
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "Residency in the lab is shared with some other creatures, who consider the place as their home, not a lab. They may provide a nuisance to the owner, and vice-versa."
    }
    #taJl2d2EdZ0f01U9Yd42ylWK ^"Predecessor (Lab Flaw)" DEF {
        EXTENDS ^"Laboratory Flaw"
        PROPERTIES {
            ^"Magnitude" STRING "Free" FIXED
            ^"Category" STRING "Supernatural" FIXED
            ^"Modifiers" STRING "–1 Safety, +1 Warping; +1 Experimentation."
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "The lab retains some foibles due to its (notable) previous owner."
    }
    #ttL91xTNVNQlWMOWvt4AypDu ^"Restriction (Lab Flaw)" DEF {
