    #tQBxpWH3UOLQ1BG9gX6xfGsl ^"Fachan" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 30
            ^"Might Realm" STRING "Faerie" FIXED
            ^"Size" INTEGER 1
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER -3
                ^"Communication" INTEGER -3
                ^"Strength" INTEGER 3
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 1
            }
            ^"Soak" INTEGER 5
            ^"Wound Penalties" STRING "–1 (1–6), –3 (7–12), –5 (13–18), Incapacitated (19–24), Dead (25+)"
            ^"Vis" STRING "6 pawns, a decayed apple"
            ^"Appearance" STRING "A fachan looks like a human, but has a single eye in the middle of its head, a single arm extending from its sternum, and a single leg. Fachans also have a black, feathered crest that runs from the top of their heads along their spines. The mouth of a fachan is inhumanly large."
            ^"Source" STRING "Realms of Power: Faerie"
        }
        VIRTUES {
            ^"Greater Faerie Powers"
            TIMES 2
            ^"Faerie Sight"
            ^"Faerie Speech"
            ^"Increased Faerie Might"
            TIMES 5
            ^"Large"
            ^"Hybrid Form"
        }
        FLAWS {
            ^"Missing Eye"
            ^"Missing Hand"
            ^"Incognizant"
        }
        PERSONALITY_TRAITS {
            "Hates humans" +3
            "Bloodthirsty" +2
        }
        COMBAT {
            "Club" INIT 2 ATTACK 14 DEFENSE 11 DAMAGE 6
            "Fist" INIT 1 ATTACK 13 DEFENSE 11 DAMAGE 3
            "Flail" INIT 3 ATTACK 16 DEFENSE 11 DAMAGE 10
        }
        ABILITIES {
            "Awareness" SCORE 3 SPECIALTY "humans"
            "Brawl" SCORE 5 SPECIALTY "humans"
            "Faerie Speech" SCORE 3 SPECIALTY "primitive threats"
            "Penetration" SCORE 3 SPECIALTY "poisoned weapons"
            "Single Weapon" SCORE 9 SPECIALTY "club or flail"
        }
        POWERS {
            ^"Lurching heart" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "The fachan is so terrible to look upon that characters who see it must make a Brave roll against an Ease Factor of 9. If they fail, their heart flutters uncontrollably until they gather their courage. This cramping in the heart is treated as a fresh Light wound every round until the Brave roll is made. The great kings of the fachans can strike men dead with fear simply by being present, and some magi have encountered fachans who cause more grievous harm than described here. (35 spell levels (Base 5 +3 Sight +2 Sun +1 Constant) +15 xp in Penetration from intricacy points.)"
            }
            ^"Poisoned Weapons" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION "The weapons of the fachan are smeared with deadly poison. Its Ease Factor is 9. See ArM5 page 180 for more details. (35 spell levels (Base 20 +2 Sun +1 constant) +15 xp in Penetration from intricacy points.)"
            }
        }
        DESCRIPTION "Flail footnote: * Poisoned: see powers section. Equipment: Flail or club, belt. The fachans are faeries of distant lochs and valleys, found in Ireland and Scotland. They are rarely seen, but hate humans. Many fachans fight with clubs, but many others use iron flails, with up to twelve chains and fifty weights, dipped in poison. Fachans wear a cloak of sticky feathers that provide light armor."
    }
