            ^"Faerie Sight"
            ^"Faerie Speech"
            ^"Feast of the Dead"
            ^"Humanoid Faerie"
            ^"Increased Faerie Might"
            TIMES 3
            ^"Personal Faerie Powers"
        }
        FLAWS {
            ^"Narrowly Cognizant"
            ^"Restricted Might"
            OF "daylight" SIZE "Major"
