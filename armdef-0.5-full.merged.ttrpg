    #tdca136c158c0b3a4f82863 ^"Persona" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Houses of Hermes: Societates"
        }
        DESCRIPTION "The character may adopt one or more flawless disguises, changing both his physical appearance and mannerisms. Choosing this Virtue confers the Supernatural Ability Persona 1 (see Personae, above)."
    }
    #tl7t4tnrSaB3n28mGxwz38jG ^"Philosophiae" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Ability Type" STRING "Academic" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Specialties" LIST OF STRING ["natural philosophy", "moral philosophy", "metaphysics", "Ritual magic", "Ceremonial magic"]
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "There are three philosophies — natural philosophy, moral philosophy, and metaphysics. Aristotle is the auctor for all of them, in different books. Most scholars study the philosophies after the Arts but before going on to Law, Theology or Medicine. Natural philosophy is the study of the sub-lunar world. It roughly corresponds to today's science. The main texts are the Physica, De Meteorologia, and De historia animalium. Moral philosophy is the study of the proper way of human life. It covers ethics, politics, and economics — the texts are the Ethica, Politica, and Economica. Metaphysics is the philosophy of the fundamental nature of the world. The main text is Aristotle's Metaphysica. The theories of the Philosophiae are all basically correct in Mythic Europe."
    }
    #tEssLySCq4TaXmBHvSNMHKQd ^"Premonitions" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor" FIXED
            ^"Category" STRING "Supernatural" FIXED
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "You intuitively sense whenever something is wrong, or is likely to go wrong soon. Choosing this Virtue confers the Ability Premonitions 1 (page 170)."
    }
    #tlPzmRO3IzuCqp9XHPRLparG ^"Profession (Type)" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Ability Type" STRING "General" FIXED
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "The ability to do a job which does not involve making something. Examples include jongleur, marshal, reeve, sailor, steward, teamster, and washerwoman. Specialties depend on the profession."
    }
    #teGsgpG92fvegsyHI1GgG6cH ^"Rabbinic Law" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Ability Type" STRING "Academic" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Specialties" LIST OF STRING ["any one of the sources of Rabbinic Law", "dietary laws", "particular topics", "precedents of a given area"]
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "This is the Jewish version of Civil & Canon Law. The major sources of Rabbinic Law are the Talmud, the Oral Torah, and the Responsa of the Geonim."
    }
    #tzE9Zr2U5XAxmP0HER4AMyeG ^"Ride" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Ability Type" STRING "General" FIXED
            ^"Specialties" LIST OF STRING ["battle", "speed", "tricks"]
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "Riding and controlling a riding animal, especially under stress."
    }
    #tc0ipSRjCRDpM05b92rdB7yS ^"Second Sight" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor" FIXED
            ^"Category" STRING "Supernatural" FIXED
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "You are able to see through illusionary concealment and disguise, including invisibility, and can also see naturally invisible things such as spirits and the boundaries between regio levels (see page 421). Choosing this Virtue confers the Ability Second Sight 1 (page 170)."
    }
    #tOx27jnq6PnZDQXPCwgEfIVH ^"Sense Holiness and Unholiness" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor" FIXED
            ^"Category" STRING "Supernatural" FIXED
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "You are able to feel the presence of good and evil. In auras of particularly strong divine or infernal influence, your sensitivity may overwhelm you. Choosing this Virtue confers the Ability Sense Holiness and Unholiness 1 (page 170)."
    }
    #t6ae43bebbee57a30102904 ^"Sense Passions" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "The character can see into the hearts and minds of others, learning their weaknesses, fears, and evil thoughts. This gives her the Supernatural Ability Sense Passions at 1, described in more detail under New Abilities, below."
    }
    #tGv5QbIp1bZcoOl86hV5CJfo ^"Shapeshifter" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Major" FIXED
            ^"Category" STRING "Supernatural" FIXED
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "You may change your shape into that of one or more mundane animals. Choosing this Virtue confers the Ability Shapeshifter 1 (page 171)."
    }
    #teT2LcXE2F4TDMJ6PBCx2GZI ^"Single Weapon" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Ability Type" STRING "Martial" FIXED
            ^"Specialties" LIST OF STRING ["any one weapon or shield, which covers using that weapon with any shield or none, and that shield with any weapon"]
            ^"Source" STRING "Core Rules"
        }
