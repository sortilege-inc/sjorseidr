    }
    #tfgy0BZ4q2JDdDTEfLS0Snui ^"A Spell to Milk Cattle" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Animal" FIXED
            ^"Level" INTEGER 15 FIXED
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Group"
            ^"Source" STRING "Covenants"
        }
        LEVEL_CALCULATION {
            BASE 3
            MODIFIERS {
                +1 "Touch"
                +1 "Conc"
                +2 "Group"
            }
        }
        DESCRIPTION "While you wait, the cows are magically milked without further handling, transferring their milk into nearby milkpails. The magus’s Perception + Finesse roll substitutes for an Animal Handling roll by a competent farmer; the spell gathers the milk, but if the roll is failed, the cattle may be spooked.

Milking cattle is normally Simple (3) if the cattle are accustomed to the process and the milking hand, so the basic Finesse Ease Factor is at least 6, higher if anything disturbs the cows. Cows are initially be disconcerted at being milked by invisible hands, and need soothing (The Gentle Herd is ideal for this task). Unless magically calmed, the Finesse roll is Very Hard (15+) the first time cows are milked by magic, but this Ease Factor reducing over time and successful milking to 12, then 9, until the cows become accustomed to the process (6)."
        REFERENCES {
            "Animal Handling" -> #teWrQcCWtN9DNBmHrm2qAE9c ^"Animal Handling"
            "The Gentle Herd" -> #te60jRGCpp8YNkecj8ZAjMl9 ^"The Gentle Herd"
        }
    }
    #te60jRGCpp8YNkecj8ZAjMl9 ^"The Gentle Herd" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Animal" FIXED
            ^"Level" INTEGER 20 FIXED
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Group"
            ^"Source" STRING "Covenants"
        }
        LEVEL_CALCULATION {
            BASE 4
            MODIFIERS {
                +1 "Touch"
                +1 "Conc"
                +2 "Group"
            }
        }
        DESCRIPTION "A group of animals are rendered calm and placid, even while unusual events occur, such as invisible hands milking them."
    }
    #tyi9GDRvl0PuOfuWcM6Vbe6L ^"The Carpenter’s Keen Eye" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego" FIXED
            ^"Form" STRING "Herbam" FIXED
            ^"Level" INTEGER 15 FIXED
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
