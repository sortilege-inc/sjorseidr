    #tEPWavQHn85UDCUhZPmd1alC ^"Scitalis" DEF {
        EXTENDS ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 5
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Animal"
            ^"Size" INTEGER -2
            ^"Characteristics" DEF {
                ^"Cunning" INTEGER 1
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER 4
                ^"Communication" INTEGER -3
                ^"Strength" INTEGER -2
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER -2
            }
            ^"Virtues and Flaws" LIST ["Great Presence", "Poor Quickness", "Weak Characteristics"]
            ^"Soak" INTEGER 4
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–3), –3 (4–6), –5 (7–9), Incapacitated (10–12), Dead (13+)"
            ^"Vis" STRING "1 Imaginem in skin"
            ^"Appearance" STRING "The scitalis is a large snake, about six feet long and as thick as a man's arm. Its scales are patterned in a variety of spectacular colors."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Lethargic" +2
            "Territorial" +2
        }
        COMBAT {
            "Fangs" INIT -2 ATTACK 7 DEFENSE 3 DAMAGE -1
        }
        ABILITIES {
            "Brawl" SCORE 3 SPECIALTY "fangs"
            "Ignem Resistance" SCORE 3 SPECIALTY "cold"
            "Survival" SCORE 2 SPECIALTY "winter"
        }
        POWERS {
            ^"Dazzling Appearance" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "-3"
                    ^"Form" STRING "Mentem or Animal"
                    ^"Range" STRING "Per"
                    ^"Duration" STRING "Conc"
                    ^"Target" STRING "Spectacle"
                    ^"Spell Equivalent" STRING "ReMe(An) 45"
                    ^"Design" STRING "(Base 15, +1 Conc, +4 Spectacle, +1 Animal requisite)"
                }
                DESCRIPTION "The scitalis can use its wondrous colors and appearance to stupefy those who look at it. Victims stand in slack-jawed amazement, unable to move, speak, or act, for as long as the scitalis concentrates. It uses this power to capture its prey, for it is a slow-moving creature."
            }
            ^"Venom" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "n/a"
                    ^"Form" STRING "Aquam"
                    ^"Range" STRING "Touch"
                    ^"Duration" STRING "Sun"
                    ^"Target" STRING "Ind"
                    ^"Spell Equivalent" STRING "CrAq 30"
                    ^"Design" STRING "(Base 10, +1 Touch, +2 Sun, +1 continuous effect)"
                }
                DESCRIPTION "The scitalis' fangs drip a venom that causes a Medium Wound (if it penetrates Magic Resistance) unless its victim can make a Stamina roll against an Ease Factor of 9."
            }
        }
        DESCRIPTION "The scitalis is a slow-moving serpent that relies on its marvelous appearance to stun its prey. The scitalis usually hunts by hiding near a water source or game trail. It typically preys on small animals, but has been known to attack humans if it feels threatened. Unlike mundane snakes, the blood of the scitalis is hot, enabling the serpent to remain active throughout the winter months."
    }

    #tVAmrZ0d6aEPytRGEExAjf6m ^"Stag of Virtue" DEF {
        EXTENDS ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 17
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Animal"
            ^"Size" INTEGER 2
            ^"Characteristics" DEF {
                ^"Cunning" INTEGER -2
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER 2
                ^"Communication" INTEGER -3
                ^"Strength" INTEGER 4
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 2
            }
            ^"Virtues and Flaws" LIST ["Ways of the Forest", "Essential Virtue (healthy, minor)", "Ferocity (when at bay)", "Great Quickness", "Lesser Immunity (fevers)", "Long-Winded", "Puissant Athletics", "Hatred (of serpents, major)", "Higher Purpose (protect its herd)", "Restricted Power (x2)"]
            ^"Reputations" LIST ["Noble 2 (local)"]
            ^"Soak" INTEGER 7
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–7), –3 (8–14), –5 (15–21), Incapacitated (22–28), Dead (29+)"
            ^"Vis" STRING "3 Creo in right antler."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Stag" +3
            "Noble" +3
            "Healthy (Stamina)" +3
            "Brave" +2
        }
        COMBAT {
            "Antlers" INIT 4 ATTACK 10 DEFENSE 10 DAMAGE 7
            "Hooves" INIT 4 ATTACK 8 DEFENSE 9 DAMAGE 5
        }
        ABILITIES {
            "Athletics" SCORE 8 SPECIALTY "sprinting"
            "Awareness" SCORE 5 SPECIALTY "hunters"
            "Brawl" SCORE 5 SPECIALTY "antlers"
            "Stealth" SCORE 3 SPECIALTY "hiding in undergrowth"
            "Survival" SCORE 4 SPECIALTY "forests"
        }
        POWERS {
            ^"Healing" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "-8"
                    ^"Form" STRING "Animal"
                    ^"Range" STRING "Per"
                    ^"Duration" STRING "Mom"
                    ^"Target" STRING "Ind"
                    ^"Spell Equivalent" STRING "CrAn 25"
                    ^"Design" STRING "(Base effect)"
                }
                DESCRIPTION "The stag can heal one of its own Heavy or lesser wounds. This is a Restricted Power: the stag must eat the herb dittany to activate it."
            }
            ^"Delay the Serpent's Venom" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "n/a"
                    ^"Form" STRING "Aquam"
                    ^"Range" STRING "Per"
                    ^"Duration" STRING "Sun"
                    ^"Target" STRING "Ind"
                    ^"Spell Equivalent" STRING "Re(In)Aq 20"
                    ^"Design" STRING "(Base 5, +2 Sun, +1 Intellego requisite)"
                }
                DESCRIPTION "The Stag of Virtue is magically warded against poison. Any poison introduced into the Stag's body takes no effect until the next sunrise or sunset (whichever comes first). This power activates whenever such a poison is introduced, and thus has an Intellego requisite."
            }
            ^"Alleviate the Serpent's Bite" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Aquam"
                    ^"Range" STRING "Per"
                    ^"Duration" STRING "Mom"
                    ^"Target" STRING "Ind"
                    ^"Spell Equivalent" STRING "PeAq 15"
                    ^"Design" STRING "(Base 15)"
                }
                DESCRIPTION "A Stag of Virtue can permanently neutralize any poison already inside its body. This is a Restricted Power, which the Stag must drink water to activate."
            }
        }
        DESCRIPTION "A Stag of Virtue is a great enemy of serpents and kills them whenever it can. It does this by filling its mouth with water and spitting it down the serpent's hole; when the serpent emerges to escape drowning, the Stag of Virtue tramples it to death. A Stag of Virtue enjoys vigorous health and can live a very long time (in fact, like other Beasts of Virtue, it can live forever). To keep itself youthful and healthy, this stag swallows a live, venomous serpent. Then it drinks a large quantity of water to neutralize the venom. After this process, its antlers fall off and its vigor is restored. Hermetic experts concur that the Stag of Virtue actually consumes Magical serpents for this process and that it becomes weak and looks aged when it cannot find snakes to eat (such as during the winter). The Stag of Virtue lives only in places where Magical snakes can be found. The right antler of a Stag of Virtue has healing powers and is greatly sought by hedge wizards and magi alike. The stag always buries its antlers after shedding them. Anyone who consumes the flesh of a Stag of Virtue gains a Lesser Immunity to fevers for Moon duration. The stag itself is immune to fevers and the venison transfers this immunity through the Law of Contagion."
    }

    #tYRdC3inztNaGGaLM7rydTeA ^"Stellatus, the Dragon" DEF {
        EXTENDS ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 50
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Ignem"
            ^"Size" INTEGER 8
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 4
                ^"Perception" INTEGER 4
                ^"Presence" INTEGER 7
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 8
                ^"Stamina" INTEGER 8
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 0
            }
            ^"Virtues and Flaws" LIST ["Second Sight"]
            ^"Reputations" LIST ["The Powerful Dragon who Lives in the Mountains (local) 5"]
            ^"Soak" INTEGER 20
            ^"Fatigue Levels" STRING "OK, 0/0/0/0/0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–13), –3 (14–26), –5 (27–39), Incapacitated (40–52)"
            ^"Vis" STRING "5 pawns of Ignem vis in each eye."
            ^"Appearance" STRING "An enormous lizard with great wings, covered in scales of red so dark as to be almost black. His eyes are lit from within by a smoldering orange glow. Although he is a little on the small side for a dragon, he is larger than most houses."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Proud" +3
        }
        COMBAT {
            "Claws" INIT 3 ATTACK 22 DEFENSE 18 DAMAGE 20
        }
        ABILITIES {
            "[Area] Lore" SCORE 5 SPECIALTY "history"
            "Awareness" SCORE 8 SPECIALTY "human beings"
            "Brawl" SCORE 7 SPECIALTY "claws"
            "Divine Lore" SCORE 1 SPECIALTY "saints"
            "Faerie Lore" SCORE 2 SPECIALTY "knights"
            "Folk Ken" SCORE 2 SPECIALTY "scholars"
            "Guile" SCORE 4 SPECIALTY "keeping secrets"
            "Infernal Lore" SCORE 0 SPECIALTY "undead"
            "Magic Lore" SCORE 8 SPECIALTY "dragons"
            "Order of Hermes Lore" SCORE 1 SPECIALTY "Tytalus"
            "Second Sight" SCORE 8 SPECIALTY "magical invisibility"
        }
        POWERS {
            ^"Human Form" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "The dragon can assume the form of a human being. This is always the same form, a man with dark hair and eyes, in the prime of life. The transformation lasts until he eats or drinks, or until Stellatus uses the same power again to change back. The dragon has all his powers in human form, and the same Characteristics, but he is much weaker in combat and thus changes back if he needs to fight."
            }
            ^"Instill Loyalty" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Stellatus can make any individual whom he can see totally loyal. This does not remove free will, but the victim is completely loyal to the dragon, and this loyalty lasts as long as Stellatus is alive."
            }
            ^"Fiery Breath" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+5"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "Stellatus can breathe fire. The fire extends in a cone from his mouth, out to a distance of 20 paces, where it is 20 paces across. The fire has an intensity of +15. Dodging it is a Qik + Athletics roll against an Ease Factor of 9. A failure means that the character is engulfed in the flames, taking +45 damage, a success by 3 points or less means that a limb is covered, for +30 damage, a success by 4 to 6 points (that is, success against Ease Factor 12) means that the character is only brushed by the flames, for +15 damage, while success by 7 points or more (that is, success against Ease Factor 15) means that the character dodges out of the fire entirely."
            }
            ^"Master of Fire" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 or more Might Points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "Stellatus can control fire. He can duplicate any Hermetic Rego Ignem spell of fourth magnitude or less at the cost of 1 Might point. For every additional Might point he spends, the level of the spell increases by one magnitude."
            }
        }
        DESCRIPTION "Stellatus is an ancient dragon who has laired under the same mountain range for centuries. Most of the time he lies quietly in his lair, contemplating his treasure, or travels the area around in human form (he can go for weeks without eating or drinking). Every couple of centuries, he erupts in draconic form to carry out some plan or seize some item, and every decade or so some would-be hero disturbs him. The dragon is aware of The Gift, but it inspires him with curiosity, making him less likely to simply kill magi who enter his lair. A Tytalus maga did spend some time challenging the dragon in various ways, and although Stellatus eventually killed her by rigging an entirely mundane rock-fall trap, he quite enjoyed the experience. He regards himself as superior to all Hermetic magi, and is firmly convinced that he is immune to their magic. With a Magic Resistance of 50, this is almost, but not quite, true."
    }

    #tROL9hZgdTQUAe6r3Cq7pj9b ^"Zwergenstimme" DEF {
        EXTENDS ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 15
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Imaginem"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER -1
                ^"Communication" INTEGER 4
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER -1
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER 3
            }
            ^"Virtues and Flaws" LIST ["Great Communication", "Improved Characteristics", "Sharp Ears"]
            ^"Reputations" LIST ["Murderous 1 (Local)"]
            ^"Vis" STRING "3 pawns of Imaginem, as an immaterial echo"
            ^"Appearance" STRING "An echo. This spirit appears only as auditory species to those with Second Sight"
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Mischievous" +3
            "Echo" +3
        }
        COMBAT {
            "Thrown Rock" INIT 3 ATTACK 4 DAMAGE 5
        }
        ABILITIES {
            "Awareness" SCORE 4 SPECIALTY "sounds"
            "Folk Ken" SCORE 1 SPECIALTY "fear"
            "Guile" SCORE 1 SPECIALTY "mimicry"
            "Music" SCORE 2 SPECIALTY "echoes"
            "Thrown Weapon" SCORE 4 SPECIALTY "rocks"
        }
        POWERS {
            ^"Master of Sound" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+5 – Might cost"
                    ^"Form" STRING "Imaginem"
                    ^"Spell Equivalent" STRING "(Te)Im15"
                }
                DESCRIPTION "The spirit can duplicate any non-Ritual spell involving sound up to Level 15, at a cost of 1 Might Point per magnitude of effect."
            }
            ^"Bring Down the Roof" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Terram"
                    ^"Range" STRING "Touch"
                    ^"Target" STRING "Room"
                    ^"Spell Equivalent" STRING "PeTe 20"
                    ^"Design" STRING "base 3, +2 Size"
                }
                DESCRIPTION "The Zwergenstimme can cause the roof of a cave to collapse, crushing any within it. This causes +20 damage, and seals the exit from the cave."
            }
            ^"Presence" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Imaginem"
                }
                DESCRIPTION "Grants awareness of everything that happens within the bounds of a specific domain chosen by the spirit. In essence, the spirit is coterminous with its associated landscape feature, so it is present simultaneously everywhere within its boundaries. The area controlled by the spirit can produce a yearly harvest of 2 pawns of vis of an appropriate Form, which manifests as physical objects within the controlled region. Harvesting this vis does not erode the spirit's Might. The echo spirit can haunt a series of caves (constituting a Structure)."
            }
            ^"Ghost Touch" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable cost"
                    ^"Initiative" STRING "+2"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "The spirit can hurl rocks at enemies. It uses the combat scores listed above, but each attack costs 1 Might point."
            }
        }
        DESCRIPTION "This spirit of an echo lurks in caves or ravines. Its name literally means \"dwarf voice\" in German, and these spirits have been known to mislead lost humans by “playing” with them. The spirit certainly has no intent to harm; it doesn't even understand what harm is."
    }
}
