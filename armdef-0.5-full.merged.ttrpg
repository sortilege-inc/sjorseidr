    #ta572166c36a56aa0c75400 ^"The Oracle’s Dredge" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 15
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Base 3, +1 Touch, +1 Part; +10 Unlimited)"
            ^"Printed Effect Line" STRING "PeTe 15 Pen +0, Unlimited R: Touch, D: Momentary, T: Part"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 93
        }
        DESCRIPTION "This is a long wooden pole (about 20 feet long) with a scoop attached to one end. When activated it destroys the mud that it touches (about 10 cubic paces).

The Dredge is used at Miletos to dredge the Lion Harbor, which otherwise fills with sediment from the Meander river. The covenfolk paddle around the Lion Harbor once every month to clear it, otherwise, the harbor will visibly silt up within a season and be unusable within a decade. The mundane authorities and merchants know that the covenant performs this service for Miletos (and has done so for more than two hundred years)."
    }
    #td5c65d0633f35bd1e7e5a6 ^"Porter’s Helpers" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
