        }
        POWERS {
            ^"Guide" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+6"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "4 intricacy points spent on cost, added magnitudes for Sight Range and Sun Duration."
            }
        }
        DESCRIPTION "Str n/a, Sta n/a. Equipment: One large swamp. Fool's fires are tiny lights, also called will o' the wisps, that guide lost travelers into dangerous terrain. Some fool's fires act as lure on behalf of more powerful faeries. In some German areas they are thought to be the ghosts of people who have moved border marking stones."
    }
    #t51uVdb4YJ8bPZzRLjcDZpuI ^"Fauns" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 5
            ^"Might Realm" STRING "Faerie" FIXED
            ^"Size" INTEGER 1
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -1
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 2
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER 2
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 2
            }
            ^"Soak" INTEGER 3
            ^"Wound Penalties" STRING "–1 (1-6), –3 (7-12), –5 (13-18), Incapacitated (19-24), Dead (25+)"
            ^"Vis" STRING "1 pawn Animal, goat horn"
            ^"Appearance" STRING "Fauns are rugged, wild men with two sharp horns and goat’s legs and hooves. They have the ears and tails of horses. They are very hairy, their whole bodies covered in short, dark fur, and they often sport scraggly beards. They are also a little larger than normal men. In spite of all this, they are still very attractive in a wild, virile way, for they embody pure masculinity in everything they do."
            ^"Source" STRING "Realms of Power: Faerie"
        }
        VIRTUES {
            ^"Greater Faerie Powers"
            ^"Faerie Speech"
            ^"Faerie Sight"
            ^"Improved Characteristics"
            TIMES 3
            ^"Hybrid Form"
            ^"Large"
        }
        FLAWS {
            ^"Lecherous"
            SIZE "Major" NOTE "or Greedy (wine - major)"
            ^"Aloof"
            ^"Incognizant"
            ^"Weakness"
            OF "music or sex or wine"
            ^"Traditional Ward"
            OF "religious"
        }
        PERSONALITY_TRAITS {
            "Lusty" +5
            "Hasty" +2
        }
        COMBAT {
            "Kick (brawl)" INIT 4 ATTACK 8 DEFENSE 9 DAMAGE 5
            "Horns (brawl)" INIT 3 ATTACK 9 DEFENSE 6 DAMAGE 6
            "Spear" INIT 4 ATTACK 7 DEFENSE 6 DAMAGE 7
            "Spear (thrown)" INIT 2 ATTACK 7 DEFENSE 6 DAMAGE 7
        }
        ABILITIES {
            "Athletics" SCORE 2 SPECIALTY "dancing"
            "Awareness" SCORE 2
            "Brawl" SCORE 5 SPECIALTY "wrestling"
            "Carouse" SCORE 6
            "Charm" SCORE 2 SPECIALTY "taking liberties"
            "Guile" SCORE 2 SPECIALTY "women"
            "Local Language" SCORE 3
            "Music" SCORE 3 SPECIALTY "flute"
            "Single Weapon" SCORE 3 SPECIALTY "spear"
            "Thrown Weapon" SCORE 3 SPECIALTY "spear"
        }
        POWERS {
            ^"Grant Puissance in Combat" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Fauns can play wild, violent music, giving those who hear it +3 on Weapon Skills (affecting Attack and Damage rolls) and Brave totals for the rest of the scene."
            }
            #t9718bc3d1ffc19b25ceff2 ^"Endless Wine" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Herbam"
                }
                DESCRIPTION "(1 intricacy point spent on cost). Any vessel the faun touches fills with wine, if the faun so wishes. Note that fauns prefer human wine, because it has vitality. Fauns give this wine to humans so that they act in vital, uninhibited ways. This effect also makes vines laden with grapes spring up in places where fauns dwell, in some cases. (Base 2, +1 Touch, +2 Sun, +1 constant.* ) * This power lasts for the length of the party. These usually break up at dawn, so it has been given Sun Duration. Note that harm caused to people by effects that vanish does not, itself, vanish, so phantom wine can create real hangovers."
            }
            ^"Steal Judgment" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "OR Endless Wine: 0 points, constant, Herbam."
                REFERENCES {
                    "Endless Wine" -> #t9718bc3d1ffc19b25ceff2 ^"Endless Wine"
                }
            }
            ^"Enthralling Sound" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "(3 intricacy points spent on cost) Faun dancing music makes listeners more riotous and merry, increasing Personality traits like Reckless, Lustful, and Impulsive for the rest of the scene."
            }
        }
        DESCRIPTION "Fauns represent the freedom granted by the secrecy that the forest provides. Fauns are braver than satyrs, described later, and represent what people can get away with in the woods, while satyrs represent what petty people wish they could get away with. Both are dangerous, particularly to women, but satyrs more so when in groups."
    }
    #tHkqcbNGBHuYRF56J9KKR2FJ ^"Satyrs" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 5
            ^"Might Realm" STRING "Faerie" FIXED
            ^"Size" INTEGER -1
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 2
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER 4
            }
            ^"Soak" INTEGER 4
            ^"Wound Penalties" STRING "–1 (1-4), –3 (5-8), –5 (9-12), Incapacitated (13-16), Dead (17+)"
            ^"Vis" STRING "1 pawn in a phallic-looking reed"
            ^"Appearance" STRING "Satyrs have human bodies, including the legs, but have but have the ears of donkeys and the tails of horses."
            ^"Source" STRING "Realms of Power: Faerie"
        }
        VIRTUES {
            ^"Great Characteristic"
            ^"Greater Faerie Powers"
            ^"Faerie Sight"
            ^"Faerie Speech"
            ^"Improved Characteristics"
            TIMES 2
            ^"Hybrid Form"
            ^"Observant"
        }
        FLAWS {
            ^"Lecherous"
            SIZE "Major" NOTE "or Greedy (wine – major)"
            ^"Aloof"
            ^"Incognizant"
            ^"Small Frame"
            ^"Traditional Ward"
            OF "folk charms"
            ^"Weakness"
            OF "music or sex or wine"
        }
        PERSONALITY_TRAITS {
            "Proud" +3
            "Lusty" +2
            "Brave" -2
        }
        COMBAT {
            "Kick (brawl)" INIT 4 ATTACK 6 DEFENSE 6 DAMAGE 2
            "Horns" INIT 5 ATTACK 3 DEFENSE -1 DAMAGE 2
            "Spear (thrown)" INIT 4 ATTACK 7 DEFENSE 9 DAMAGE 5
        }
        ABILITIES {
            "Athletics" SCORE 2 SPECIALTY "dancing"
            "Awareness" SCORE 2 SPECIALTY "humans"
            "Brawl" SCORE 1 SPECIALTY "escaping"
            "Carouse" SCORE 6 SPECIALTY "party games"
            "Charm" SCORE 2 SPECIALTY "taking liberties"
            "Guile" SCORE 2 SPECIALTY "women"
            "Local Language" SCORE 3
            "Music" SCORE 3 SPECIALTY "flute"
            "Thrown Weapon" SCORE 5 SPECIALTY "spear"
        }
        POWERS {
            ^"Enthralling Sound" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 point"
                    ^"Initiative" STRING "+2"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "(3 intricacy points spent on cost, 1 on Initiative) Satyr dancing music makes listeners more riotous and merry, increasing Personality traits like Reckless, Lustful, and Impulsive for the rest of the scene."
            }
        }
        DESCRIPTION "* Satyrs are less timid when in groups, or by driven by their compulsions. Satyrs embody the cowardice of the common man, in heroic stories. They appear in many Greek plays, and their role is to promise to support the hero, and offer to do great deeds, but to fail because they are stupid and cowardly. This re-enforces the belief that heroes are a separate and better class of human, which was important to Greek audiences. Satyrs are similar to fauns, and most Mythic Europeans use the word interchangeably for what this chapter calls a faun, but satyrs are far smaller, and their machismo is mere bravado. Both fauns and satyrs are notorious for sexual violence, but satyrs tend to be violent more often, and also attack children more frequently."
    }
    #tpILJlgVA9oQ3TqODmX4qv9f ^"Koerakoonlane" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 5
            ^"Might Realm" STRING "Faerie" FIXED
            ^"Size" INTEGER 0
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER -3
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER 2
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER 2
            }
            ^"Soak" INTEGER 6
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Vis" STRING "1 pawn, the frozen corpse of a dog."
            ^"Appearance" STRING "A hybrid of both dog and human features."
            ^"Source" STRING "Realms of Power: Faerie"
        }
        VIRTUES {
            ^"Faerie Sight"
            ^"Faerie Speech"
            ^"Observant"
        }
        FLAWS {
            ^"Hybrid Form"
            ^"Incognizant"
        }
        PERSONALITY_TRAITS {
            "Brave" +2
            "Cruel" +2
        }
        COMBAT {
            "Bite (Vertically Divided)" INIT 2 ATTACK 6 DEFENSE 6 DAMAGE 3
            "Club (Vertically Divided)" INIT 3 ATTACK 7 DEFENSE 8 DAMAGE 5
            "Javelin (Vertically Divided)*" INIT 2 ATTACK 7 DEFENSE 7 DAMAGE 7
            "Bite (Cynocephalus)" INIT 0 ATTACK 7 DEFENSE 4 DAMAGE 1
            "Club (Cynocephalus)" INIT 1 ATTACK 8 DEFENSE 6 DAMAGE 3
            "Javelin (Cynocephalus)" INIT 0 ATTACK 8 DEFENSE 5 DAMAGE 5
        }
        ABILITIES {
            "Animal Handling" SCORE 3 SPECIALTY "dogs"
            "Awareness" SCORE 2 SPECIALTY "slaves"
            "Brawl" SCORE 2 SPECIALTY "bite"
            "Carouse" SCORE 1 SPECIALTY "on spoils of raid"
            "Faerie Speech" SCORE 4 SPECIALTY "making demands"
            "Hunt" SCORE 3 SPECIALTY "humans"
            "Ride" SCORE 5 SPECIALTY "sled"
            "Single Weapon" SCORE 4 SPECIALTY "club"
            "Survival" SCORE 3 SPECIALTY "icy conditions"
            "Thrown Weapon" SCORE 4 SPECIALTY "javelin"
        }
        DESCRIPTION "Cynocephalus characteristics: Int 0, Per +2, Pre –2, Com 0, Str 0, Sta +3, Dex +1, Qik 0. For the leader of a raiding party, add +3 to all Attack and Defense bonuses to represent superior Pretenses. * Missing eye not included. Equipment: Sled, team of dogs, furs, club, javelins. These faeries eat, although they do not die of starvation, and carry rations made by, or from, humans. The koerakoonlased are faeries of the frozen north, who sweep out of the storms into isolated human settlements to take prisoners. They march their captives north to their distant home, where the humans serve as slaves and as cattle. Individuals sometimes attack isolated farms, but raiding parties, usually made of up 12 koerakoonlased, more frequently attack settlements cut off from outside aid. Migrations involving clans with 40 warriors and their dependents have been reported. A koerakoonlane warrior usually fights with a club and javelins, and wears thick furs that provide limited protection. Most do not use shields. Many ride in sleds pulled by five dogs. When engaging in combat they may swiftly unharness their teams to allow them to attack a foe. This tactic is, however, rare. The warriors prefer to pursue and kill their own prey, and only unleash their dogs if they face skilled opposition, or if they need their dogs to chase down fleeing potential slaves. More-powerful koerakoonlased have been observed. Some act as war leaders, and these have the Spreading a Mantle of Snow Power. Unnatural snow is often the first warning that a raid is imminent. It allows the faeries to prepare the ground for their sleds, which they use as mounts for warfare, and to carry away booty. Others are able to apply the Kiss of Frost power with their whips. This allows the slaves of the koerakoonlased to survive their march into the northern wastes."
        REFERENCES {
            "Spreading a Mantle of Snow" -> #tuNP1YRuzjEbdtKfdjEA4sma ^"Spreading a Mantle of Snow"
            "Kiss of Frost" -> #tNRJ8EXo4F6Z0BrLjUKrYbGD ^"Kiss of Frost"
        }
    }
    #tsPR5eaY7MFtcd11YVmwoXxP ^"Dwarfs, Gnomes, & Goblins" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 5
            ^"Might Realm" STRING "Faerie" FIXED
            ^"Form" STRING "Terram"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER -3
                ^"Communication" INTEGER -2
                ^"Strength" INTEGER -1
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 4
            }
            ^"Soak" INTEGER 6
            ^"Wound Penalties" STRING "For Size –2: –1 (1-3), –3 (4-6), –5 (7-9), Incapacitated (10–12), Dead (13+); For Size –3: –1 (1-2), –3 (3-4), –5 (5-6), Incapacitated (7-8), Dead (9+); For Size –4: –1 (1), –3 (2), –5 (3), Incapacitated (4), Dead (5+); For Size –5: –3 (1), –5 (2), Incapacitated (3), Dead (4+)"
            ^"Vis" STRING "1 pawn, in main tool or body residue."
            ^"Appearance" STRING "In many areas, dwarfs are small bearded men. Dwarfish women may be hideous or beautiful, by region."
            ^"Source" STRING "Realms of Power: Faerie"
        }
        VIRTUES {
            ^"Immunity from Terram"
            ^"Great Characteristic"
            TIMES 2
            ^"Faerie Sight"
            ^"Faerie Speech"
            ^"Humanoid Faerie"
            ^"Improved Characteristic"
            TIMES 2
            ^"Observant"
        }
        FLAWS {
            ^"Little"
            NOTE "once or twice"
            ^"Traditional Ward"
            OF "offerings"
        }
        PERSONALITY_TRAITS {
            "Vengeful" +3
        }
        COMBAT {
            "Brawl (fist)" INIT 4 ATTACK 9 DEFENSE 11 DAMAGE 3
            "Pick/Tool (two handed)" INIT 7 ATTACK 8 DEFENSE 11 DAMAGE 11
        }
        ABILITIES {
            "Athletics" SCORE 2 SPECIALTY "digging"
            "Awareness" SCORE 2 SPECIALTY "hazards underground"
            "Bargain" SCORE 5 SPECIALTY "with mortals"
            "Brawl" SCORE 6 SPECIALTY "fist"
            "Craft (smith)" SCORE 5 SPECIALTY "weapons"
            "Great Weapon" SCORE 5 SPECIALTY "pick, as pole arm"
        }
        DESCRIPTION "Characteristics for Size –2: Str –1, Qik +4. For Size –3: Str –3, Qik +5. For Size –4: Str –5, Qik +6. For Size –5: Str –7, Qik +7. For every Size less than –2, subtract –2 Damage and add +1 Initiative and Defense. * Includes +1 for pretense specialization. Soak +6, Immunity from Terram. Powers: Many cause rock falls, but this may be through physically damaging the mine’s supports, rather than with a power. Some faeries seem to have the power to make people tiny, so that they can enter the faeries’ miniature subterranean kingdoms. Equipment: Professional gear. Dwarfs, gnomes, and goblins are subterranean versions of the small faeries described in other sections of this chapter. In many countries, the equivalent of a brownie is merely an antisocial dwarf who lives alone in a human homestead. The dwarfs in this section are those that live in communities that guard the entrances to the earth. They are found in caves, barrows (ancient tombs), and in mines. They also dwell in Arcadia. There are many legends of the gnomes, but they all seem to center on two facts: they are cunning smiths, and they have access to the treasures of the Earth. Dwarfs, like most faeries, lack the capacity to innovate. They can, however, make excellent versions of currently known things, remake items so that they appear magical, and create objects that express the inner natures of their owners. They are able to grant the External Vis Virtue to other faeries. The little folk known in many tales as having a pot of gold that they must surrender if caught are a type of dwarf. In Mythic Europe these creatures tend to dress in red, and sometimes have the habit of sending dreams that are addictive. They make their victim dig for treasure at a certain spot until they lose their profession, then their health, then their life. Some gnomes live just beneath the Earth, and are able to affect the fertility of plants, through their roots, leading to conventional affluence."
        REFERENCES {
            "External Vis" -> #tWtTlKRyGAohorFjb8CWnHqC ^"External Vis"
            "Mythic Europe" -> #tARMDefConceptMythicEurope ^"Mythic Europe"
        }
    }
    #tZPU90FusND4MfmLoe0dibws ^"Giants and Other Gigantic Humans" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 5
            ^"Might Realm" STRING "Faerie" FIXED
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 0
            }
            ^"Soak" INTEGER 3
            ^"Wound Penalties" STRING "Size +3: –1 (1-8), –3 (7-16), –5 (8-24), Incapacitated (25-32), Dead (33+); Size +5: –1 (1-10), –3 (11-20), –5 (21-30), Incapacitated (31–40), Dead (41+); Size +7: –1 (1-12), –3 (13-24), –5 (25-36), Incapacitated (37-48), Dead (49+)"
            ^"Vis" STRING "1/5th Might in human bones, Corpus"
            ^"Appearance" STRING "Huge men, usually uncivilized and bestial looking. There are female giants, but they tend to be beautiful and smaller than the males."
            ^"Source" STRING "Realms of Power: Faerie Bestiary"
        }
        VIRTUES {
            ^"Huge"
            SIZE "Major" TIMES 2 NOTE "at least twice"
            ^"Faerie Sight"
            ^"Faerie Speech"
            ^"Human Form"
            ^"Increased Might"
            NOTE "for a raider"
            ^"Place of Power"
            NOTE "for a giant the characters seek out in its lair"
        }
        FLAWS {
            ^"Incognizant"
        }
        PERSONALITY_TRAITS {
            "Destructive" +3
        }
        COMBAT {
            "Brawl (fist), Size 3" INIT -3 ATTACK 7 DEFENSE 3 DAMAGE 6
            "Club, Size 3" INIT -2 ATTACK 10 DEFENSE 5 DAMAGE 9
            "Thrown Rocks, Size 3" INIT -3 ATTACK 6 DEFENSE 1 DAMAGE 8
            "Brawl (kick), Size 5" INIT -6 ATTACK 7 DEFENSE 0 DAMAGE 13
            "Club, Size 5" INIT -4 ATTACK 10 DEFENSE 3 DAMAGE 13
            "Thrown Rocks, Size 5" INIT -5 ATTACK 6 DEFENSE -1 DAMAGE 12
            "Brawl (kick), Size 7" INIT -8 ATTACK 7 DEFENSE -2 DAMAGE 17
            "Club, Size 7" INIT -6 ATTACK 10 DEFENSE 1 DAMAGE 17
            "Thrown Rocks, Size 7" INIT -6 ATTACK 6 DEFENSE -3 DAMAGE 16
        }
        ABILITIES {
            "Awareness" SCORE 3 SPECIALTY "small moving things"
            "Brawl" SCORE 5 SPECIALTY "fist for Size +2 or +3, kick for larger"
            "Carouse" SCORE 2 SPECIALTY "drinking"
            "Faerie Speech" SCORE 5
            "Folk Ken" SCORE 3 SPECIALTY "threats"
            "Single Weapon" SCORE 6 SPECIALTY "club"
            "Thrown Weapon" SCORE 3 SPECIALTY "rocks"
        }
        DESCRIPTION "Huge humans — giants, ogres, trolls, and many others going by less-modern names — are a typical guard for any space in faerie stories. All of these huge humanoids use the statistics here, but are differentiated with powers and through superficial appearance. Faerie giants differ from Magical giants in several ways. Faerie giants are drawn to humans, despite the known danger from magi. They tend to cause terror and pain, so that they can harvest vitality. This makes them far more destructive than their Magical counterparts. Faerie giants also tend to recur: they regenerate unless their vis is used, so they plague regions periodically. Faerie giants often have daughters who are beautiful and human-sized, since this facilitates their role as love interest for heroes who come to slay the giant."
    }
    #tPJV6JDnKWAHzZ2v8GYm0qnD ^"Orms and Other Dragons" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 0
            ^"Might Realm" STRING "Faerie" FIXED
            ^"Form" STRING "Animal"
            ^"Size" INTEGER 0
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER -2
                ^"Presence" INTEGER -6
                ^"Communication" INTEGER -6
                ^"Strength" INTEGER 1
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 0
            }
            ^"Soak" INTEGER 6
            ^"Wound Penalties" STRING "Size –4: –1 (1), –3 (2), –5 (3), Incapacitated (4), Dead (5+); Size –2: –1 (1-3), –3 (4-6), –5 (7-9), Incapacitated (10–12), Dead (13+); Size 0: –1 (1-5), –3 (6-10), –5 (11-15), Incapacitated (16-20), Dead (21+); Size +2: –1 (1-7), –3 (8-14), –5 (15-21), Incapacitated (22-28), Dead (29+); Size +4: –1 (1-9), –3 (10-18), –5 (19-27), Incapacitated (28–36), Dead (37+); Size +6: –1 (1-11), –3 (12-22), –5 (23-33), Incapacitated (34-44), Dead (45+); Size +8: –1 (1-13), –3 (14-26), –5 (27-39), Incapacitated (37-52) Dead (53+)"
            ^"Vis" STRING "Might/5 pawns, in a snakeskin or a piece of lost string"
            ^"Appearance" STRING "Orms are vast snakes, normally smeared in toxic mucus."
            ^"Source" STRING "Realms of Power: Faerie Bestiary"
        }
        VIRTUES {
            ^"Huge or Little"
            NOTE "as suits size"
            ^"Faerie Beast"
            ^"Faerie Sight"
            ^"Faerie Speech"
            NOTE "If Intelligent. Cunning orms are Incognizant and lack Faerie Speech."
            ^"Highly Cognizant"
            ^"Increased Characteristics"
            ^"Increased Might"
            TIMES 3 NOTE "adjusted with size increase or decrease"
            ^"Personal Faerie Power"
            OF "Constant Damaging Effect"
        }
        PERSONALITY_TRAITS {
            "Inquisitive" +3
            "Hungry" +2
        }
        COMBAT {
            "Fangs, Size 0 (Init 0–Size, Defense +5–Size, Damage (2 x Size)+2)" ATTACK 14
            "Constriction, Size 0" INIT 0 ATTACK 9 DEFENSE 5 DAMAGE 8
            "Claws (if appropriate), Size 0" INIT -1 ATTACK 11 DEFENSE 10 DAMAGE 3
        }
        ABILITIES {
            "Area Lore" SCORE 3 SPECIALTY "watering points for prey"
            "Awareness" SCORE 3 SPECIALTY "prey"
            "Brawl" SCORE 7 SPECIALTY "crushing"
            "Hunt" SCORE 4 SPECIALTY "rodents"
            "Faerie Speech" SCORE 5 SPECIALTY "threats"
            "Folk Ken" SCORE 1 SPECIALTY "human prey"
            "Stealth" SCORE 3 SPECIALTY "stalking prey"
        }
        POWERS {
            ^"Constrict" DEF {
                PROPERTIES {
                    ^"Cost" STRING
                    ^"Initiative" STRING
                }
                DESCRIPTION "When successfully struck with a constrict attack, the character is encoiled and unable to use mêlée weapons. The orm automatically does damage in each subsequent round, without requiring an Attack roll. The victim may still Soak damage. At the end of each round, including the round in which the constriction attack succeeds, the character may attempt to break free by an opposed Strength roll. To do this, he rolls Strength + a stress die, and compares it to the orm’s Strength + a stress die. Success indicates he is free, and may attack normally in the following round. For each character assisting him to break free, he may add +1 to the Strength roll, but an assistant is unable to attack the orm in that round. A character unable to break free for 30 seconds (6 combat rounds) needs to make deprivation rolls, as described on page 179 of ArM5."
            }
            ^"Constant Damaging Effect" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "Many orms emit a noxious slime or have toxic breath, and poison their surroundings, but many other damaging effects are known. This effect does +5 Damage, but is always active. 25 spell levels (Base 5 +1 Part, +2 Sun, +1 Constant)"
            }
            ^"Venomous Bite" DEF {
                PROPERTIES {
                    ^"Cost" STRING
                    ^"Initiative" STRING
                }
                DESCRIPTION "When the orm attacks, compare its Attack Advantage to the victim’s armor Protection (not his Soak). If the orm’s advantage is higher, the victim suffers the effects of adder venom as listed in the Poison Table on page 180 of ArM5, regardless of whether the bite inflicts an actual wound. The storyguide may adjust the required Attack Advantage for special circumstances."
                REFERENCES {
                    "Poison Table" -> #tx5an6Dnupl80vEvCJHbjINO ^"Poison Table"
                }
            }
            ^"Flight" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "Qik+3"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "Gwibers and other flying orms also have a Personal Faerie Power: Flight, 0 points, Init Qik+3, Auram"
                REFERENCES {
                    "Faerie Power" -> #t84d15c61569668f6f97c5a ^"Faerie Power"
                }
            }
        }
        DESCRIPTION "Most of the dragons of Mythic Europe are Magical or Infernal creatures, but one class of dragons, termed orms, are predominantly faeries. Orms, which means “worms,” are usually faeries that take the role in the expectation that they will be destroyed. Orms can be distinguished from quite similar Magical dragons through their desire to eat vital things. Orms usually love cows’ milk, and some demand that peasants leave out great pails of it in tribute, much as brownies expect a dish of milk. Others simply suckle directly from cows. Some orms eat only virgins. Some orms drain the vitality out of their surroundings so severely that they seem to be poisoning the landscape. Many take residence around wells or springs."
        REFERENCES {
            "Mythic Europe" -> #tARMDefConceptMythicEurope ^"Mythic Europe"
        }
    }
    #tulZQDSmTYWLb9xLWh4dHRhg ^"Bloodcap Blood" DEF {
        EXTENDS #te111b4e360261e56d88f79 ^"Faerie Blood"
        PROPERTIES {
            ^"Stock" STRING "Bloodcap"
            ^"Source" STRING "Realms of Power: Faerie"
        }
        DESCRIPTION "Bloodcaps are frightening faeries of cruel winter who haunt the wildernesses where blood has been shed, drawn to violence and death. Children with bloodcap blood most often come about when a woman is held captive by one of these faeries and subjected to a terrifying imprisonment while the faerie feeds off her fear. It is said that one of Mercere’s grandchildren married a bloodcap in an unholy ceremony, and raised her children as Redcaps (see Houses of Hermes: True Lineages, pages 91, 104–105 for more details)."
    }
    #tsGM681VndZBSDnfLT54x0Cm ^"Varieties of Faerie Blood (introduction)" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Source" STRING "Realms of Power: Faerie"
        }
        DESCRIPTION "This section describes some common varieties of the Faerie Blood Virtue. It repeats and expands the information found on page 42 of ArM5, as well as adding new varieties. The specific benefit of possessing Faerie Blood of each type is listed, along with the enhanced version for those characters who have the Faerie Legacy Virtue."
        REFERENCES {
            "Faerie Blood" -> #t1nZXXugNY4VguZEkVj0BTj7 ^"Faerie Blood"
            "Faerie Blood" -> #t1nZXXugNY4VguZEkVj0BTj7 ^"Faerie Blood"
            "Faerie Legacy" -> #tlH8dsroAoHZozzOfd0YQ1xw ^"Faerie Legacy"
        }
    }
    #tJDCPiLpfVOHEDOfMhJHYsbQ ^"Brownie Blood" DEF {
        EXTENDS #te111b4e360261e56d88f79 ^"Faerie Blood"
        PROPERTIES {
            ^"Stock" STRING "Brownie"
            ^"Source" STRING "Realms of Power: Faerie"
        }
        DESCRIPTION "Couples that are fortunate to have a helpful faerie such as a brownie or portune would be wise to exercise caution before introducing a child to the family. Household faeries can be very jealous of babies and may take them in lieu of payment for their service. Such children, if retrieved, may bear the blood of a brownie. And even if it is wellinclined towards the child, the attention of a brownie can still taint an infant, leaving it with Faerie Blood. Characters with brownie blood are usually diligent by nature and hard workers. They often have an unnatural desire to help people out."
        REFERENCES {
            "Faerie Blood" -> #t1nZXXugNY4VguZEkVj0BTj7 ^"Faerie Blood"
        }
    }
    #tHAknW85bICOn5wMTkyUo49g ^"Dwarf Blood" DEF {
        EXTENDS #te111b4e360261e56d88f79 ^"Faerie Blood"
        PROPERTIES {
            ^"Stock" STRING "Dwarf"
            ^"Source" STRING "Realms of Power: Faerie"
        }
        DESCRIPTION "This variety of Faerie Blood can originate in any diminutive subterranean faeries. Dwarfs often make their homes close to mundane settlements. And mortals may profit from their labor, although not always with the consent of the dwarf. Subterranean faeries occasionally make charms that are bought or stolen from them. These charms induce fertility, health, or else are designed to ward a child from evil; but all can also cause Faerie Blood. Like their cousins the goblins, dwarfs are also prone to taking children in exchange for changelings."
        REFERENCES {
            "Faerie Blood" -> #t1nZXXugNY4VguZEkVj0BTj7 ^"Faerie Blood"
            "Faerie Blood" -> #t1nZXXugNY4VguZEkVj0BTj7 ^"Faerie Blood"
        }
    }
    #tfFwdYz9ex03TokLAdgTMwZC ^"Ettin Blood" DEF {
        EXTENDS #te111b4e360261e56d88f79 ^"Faerie Blood"
        PROPERTIES {
            ^"Stock" STRING "Ettin"
            ^"Source" STRING "Realms of Power: Faerie"
        }
        DESCRIPTION "Ettins (also called ogres or trolls) are common in the stories of Germanic people. They are brutish giants that usually range from Size +3 to +5. Female ettins — called \"troll-wives\" — can often be exceedingly beautiful. Troll-wives are particularly prone to take husbands among heroic men who impress them, and their children are often powerful magicians. Some troll-wives steal Gifted children rather than giving birth to them, then raise them as their own. Trollwives are usually no more than 3 points of Size from their husband, or else are capable of adopting a human-sized form. Characters with ettin blood must be careful in bright sunlight, since it is often painful or can even turn the character to stone until sunset, although only direct sunlight can have this effect."
    }
    #t4SyFRbVOyhZY2QpYdTuuqXN ^"Faerie God Blood" DEF {
        EXTENDS #te111b4e360261e56d88f79 ^"Faerie Blood"
        PROPERTIES {
            ^"Stock" STRING "Faerie God"
            ^"Source" STRING "Realms of Power: Faerie"
        }
        DESCRIPTION "Sometimes the gods of old — powerful faeries in their own right — had children with mortals, and legends abound with the stories of their exploits. Characters with this variety of Faerie Blood might be descendants of Zeus, Venus, Morrigan, Odin, Pelos, or any one of the host of the other gods of their people. With such noble blood in their veins, these characters rarely remain anonymous for long, and many believe that a great destiny lies before them. Picking Sympathy Traits appropriate to the specific god is very important, and they should relate to his or her principle attributes."
        REFERENCES {
            "Faerie Blood" -> #t1nZXXugNY4VguZEkVj0BTj7 ^"Faerie Blood"
        }
    }
    #tmnUYh9OWQUZQlX8LmPDmyMa ^"Ghul Blood" DEF {
        EXTENDS #te111b4e360261e56d88f79 ^"Faerie Blood"
        PROPERTIES {
            ^"Stock" STRING "Ghul"
            ^"Source" STRING "Realms of Power: Faerie"
        }
        DESCRIPTION "The ghula are rapacious wasteland faeries of the Arabic world. Sexual encounters between human men and female ghula result in either another ghula (if the child is a girl) or ghul-blooded humans (if a boy is born). The sons of ghula can then go on to produce either girls or boys with ghul blood. This variety of faerie blood could also represent other violent faerie ancestors. Those with ghul blood are nearly always sinister-looking, born with teeth, and unusually aware of their surroundings."
    }
    #t1rnXTiH54nGLnRBxkYWvHAw ^"Goblin Blood" DEF {
        EXTENDS #te111b4e360261e56d88f79 ^"Faerie Blood"
        PROPERTIES {
            ^"Stock" STRING "Goblin"
            ^"Source" STRING "Realms of Power: Faerie"
        }
        DESCRIPTION "\"Goblin\" is the general term for a subterranean faerie of a destructive bent such as those found in caves or mines. More generally it is used to denote a malicious faerie of short stature. Goblin Blood nearly always enters a human lineage through changelings who have been retrieved by their parents or else abandoned by the goblin troupe once the faeries lose interest."
    }
    #tlMofDZzpgVoTgqIJGt7p7yH ^"Huldra Blood" DEF {
        EXTENDS #te111b4e360261e56d88f79 ^"Faerie Blood"
        PROPERTIES {
            ^"Stock" STRING "Huldra"
            ^"Source" STRING "Realms of Power: Faerie"
        }
        DESCRIPTION "The huldra (plural huldrene) is a variety of nymph native to Scandinavian lands, also known as a skogsrå or tallemaja. The rarer male form is called a huldu or huldrekall. They are often exceedingly beautiful from the front, although their backs are hollow like a canoe. Huldrene never wear clothes, and have the tail of a cow. Their most distinctive feature is their power to disappear from sight and remain hidden when no-one is watching. A man can unknowingly marry a huldra and raise children with her, but she always eventually leaves him when he discovers her secret. Some huldrene are sexual predators, rewarding those who please them and killing those who disappoint. Others are guardians of morality; if a man is unfaithful to his wife with a huldra, then the faerie punishes him by causing him to father huldrablooded children."
    }
    #tak7nOUuxheGPGwM0bOpQgNV ^"Nymph Blood" DEF {
        EXTENDS #te111b4e360261e56d88f79 ^"Faerie Blood"
        PROPERTIES {
            ^"Stock" STRING "Nymph"
            ^"Source" STRING "Realms of Power: Faerie"
        }
        DESCRIPTION "Nymphs haunt the borders of human settlement, and are the archetypal sexual predator. They are particularly attracted to young men on the verge of adulthood, and occasionally seek out young heroes with whom to mate. A nymph who has a child herself is transformed into a different type of faerie altogether, and abandons the child with its father. Consequently, some nymphs chose not to directly have children; instead, an encounter with the nymph leaves a man both exceptionally lustful and especially virile, and he often conceives a child with a mortal woman while still under the faerie's influence. These children always have nymph blood. Nymphs also partake in wild parties with satyrs, and any girl children born to humans following such a party bear nymph blood."
    }
    #tAAWka5rfL0PD257LUAoaqbo ^"Padfoot Blood" DEF {
        EXTENDS #te111b4e360261e56d88f79 ^"Faerie Blood"
        PROPERTIES {
            ^"Stock" STRING "Padfoot"
            ^"Source" STRING "Realms of Power: Faerie"
        }
        DESCRIPTION "A padfoot is a faerie that takes the form of an immense black dog with glowing green eyes. Padfoots are commonly believed to be hostile to man, perhaps because a number of other faeries and demons take a similar form, but in actual fact they take it upon themselves to protect travelers from dangers such as treacherous bridges and bandits. Those whom they ward from these dangers are often terrified of the hound and oblivious of the danger they are in until later. Pregnant women who are protected by a padfoot may have a child who bears animal features."
    }
    #t1JDTZXY3zBHTOPHVJ2fU6qJ ^"Satyr Blood" DEF {
        EXTENDS #te111b4e360261e56d88f79 ^"Faerie Blood"
        PROPERTIES {
            ^"Stock" STRING "Satyr"
            ^"Source" STRING "Realms of Power: Faerie"
        }
        DESCRIPTION "Almost as common as mortal descendants of courtly faeries are those engendered by fauns and satyrs. These lustful faeries frequently force themselves on mortal women who meet them on the borders of the wilderness; but such encounters are about the sexual act, not procreation. However, on occasion satyrs and fauns hold bacchanalian parties with nymphs, and not all who attend are faeries. Mortal men and women are deliberately included in these orgies, although they are shrouded in the glamour to appear as fauns or nymphs, respectively. Children that are conceived at one of these parties have Faerie Blood — the boys have satyr blood and the girls have nymph blood."
        REFERENCES {
            "Faerie Blood" -> #t1nZXXugNY4VguZEkVj0BTj7 ^"Faerie Blood"
        }
    }
    #tV9bk0cQopznjXwmGFYcqbQw ^"Selkie Blood" DEF {
        EXTENDS #te111b4e360261e56d88f79 ^"Faerie Blood"
        PROPERTIES {
            ^"Stock" STRING "Selkie"
            ^"Source" STRING "Realms of Power: Faerie"
        }
        DESCRIPTION "Selkies and their close cousins the swanmaidens can be trapped by mortal men, and become their brides. They derive vitality from their families by acting the part of wife and mother, and raise children with selkie blood. Should the selkie gain her freedom from the marriage (and they almost always do), then the child is often left to fend for itself while the father fruitlessly searches for his wife."
    }
    #tQ6jzCQOR51mekyREGRfhCcI ^"Sidhe Blood" DEF {
        EXTENDS #te111b4e360261e56d88f79 ^"Faerie Blood"
        PROPERTIES {
            ^"Stock" STRING "Sidhe"
            ^"Source" STRING "Realms of Power: Faerie"
        }
        DESCRIPTION "The most common varieties of all Faerie Blood are derived from the courtly faeries, which in Ireland are called \"sidhe.\" Highly cognizant faeries of this type often seek out humans for the specific purpose of producing a child who partakes in the faerie's own nature. The Faerie Heritage Flaw is therefore particularly common among those with sidhe blood. Stories are told of Faerie Knights who have a passionate encounter with a mortal woman but who then leave, unaware of the child conceived of their lust. When, many years later, the son tracks down his father the faerie does the honorable thing and marries the woman he has shamed. More sinister are the glanconers who abduct maidens from their homes. The woman never returns, but occasionally a child might appear on the doorstep of its grandparents' home."
        REFERENCES {
            "Faerie Blood" -> #t1nZXXugNY4VguZEkVj0BTj7 ^"Faerie Blood"
            "Faerie Heritage" -> #tPShaqfkH1Ix0PfGIHHSzibN ^"Faerie Heritage"
        }
    }
    #tf2oQ6VURYCz2PzN0unnBhQf ^"Undine Blood" DEF {
        EXTENDS #te111b4e360261e56d88f79 ^"Faerie Blood"
        PROPERTIES {
            ^"Stock" STRING "Undine"
            ^"Source" STRING "Realms of Power: Faerie"
        }
        DESCRIPTION "Undines are those Courtly Faeries who inhabit rivers, particularly those rivers that form boundaries between countries or geographical features. They may be the progenitors of lineages of mortals in similar manner to other Courtly Faeries. Perhaps the most famous lineage of undine blood is that of the rulers of Lusignan castle, who had Mélusine as their ancestor. A character with undine blood often needs to be immersed in water regularly, or else he suffers ill effects. This variety of Faerie Blood can substitute for a water-inhabiting faerie such as a mermaid, although those faeries that can change shape are best treated as a variety of selkie blood instead."
        REFERENCES {
            "Faerie Blood" -> #t1nZXXugNY4VguZEkVj0BTj7 ^"Faerie Blood"
        }
    }
    # Realms of Power: Faerie is an EXTENSION on the arm5e edition, loaded
    # alongside the core rulebook (spec S13 composition). It declares the types
    # the supplement introduces that the core rulebook has no place for.
    # 
    # What it does NOT declare, deliberately:
    # - Virtues and Flaws. The book's 91 faerie Virtues and Flaws fit the core
    # ^"Virtue"/^"Flaw" types unchanged: their sizes are the same enum
    # (Minor / Major / Free / "Major or Minor" / Special) and their
    # categories (Supernatural, Social Interaction, General, Story, Hermetic)
    # are the same free-text category axis the core rulebook already uses.
    # There is no new axis to widen, so those files EXTEND ^"Virtue"/^"Flaw"
    # and DEPEND_ON ArM5_Core_Virtue_Flaw directly — no MODIFY here.
    # - Faerie creature stat blocks. The 37 statted faeries are ^"Creature"s
    # with a Faerie Might, so the bestiary file EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature" and
    # DEPENDS_ON ArM5_Core_Creature directly.
    # -------------------------------------------------------- Faerie Powers
    # Chapter Three's catalogue of the innate abilities a faerie buys with its
    # Might. 57 named powers filed under four kinds, which the book prints as
    # section headers: Ritual, Greater and Lesser, Focus, Personal. The Might
    # cost is kept BOTH as the printed string ("2 or more points", "10 points")
    # and, when the book gives a determinate number, as an integer, so a
    # consumer can total a faerie's Might expenditure without re-parsing prose.
    #t84d15c61569668f6f97c5a ^"Faerie Power" DEF {
        PROPERTIES {
            ^"Group" ENUM ["Ritual", "Greater and Lesser", "Focus", "Personal"] REQUIRED
            ^"Might Cost" STRING
            ^"Might Cost Value" INTEGER
            ^"Initiative" STRING
            ^"Form" STRING
            ^"Source" STRING DEFAULT "Realms of Power: Faerie"
        }
        DESCRIPTION "An innate faerie ability powered by Might. The book files each under one of four kinds (Ritual, Greater and Lesser, Focus, Personal) and states its Might cost, Initiative modifier and associated Hermetic Form."
        REFERENCES {
            "Hermetic Form" -> #tUEdmiz0IADMNt9MPAbcgRyn ^"Hermetic Form"
        }
    }
    # -------------------------------------------------------- Faerie Blood
    # Chapter Five's fourteen named faerie bloodlines (Bloodcap Blood, Nymph
    # Blood, ...). Each is a specific stock a character with faerie ancestry can
    # descend from, with its own bonuses. Kept distinct from the core rulebook's
    # single parameterised ^"Faerie Blood" Virtue: these are the enumerated
    # stocks that Virtue's subject ranges over, each with a full write-up.
    # -------------------------------------------------------- Story Elements
    # Chapter Seven's story-telling toolkit: 20 evocative elements filed under
    # Actors, Props and Scenery, each read three ways down a Path of Chance, a
    # Path of Destiny, or a Forking Path. The three readings are first-class
    # STRING properties (not one packed blob) so a storyguide can pull the
    # reading they want.
    #t810e46640b34c455bb72f7 ^"Story Element" DEF {
        PROPERTIES {
            ^"Group" ENUM ["Actors", "Props", "Scenery"] REQUIRED
            ^"Path of Chance" STRING
            ^"Path of Destiny" STRING
            ^"Forking Path" STRING
            ^"Source" STRING DEFAULT "Realms of Power: Faerie"
        }
        DESCRIPTION "An evocative element (an actor, a prop, or a piece of scenery) a faerie story can be built around, read three ways: down a Path of Chance, a Path of Destiny, or a Forking Path."
    }
    # ------------------------------------------------------- Faerie Wizardry
    # Chapter Six's rules for mortal wizards who bargain with, mimic, or wield
    # faerie power. 22 rules topics filed under five sections (Rites of Faerie,
    # Faerie Methods, Faerie Powers, Faerie Bargaining, Pagan Traditions).
    #t46b0e8b651dcf1476aad19 ^"Faerie Wizardry" DEF {
        PROPERTIES {
            ^"Section" STRING REQUIRED
            ^"Source" STRING DEFAULT "Realms of Power: Faerie"
        }
        DESCRIPTION "A rules topic from the Faerie Wizardry chapter, filed under one of its five sections."
    }
    # The level guidelines for the eight Faerie Wizardry powers (Beguile,
    # Conjure, Dream, Grant, Portage, Ware, Weal, Woe), read exactly like
    # Hermetic spell guidelines: a level and the effects available at it. A
    # single level often lists several distinct effects, kept as a LIST so none
    # is merged away.
    #tcdeb0b361edb7e888c3f31 ^"Faerie Wizardry Guideline" DEF {
        PROPERTIES {
            ^"Power" STRING REQUIRED
            ^"Level" STRING REQUIRED
            ^"Effects" LIST OF STRING
            ^"Source" STRING DEFAULT "Realms of Power: Faerie"
        }
        DESCRIPTION "A level guideline for one of the eight Faerie Wizardry powers: the level and the effects that can be achieved at it."
        REFERENCES {
            "Faerie Wizardry" -> #t46b0e8b651dcf1476aad19 ^"Faerie Wizardry"
        }
    }
    # -------------------------------------------------- Faerie Creature Note
    # The Faerie Bestiary chapter prints 37 full stat blocks (converted as
    # ^"Creature"s) interleaved with 57 prose passages that carry no stat block
    # of their own: variant write-ups ("Lamia Variants"), thematic groupings
    # ("Child Killers", "Protectors"), and sub-location notes. They are real,
    # enumerable bestiary content but the book gives them as prose, so they are
    # soft-statted here: a name, the verbatim passage, and — for a variant — the
    # base creature it varies. NEVER invented numbers.
    #t65b42046008183271439be ^"Faerie Creature Note" DEF {
        PROPERTIES {
            ^"Relates To" STRING
            ^"Source" STRING DEFAULT "Realms of Power: Faerie"
        }
        DESCRIPTION "A prose bestiary passage without a stat block of its own: a creature variant, a thematic grouping, or a sub-location note. Soft-statted verbatim; no numbers are invented."
    }
    # ------------------------------------------ Faerie Character Creation
    # Chapter Three's player-character build budget. The narrative procedure is
    # captured verbatim in armdef-rop-faerie-0.5-faerie-characters.lore; the
    # determinate numbers are ALSO recorded here (double-capture, as with the
    # Faerie Power Might costs) so a character-creation tool can read the budget
    # without re-parsing prose. Owner decision, 2026-07-31. No numbers invented.
    #tfae51c4ea70cre8budget001 ^"Faerie Character Creation" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Starting Might" INTEGER 5 FIXED
            ^"Characteristic Points" INTEGER 7 FIXED
            ^"Pretense Points Per Year" INTEGER 15 FIXED
            ^"Pretense Reference Age" INTEGER 5 FIXED
            ^"Pretense Points Base" INTEGER 120 FIXED
            ^"Default Magus Age" INTEGER 21
            ^"Default Pretense Points" INTEGER 360
            NOTE "15 × (21 − 5) + 120"
            ^"Companion Virtue Points" INTEGER 10 FIXED
            ^"Magus Free Virtues" INTEGER 1 FIXED
            ^"Magus Virtue Points" INTEGER 20 FIXED
            ^"Magus Virtues Per Flaw" INTEGER 2 FIXED
            ^"Source" STRING "Realms of Power: Faerie"
            ^"Page" INTEGER 45
        }
        DESCRIPTION "Faeries designed as player characters use values from the following formula. Replacing a Companion: up to 10 points of Virtues balanced by Flaws. Replacing a Magus: 1 free, then up to 20 points of Virtues paid for with Flaws at 2 Virtues per Flaw. The character has a number of Pretense points figured as follows: Pretense Points = 15 × (average age of magus player characters – 5) + 120 points. This multiplier may be changed by the Pretentious or Ostentatious Virtues, or Aloof Flaw. If the character’s physical form has any inherent Abilities, you must purchase Pretenses for those first. In Chapter 4: Faerie Bestiary, faeries designed for use as player characters assume that the magi in the campaign are 21 years old, which gives 360 points of Pretences. Player characters begin with a Faerie Might score of 5, which may be varied by selecting appropriate Virtues or Flaws during character creation. A character must have a Might score, a physical form, a level of cognizance, a Social Interaction Virtue, and a taboo."
    }
    #twfKfMXXYaYNzdb9BmhFQ3JC ^"Binding Oath" DEF {
        EXTENDS #t84d15c61569668f6f97c5a ^"Faerie Power"
        PROPERTIES {
            ^"Group" STRING "Ritual" FIXED
            ^"Might Cost" STRING "10 points, Init (Qik – 20), Vim"
            ^"Might Cost Value" INTEGER 10
            ^"Initiative" STRING "Init (Qik – 20)"
            ^"Form" STRING "Vim"
            ^"Source" STRING "Realms of Power: Faerie"
        }
        DESCRIPTION "Enforces the power of a solemnly sworn oath or contract between two or more parties. All parties must agree to the oath of their own free will, and the power must penetrate the Magic Resistance of all parties to take effect.

If one participant attempts to act in direct contravention to the oath, the other participants are immediately aware of this. Humans who attempt to break their oaths are given a warning. This warning often takes the form of a memory or sensation this is reminiscent of the faerie’s motif. If the human fails to understand, or disregards, this warning he suffers a Major or Minor Flaw at the discretion of the Troupe.

The Troupe should assign the Flaw based on the powers of the faerie, the nature of the oath, and the seriousness of the transgression within the framework of the story. This Flaw can be removed by powers that destroy mystical effects. The character may also end the Flaw by fulfilling the conditions of the oath, swearing a new oath with the wronged faerie, or destroying all of the oath’s other participants.

Faeries cannot break their oaths, although some roles allow them to seek loopholes and alternative interpretations.

Costs 50 levels. Special, No Hermetic equivalent (R: Touch, D: Mom, T: Group, Ritual)"
        REFERENCES {
            "Magic Resistance" -> #tmM1uJVBdvXpEsg4iImNPyjr ^"Magic Resistance"
        }
    }
    #t4RjYs7mrMVZLz3dPaxskwtE ^"Grant (Major Virtue)" DEF {
        EXTENDS #tbQ683ClGPQQ2UpLbIXsx7h3 ^"Common Magic Power"
        PROPERTIES {
            ^"Page" INTEGER 38
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "10 points, Init equal to (Qik – 20), Vim R: Touch, D: Mom, T: Ind, Ritual Imposes the named Major Virtue upon a target. Each creature may have more than one power of this type, each bestowing a different Virtue. The creature can decide to bestow the Virtue permanently or temporarily. If permanent, the power is a ritual-like power and costs points from the creature’s Might score as well as Might pool (see Ritual Power, below). If temporary, the Might points spent on this power are only recovered when its effects are withdrawn. No Hermetic equivalent: Ritual Power x 2 a Characteristic that is already +5 or more. This boost is applied before the character’s Strength and Quickness are adjusted for Size, so that a Size +2 and Quickness +3 character (Quickness +5 before Size is subtracted) who took this Quality could raise its Quickness to +4. This Quality may be taken more than once. Magical Meditation: This Quality gives the character the Supernatural Ability Magical Meditation at 1 (see New and Modified Abilities, below). Major Virtue: The character gains a Major Virtue, usually either General or Supernatural (Magic), to represent an advantage of its magical nature. Note that while this Quality may be taken more than once, only Virtues that allow a character to take them multiple times may be duplicated multiple times. Also, if a Virtue has requirements or restrictions on the characters who may take it, the magic character must meet them. For example, only a magic character with The Gift (or the Gifted Quality described above) can take Hermetic Virtues. Natural Appearance: The character appears to be a normal human being, with no traces of his magical nature. Just as the Gentle Gift hides all traces of The Gift in"
        REFERENCES {
            "Major Virtue" -> #tbJg1vLxjnfxLjK4caxuiyGt ^"Major Virtue"
            "Ritual Power" -> #tdQ93Crvoc8wGzRCRqAYgMKe ^"Ritual Power"
            "Ritual Power" -> #tdQ93Crvoc8wGzRCRqAYgMKe ^"Ritual Power"
            "Magical Meditation" -> #tUVmSPidFhAHJZElG4cK9pa8 ^"Magical Meditation"
            "Magical Meditation" -> #tBapzC9frzWETwU4EkhEh2X7 ^"Magical Meditation"
            "Major Virtue" -> #tbJg1vLxjnfxLjK4caxuiyGt ^"Major Virtue"
            "Major Virtue" -> #tbJg1vLxjnfxLjK4caxuiyGt ^"Major Virtue"
            "The Gift" -> #tl8PlKeRUtDRy1gIvS6afpp4 ^"The Gift"
            "Natural Appearance" -> #tu6sSYofNsoNt86VGKClg4Qv ^"Natural Appearance"
            "Gentle Gift" -> #tc41u2TzdGx1UBJfs3U158b7 ^"Gentle Gift"
            "The Gift" -> #tl8PlKeRUtDRy1gIvS6afpp4 ^"The Gift"
        }
    }
    #teFbuV969sAjGl2Yrlkbl0cW ^"Grant (Minor Virtue)" DEF {
        EXTENDS #tbQ683ClGPQQ2UpLbIXsx7h3 ^"Common Magic Power"
        PROPERTIES {
            ^"Page" INTEGER 39
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "5 points, Init equal to (Qik – 10), Vim R: Touch, D: Mom, T: Ind, Ritual Imposes the named Minor Virtue upon a target. Each creature may have more than one power of this type, each bestowing a different Virtue. The creature can decide to bestow the Virtue permanently or temporarily. If permanent, the power is a ritual-like power and costs points from the creature’s Might score as well as Might pool (see Ritual Power, above). If temporary, the Might points spent on this power are only recovered when its effects are withdrawn. No Hermetic equivalent: Ritual Power"
        REFERENCES {
            "Minor Virtue" -> #tMoVggISfKZjjEkUe53rxMUR ^"Minor Virtue"
            "Ritual Power" -> #tdQ93Crvoc8wGzRCRqAYgMKe ^"Ritual Power"
            "Ritual Power" -> #tdQ93Crvoc8wGzRCRqAYgMKe ^"Ritual Power"
        }
    }
    #t3byUsSRwGz0ADIcyBfu3mIe ^"Grant (Major Flaw)" DEF {
        EXTENDS #tbQ683ClGPQQ2UpLbIXsx7h3 ^"Common Magic Power"
        PROPERTIES {
            ^"Page" INTEGER 38
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "10 points, Init equal to (Qik – 20), Vim R: Touch, D: Mom, T: Ind, Ritual Imposes the named Major Flaw upon a victim. Each creature may have more than one power of this type, each bestowing a different Flaw. The creature can decide to bestow the Flaw permanently or temporarily. If permanent, the power is a ritual-like power and costs points from the creature’s Might score as well as Might pool (see Ritual Power, below). If temporary, the Might points spent on this power are only recovered when its effects are withdrawn. No Hermetic equivalent: Ritual Power x 2"
        REFERENCES {
