        PROPERTIES {
            ^"Size" STRING "Major" FIXED
            ^"Category" STRING "Supernatural" FIXED
            ^"Source" STRING "Hedge Magic [Revised Edition]"
        }
        DESCRIPTION "The folk witch can cast curses on other characters. She has a score of 1 in the Supernatural Ability Cursing (see later)."
    }
    #tGoBu4AP4aejKxsAJGksYBei ^"Painless Moon" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor" FIXED
