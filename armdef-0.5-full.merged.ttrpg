            ^"Form" STRING "Mentem" FIXED
            ^"Level" INTEGER 10 FIXED
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 4
            MODIFIERS {
                +2 "Voice"
            }
        }
        DESCRIPTION "The target becomes sleepy and falls asleep within a few seconds."
    }
    #t8PZVU0D5n6RQF6ptaOEhjNy ^"Snap of Awakening" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Mentem" FIXED
            ^"Level" INTEGER 10 FIXED
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 4
            MODIFIERS {
                +2 "Voice"
            }
        }
        DESCRIPTION "When you snap your fingers you instantly awaken the target from sleep to alert consciousness. Does not work on someone unconscious from Fatigue-level loss, wounds, or magic."
    }
    #tu5KXTrC8pVaaVG7CAQy1WHK ^"Confusion of the Numbed Will" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Mentem" FIXED
            ^"Level" INTEGER 15 FIXED
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 4
            MODIFIERS {
                +1 "Eye"
                +2 "Sun"
            }
        }
        DESCRIPTION "Confuses a person, who must make an Intelligence stress roll to take any direct action. A roll of 12+ ends the spell, while a roll of 9+ lets the character take the intended action, but the spell remains in effect. Any lower roll means the character is confused and takes some other type of action. When it is imperative for the victim to take an action, the storyguide should allow an appropriate modifier to the roll. While under this spell, a character always strikes last in combat and gets at least a –1 on all attacking and defending rolls."
    }
    #tgvpsNXRl3zxOC2HLHj1jwVO ^"Aura of Rightful Authority" DEF {
        EXTENDS #tL4MotIBVF5lx9HoVrT1yDlM ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 71
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "4 points, Mentem R: Eye, D: Sun, T: Ind This effect is used to overcome the shock caused by talking cats. It also inclines humans to obey orders. (20 spell levels: Base 5, +1 Eye, +2 Sun)"
    }
    #tTbQSzzSPM6xA2qd5nsEw1Zc ^"Coerce the Spirits of the Night" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Mentem" FIXED
            ^"Level" INTEGER 20 FIXED
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 5
            MODIFIERS {
                +2 "Voice"
                +1 "Conc"
            }
        }
        DESCRIPTION "Makes a ghost obey you as long as you can coerce it with threats, such as a threat to defile its grave or to banish it to Hell. The more lurid and dramatic the threat, the more cooperative the ghost is. If the spell penetrates the ghost's Magic Resistance, roll Communication + Leadership to see how effective your threats are. The storyguide should always give a bonus or penalty that depends on the potency of the threat, and any roll other than a botch will compel at least minimal obedience."
        REFERENCES {
            "Magic Resistance" -> #tmM1uJVBdvXpEsg4iImNPyjr ^"Magic Resistance"
        }
    }
    #t4QjwdxnaK1PaUCSTcd9cgnL ^"Scent of Peaceful Slumber" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Mentem" FIXED
            ^"Level" INTEGER 20 FIXED
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Room"
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 4
            MODIFIERS {
                +2 "Voice"
                +2 "Room"
            }
        }
        DESCRIPTION "Everyone in the room falls asleep over a few seconds, with the smell of lilacs in their nostrils."
    }
    #tW58DbrN0YGxUhC3KNNwgOsU ^"Visions of the Infernal Terrors" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Mentem" FIXED
            ^"Level" INTEGER 30 FIXED
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 10
            MODIFIERS {
                +2 "Voice"
                +2 "Sun"
            }
        }
        DESCRIPTION "Causes everything the target sees to look and sound terrifying. The world looks basically the same, save that everything is hideously transformed somehow. The target must roll a stress die, adding his Stamina and adding or subtracting an appropriate Personality Trait to see what the effects are. The nature of the Personality Trait used determines how it affects the Stamina roll. A Trait like Brave makes you resistant to fear, while one like Cowardly reduces the result of your roll."
        REFERENCES {
            "Personality Trait" -> #tcBZnRedWJ5vEcmMkio8kULU ^"Personality Trait"
            "Personality Trait" -> #tcBZnRedWJ5vEcmMkio8kULU ^"Personality Trait"
        }
    }
    #tiwjlAnT3gTcA0meU1eoI2lM ^"Enslave the Mortal Mind" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Mentem" FIXED
            ^"Level" INTEGER 40 FIXED
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 25
            MODIFIERS {
                +1 "Eye"
                +2 "Sun"
            }
        }
        DESCRIPTION "Enables you to completely control the loyalty, emotions, desires, interests, and activities of any person. People revert to normal when the spell ends, and may be extremely angry with the magus."
    }
    #tC7FJMvvqOlbUcqGJww1zm8b ^"Incantation of Summoning the Dead" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Mentem" FIXED
            ^"Level" INTEGER 40 FIXED
            ^"Range" STRING "Arcane Connection"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Ritual" BOOLEAN true
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 15
            MODIFIERS {
                +4 "Arc"
                +1 "Conc"
            }
        }
        DESCRIPTION "Calls up a person's ghost. You must be on the spot where the person died, or must have the corpse (either of these constitutes an Arcane Connection). Alternatively, you can summon any ghost that haunts the area you are in, if you know the ghost's full name, according to the Law of Names. Those buried by Church ceremony and those have who gone straight to heaven (that is, saints and crusaders, as opposed to the normal folk who must wait for a time before going on) are not available for summoning. This spell is a ritual because it can summon those who are beyond the mortal world, as long as they are not in heaven. If the ghost has Magic Resistance, you must penetrate that resistance in order to summon it."
        REFERENCES {
            "Magic Resistance" -> #tmM1uJVBdvXpEsg4iImNPyjr ^"Magic Resistance"
        }
    }
    #t7xGfVnGhAbwcvofEsR4C8x6 ^"The Shrouded Glen" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
