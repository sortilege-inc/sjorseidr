            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "The lab is lacking even basic defenses, and is easily broken or stumbled into. For example, it is on the ground floor and has no door. –1 Aesthetics."
    }
    #tY2RpCqsjzxmNG8nkB75V4Z4 ^"Awkward Shape" DEF {
