            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "The lab is home to a haunting spirit, who occasionally disturbs the current owner."
    }
    #tIGWj6D194x0BXPRN8Jl5ulm ^"Impregnable (Lab Flaw)" DEF {
        EXTENDS #tlMBbzhtlHSbThf38A5xinnb ^"Laboratory Flaw"
        PROPERTIES {
            ^"Magnitude" STRING "Free" FIXED
            ^"Category" STRING "Supernatural" FIXED
            ^"Modifiers" STRING "–2 Aesthetics."
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "The lab is completely inaccessible, except through reasonably powerful magic. For example, it is blocked off by a stone wall and requires a Muto Terram spell to access. While the owner is much less likely to be disturbed, fewer people will ever get to see the lab, or they may assume that the owner is rather paranoid."
    }
    #tBKS2XPd6eatNg2JbQpbdK9M ^"Inhabitants (Lab Flaw)" DEF {
