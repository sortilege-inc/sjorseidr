            +5
            "Hasty"
            +2
        }
        COMBAT {
            "Kick (brawl)"
            INIT 4
            ATTACK 8
            DEFENSE 9
            DAMAGE 5 "Horns (brawl)"
            INIT 3
            ATTACK 9
            DEFENSE 6
            DAMAGE 6 "Spear"
            INIT 4
            ATTACK 7
            DEFENSE 6
            DAMAGE 7 "Spear (thrown)"
            INIT 2
