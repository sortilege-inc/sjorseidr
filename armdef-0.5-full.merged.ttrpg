    # Torvus: William’s Falcon Familiar (Chapter Four: The Oracles of Didyma, p81): a familiar, its stat lines verbatim fields.
    #t588a6e0ccaff97c3ea4ce0 ^"Torvus: William’s Falcon Familiar" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Covenant" LIST [#te665861b28dd8521c67fe4 ^"Didyma"]
            ^"Might Realm" STRING "Magic" FIXED
            ^"Season" STRING "Summer"
            ^"Might" INTEGER 12
            ^"Form" STRING "Auram"
            ^"Characteristics" STRING "Int 0, Per +3, Pre –1, Com 0, Str –6, Sta –1, Dex +1, Qik +6 Size: –3 Confidence Score: 1(3)"
            ^"Virtues and Flaws" STRING "Magic Friend; Magic Animal; Educated, Keen Vision, True Friend (William), Unaffected by The Gift; Avaricious; Blackmail, Fragile Constitution."
            ^"Qualities" STRING "Greater Power (The Cloudless Sky Returned); Gift of Speech, Lesser Power (Sailor’s Foretaste of the Morrow), Personal Power (Shriek of the Impending Shafts), Personal Power x2 (Sight of the True Form)"
            ^"Animal Qualities" STRING "Accomplished Flier, Fast Flier, Keen Eyesight, Pursuit Predator, Extra Natural Weapons."
            ^"Reputations" LIST ["Thief 2 (local)"]
            ^"Combat" STRING "Talons: Init +5, Attack: +6, Defense: +12, Damage: –4 Beak: Init +6, Attack: +6, Defense: +9, Damage: –5"
            ^"Soak" STRING "+1 (Sta + Bronze Cord)"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–2), –3 (3–4), –5 (5–6), Incapacitated (7–8), Dead (9+)"
            ^"Powers" STRING "Location: (both ways) Invested in familiar bond (ArM5, page 105). Mental Communication: (both ways) Invested in familiar bond (ArM5, page 105). Sailor’s Foretaste of the Morrow: 3 points, Init +2, Auram: As the Hermetic spell (ArM5, page 127). Lesser Power (20 Levels; –1 Might Cost) Shriek of the Impending Shafts: 0 points, Init +4, Herbam: As the Hermetic spell (ArM5, page 136). Personal Power (15 Levels; –2 Might Cost) Sight of the True Form: 0 points, Init +4, Corpus: Equivalent to the Hermetic spell at level 15, but constant effect (ArM5, page 130). Personal Power2 (30 Levels; –3 Might Cost, +1 Init) The Cloudless Sky Returned: 4 points, Init +1, Auram: As the Hermetic spell (ArM5, page 128). Greater Power (45 Levels, –1 Might Cost)"
            ^"Equipment" STRING "None."
            ^"Vis" STRING "3 pawns of Auram in tail feathers."
            ^"Appearance" STRING "A brown falcon with a three foot wing-span, Torvus is a hoarder of fascinating objects, and he has several stashes of objects on and under the roofs of the Didyma temples. Among his hoard are documents which reveal corruption by the tax officials in Miletos - unbeknown to William, Torvus is using this information to blackmail the head tax official, Leander."
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 81
        }
        PERSONALITY_TRAITS {
            "Hoarder" +6
            "Falcon (essential)" +3
        }
        ABILITIES {
            "Area Lore: Constantinople" SCORE 1 SPECIALTY "from above"
            "Area Lore: Normandy" SCORE 3 SPECIALTY "from above"
            "Area Lore: Theban Tribunal" SCORE 3 SPECIALTY "from above"
            "Artes Liberales" SCORE 1 SPECIALTY "astronomy"
            "Athletics" SCORE 5 SPECIALTY "flight"
            "Awareness" SCORE 4 SPECIALTY "prey"
            "Brawl" SCORE 2 SPECIALTY "talons"
            "Code of Hermes" SCORE 1 SPECIALTY "familiars"
            "Dead Language: Latin" SCORE 4 SPECIALTY "Hermetic usage"
            "Guile" SCORE 1 SPECIALTY "magi"
            "Faerie Lore" SCORE 2 SPECIALTY "traditions"
            "Legerdemain" SCORE 3 SPECIALTY "picking pockets"
            "Living Language: Low German" SCORE 2 SPECIALTY "military usage"
            "Living Language: French" SCORE 5 SPECIALTY "Norman"
            "Living Language: Romaic Greek" SCORE 2 SPECIALTY "Hermetic usage"
            "Magic Lore" SCORE 2 SPECIALTY "monsters"
            "Magic Theory" SCORE 3 SPECIALTY "Auram"
            "Organization Lore: Didyma" SCORE 1 SPECIALTY "structures"
            "Stealth" SCORE 2 SPECIALTY "hiding hoard"
            "Survival" SCORE 3 SPECIALTY "cold"
        }
        DESCRIPTION "Torvus is a fast flyer and has a +3 bonus to rolls involving speed. The Familiar Bond was forged with an InAu Lab Total of 20. The Cords are: +1 Gold, 0 Silver, +2 Bronze."
    }
    # The chapter's vis sources, structured; each DESCRIPTION the source's text, verbatim.
    #t230b58eaef32cb400c94bb ^"Arab Market" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Muto"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 96
        }
        DESCRIPTION "*5 pawns Muto vis per year (25 BP).* Some spices in the bustling, scented Arab market contain vis and Callista regularly uses the Spice Wand (see items) to search the market for the vis-rich spices. Some years, more than 5 pawns of vis is found."
    }
    #tc862e763d0d6aa37bf5f3a ^"Harvest of Aftonsitiron" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Creo"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 96
        }
        DESCRIPTION "*7 pawns Creo vis per year (35 BP).* Aftonsitiron is a small village, a mile north of Miletos, that has fertile soils and abundant barley harvests. Some of the barley contains vis, which the covenant grogs search for by walking through the swaying fields with the Vis Divining Rods. The lucky farmers who grow the vis are paid one silver coin per pawn by the covenant. The farmers are perfectly happy with this arrangement as one silver coin for a handful of barley stalks is a fabulous price."
    }
    #te6406a744c41a999aba0ee ^"Hunt (Through the Aegis)" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Printed Name" STRING "Hunt"
            ^"Art" STRING "Animal, Aquam"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 96
        }
        DESCRIPTION "*Variable pawns of Form vis per year (80 BP).* Every summer faerie animals leave the Sacred Way entering the Didyma plain, and are then hunted by Herakles and William for their vis.

This source is worth a variable amount depending on the creatures hunted. Unless the troupe has a story need for particular faerie creatures (for example, if the player characters are hunting) roll two simple dice three times to determine the vis gathered. The first die in each pair indicates the vis Form type (1 = Animal, 2 = Aquam, etc) and the second die indicates the number of pawns of that type. The total haul of vis therefore varies between 3 and 30 pawns. It is faerie tainted."
    }
    #t3cd8076246102b0fc72c95 ^"Mouth of the Meander River" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Aquam"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 96
        }
        DESCRIPTION "*3 pawns Aquam vis per year (15 BP).* North of Miletos is the mouth of the Meander river, the source of the silt that the covenant clears from Lion Harbor. In spring, the river floods a large delta-plain, and the first flood waters contain 3 pawns of Aquam vis. The Vis Net is used to collect this vis, and the timing of the flood waters is predicted astrologically by Ariane (Int + Artes Liberales (astronomy) roll against an Ease Factor of 6). Grogs usually do the actual collection."
    }
    #td45c23618503d432297221 ^"Sacred Springs" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Intellego"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 96
        }
        DESCRIPTION "*13 pawns Intellego vis per year (65 BP).* The Sacred Springs (within the covenant enclosure) are worth 13 pawns of Intellego vis per year (one pawn each full moon). Ariane collects this vis with The Vis Net."
    }
    # William of Normandy: House Flambeau (Chapter Four: The Oracles of Didyma, p81): one character, its stat lines verbatim fields.
    #t833e8674f1a140fc4ca61e ^"William of Normandy: House Flambeau" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#te665861b28dd8521c67fe4 ^"Didyma"]
            ^"Characteristics" STRING "Int 0, Per +2(2), Pre 1(1), Com 0, Str +1(1), Sta +1(1), Dex +1(1), Qik +2(2)"
            ^"Size" STRING "0"
            ^"Age" STRING "55 (54; –2 Longevity Ritual, –2 Bronze Cord)"
            ^"Decrepitude" STRING "1 (3)"
            ^"Warping Score" STRING "4 (21)"
            ^"Confidence Score" STRING "2 (5)"
            ^"Virtues and Flaws" STRING "The Gift; Hermetic Magus; Gentle Gift; Improved Characteristics, True Friend (Torvus), Puissant Perdo, Quiet Magic, Quiet Magic, Self-Confident, Subtle Magic, Warrior, Well-Traveled; Ambitious (greatest monster slayer), Difficult Longevity Ritual, Difficult Underlings; Vow (to never kill a man). House Virtues/Flaws Gained via Familiar Bond (does not need to be balanced with a Flaw)."
            ^"Personality Trait" STRING "Ambitious +6, Brave +3"
            ^"Reputations" STRING "Monster Slayer 2 (Hermetic)"
            ^"Combat" STRING "Fist: Init +2, Attack +4, Defense +5, Damage +1 Long Sword & Shield: Init +4, Attack +11, Defense +11, Damage +7 Lance & Shield: Init +4, Attack +13, Defense +12, Damage +6 Pole-Axe: Init +3, Attack +11, Defense +7, Damage +12 Short Bow: Init +1, Attack +8, Defense +6, Damage +7 Includes +3 Mounted Bonus"
            ^"Soak" STRING "+13 (Sta + Armour + Bronze Cord)"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –2 (6–10), –3 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Animal Handling 1 (horse), Area Lore: Constaninople 1 (crusaders), Area Lore: Miletus 2 (creatures), Area Lore: Normandy 3 (nobles), Artes Liberales 1 (astronomy), Athletics 2 (running), Awareness 4 (creatures), Bow 3 (short bow), Brawl 2 (fist), Code of Hermes 1 (vis rights), Concentration 3 (spells), Dead Language: Latin 4 (Hermetic usage), Etiquette 1 (nobles), Finesse 2 (items), Folk Ken 2 (nobles), Great Weapon 4 (pole axe), Guile 1 (fast talk), Hunt 4 (mythic creatures), Leadership 5 (combat), Living Langauge: Low German 2 (military usage), Living Language: French 5 (Norman), Living Language: Romaic Greek 2 (Hermetic usage), Magic Lore 3 (creature weaknesses), Magic Theory 4 (items), Organisation Lore: Order of Hermes 2 (monster hunters), Parma Magica 6 (Corpus), Penetration 3 (Vim), Ride 3 (horse), Single Weapon 5 (long sword), Stealth 2 (sneaking), Swim 2 (river)"
            ^"Arts" STRING "Cr 7, In 6, Mu 8, Pe 7+3, Re 7; An 6, Aq 5, Au 5, Co 17, He 6, Ig 7, Im 5, Me 5, Te 7, Vi 7"
            ^"Twilight Scars" STRING "Different colored eyes (one blue, one brown), and his hair crackles with static electricity. In darkness flashes of light can be seen flowing over his head."
            ^"Casting Sigil" STRING "The spectacular, but harmless, discharge of electricity."
            ^"Voting Sigil" STRING "A falcon’s feather made of silver."
            ^"Equipment" STRING "Long sword, round shield, pole-axe, lance, short bow and arrows, breastplate (talisman) and mail armor with helm, and warhorse. A collection of magic arrows (see below). Note: William only carries the weapons he is immediately using. The rest are carried by his warhorse Lambert."
            ^"Encumbrance" STRING "3 (4)"
            ^"Spells Known" STRING "Image of the Beast (InAn 5/+13) Bind Wound (CrCo 10/+25) Purification of the Festering Wounds (CrCo 20/+25) The Chirurgeon’s Healing Touch (CrCo 20/+25) Eyes of the Cat (MuCo(An) 5/+15) Gift of the Bear’s Fortitude (MuCo 25/+26) Grip of the Choking Hand (PeCo 25/+28) Blade of the Virulent Flame (CrIg 15/+15) Quell the Scent (PeIm 10/+16) Words of the Unbroken Silence (CrMe 10/+13) Wizard’s Vigil (MuVi 20/+16) Demon’s Eternal Oblivion (PeVi 5/+18) End of the Titans (Magic equivalent of Demon’s Eternal Oblivion) (PeVi 5/+18) Faerie Bane (Faerie equivalent of Demon’s Eternal Oblivion) (PeVi 5/+18) Personal Ward Against Demons (R: Touch, D:

Sun, ReVi 10/+15) Personal Ward Against Faeries (R: Touch, D:

Sun, ReVi 10/+15) Personal Ward Against Magic Creatures (R:

Touch, D: Sun, ReVi 10/+15) Gather the Essence of Beast (ReVi 15/+15)"
            ^"Vis" STRING "None."
            ^"Appearance" STRING "William is a magus of House"
            ^"Familiar" LIST [#t588a6e0ccaff97c3ea4ce0 ^"Torvus: William’s Falcon Familiar"]
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 81
        }
        DESCRIPTION "Flambeau, of the school of Ramius, and of the Normandy Tribunal. He has wild red hair, which crackles and sparks with static discharges (a Twilight scar), and is determined to be the greatest hunter of magic and faerie creatures. Since the bloody siege of Constantinople, William has sworn to never kill a human (again). His familiar is a kleptomaniac falcon named Torvus.

William originally came to the Theban Tribunal in the wake of the Crusaders who besieged Constantinople in 1204. He has since befriended Herakles and the pair hunt together. William also commands a small band of mercenaries who followed him from Normandy. William is unmarried and his soldiers quietly joke among themselves about his apparent close relationship with Herakles."
    }
    # The chapter's boons hooks, structured; each DESCRIPTION the source's text, verbatim.
    #tdfbb91305dd026bafe339d ^"Aura (Longmist)" DEF {
        EXTENDS #tARMDefCompatCovenantBoon ^"Covenant Boon"
        PROPERTIES {
            ^"Printed Name" STRING "Aura (Major Boon)"
            ^"Magnitude" STRING "Major"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "The mundane world contains only part of Longmist. The magi live and work in a tower that exists within a regio that sits atop the old covenant buildings, which have long been left to the covenfolk. Within this regio, which contains the main tower, the aura rises to six. An enchanted doorway provides a permanent route into the regio, so it is modeled here as an increased localized aura rather than by taking the Regio Boon."
    }
    #t10ac7bd19bb32188a064f4 ^"Magical Fortress (Longmist)" DEF {
        EXTENDS #tPQREJGlOrY8wo68HSSX9qvZ ^"Magical Fortress"
        PROPERTIES {
            ^"Printed Name" STRING "Magical Fortress (Major Boon)"
            ^"Magnitude" STRING "Major"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "This is a tall tower raised from within the regio. The

tower was conjured through ritual during Longmist’s long summer and is the work of a long-since dead Verditius specialist."
    }
    #t312b56dd7e4568f69bb853 ^"Mystical Allies (Longmist)" DEF {
        EXTENDS #tK2Pi5dsyhgEWadFeCliDjNA ^"Mystical Allies"
        PROPERTIES {
            ^"Printed Name" STRING "Mystical Allies (Major Boon)"
            ^"Magnitude" STRING "Major"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "Longmist’s name carries weight with the Fir Bolg of Ireland, with airy spirits of the land and sky, and with the non-Hermetic druids of Connacht."
    }
    #t94c3a5bc20b4ba49bc729d ^"Aura x2 (Longmist)" DEF {
        EXTENDS #tARMDefCompatCovenantBoon ^"Covenant Boon"
        PROPERTIES {
            ^"Printed Name" STRING "Aura x2 (Minor Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "The covenant’s general aura is five."
    }
    #t195e2b81984054f6718c30 ^"Seclusion (Longmist)" DEF {
        EXTENDS #tARMDefCompatCovenantBoon ^"Covenant Boon"
        PROPERTIES {
            ^"Printed Name" STRING "Seclusion (Minor Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "Long before the Normans came to Ulaid, the people of that land learned not to interfere with the druids of the long mists, and so the covenant receives few visitors to the valley that shrouds it."
    }
    #t27fb1516179b237d4c4211 ^"Divided Loyalty (Longmist)" DEF {
        EXTENDS #tyAKoGt7FTzfGTQpPHYgrz1E ^"Divided Loyalty"
        PROPERTIES {
            ^"Printed Name" STRING "Divided Loyalty (Major Hook)"
            ^"Magnitude" STRING "Major"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "The remaining covenfolk have loyalty to one of the two elder magi of Longmist. They hope to receive favor by supporting one over the other. This extends to the younger magi too, and perceived allies of one elder magus may be treated with suspicion by servants of the other."
    }
    #t4393fc971b6ce611768855 ^"Fractured Council (Longmist)" DEF {
        EXTENDS #ty7lueI0Gm2WEWrzKDcAaUit ^"Fractured Council"
        PROPERTIES {
            ^"Printed Name" STRING "Fractured Council (Major Hook)"
            ^"Magnitude" STRING "Major"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "The council is in deadlock. The position of princeps is vacant and both of the elder magi desire it. The younger magi may be called upon to undertake tasks for these opposing masters and must chart a careful course between them."
    }
    #t33a7df9766f6a4ab844de7 ^"Contested Resource (Longmist)" DEF {
        EXTENDS #tARMDefCompatCovenantHook ^"Covenant Hook"
        PROPERTIES {
            ^"Printed Name" STRING "Contested Resource (Minor Hook)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "All Hibernian covenants must have a Cathach, or trophy, to prove their connection to Ireland and their worthiness to hold their lands. It must be kept outside the Aegis as a challenge to those who would test themselves against the covenant. In this case, Longmist’s Cathach is the pelt of a Bjornaer magus, ancestor to a covenant of Bjornaer wolves. The continued display of the pelt is an insult that has never been forgiven."
    }
    #t54fc1e7a4313ba9c14cedf ^"Crumbling (Longmist)" DEF {
        EXTENDS #tRwMRUb5UxjUdONUHoS3HkZq ^"Crumbling"
        PROPERTIES {
            ^"Printed Name" STRING "Crumbling (Minor Hook)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "The covenant is poorly-maintained, with plaster and mortar flaking from the walls, gates rusted shut, and doors and window shutters warped and ill-fitting."
    }
    #t445e326f27163fbc1f9920 ^"Deathbed Visitor (Longmist)" DEF {
        EXTENDS #tXEttjWlLgyfqAeFIzAI3apN ^"Deathbed Visitor"
        PROPERTIES {
            ^"Printed Name" STRING "Deathbed Visitor (Minor Hook)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "The local Ulaidh people fear the cry of the banshee as it heralds a doom. There are few things that would drive the mundane to the walls of Longmist, but the ungodly wail foretelling death is one of them. The covenant itself is not immune from the banshee’s power and it may be heard circling the valley, portending the death of one of the covenfolk. If the magi can capture the banshee, however, they may be able to prevent the death."
    }
    #tfd2c332d33cc2a0a314f9e ^"Dwindling Resource (Longmist)" DEF {
        EXTENDS #tARMDefCompatCovenantHook ^"Covenant Hook"
        PROPERTIES {
            ^"Printed Name" STRING "Dwindling Resource (Minor Hook)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "For years, the walls of Longmist have produced raw Vim vis. But the yield has recently been falling. Whether this is because the aura is generating less vis or the covenfolk have become less adept at finding it isn’t clear. This Hook applies to the From the Very Walls Themselves vis source as described later. From the start of play, the source loses 10% of its yield each year."
    }
    #t31299c6d30c8dc580cb70e ^"Faerie Court (Longmist)" DEF {
        EXTENDS #tsTPGzaRIVVwxKBDDacyIi4L ^"Faerie Court"
        PROPERTIES {
            ^"Printed Name" STRING "Faerie Court (Minor Hook)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "The kings and princes of the Túatha Dé Danann take an active interest in the magi of Longmist, especially Conchobor and those who support him. They provide service to Conchobor, including maintaining a watch over the Cathach, but they frequently ask for service in return."
    }
    #t0f7d5073174a5129daa0af ^"Superiors (Longmist)" DEF {
        EXTENDS #tARMDefCompatCovenantHook ^"Covenant Hook"
        PROPERTIES {
            ^"Printed Name" STRING "Superiors (Minor Hook)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "The younger magi have few rights over the covenant’s resources. Requests for access or use must be put before the council and an inquorate council or veto from an elder means that the resource may be withheld. Negotiation and service is often required."
    }
    #tacdfdcb13e5975d3e35a9e ^"Criminals (Clan Mac Tire)" DEF {
        EXTENDS #tDNR0bn2wc1Ki76qHPEnwgsC ^"Criminals"
        PROPERTIES {
            ^"Printed Name" STRING "Criminals (Minor Residents Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "Residents"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Clan Mac Tire"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 119
        }
        DESCRIPTION "Not only do the magi raid the resources belonging to other covenants, but they offer a haven to mundane criminals and outlaws."
    }
    #t8b414f8f1466e81acf8176 ^"Difficult Access (Clan Mac Tire)" DEF {
        EXTENDS #toHkLxXYLWDAlAKCggYRkMTu ^"Difficult Access"
        PROPERTIES {
            ^"Printed Name" STRING "Difficult Access (Minor Fortifications Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "Fortifications"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Clan Mac Tire"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 119
        }
        DESCRIPTION "Many of the booley villages that the covenant uses are built on islands in the middle of lakes, which provides protection against intrusion. As the covenant seeks out those with Magical auras, some even host regiones, which offer even more protection."
    }
    #tfa9004ad6ab0fb99fd5f2d ^"Informants (Clan Mac Tire)" DEF {
        EXTENDS #t1YjWMwPZtiUAJ4FDbW5y8D7 ^"Informants"
        PROPERTIES {
            ^"Printed Name" STRING "Informants (Minor External Relations Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "External Relations"
