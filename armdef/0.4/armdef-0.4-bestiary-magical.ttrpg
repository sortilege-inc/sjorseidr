    #tI1oSX2qK15EHMucWW613G4k ^"A Fire Elemental" DEF {
        EXTENDS ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 15
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Ignem"
            ^"Size" INTEGER 0
