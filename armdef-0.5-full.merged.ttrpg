            ^"Page" INTEGER 94
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "1 point, Init (Qik – 4), Mentem R: Per, D: Conc, T: Ind The character becomes incorporeal, like a ghost, and is able to pass through solid objects and ignore physical damage. MuCo(Me) 35 (base 30, +1 Conc): Greater Power (35 levels, –3 Might cost)"
        REFERENCES {
            "Greater Power" -> #tI9yiBqA2pLll1mfoJpQrwzX ^"Greater Power"
