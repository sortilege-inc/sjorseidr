            PROPERTIES {
                ^"Magnitude" STRING "Free" FIXED
                ^"Category" STRING "Supernatural" FIXED
                ^"Modifiers" STRING "–2 Aesthetics."
                ^"Source" STRING "Core Rules"
            }
