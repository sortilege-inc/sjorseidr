            ^"Group" STRING "Structure" FIXED
            ^"Repeatable" BOOLEAN false
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "The lab or its entrance is protected by some mundane concealment, such as a hidden door. –1 Aesthetics."
    }
    #tMxvXhxwpW8IHCW7hhrynt9q ^"Empty" DEF {
