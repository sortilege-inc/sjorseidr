            "Awareness" SCORE 6 SPECIALTY "hunters"
            "Brawl" SCORE 5 SPECIALTY "bite"
            "Stealth" SCORE 5 SPECIALTY "when being hunted"
        }
        POWERS {
            ^"Spirit Away" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "n/a"
