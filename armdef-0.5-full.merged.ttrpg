            "Guile" SCORE 2 SPECIALTY "excuses"
            "Hunt" SCORE 2 SPECIALTY "birds"
            "Leadership" SCORE 2 SPECIALTY "in combat"
            "Native Language" SCORE 5 SPECIALTY "cursing"
