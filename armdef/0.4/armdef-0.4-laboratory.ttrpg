                ^"Category" STRING "Supernatural" FIXED
                ^"Modifiers" STRING "+1 Warping, –1 Aesthetics; +2 Me."
                ^"Source" STRING "Core Rules"
            }
            DESCRIPTION "The lab is home to a haunting spirit, who occasionally disturbs the current owner."
        }
        #tIGWj6D194x0BXPRN8Jl5ulm ^"Impregnable (Lab Flaw)" DEF {
