        }
        LEVEL_CALCULATION {
            BASE 1
            MODIFIERS {
                +4 "Arc"
                +1 "Conc"
                +2 "Room"
            }
        }
        DESCRIPTION "You can hear what is happening in the place you designate. You must have an Arcane Connection with the place or with a person there."
    }
    #t3G6jdRZWyGkPbmgMPFGPz7Y ^"Eyes of the Eagle" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego" FIXED
            ^"Form" STRING "Imaginem" FIXED
            ^"Level" INTEGER 25 FIXED
            ^"Range" STRING "Personal"
