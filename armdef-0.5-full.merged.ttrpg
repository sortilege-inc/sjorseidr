    #ta86582b4af9b6198e44d82 ^"Bind The Gift" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Wizard’s Bridle"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base effect, +1 Touch, +2 Sun)"
            ^"Final Level" STRING "34"
            ^"Printed Effect Line" STRING "ReVi 30; R:Touch, D:Sun, T:Ind"
            ^"Owner" STRING "Philippus Niger of House Flambeau"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "A wicked-looking frame which sits over the head of the victim, forcing his mouth open and trapping his tongue with a spiked metal plate. Chains and rods attach to a set of shackles and manacles, thus preventing both words and gestures. It was created with the assistance of two of Philippus’ filii.

Prevents the casting of any spells of level 25 or below. With 2 uses per day (+1 level) and an environmental tripper (+3), this is a constant effect."
    }
