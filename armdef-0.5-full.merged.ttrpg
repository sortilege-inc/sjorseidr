            ^"Page" INTEGER 86
        }
        DESCRIPTION "This Virtue gives the character the Supernatural Ability of Malediction at 1.

See Chapter 10: The Maleficia for more information on this Unholy Power."
    }
    #tb20f32f2c0af4a3761a50a ^"Phantasm" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Major"
            ^"Category" STRING "Unholy Power"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "This Virtue gives the character the Supernatural Ability of Phantasm at 1. See Chapter 10: The Maleficia for more information on this Unholy Power."
    }
