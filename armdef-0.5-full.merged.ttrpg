    # The chapter's creatures, structured; each DESCRIPTION the source's text, verbatim.
    #tb95756c2f8a2831ffeb69f ^"Justinian’s Nightingale" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Magic" FIXED
            ^"Might" INTEGER 29
            ^"Form" STRING "Auram"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 1
                ^"Perception" INTEGER -1
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER 3
                ^"Strength" INTEGER -3
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 2
            }
            ^"Size" INTEGER -6
            ^"Age" STRING "800+ (n/a)"
            ^"Virtues and Flaws" STRING "Enchanting Music; Second Sight"
            ^"Reputations" LIST ["Beautiful Voice 3 (Constantinople)"]
            ^"Soak" INTEGER 4
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Equipment" STRING "None"
            ^"Vis" STRING "None"
            ^"Appearance" STRING "The nightingale is made of gleaming gold and silver clockwork with jeweled feathers. Its eyes are twin rubies and its voice is a sweet song."
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 84
        }
        PERSONALITY_TRAITS {
            "Talkative" +3
            "Loyal" +2
            "Helpful" +1
        }
        COMBAT {
            "Dodge" INIT 2 DEFENSE 8
        }
        ABILITIES {
            "Artes Liberales" SCORE 4 SPECIALTY "rhetoric"
            "Awareness" SCORE 3 SPECIALTY "alertness"
            "Brawl" SCORE 1 SPECIALTY "dodge"
            "Coptic" SCORE 4 SPECIALTY "crafters"
            "Greek" SCORE 6 SPECIALTY "courtly"
            "Area Lore Eastern Empire" SCORE 2 SPECIALTY "Byzantine Centers"
            "Enchanting Music" SCORE 6 SPECIALTY "awaken"
            "Folk Ken" SCORE 4 SPECIALTY "nobles"
            "History" SCORE 3 SPECIALTY "personal experiences"
            "Latin" SCORE 5 SPECIALTY "listening"
            "Leadership" SCORE 3 SPECIALTY "intimidation"
            "Magic Lore" SCORE 3 SPECIALTY "constructs"
            "Philosophiae" SCORE 5 SPECIALTY "Aristotle"
            "Second Sight" SCORE 3 SPECIALTY "intruders"
            "Sing" SCORE 6 SPECIALTY "joyous"
        }
        POWERS {
            #t63b5a28d3c333306f78416 ^"Flying" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "The Nightingale can fly like an ordinary bird, though its movements are accompanied by a beautiful chime-like sound. *Greet the Dawn, *2 points Auram, Init 10: The Nightingale issues a clarion call, awakening everyone within Voice Range."
            }
            #t8bc03beed490d38d39e584 ^"Voice of Chiming Gold" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "The Nightingale can speak as well as sing using a tiny voice box and bellows, though only in languages it knows."
            }
        }
        DESCRIPTION "Hypatia, one of the last Librarians of Alexandria, created the Nightingale from gold, silver, and jewels. Designed as a companion and entertainer, the awakened mechanica’s beautiful voice enthralled all who listened to its jewel-like tones. The nightingale watched over Theon and his household, waking them with a clarion voice when fire or robber threatened.

After Hypatia’s murder, the bird came to the attention of Emperor Justinian and became a toy used to entertain the Imperial court. Centuries went by as the bird passed from hand to hand, until it was lost during the sack of Constantinople.

The nightingale can tell much of Heron’s lore, but it lacks The Gift and the proper understanding of magical theory necessary for it to be able to pass on the secrets of mechanica. It has seen much during its centuries of existence and knows much about the truths behind Byzantine history. The Nightingale loves philosophical debate and can discourse for hours upon Plato and Aristotle.

After centuries of being treated as little more than a pet, the Nightingale has grown very lonely for the kind of scholastic discourse it enjoyed with its creator and his family. The beggar king’s rather foolish scheme is the result of the Nightingale’s manipulation.

Justinian’s Nightingale can relate the tale of Hypatia’s burial, including an accurate location of the old temple. It also knows that Heron’s Theatre was hidden there, along with numerous mechanica salvaged from the Library of Alexandria. It has no idea that the temple is haunted and will be horrified by its creator’s current plight (see below)."
    }
    #tea38b870285e910867e1bf ^"The Ghost of Hypatia" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Magic" FIXED
            ^"Might" INTEGER 25
