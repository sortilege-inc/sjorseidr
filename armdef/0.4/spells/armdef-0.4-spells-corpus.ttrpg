        }
        LEVEL_CALCULATION {
            BASE 2
            MODIFIERS {
            +2 "Voice"
            +1 "Conc"
            }
        }
        DESCRIPTION "One of the target's hands spasms, causing him to drop anything he is holding in it. It keeps spasming for as long as you concentrate."
    }

    #tWVzIXU26OAEcpl0GYsKDyCn ^"Rise of the Feathery Body" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
