    }
    #t1ULpJ1iXPpSIKsyBrLuIRtO ^"Stealth" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Ability Type" STRING "General" FIXED
            ^"Specialties" LIST OF STRING ["hide", "sneak", "shadowing", "urban areas", "natural areas"]
            ^"Source" STRING "Core Rules"
        }
