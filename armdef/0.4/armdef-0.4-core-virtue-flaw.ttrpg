BASE "ARMDef_Core_Virtue_Flaw" {
    NAME "Ars Magica Definitive Edition - Virtue and Flaw (core stub)"
    VERSION "0.4"
    SPEC_VERSION "0.4"
    RELEASE_DATE "2026-07-14"

    # Minimal base types for Virtues and Flaws, so the chapter IV buckets
    # (armdef-0.4-virtues.ttrpg / armdef-0.4-flaws.ttrpg) have shared types to
    # EXTEND. Individual entries set concrete inline values and do not restate
    # these constraints (Definitions vs. Instances, spec S5).
    # Category is a STRING, not an ENUM: the book uses compound categories
    # ("Supernatural, Tainted", "Social Status, animals only", "Mythic
    # Companion", "Special") that an enum would misrepresent.

    #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue" DEF {
        APPLIES TO [^"Entity"]

        PROPERTIES {
            ^"Size" ENUM ["Minor", "Major", "Free", "Major or Minor"] REQUIRED
            ^"Category" STRING REQUIRED
            ^"Source" STRING DEFAULT "Core Rules"
        }
    }

    #tgA0K9vGShU1WKTibhCc4jXz ^"Flaw" DEF {
        APPLIES TO [^"Entity"]

        PROPERTIES {
            ^"Size" ENUM ["Minor", "Major", "Free", "Major or Minor"] REQUIRED
            ^"Category" STRING REQUIRED
            ^"Source" STRING DEFAULT "Core Rules"
        }
    }
}
