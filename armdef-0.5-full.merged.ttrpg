            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "Common Magic Power listed in the pp.38-39 insert (p.38)."
        REFERENCES {
            "Common Magic Power" -> #tbQ683ClGPQQ2UpLbIXsx7h3 ^"Common Magic Power"
        }
    }
    #tIlNy7yLmPEegORsuqmy0h9H ^"Equine Shape" DEF {
        EXTENDS #tbQ683ClGPQQ2UpLbIXsx7h3 ^"Common Magic Power"
        PROPERTIES {
            ^"Page" INTEGER 38
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "2 points, Init equal to (Qik – 2), Animal R: Per, D: Sun, T: Ind The character can transform into a horse until the sun rises or sets. MuFo 25 (base 10, +2 Sun, +1 size): Personal Power (25 levels)"
        REFERENCES {
            "Personal Power" -> #tOquixKtJZbCUVhhZeZTQoLf ^"Personal Power"
        }
    }
    #tr8eFiCJQDU4VFHKzLlMnWXH ^"Flight of the Hummingbird" DEF {
        EXTENDS #tbQ683ClGPQQ2UpLbIXsx7h3 ^"Common Magic Power"
        PROPERTIES {
            ^"Page" INTEGER 38
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "0 points, Init equal to (Qik – 2), appropriate Form R: Per, D: Sun, T: Ind The character can fly through the air in any direction, simply by concentrating. If distracted, this control is lost but the power still holds the character aloft indefinitely. ReFo 15 (base 4, +2 Sun, constant): Personal Power (15 levels, –2 Might cost)"
        REFERENCES {
            "Personal Power" -> #tOquixKtJZbCUVhhZeZTQoLf ^"Personal Power"
        }
    }
    #tXMIdLc9ezQ6h6SglJiGrTtz ^"Hands of the Magical Animal" DEF {
        EXTENDS #tbQ683ClGPQQ2UpLbIXsx7h3 ^"Common Magic Power"
        PROPERTIES {
            ^"Page" INTEGER 39
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "0 points, Init (Qik – 2), approp. Form R: Touch, D: Sun, T: Ind This allows an animal to manipulate and carry an item as if it had human hands and a Strength of +5. The character must concentrate to do anything other than carry the object, including dropping it or taking something else. ReTe 15 (base 3, +1 Touch, +2 Sun, +1 constant): Personal Power (15 levels, –2 Might cost)"
        REFERENCES {
            "Personal Power" -> #tOquixKtJZbCUVhhZeZTQoLf ^"Personal Power"
        }
    }
    #tjWwjpFgKsWmhgPIt02l8QTt ^"Human Shape" DEF {
