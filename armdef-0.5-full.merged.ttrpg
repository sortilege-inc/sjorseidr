    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.
    #taf60189ab48bc5c7acd861 ^"Waves of Drowning and Smashing (Through the Aegis)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Waves of Drowning and Smashing"
            ^"Part Of" STRING "Talisman (Carles Magnus)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Effect Line" STRING "ReAq 30 Pen +0, 1/day R: Sight, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 11
        }
        DESCRIPTION "As per the spell of the same name in ArM5, page 124."
    }
    #t193995e94f11cc3f7fe5b9 ^"(Effect: Base 10, +3 Sight, +1 size) Wizard’s Leap" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Talisman (Carles Magnus)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 18
            ^"Requisite" STRING "Animal, Herbam, Terram"
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "6/day"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Effect Line" STRING "ReCo (Animal, Herbam, Terram) 18 Pen +0, 6/day R: Personal, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 11
        }
        DESCRIPTION "The caster is instantly transported up to 50 paces in any direction, provided he can see his destination or has an Arcane Connection to it. His Talisman and any equipment associated with the forms of Animal, Herbam, and Terram comes with him. Otherwise, as per the description in *Houses of Hermes: Societates*, page 36."
    }
    #t2255f23f2b1992f06405e5 ^"(Effect: Base 15; Modifications: +3 for 6/day) The Wound that Weeps" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Talisman (Carles Magnus)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "+24"
            ^"Uses" STRING "6/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Effect Line" STRING "PeCo 30 Pen +24, 6/day R: Voice, D Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 11
        }
        DESCRIPTION "As the spell described in ArM5, page 133. (Effect: Base 5, +2 Voice; Modifications: +3 for 6/day, +12 for +24 Penetration)"
    }
    #tbb452229cef113853b72cf ^"Rusted Decay of Ten Score Years" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Talisman (Carles Magnus)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Penetration" STRING "+24"
            ^"Uses" STRING "6/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 2, +1 Touch, +2 metal; Modifications: +3 for 6/day, +12 for +24 Penetration)"
            ^"Printed Effect Line" STRING "PeTe 20 Pen +24, 6/day R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 11
        }
        DESCRIPTION "As the spell described in ArM5, page 155. This effect is triggered in combat, when it strikes an opponent’s metal weapon or armor. If the effect penetrates, it rusts the target through and weapons become little more than bludgeons and armor drops to the next protection value as per the table in ArM5, page 176."
    }
    #t7ecca22037d6cfa07c59a4 ^"Babel Rejoined" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 40
            ^"Penetration" STRING "+8"
            ^"Uses" STRING "2/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Hearing"
            ^"Effect Design" STRING "(Effect: Base 5, +1 Touch, +2 Sun, +3 Hearing; Modifications: +1 for 2/ day, +4 for +8 penetration)"
            ^"Printed Effect Line" STRING "InMe 40 Pen +8, 2/day R: Touch, D: Sun, T: Hearing"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 26
        }
        DESCRIPTION "Those in the same structure as the long bone of Epiphanius understand the spoken words of all others within the structure regardless of the languages that any of them speak. To benefit, targets must at least nominally be members of either the western or eastern Churches. Jewish and Islamic characters do not benefit, neither do heretics, pagans, or those aligned with the Infernal.

The power is activated by invoking Saint Epiphanius in the presence of the bone, something widely-known by the crew."
    }
    #ta9d4e7a4106156a19001ad ^"Brooch of Lungs of the Fish" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 24
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Effect: Base 4, +1 Touch, +2 Sun, +1 Part; Modifications: +1 for 2/day, +3 triggered at sunrise/set)"
            ^"Printed Effect Line" STRING "MuAq 24 Pen +0, Constant Effect R: Touch, D: Sun, T: Part"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 29
        }
        DESCRIPTION "This brooch affects the wearer as per the Lungs of the Fish spell described in ArM5, page 122. The effect is constantly active and so the user simply needs to wear it to benefit.

The covenant has only one of these at present but the Laboratory Text is available."
    }
    #t6c195ed7fe6a350f88ea67 ^"The Freshwater Barrel" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 20
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 15, +1 Touch) These devices together cost 16 Build Points."
            ^"Printed Effect Line" STRING "PeAq 20 Pen +0, 1/day R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 29
        }
        DESCRIPTION "This barrel, when filled once per day from the sea, destroys the saltiness property of the seawater caught within it.

Both Carles and Hilde each have one of these devices and the Laboratory Text is available."
    }
    #t1bd0c8f2d4fe5b0a64b2e0 ^"This device costs 12 Build Points. Finding the Fleet" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Master’s Chart"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 14
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Arcane Connection"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 2, +4 Arcane Connection; Modifications: +4 for 12/day)"
            ^"Printed Effect Line" STRING "InHe 14 Pen +0, 12/day R: Arcane Connection: D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 29
        }
        DESCRIPTION "Provides information on the location of a target ship given an arcane connection to it."
    }
    #t9543048ef282cad6a6f075 ^"Mark the Fleet" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Master’s Chart"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 11
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 3, +1 Touch; Modifications: +4 for 12/day, +3 triggered by Finding the Fleet)"
            ^"Printed Effect Line" STRING "ReHe 11 Pen +0, 12/day R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 29
        }
        DESCRIPTION "Moves the token placed upon the chart to the location indicated by the Finding the Fleet effect."
    }
    #t81c7883e85077a95bcabd3 ^"Bell of Summoning" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Arcane Connection"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 1, +4 Arcane Connection, +1 Diameter; Modifications: +4 for 12/day, +16 for +32 penetration)"
            ^"Printed Effect Line" STRING "CrIm 30 Pen +0, 12/day R: Arcane Connection, D: Diameter, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "Commissioned from a Verditius working out of Verdi, when rung this bell sounds throughout all six ships of the fleet, using up six of its 12 uses. This allows the bell to be rung twice with effect.

The bell is housed on La Charytee to be rung when Carles gets to port ahead of a council meeting. The bell is usually rung twice in succession, once to alert the magi and again to give them chance to locate the direction of the magic using their Magical Astrolabes, described below."
    }
    #t8dd9a35ffff11de533b2aa ^"The Magical Astrolabe" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 40
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 10, +1 Touch, +3 for increased information; Modifications +10 unlimited use)"
            ^"Printed Effect Line" STRING "InVi 40 Pen +0, Unlimited R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "When used against an active magical effect, the astrolabe allows the user to determine the horizontal and vertical directions of the magic’s origins. It cannot provide distance information.

The device is used to locate the source of the sound of the Bell of Summoning. When used in conjunction with charts, this provides a confident view on where the bell is.

Each ship in the fleet is issued with one of these devices."
    }
    #tf1c09604afa716ed943ba7 ^"The Unbidden Horrors" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Summer Fog"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 20
            ^"Penetration" STRING "+10"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 4, +1 Touch, +2 Sun; Modifications: +5 for +10 Penetration)"
            ^"Printed Effect Line" STRING "CrMe 20 Pen +10, 1/day R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 32
        }
        DESCRIPTION "Individuals touched by the fog feel unease, rising to dread, through suspicion and fear, and into the horror of their deepest nightmares. The effect lasts through the night, and the screams of those unlucky cursed few can be heard throughout the village of Sønder Vorupør.

The memories of the experience live longer than the effects of the magic itself."
    }
    #t9427e00e23f6858557d4d7 ^"The Animated Corpse" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Alfgeir’s Bones"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 24
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 10, +2 Sun; Modifications:"
            ^"Printed Effect Line" STRING "ReCo 24 Pen +0, Constant Effect R: Personal, D: Sun, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 32
        }
        DESCRIPTION "A season spent taming Alfgeir’s skeletal form, which can be achieved as a five-day distraction, imparts a Dexterity equal to the controller’s Intelligence and a Single Weapon Ability equal to the controller’s Finesse as the controller impresses their will upon the corpse. All other characteristics and Ability scores are considered to be zero and/or normal for a typical human."
    }
    #t695e72b3c3d31583b5865a ^"The Agile Shield" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Oyster King’s Shell"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 14
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 3, +2 Sun, +1 stone; Modifications: +1 for 2/day, +3 triggered at sunrise/set)"
            ^"Printed Effect Line" STRING "MuTe 14 Pen +0, Constant Effect R: Personal, D: Sun, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "This effect transforms the stone of the giant oyster shell so that it is as hard as the finest steel but as light as beaten tin."
    }
    # Dolly Price (Chapter Two: The Northern Seas, p19): one character, its stat lines verbatim fields.
    #t7f999cd209004ef4bc19db ^"Dolly Price" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Companion"
            ^"Covenant" LIST [#t2b859a5f0c51942368a661 ^"The Northern Seas"]
            ^"Characteristics" STRING "Int +2, Per 0, Pre +3, Com 0, Str –1, Sta –1, Dex 0, Qik 0"
            ^"Size" STRING "–1"
            ^"Age" STRING "30 (30)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (0)"
            ^"Confidence" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Merchant; Entrancement, Wealthy; Protection (Carles Magnus), Temporal Influence (coastal criminals and smugglers); Enemies (Sheriff of Southampton), Greater Malediction (Plagued by Infernal Entities); Busybody, Small Frame"
            ^"Personality Trait" STRING "Gregarious +3, Unforgiving +2, Determined +1"
            ^"Reputations" STRING "Stay on the right side of Dolly Price 3 (thieves and rogues), A thief and a rogue 3 (sheriff of Southampton)"
            ^"Combat" STRING "Dodge: Init +0, Attack n/a, Defense +2, Damage n/a Fist: Init +0, Attack +2, Defense +2, Damage –1 Kick: Init –1, Attack +2, Defense +1, Damage +2 Bludgeon: Init –1, Attack +4, Defense +2, Damage +1 Dagger: Init +0, Attack +5, Defense +3, Damage +2 Throwing Knife: Init +0, Attack +5, Defense +4, Damage +1"
            ^"Soak" STRING "–1"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–4), –3 (5–8), –5 (9–12), Incapacitated (13–16), Dead (17+)"
            ^"Abilities" STRING "Area Lore: Southampton 4 (personalities), Athletics 2 (running), Awareness 3 (alertness), Bargain 2 (hard sell), Brawl 2 (Dagger), Carouse 4 (power drinking), Organization Lore: Covenant of the Northern Seas 1 (personalities), Disguise 2 (peasants), English 5 (slang), Entrancement 5 (questionable commands), Folk Ken 3 (the opposite sex), French 4 (slang), Guile 3 (lying to authority), Intrigue 3 (rumormongering), Leadership 4 (intimidation), Legerdemain 1 (picking pockets), Order of Hermes Lore 1 (personalities), Tavern/Brothel Owner 4 (exotic girls), Thrown Weapon 3 (throwing knife)"
            ^"Equipment" STRING "Encumbrance: 1 (1)"
            ^"Appearance" STRING "Dolly is a short woman with cascading dark locks, a broad mouth, and large bright eyes."
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 19
        }
        DESCRIPTION "The inn is within an Infernal aura that enfolds places where drinking, gambling, and debauchery are indulged. This is level 1 during the day, but rises to level 2 at night. This accounts for the many minor infernal influences that surround her. Unfortunately for her, Dolly’s soul is probably thrice-damned already, what with all the men she’s robbed, killed, or otherwise wronged."
    }
    # Fang (Chapter Two: The Northern Seas, p21): one character, its stat lines verbatim fields.
    #t5ac49c27e065459646cb01 ^"Fang" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Grog"
            ^"Covenant" LIST [#t2b859a5f0c51942368a661 ^"The Northern Seas"]
            ^"Characteristics" STRING "Int –2, Per +1, Pre –1, Com –2, Str +1, Sta +2, Dex +3, Qik +2"
            ^"Size" STRING "0"
            ^"Age" STRING "28 (28)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (0)"
            ^"Virtues and Flaws" STRING "Covenfolk; Puissant Brawl, Tough, Warrior; Careless with Great Weapon, Social Handicap (Unpleasant odor), Weakness (Drinking) From the Grogs supplement"
            ^"Personality Trait" STRING "Brave +3, Loyal +2, Subtle –2"
            ^"Combat" STRING "Dodge: Init +1, Attack n/a, Defense +9, Damage n/a Bite: Init +2, Attack +11, Defense +10, Damage +1 Fist: Init +1, Attack +10, Defense +9, Damage +1 Grappling: Init +2, Attack +10, Defense +9, Damage +1 Kick: Init +0, Attack +10, Defense +8, Damage +4 Axe & heater shield: Init +2, Attack +13, Defense +11, Damage +7"
            ^"Soak" STRING "+7"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Area Lore: Area 2 (brewers), Athletics 2 (climbing), Awareness 3 (in combat), Brawl 5+2 (Bite), Carouse 4 (drinking), Charm 3 (when drunk), Chirurgy 3 (cauterization), Organization Lore: Covenant of the Northern Seas 2 (personalities), English 5 (talking about fighting), Folk Ken 1 (magi), Great Weapon 3 (long spear), Guile 3 (lying to magi), Music 2 (drinking songs), Ride 1 (pack horse), Single Weapon 5 (heater shield), Survival 1 (on rivers), Swim 2 (underwater maneuvering)"
            ^"Equipment" STRING "Heater shield; Pack; Partial Metal Reinforced Leather Armor; Ax"
            ^"Encumbrance" STRING "1 (2)"
            ^"Appearance" STRING "Bearded, hunched, and reeking."
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 21
        }
        DESCRIPTION "Fang is a brawler and likes to get in close and grapple. He has a tendency to bite his opponents, claiming it takes the fight out of them, though even his closest friends state it is his foul odor responsible for that.

Fang has a weakness for drink and indulges whenever he is given the opportunity, which almost always ends in him becoming embroiled in one fight or another.

His armor is loose and filthy, possibly more use for carrying chunks of bread and cheese inside for when he gets hungry. He does have an ax and a shield, but frequently forgets them and so is just as often seen without them as with.

Fang enjoys grappling and brawling, which makes for an effective means of subduing enemies rather than hacking at them indiscriminately."
    }
    # Feliadexter (Chapter Two: The Northern Seas, p28): one creature, its stat lines verbatim fields.
    #t6462babb074f7fc8f0232c ^"Feliadexter" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Covenant" LIST [#t2b859a5f0c51942368a661 ^"The Northern Seas"]
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Tempters"
            ^"Might" INTEGER 20
            ^"Form" STRING "Mentem"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 1
                ^"Perception" INTEGER -1
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER 3
                ^"Strength" INTEGER 3
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 2
            }
            ^"Size" INTEGER 0
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Weak-Willed"
            ^"Reputations" LIST ["None"]
            ^"Hierarchy" INTEGER 0
            ^"Combat" STRING "Claws: Init +3, Atk +6, Def +5, Dam +5 Tongue: Init +4, Atk +7, Def +7, Dam +0"
            ^"Soak" INTEGER 3
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Weakness" STRING "Love, freely given"
            ^"Vis" STRING "4 pawns of Mentem vis sordida found in the demon’s bowels"
            ^"Appearance" STRING "Feliadexter’s true form is that of a spindly bony man with rips tearing through his skin. His mouth is forced open so far that his head always tips back, and out of it spills a massive tongue as wide around as a grog’s arm. The tongue flails around and it is this he uses in combat as a whip."
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 28
        }
        PERSONALITY_TRAITS {
            "Selfish" +5
            "Cruel" +4
            "Angry" +3
            "Spiteful" +3
        }
        ABILITIES {
            "Brawl" SCORE 3 SPECIALTY "whip"
            "Charm" SCORE 4 SPECIALTY "chosen victim"
            "Folk Ken" SCORE 6 SPECIALTY "character faults"
            "Guile" SCORE 6 SPECIALTY "imaginary faults"
        }
        POWERS {
            #tf2235e5cdf554607c2eafc ^"Possession (Through the Aegis)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Possession"
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+2"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "*See Realms of Power: The Infernal*, page 32."
            }
            #t86f6f1349cb45a0864627a ^"Coagulation (Through the Aegis)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Coagulation"
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See *Realms of Power: The Infernal*, page 31."
            }
            #tb8061e20120a04ae975158 ^"Obsession (Cruelty)" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "See *Realms of Power: The Infernal*, page 31."
            }
        }
        DESCRIPTION "The possessing spirit of Feliadexter has a Possession Pool of 15, which should be used in place of the Might Score listed above. Points from this Possession Pool are not regained.

His Possession power has no other Might cost other than the points Feliadexter chooses to place within the host. This means that the demon can jump between hosts with no loss of power and, as the part has the powers of the whole, even split off further possessing spirits and place them within additional crewmembers."
    }
    # Hilde Oddfish (Chapter Two: The Northern Seas, p14): one character, its stat lines verbatim fields.
    #t6f0a06e56fe162428597b5 ^"Hilde Oddfish" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t2b859a5f0c51942368a661 ^"The Northern Seas"]
            ^"Characteristics" STRING "Int +1 (1), Per 0, Pre +3 (2), Com 0, Str +2, Sta 0, Dex 0, Qik +2 (2)"
            ^"Size" STRING "+2"
            ^"Age" STRING "65 (50)"
            ^"Decrepitude" STRING "1 (0)"
            ^"Warping Score" STRING "4 (20)"
            ^"Confidence" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "The Gift; Hermetic Magus; Flawless Magic, Giant Blood, Mystery of the Epitome; Berserk, Heartbeast (Shark), Improved Characteristics, Lightning Reflexes; Chaotic Magic, Fury (blood in the water), True Friend (Carles); Careless Sorcerer, Clumsy Magic, Greedy, House Virtue Gained through initiation"
            ^"Personality Trait" STRING "Shark +3, Angry +2, Loyal to Carles Magnus +2, Studious –1"
            ^"Reputations" STRING "Afflicted +3 (House Bjornaer), Dangerous +2 (Normandy)"
            ^"Combat" STRING "Dodge: Init: +2, Attack n/a, Defense +6/+4, Damage n/a Fist: Init: +2, Attack +4/+6, Defense +6/+4, Damage +2 Bite: Init: +2, Attack +5/+7, Defense +7/+5, Damage +2 Bludgeon: Init: +2, Attack +6/+8, Defense +6/+4, Damage +4 Adjustments for the Berserk Virtue"
            ^"Soak" STRING "0/+2"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–7), –3 (8–14), –5 (15–21), Incapacitated (22–28), Dead (29+)"
            ^"Abilities" STRING "Artes Liberales 3 (ritual magic), Athletics 3 (grace), Awareness 2 (in the water), Bjornaer Lore 5 (modifying initiation scripts), Brawl 4 (Bite), Carouse 1 (power drinking), Code of Hermes 3 (tribunal procedures), Faerie Lore 2 (faeries of the sea), Finesse 3 (fast casting), French 4 (slang), German 5 (slang), Heartbeast 6 (regain human form), Latin 5 (hermetic usage), Magic Lore 3 (giants), Magic Theory 6 (inventing spells), Order of Hermes Lore 2 (personalities), Parma Magica 5 (Animal), Penetration 5 (Corpus), Philosophiae 3 (ritual magic), Swim 5 (underwater maneuvering)"
            ^"Arts" STRING "Cr 10, In 8, Mu 5, Pe 12, Re 7, An 13, Aq 8, Au 5, Co 13, He 11, Ig 5, Im 3, Me 5, Te 5, Vi 7"
            ^"Twilight Scars" STRING "None"
            ^"Equipment" STRING "None"
            ^"Encumbrance" STRING "0 (1)"
            ^"Appearance" STRING "Hilde is very large, with broad shoulders and powerful arms and legs. Her wide grin is filled with too many teeth."
            ^"Casting Sigil" STRING "Brine seeps from Hilde’s skin with each spell cast or device activated"
            ^"Voting Sigil" STRING "A shark’s tooth made of smooth black stone"
            ^"Spells Known" STRING "Image of the Beast (InAn 5) +22, Mastery 1 (penetration) Hunter’s Sense (InAn 30) +22, Mastery 1 (penetration) The Baleful Eye that Pains the Beast (PeAn 20) +26, Mastery 1 (penetration) Cripple the Howling Wolf (PeAn 25) +26, Mastery 1 (penetration) Viper’s Gaze (ReAn 15) +21, Mastery 1 (penetration) Subtle Taste of Poison and Purity (InAq 5) +17,"
            ^"Heartbeast Statistics" DEF {
                ^"Characteristics (Outer Heartbeast)" STRING "Int +1, Per –2, Pre –3/+3, Com –6, Str +7, Sta 0, Dex +2, Qik +1"
                ^"Characteristics (Inner Heartbeast)" STRING "Int +1, Per –2, Pre –3/+3, Com –6, Str +10, Sta 0, Dex +2, Qik +1"
                ^"Size" STRING "+3"
                ^"Confidence" STRING "1 (3)"
                ^"Virtues & Flaws" STRING "Berserk, Lightening Reflexes; Ferocity (hunting), Fury (blood in the water), Greedy, Tough"
                ^"Qualities" STRING "Aggressive, Ambush Predator, Aquatic, Large Teeth, Loathsome Appearance"
                ^"Personality Trait" STRING "Brave +3, Greedy +3, Cruel +2"
                ^"Reputations" STRING "Deadly (mariners) 2"
                ^"Combat" STRING "Large Teeth (Outer Heartbeast): Init +0, Atk +11, Def +6, Dam +10 Large Teeth (Inner Heartbeast): Init +0, Atk +11, Def +6, Dam +13"
                ^"Soak" STRING "+2"
                ^"Fatigue Levels" STRING "OK, 0/0, –1/–1, –3/–3, –5, Unconscious"
                ^"Wound Penalties" STRING "–1 (1–8), –3 (9–16), –5 (17–24), Incapacitated (25–32), Dead (33+)"
                ^"Abilities" STRING "Artes Liberales 3 (ritual magic), Awareness 2 (food), Bjornaer Lore 5 (modifying initiation scripts), Brawl 5 (Large Teeth), Code of Hermes 3 (tribunal procedures), Faerie Lore 2 (faeries of the sea), Finesse 3 (casting speed), French 4 (slang), German 5 (slang), Heartbeast 6 (regain human form), Hunt 4 (prey), Latin 5 (hermetic usage), Magic Lore 3 (giants), Magic Theory 6 (inventing spells), Order of Hermes Lore 2 (personalities), Parma Magica 5 (Animal), Penetration 5 (Corpus), Philosophiae 3 (ritual magic), Stealth 4 (stalking prey), Survival 3 (home terrain), Swim 5 (home terrain)"
                ^"Appearance" STRING "The heartbeast is a noticeably large shark with scarred and pitted grey skin and a wide gaping mouth filled with jagged teeth."
                ^"Mythic Feat" STRING "At the cost of 1 Confidence"
            }
            ^"Heartbeast Statistics Notes" STRING "Using the rules in *Houses of Hermes: Mystery Cults*, page 23, Hilde, in the shape of her shark Heartbeast, has stats as listed below. They include all modifiers for the House Bjornaer Inner Hearbeast (Epitome) Mystery Virtue. Any relevant Virtues and Flaws from human form still apply in animal shape, Social Status is irrelevant. No General Abilities from human form are usable except language and lores, but Arcane, Academic, and Supernatural Abilities are still accessible. In animal form she uses the General Abilities inherent to that beast at their fixed levels, although she may practice if she stays in animal form for an entire season, or spend experience gained on adventures while in animal form.

Point, the Inner Heartbeast may inflict a Heavy Wound on any creature of size +1 or less on a successful attack. The shark is an unattractive beast, hence its low Presence score. However, its Loathsome Appearance Quality makes it fearsome and its Presence is treated as +3 for the purposes of intimidation.

If using City & Guild, attacks by her Inner Heartbeast are sufficient to cause ships to make damage rolls."
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 14
        }
        DESCRIPTION "Mastery 1 (quiet casting) The Wound that Weeps (PeCo 20) +26, Mastery 1 (penetration) Grip of the Choking Hand (PeCo 25) +26, Mastery 1 (penetration) The Withering Eye (PeCo 25) +26, Mastery 1 (penetration) Evisceration of a Thousand Knives (PeCo 30) +26, Mastery 1 (penetration) † Endurance of the Berserkers (ReCo 15) +21, Mastery 1 (quick casting) Demon’s Eternal Oblivion (PeVi 10) +20, Mastery 1 (penetration) Dreadful Bane of the Fae (PeVi 10) +20, Mastery 1 (penetration) † † Guardians of the Forests, page 60. Hilde has not enchanted any items since her unhappy apprenticeship as he is wedded to a Bjornaer sense of purity; she relies on herself and her magic only.

She has invented her own Longevity Ritual and this provides –6 to Aging Rolls."
    }
    # The chapter's laboratories, structured; each DESCRIPTION the source's text, verbatim.
    #t471ab77a658fd6fbdf8466 ^"Laboratories (The Northern Seas)" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
