                ^"Communication" INTEGER 1
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 0
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER 0
            }
            ^"Size" INTEGER 0
            ^"Age" INTEGER 25
            ^"Apparent Age" INTEGER 25
            ^"Decrepitude" INTEGER 0
            ^"Warping Score" INTEGER 0
            ^"Warping Points" INTEGER 0
            ^"Confidence Score" INTEGER 1
            ^"Confidence Points" INTEGER 3
            ^"Hermetic Arts" DEF {
                ^"Creo" INTEGER 12
                ^"Intellego" INTEGER 0
                ^"Muto" INTEGER 0
                ^"Perdo" INTEGER 0
                ^"Rego" INTEGER 3
                ^"Animal" INTEGER 0
                ^"Aquam" INTEGER 0
                ^"Auram" INTEGER 12
                ^"Corpus" INTEGER 4
                ^"Herbam" INTEGER 0
                ^"Ignem" INTEGER 0
                ^"Imaginem" INTEGER 0
                ^"Mentem" INTEGER 0
                ^"Terram" INTEGER 0
                ^"Vim" INTEGER 0
            }
            ^"Virtues" LIST ["The Gift", "Hermetic Magus", "Affinity with Auram", "Affinity with Creo", "Book Learner", "Free Study", "Great Intelligence (x2)", "Inventive Genius", "Puissant Magic Theory*", "Secondary Insight"]
            ^"Flaws" LIST ["Favors", "Painful Magic", "Driven (Minor)", "Weak Enchanter"]
            ^"Soak" INTEGER 0
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Twilight Scars" STRING "None"
            ^"Equipment" LIST ["Wizardly robes."]
            ^"Encumbrance" STRING "0 (0)"
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Brave" -1
            "Driven" +3
            "Studious" +2
        }
        COMBAT {
            "Dodging" INIT 0 DEFENSE 0
        }
        ABILITIES {
            "Artes Liberales" SCORE 1 SPECIALTY "logic"
            "Awareness" SCORE 2 SPECIALTY "when working"
            "Charm" SCORE 2 SPECIALTY "equals"
            "Concentration" SCORE 3 SPECIALTY "spell casting"
            "Folk Ken" SCORE 2 SPECIALTY "magi"
            "Latin" SCORE 4 SPECIALTY "Hermetic technical terms"
            "Magic Lore" SCORE 1 SPECIALTY "nonHermetic magic"
            "Magic Theory" SCORE 4 SPECIALTY "Creo"
            "Native Language" SCORE 5 SPECIALTY "educated talk"
            "Order of Hermes Lore" SCORE 2 SPECIALTY "great discoveries"
            "Parma Magica" SCORE 1 SPECIALTY "Mentem"
            "Penetration" SCORE 1 SPECIALTY "Auram"
            "Teaching" SCORE 3 SPECIALTY "Hermetic Arts"
        }
