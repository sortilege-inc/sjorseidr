    # Dobhar-chú (Chapter Ten: The Magical Landscape, p122): one being, its stat lines verbatim fields.
    #tebf59598a64ba22168dc69 ^"Dobhar-chú" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Magic" FIXED
            ^"Might" INTEGER 8
            ^"Form" STRING "Aquam"
            ^"Season" STRING "Summer"
            ^"Characteristics" DEF {
                ^"Cunning" INTEGER 0
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER -3
                ^"Strength" INTEGER 3
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 1
            }
            ^"Size" INTEGER 1
            ^"Confidence Score" STRING "2 (5)"
            ^"Virtues and Flaws" STRING "Magic Animal; Magical Monster; Ways of the Lough; Ferocity (against interlopers), Improved Characteristics, Puissant Swim, Self Confident; Wrathful; Infamous"
            ^"Mundane Qualities" STRING "Amphibious, Imposing Appearance x2, Pursuit Predator, Tireless"
            ^"Magical Qualities and Inferiorities" STRING "Gigantic, Major Virtue (Greater Immunity to metal weapons), Ritual Power (Death Curse); Minor Virtue (Life Boost), Improved Attack (grapple) x2; Lesser Malediction (vulnerable to silver), Temporary Might"
