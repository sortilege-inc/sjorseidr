    # Oikos tou Eleous (Chapter Five: Greece): the covenant, its site, patron, people and records.
    #te66a463140e7bf322395af ^"Oikos tou Eleous" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Printed Name" STRING "Oikos tou Eleous: The Ladies of Thessaloniki"
            ^"Location" LIST [#t391c6db54acbe2ea6dac54 ^"Oikos tou Eleous"]
            ^"Patron" STRING "Saint Demetrios"
            ^"Patron Statement" STRING "The covenant’s patron is Saint Demetrios"
            ^"Magi" LIST [#t39bf16c33d48efc3da20a5 ^"Anna Psellus of House Jerbiton", #t6bc2742421013c5b9096ef ^"Theocharista Psellus of House Jerbiton", #tbc2cbafbfd91c7af1ff7bb ^"Nereida Ex Miscellanea", #t8d976b0ef83ded860da7b4 ^"Nonna Ex Miscellanea"]
