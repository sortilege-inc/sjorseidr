    #ts8tqYvObdZKPZasIKvbHfnu ^"Revenant, Skeletal Form" DEF {
        EXTENDS ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 6
            ^"Might Realm" STRING "Magic" FIXED
