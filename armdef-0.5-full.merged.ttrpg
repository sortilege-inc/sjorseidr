            ^"Modifiers" STRING "+(servant's Intelligence/2, rounding up) Safety, +1 Aesthetics; +1 Me."
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "One of the covenfolk is employed as a full-time lab servant, to perform the most mundane or bothersome tasks in the lab, and cater to the needs of the magus."
    }
    #tAKIGIB94ottgPIhLW4aXGiX ^"Spotless (Lab Virtue)" DEF {
