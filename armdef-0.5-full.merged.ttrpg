            ^"Apparent Age" INTEGER 25
            ^"Decrepitude" INTEGER 0
            ^"Warping Score" INTEGER 0
            ^"Warping Points" INTEGER 0
            ^"Confidence Score" INTEGER 1
            ^"Confidence Points" INTEGER 3
            ^"Hermetic Arts" DEF {
                ^"Creo" INTEGER 0
                ^"Intellego" INTEGER 12
                ^"Muto" INTEGER 0
                ^"Perdo" INTEGER 2
                ^"Rego" INTEGER 0
                ^"Animal" INTEGER 0
                ^"Aquam" INTEGER 0
                ^"Auram" INTEGER 0
                ^"Corpus" INTEGER 5
                ^"Herbam" INTEGER 0
                ^"Ignem" INTEGER 0
                ^"Imaginem" INTEGER 6
                ^"Mentem" INTEGER 6
                ^"Terram" INTEGER 0
                ^"Vim" INTEGER 0
            }
            ^"Virtues" LIST [^"The Gift", ^"Hermetic Magus", ^"Affinity with Art"(^"Intellego"), ^"Clear Thinker", ^"Great"(^"Perception"), ^"Hermetic Prestige", ^"Improved Characteristics", ^"Puissant Art"(^"Intellego"), ^"Side Effect"("Lying is hard")]
            ^"Free Virtue" LIST [^"Hermetic Prestige"]
            ^"Flaws" LIST [^"Curse of Venus", ^"Restriction"("No magic for Sun duration after lying")]
            ^"Soak" INTEGER 0
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Twilight Scars" STRING "None"
            ^"Equipment" LIST ["Wizardly robes"]
            ^"Encumbrance" STRING "0 (0)"
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Honest" +3
            "Fair" +2
            "Nervous around the opposite sex" +2
        }
        REPUTATIONS {
            "Quaesitor" SCORE 3 TYPE "Hermetic"
        }
        COMBAT {
            "Dodging" INIT 0 DEFENSE 2
        }
        ABILITIES {
            "Artes Liberales" SCORE 1 SPECIALTY "logic"
            "Awareness" SCORE 3 SPECIALTY "clues"
            "Brawl" SCORE 1 SPECIALTY "dodging"
            "Charm" SCORE 2 SPECIALTY "people you suspect"
            "Code of Hermes" SCORE 3 SPECIALTY "the local Tribunal"
            "Concentration" SCORE 1 SPECIALTY "observing people or places"
            "Folk Ken" SCORE 4 SPECIALTY "liars"
            "Guile" SCORE 2 SPECIALTY "concealing investigations"
            "Latin" SCORE 4 SPECIALTY "Hermetic terms"
            "Magic Theory" SCORE 3 SPECIALTY "Intellego"
            "Native Language" SCORE 5 SPECIALTY "questions"
            "Order of Hermes Lore" SCORE 1 SPECIALTY "legal cases"
            "Parma Magica" SCORE 1 SPECIALTY "Mentem"
        }
        SPELLS_KNOWN {
            ^"Physician's Eye"
            TECHNIQUE "Intellego" FORM "Corpus" LEVEL 5 CASTING_TOTAL 20
            ^"Eyes of the Eagle"
            TECHNIQUE "Intellego" FORM "Imaginem" LEVEL 25 CASTING_TOTAL 21
            ^"Summoning the Distant Image"
            TECHNIQUE "Intellego" FORM "Imaginem" LEVEL 25 CASTING_TOTAL 21
            ^"Invisibility of the Standing Wizard"
            TECHNIQUE "Perdo" FORM "Imaginem" LEVEL 15 CASTING_TOTAL 8
            ^"Frosty Breath of the Spoken Lie"
            TECHNIQUE "Intellego" FORM "Mentem" LEVEL 20 CASTING_TOTAL 21
            ^"Peering Into the Mortal Mind"
            TECHNIQUE "Intellego" FORM "Mentem" LEVEL 30 CASTING_TOTAL 21
        }
        CHOICES {
            "If the Guernicus lies (says something she believes to be untrue as if it were true), she cannot use any magic until the sun next rises or sets. Anyone who wants to tell a lie in her presence soon after she casts a spell (within two minutes or so) must make a relevant Personality Trait check against an Ease Factor equal to the magnitude of the spell cast. If the check fails, he cannot bring himself to lie, although he can remain silent. The Guernicus could take four more points of Flaws, and corresponding Virtues."
        }
    }
