            "6"
            "+1 per 2 years"
            "5 per year"
            "Hoofed Beasts"
            "27"
            "3"
            "20"
            "+1 per 5 years"
            "2 per year"
            "Birds"
            "81"
            "8"
            "55"
            "+1 per 15 years"
            "1 per 2 years"
            "Fish and Serpents"
            "243"
            "24"
            "170"
            "+1 per 50 years"
