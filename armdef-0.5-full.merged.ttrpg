    }
    #tWVzIXU26OAEcpl0GYsKDyCn ^"Rise of the Feathery Body" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
