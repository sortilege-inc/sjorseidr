            ^"Form" STRING "Ignem"
            ^"Source" STRING "Realms of Power: Faerie"
        }
        DESCRIPTION "Allows the person touched to survive the cold above the snowline on mountains until he treads upon grass.

Costs 15 spell levels. (Base 2 +1 Touch +4 Until)"
    }
    #tG7vzPI3lGkclU3bN3tu6psY ^"Kiss of the Mermaid" DEF {
        EXTENDS #t84d15c61569668f6f97c5a ^"Faerie Power"
        PROPERTIES {
            ^"Group" STRING "Greater and Lesser" FIXED
            ^"Might Cost" STRING "3 points, Init –3, Aquam"
