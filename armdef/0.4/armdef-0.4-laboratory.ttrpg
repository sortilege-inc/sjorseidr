            PROPERTIES {
                ^"Magnitude" STRING "Free" FIXED
                ^"Category" STRING "Structure" FIXED
                ^"Modifiers" STRING "–1 General Quality, –1 Safety, –1 Aesthetics."
                ^"Source" STRING "Core Rules"
            }
            DESCRIPTION "The ceiling is lower than the requisite ten feet, which slightly hampers some magical activities. This Flaw should be taken twice if the ceiling is less than eight feet, or thrice if the magus has to stoop (in which case also take –2 Health)."
        }
        #tdEAppt7waalT9fGvoS0Y86x ^"Subterranean (Lab Flaw)" DEF {
            EXTENDS ^"Laboratory Flaw"
            PROPERTIES {
                ^"Magnitude" STRING "Free" FIXED
                ^"Category" STRING "Structure" FIXED
                ^"Modifiers" STRING "+1 Upkeep, –1 Health, –1 Aesthetics; +1 Te."
                ^"Source" STRING "Core Rules"
            }
            DESCRIPTION "The lab is underground. There is a lack of natural light, and so more candles are required for lighting."
        }
        #tYIVfsBtH4KpeiC7hmA0Lf8S ^"Unstable (Lab Flaw)" DEF {
            EXTENDS ^"Laboratory Flaw"
            PROPERTIES {
                ^"Magnitude" STRING "Free" FIXED
                ^"Category" STRING "Structure" FIXED
                ^"Modifiers" STRING "+1 Upkeep, –1 Safety."
                ^"Source" STRING "Core Rules"
            }
            DESCRIPTION "The lab is prone to movements, for example it is on a ship, is earthquake-prone, or merely has dodgy foundations, which is the occasional cause of accidents or breakages. This Flaw may be taken more than once for a greater instability."
        }
        #toj6KbaKdFlwzDj1khhFRmv4 ^"Cramped (Lab Flaw)" DEF {
