            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 2
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER 2
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 2
            }
            ^"Size" INTEGER 0
            ^"Age" STRING "n/a (33)"
            ^"Confidence Score" STRING "2 (10)"
            ^"Virtues and Flaws" STRING "Ways of the (Local Environment); Animal Ken, Wilderness Sense"
            ^"Reputations" LIST ["None Combat: Fist: Init +2", "Attack +8", "Defense +8", "Damage +0"]
            ^"Soak" INTEGER 1
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1-5), –3 (6-10), –5 (11-15), Incapacitated (16-20)"
            ^"Equipment" STRING "Travelling clothes"
            ^"Encumbrance" STRING "0 (0)"
            ^"Vis" STRING "4 pawns of Terram in feet."
            ^"Appearance" STRING "An unassuming man dressed in well-worn travelling clothes."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 33
        }
        PERSONALITY_TRAITS {
            "Compassionate" +3
            "Just" +3
            "Love of God" +5
        }
        ABILITIES {
            "Animal Handling" SCORE 8 SPECIALTY "horses"
            "Animal Ken" SCORE 8 SPECIALTY "horses"
            "Athletics" SCORE 8 SPECIALTY "climbing"
            "Awareness" SCORE 8 SPECIALTY "natural hazards"
            "Brawl" SCORE 5 SPECIALTY "fist"
            "Chirurgy" SCORE 8 SPECIALTY "bind wound"
            "Dominion Lore" SCORE 8 SPECIALTY "angels"
            "Swim" SCORE 8 SPECIALTY "rough water"
            "Theology" SCORE 8 SPECIALTY "angelology"
            "Wilderness Sense" SCORE 8 SPECIALTY "local environment"
        }
        POWERS {
            #t879d5cff0b8eb48e1917d1 ^"Calming Touch" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Animal/Mentem"
                }
                DESCRIPTION "By touching the target, Nasir can calm his fears, making him feel reassured in the face of dangerous terrain."
            }
            #t12aa7b728f94e924110111 ^"Spirit Form" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+30"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Nasir can become a creature of pure spirit as he wishes. This means that he is unable to affect things physically, or be affected physically."
            }
            #t9b49f1372a66a05f6579c5 ^"Steadying Hand" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "+30"
                    ^"Form" STRING "Animal/Corpus"
                }
                DESCRIPTION "By touching the target, Nasir can assure that his footsteps are firm and that he can cross the most impassable of terrain. The target will not slip or fall as long as contact is maintained."
            }
            #t5030d3a5087f4b598524d6 ^"Subtle Form" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Nasir can change his appearance to look like any human being. His statistics do not change."
            }
        }
        DESCRIPTION "As I was unable to walk, I climbed the mountain on horseback, while its slopes were all covered with pieces of stone and pebbles which slipped backwards under the feet of the horse every time its hoofs struck them ... It slipped backward, with the pebbles and chips of stone sliding under it, and fell. So I dismounted, assisted the horse to its feet and stopped, unable to move. At that moment a man came down to me from the mountain and held me by the hand, my other hand holding the pack horse, until he got me to the summit. No, by Allah, I did not know who the man was and never saw him again. ... He was none other than an angel whom Allah, moved by compassion toward me, sent to my aid.

Usama ibn Munqidh (d. 1188), *The Book of Learning by Example*

Nasir is a minor angel charged with the safety of pious travellers. He spends most of his time helping those in need, seeming to appear by mundane means from just out of sight, providing what aid he can, and then leaving again before he can be questioned too closely about his origins."
    }
    #teW9lmzZVk6bDVhXGXZVbfHZ ^"Seferiel" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 50
            ^"Might Realm" STRING "Divine" FIXED
            ^"Form" STRING "Corpus"
            ^"Size" INTEGER 1
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 5
                ^"Perception" INTEGER 5
                ^"Presence" INTEGER 5
                ^"Communication" INTEGER 5
                ^"Strength" INTEGER 5
                ^"Stamina" INTEGER 5
                ^"Dexterity" INTEGER 5
                ^"Quickness" INTEGER 5
            }
            ^"Soak" INTEGER 20
            ^"Fatigue Levels" STRING "OK, 0/0/0/0/0/0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–6), –3 (7–12), –5 (13–18), Incapacitated (19–24)"
            ^"Vis" STRING "10 pawns of Ignem in the sword."
            ^"Appearance" STRING "A large man, with golden-tinged skin and burning-bright hair, dressed in a white robe that shines like the stars. He carries a burning greatsword."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Just" +3
            "Love of God" +5
            "Curious" +2
            "Merciful" +2
        }
        COMBAT {
            "Flaming Greatsword (both greatsword and fire are natural and thus not magically resisted)" INIT 18 ATTACK 21 DEFENSE 18 DAMAGE 25
        }
        ABILITIES {
            "Awareness" SCORE 5 SPECIALTY "casting magic"
            "Charm" SCORE 3 SPECIALTY "magi"
            "Divine Lore" SCORE 10 SPECIALTY "angels"
            "Great Weapon" SCORE 7 SPECIALTY "greatsword"
            "Leadership" SCORE 7 SPECIALTY "magi"
            "Magic Theory" SCORE 10 SPECIALTY "theological implications"
            "Order of Hermes Lore" SCORE 10 SPECIALTY "interactions with the Church"
            "Theology" SCORE 10 SPECIALTY "angelology"
        }
        POWERS {
            ^"Magic" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 or more points"
                    ^"Initiative" STRING "+18"
                    ^"Form" STRING "by effect"
                }
                DESCRIPTION "Seferiel can duplicate any effect of Hermetic magic, at a cost of 1 Might Point for every two magnitudes of the Hermetic effect. There is no limit, other than his remaining Might Pool, on the number of points he can spend on a single effect. This includes ritual effects, for which he needs neither vis nor long periods of time."
            }
            ^"Spirit Form" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+30"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Seferiel can become a creature of pure spirit as he wishes. This means that he is unable to affect things physically, or be affected physically."
            }
            ^"Subtle Form" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Seferiel can change his appearance to look like any human being. His statistics do not change."
            }
        }
        DESCRIPTION "Seferiel is an angel with special responsibility for Hermetic magi. Most of the time, he seeks to draw them closer to God, but sometimes he acts as the instrument of God's vengeance against those who are particularly wicked. His attitude depends slightly on whether magic is inherently sinful in your saga; his suggested courses of action depend on this more strongly. However, either way he likes Hermetic magi, in general, and finds them fascinating people. He often pretends to be a magus in order to get to know people better, and find out what they are really like. Seferiel sometimes takes an interest in a particular magus, one whom he sees has great potential, and is a suitable antagonist for the Plagued by Angel Story Flaw. His divinely-appointed mission is, however, to the Order as a whole, and he travels across Europe to bring God's message to as many magi as possible. He wears shining white robes and carries a flaming greatsword."
    }
    #tcWAeP9ikGkmEUfYPfHkLtUf ^"Faerie Hounds" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 5
            ^"Might Realm" STRING "Faerie" FIXED
            ^"Form" STRING "Animal"
            ^"Size" INTEGER 1
            ^"Characteristics" DEF {
                ^"Cunning" INTEGER 0
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER -4
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 2
            }
            ^"Soak" INTEGER 2
            ^"Wound Penalties" STRING "–1 (1-6), –3 (7-12), –5 (13-18), Incapacitated (19-24), Dead (25+)"
            ^"Vis" STRING "1 pawn Animal, dog corpse"
            ^"Appearance" STRING "Faerie hounds are usually of chunky hunting breeds. Many have shining eyes, and almost all have black, white, or green fur. These statistics also suit the hunting hounds of the courtly fae. This type of faerie hound often has a white coat, red ears, and blue eyes."
            ^"Source" STRING "Realms of Power: Faerie Bestiary"
        }
        VIRTUES {
            ^"Greater Faerie Power"
            OF "varies"
            ^"Faerie Beast"
            ^"Faerie Sight"
            ^"Improved Characteristics"
            ^"Sharp Ears"
            ^"Large"
        }
        FLAWS {
            ^"Incognizant"
            ^"Reckless"
            ^"Traditional Wards"
            OF "varies"
        }
        PERSONALITY_TRAITS {
            "Loyal" +3
            "Reckless" +3
            "Brave" +2
        }
        COMBAT {
            "Bite (small teeth)" INIT 2 ATTACK 10 DEFENSE 9 DAMAGE 1
        }
        ABILITIES {
            "Athletics" SCORE 5 SPECIALTY "distance running"
            "Awareness" SCORE 6 SPECIALTY "keeping watch"
            "Brawl" SCORE 5 SPECIALTY "bite"
            "Hunt" SCORE 6 SPECIALTY "track by scent"
        }
        POWERS {
            ^"Damaging Effect" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Varies"
                }
                DESCRIPTION ""
            }
            ^"Enthralling Sound" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "–2"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Used to cause terror and panic with its howl."
            }
            ^"Enthrallment" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "–2"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION ""
            }
            ^"Fearful Flaming Eyes" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "–2"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION ""
            }
            ^"Hound" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION ""
            }
            ^"Flight" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "constant +2"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION "(2 intricacy points on cost) Many also have the Personal Faerie Power of Flight. For this, add the Personal Faerie Powers Virtue."
                REFERENCES {
                    "Faerie Power" -> #t84d15c61569668f6f97c5a ^"Faerie Power"
                }
            }
        }
        DESCRIPTION "* In some cases, faerie hounds have the Lesser or Greater Faerie Power Damaging Effect, which adds +5 to the damage score of their bite. This is usually visually obvious, for example as their spittle ignites tiny flames on the ground, or their breath puffs like smoke because their teeth freeze like ice. For rapid character generation, select from the following Greater Powers. Many others are known, but these are the most common. Take a total of 50 spell levels of powers. Trading 5 full levels allows the character to spend an intricacy point to reduce the cost of each use of a power, or the Initiative penalty for the power, by 1. Huge faerie dogs haunt the roads of much of Mythic Europe. They terrify, and sometimes kill, travelers. Some can run rapidly, while others run upon their hindlimbs when chasing humans, so as to have their teeth closer to the victim's throat."
        REFERENCES {
            "Faerie Power" -> #t84d15c61569668f6f97c5a ^"Faerie Power"
            "Damaging Effect" -> #t885Vlj2jC9rqq8xEP0AI5tP ^"Damaging Effect"
            "Mythic Europe" -> #tARMDefConceptMythicEurope ^"Mythic Europe"
        }
    }
    #trHHWmKTfE8lSoQk2182uUEV ^"Faerie Knight" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 10
            ^"Might Realm" STRING "Faerie" FIXED
            ^"Form" STRING "Corpus"
            ^"Size" INTEGER 1
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER -2
                ^"Communication" INTEGER -2
                ^"Strength" INTEGER 3
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 1
            }
            ^"Virtues and Flaws" LIST ["Faerie Sight", "Faerie Speech", "Large", "Narrowly Cognizant", "Observant", "Sovereign Ward (varies)", "Vow (Chivalrous conduct)", "Oath of Fealty", "Overconfident"]
            ^"Soak" INTEGER 9
            ^"Wound Penalties" STRING "–1 (1–6), –3 (7–12), –5 (13–18), Incapacitated (19–25), Dead (26+)"
            ^"Vis" STRING "2 pawns, often rusty pieces of armor that the knight has poured its glamour into."
            ^"Appearance" STRING "A knight clad in silver leaves of metal, astride a fine horse. These knights often display the motif of their court on their surcoat, shield and pavilion."
            ^"Source" STRING "Bestiary"
        }
        PERSONALITY_TRAITS {
            "Arrogant" +3
            "Courteous" +3
        }
        COMBAT {
            "Brawl (gauntlet)" INIT 1 ATTACK 6 DEFENSE 6 DAMAGE 5
            "Long Sword and Heater Shield" INIT 3 ATTACK 10 DEFENSE 9 DAMAGE 9
            "Mace and Heater shield" INIT 2 ATTACK 9 DEFENSE 8 DAMAGE 11
            "Lance and Heater Shield (mounted)" INIT 3 ATTACK 10 DEFENSE 8 DAMAGE 8
        }
        ABILITIES {
            "Awareness" SCORE 1 SPECIALTY "enemies"
            "Brawl" SCORE 3 SPECIALTY "knights"
            "Carouse" SCORE 3 SPECIALTY "feasts"
            "Charm" SCORE 1 SPECIALTY "ladies"
            "Etiquette" SCORE 3 SPECIALTY "chivalrous combat"
            "Faerie Speech" SCORE 5 SPECIALTY "boasting"
            "Hunt" SCORE 2 SPECIALTY "humans"
            "Leadership" SCORE 2 SPECIALTY "guards"
            "Ride" SCORE 3 SPECIALTY "horses"
            "Single Weapon" SCORE 4 SPECIALTY "varies"
        }
        POWERS {
            ^"Damaging Effect" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–4"
                    ^"Form" STRING "as per motif of court"
                }
                DESCRIPTION "Causes all of the faerie's weapons, which are part of its glamor, to take on a more deadly aspect for two minutes. The danger of the aspect varies according to the motif usual for the faerie, but always increases the weapon's Damage by +5."
            }
            ^"Flight" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "The character is capable of flight. The character may use the Athletics skill to simulate difficult maneuvers, but may not engage in combat while flying incredibly swiftly. The faerie may not fly when heavily encumbered, or with a passenger of its Size or more, unless assisted by another faerie that shares the load."
            }
            ^"Shift Human Shapes" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Allows the knight, who is usually armored to demonstrate his role, to remove the armor simply by thinking about it."
            }
        }
        DESCRIPTION "Many knights have far higher scores than their listed Pretenses. These statistics are correct for faeries that plan to improve their Pretenses by losing to a character, then mirroring his experience gain for the season. The knight has a faerie horse constructed of the knight's own glamour, so it flies when the knight does, and shares the knight's Magic Resistance. These faeries are often encountered outside courts, on lonely roads, and guarding bridges. They seek out defeat by humans as a way of gaining additional combat Pretenses. They are never seen with their armor off, so they may be a role that other faeries take on when they wish to enjoy some blood sport. Faerie Knights are more bound to the rules of chivalry than real knights, and so they do not use the Damaging Effect Power on their weapons against worthy foes."
        REFERENCES {
            "Magic Resistance" -> #tmM1uJVBdvXpEsg4iImNPyjr ^"Magic Resistance"
            "Damaging Effect" -> #tb6e8db94547f5a6207e5 ^"Damaging Effect"
        }
    }
