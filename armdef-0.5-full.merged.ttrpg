    # The chapter's virtues flaws, structured; each DESCRIPTION the source's text, verbatim.
    #tc82835baec79703a8f3d64 ^"Ablating" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Major"
            ^"Category" STRING "Goetic Art"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 82
        }
        DESCRIPTION "When combined with Summoning, Ablating allows a sorcerer to leech away the power of a demon or other spirit for his own. This Virtue opens the Ablating

Art for him at 0, the mechanics of which are found in Chapter 11: Ars Goetia."
    }
    #t42b2be654dc4e48a4e59eb ^"Binding" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Major"
            ^"Category" STRING "Goetic Art"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 83
        }
        DESCRIPTION "Binding is the Art of forcing a demon or a similarly incorporeal spirit into a physical object or person, for one of many different purposes. It is combined with Summoning to produce an effect, as described in Chapter 11: Ars Goetia. Taking this Virtue opens the character’s score in the Binding Art at 0."
    }
    #ta7ceec05fa18739bfa4cd8 ^"Chthonic Magic" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Major"
            ^"Category" STRING "Hermetic Supernatural"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 83
        }
        DESCRIPTION "Something about the character’s magic is very sinister or dark, and because of this he can benefit from many aspects of the Infernal realm even if he is not actually evil. This gives the character the Supernatural Ability Chthonic Magic at 1, and has other benefits as well, described below under New Abilities and in Chapter 12: Black Magic."
    }
    #t585990b8949fb6bd9fb9a9 ^"Commanding" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Major"
            ^"Category" STRING "Goetic Art"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 83
        }
        DESCRIPTION "A sorcerer with the Commanding Art can summon demons that perform as he instructs them, when combined with Summoning as described in Chapter 11: Ars Goetia. This Virtue opens the character’s score in Commanding at 0."
    }
    #t3a6df19e2ab60c6e07286f ^"Consumption" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Major"
            ^"Category" STRING "Unholy Power"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 83
        }
        DESCRIPTION "This Virtue gives the character the Supernatural Ability of Consumption at 1. See Chapter 10: The Maleficia, for more information on this Unholy Power."
    }
    #t0666e111151a6f8af4144e ^"Corruption" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
