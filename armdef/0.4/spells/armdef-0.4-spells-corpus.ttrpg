        DESCRIPTION "Twists the target's tongue into a spiral, completely destroying the ability to speak. A grave offense to a magus. The damage heals as a Medium Wound."
    }

    #tsOWmr9yjxE1NJarc4FQtbtS ^"Clenching Grasp of the Crushed Heart" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo" FIXED
            ^"Form" STRING "Corpus" FIXED
            ^"Level" INTEGER 40 FIXED
