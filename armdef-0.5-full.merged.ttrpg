    #t23f3c6836b4e77ed76fe80 ^"Passing the Reins of Corpus" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Vim"
            ^"General Level" BOOLEAN true
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
