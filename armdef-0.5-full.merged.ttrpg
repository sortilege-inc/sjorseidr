    # Bran in Gai Móir (Chapter Five: The Covenant of Longmist, p111): one character, its stat lines verbatim fields.
    #t7bfceafb72cd80cab7e749 ^"Bran in Gai Móir" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Companion"
            ^"Covenant" LIST [#ta1a53a5b77da0fd4b2083d ^"Longmist"]
            ^"Characteristics" STRING "Int 0, Per 0, Pre 0, Com 0, Str +1, Sta 0, Dex +2, Qik +2"
            ^"Size" STRING "+1"
            ^"Age" STRING "34 (34)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (4)"
            ^"Confidence" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Knight; Faeborchless; Large, Reserves of Strength, Warrior; Difficult Underlings; Covenant Upbringing, Prohibition (Must not suffer a dog in his house) Described below"
            ^"Personality Trait" STRING "Daring +3, Conflicted Loyalties +2, Boastful +1 Combat: Dodge: Init –1, Attack n/a, Defense +6, Damage n/a Fist: Init –1, Attack +7, Defense +7, Damage +1 Dagger: Init –1, Attack +8, Defense +6, Damage +4 Sparra & Round Shield: Init +0, Attack +12, Defense +10, Damage +7 Long Spear (mounted): Init +1, Attack +14, Defense +10, Damage +6 Long Spear: Init +2, Attack +9, Defense +7, Damage +8"
            ^"Soak" STRING "+9"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–6), –3 (7–12), –5 (13–18), Incapacitated (19–24), Dead (25+)"
            ^"Abilities" STRING "Area Lore: Ulaid 4 (geography), Athletics 3 (running), Brawl 4 (fist), Carouse 2 (games of chance), Chirurgy 3 (setting bones), Etiquette 2 (faeries), Great Weapon 3 (long spear), Hunt 3 (tracking), Gaelic 5 (slang), Leadership 5 (in combat), Organization Lore: Covenant of Longmist 3 (politics), Organization Lore: Order of Hermes 2 (history), Ride 5 (battle), Single Weapon 5 (sparra), Survival 1 (peat bogs), Swim 1 (diving)"
            ^"Equipment" STRING "Round shield, full chain mail, horse"
            ^"Encumbrance" STRING "4 (4)"
            ^"Appearance" STRING "Bran is a tall man, longlimbed and standing a head taller than most of the grogs he leads."
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 111
        }
        DESCRIPTION " His arms and armor have been handed down from prior generations and have been altered to fit him. If using the rules for damaged goods from City & Guild, the armor has just one Damage Level left. He wants new equipment for himself and his men. Use the prices listed in City & Guild, page 144 to help decide how the magi treat his requests."
    }
    # Conchobor (Chapter Five: The Covenant of Longmist, p106): one character, its stat lines verbatim fields.
    #t4a800e075b15a7a3b7172f ^"Conchobor" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#ta1a53a5b77da0fd4b2083d ^"Longmist"]
            ^"Characteristics" STRING "Int +2, Per +1, Pre –1, Com +2, Str 0, Sta +2, Dex –1, Qik –1"
            ^"Size" STRING "0"
            ^"Age" STRING "112 (75)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "6 (20)"
            ^"Confidence" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "The Gift; Hermetic Magus; Major Magical Focus (Commanding Natural Forces), Strong Goblin Blood; Faerie Magic, Good Teacher, Nature Lore (Underworld), Second Sight; Deficient Technique (Muto), Favors (Túatha Dé Danann); Difficult Spontaneous Magic, Hatred (Lugh) Provides +1 to stealth totals and he has small horns protruding from his head House Virtue Gained through Strong Faerie Blood"
            ^"Personality Trait" STRING "Hateful toward Lugh +3, Insular +3, Charming –1"
            ^"Reputations" STRING "Willing ally 4 (Túatha Dé Danann) Combat: Dodge: Init –1, Attack n/a, Defense –1, Damage n/a Fist: Init –1, Attack –1, Defense –1, Damage +0 Bludgeon: Init –2, Attack +1, Defense –1, Damage +2"
            ^"Soak" STRING "+2"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Area Lore: Ulaid 4 (legends), Artes Liberales 3 (ceremonial magic), Burrow Lore 5, Code of Hermes 3 (Tribunal procedures), Concentration 3 (spell concentration), Faerie Lore 7 (The Túatha Dé Danann), Faerie Magic 5 (Intellego), Finesse 4 (precision), Guile 3 (lying concerning his magic), Gaelic 5 (poetry), Latin 5 (Hermetic usage), Magic Lore 6 (regiones), Magic Theory 10 (Intellego), Merinita Cult Lore 4 (Initiating self), Organization Lore: Covenant of Longmist 4 (history), Organization Lore: Order of Hermes 3 (politics), Parma Magica 6 (Mentem), Penetration 4 (Animal), Philosophiae 3 (ceremonial magic), Second Sight 6 (invisible faeries), Underworld Lore 5 (navigation) Arts: Cr 9, In 18, Mu 12, Pe 9, Re 15, An 14, Aq 7, Au 9, Co 5, He 12, Ig 6, Im 6, Me 7, Te 9, Vi 11"
            ^"Twilight Scars" STRING "His Parma Magica does not shield him from the effects of The Gift"
            ^"Equipment" STRING "Bronze arm talisman, cloak, and staff, as described below."
            ^"Encumbrance" STRING "1 (1)"
            ^"Appearance" STRING "Hunched and wrinkled, his sparse white hair is cut short and stands up in patchy clumps. He is forever watching from the corner of his hooded eyes. His left arm appears to be made of banded bronze and it still retains a robust classical youthfulness, though its weight drags him down on his left side."
            ^"Casting Sigil" STRING "Black mist swirls around his right arm and hand."
            ^"Voting Sigil" STRING "A large bronze broach embossed and patterned around the edges."
            ^"Spells Known" STRING "Image of the Beast (InAn 5) +34 Opening the Tome of the Animal’s Mind (InAn 25) +34 To See as Others See (In(Re)An 45) +45† The Gentle Beast (ReAn 25) +45† Viper’s Gaze (ReAn 15) +31 Mastering the Unruly Beast (ReAn 25) +45† Ward Against the Beasts of Legend (ReAn 25) +45† Voice of the Lake (InAq 25) +27 Gathering of the Stormy Might (ReAu 40) +35† Stir the Slumbering Tree (MuHe(Me) 25) +14† Lord of the Trees (ReHe 25) +41† Calling the Council of the Trees (Re(In)He 45) +47† Tales of the Ashes (InIg 5) +26 Leap of the Fire (ReIg 10) +29† The Obedient Fire (ReIg 20) +29† Prying Eyes (InIm 5) +26 Summoning the Distant Image (InIm 25) +26 Veil of Invisibility (PeIm 20) +17 Wizard’s Sidestep (ReIm 10) +23 Silence of the Smothered Sound (PeIm 20) +17 Sense the Feet that Tread the Earth (InTe 30) +29 Stone Tell of the Mind that Sits (InTe 30) +29 Earth Shock (ReTe 30) +26 Sense of Faerie Power (InVi 2) +31 Sense of Magical Power (InVi 2) +31 Opening the Intangible Tunnel (ReVi 30) +28 Houses of Hermes: True Lineages, page 139 † Focus applied"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 106
        }
    }
