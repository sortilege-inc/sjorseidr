            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "Telling convincing lies, as well as feigning emotion, belief, or frame of mind. If you understand the person you are attempting to deceive (roll 9+ on Perception + Folk Ken), you gain a bonus of +1 to your Guile roll. This Ability also covers disguising yourself, and pretending to be something you are not. It is often an opposed roll, against the victim's Perception + Folk Ken or, for disguise, Perception + Awareness."
        REFERENCES {
            "Folk Ken" -> #tsjid9PuuYMjxSZew5KRo08D ^"Folk Ken"
            "Folk Ken" -> #tsjid9PuuYMjxSZew5KRo08D ^"Folk Ken"
        }
    }
    #tDSYRWGpbar2NEC1iNEIZjH4 ^"Heartbeast" DEF {
