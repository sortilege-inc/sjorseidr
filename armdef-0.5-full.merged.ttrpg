            "Brawl" SCORE 3 SPECIALTY "Burn Power"
            "Charm" SCORE 3 SPECIALTY "small animals"
            "Penetration" SCORE 3 SPECIALTY "Fascination Power"
        }
        POWERS {
            ^"Burn" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "See insert for details."
            }
            ^"Fascination" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "+6"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See insert for details."
            }
            ^"Enliven the Gross Fire" DEF {
                PROPERTIES {
                    ^"Cost" STRING "6 points"
                    ^"Initiative" STRING "–10"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "This ritual-like power rarefies (creates) a fire elemental from a sufficient amount of raw elemental matter. The elemental can have any Might less than that of the creature using this power. The elemental is automatically under the control of the creature; this power can also be used to control elementals which are not of the creature's own making, but in this case must Penetrate the elemental's Might. When the creature has no further use for the elemental, its control lapses but the elemental remains."
            }
        }
        DESCRIPTION "Recovers Might points in one quarter of the normal time, which for an elemental means 3 weeks rather than a season. For a Might 15 elemental this is approximately 2 Might points every 3 days. Born of a lightning strike hitting a magically tainted tree (perhaps a vis source), this elemental has the frightening power to spawn more fire elementals, which it does if fought with water."
    }
    #t5IiGmUEodyl6VO84W7eyUII ^"Ghostly Warder" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Major" FIXED
            ^"Category" STRING "General" FIXED
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "A ghost watches over you. It might be a grandparent, a childhood friend, or anyone else who cares for you enough to stay around after death. The ghost is invisible and silent to all but you and those with Second Sight (see page 170). It can see and hear what is going on around you and makes an excellent spy, since it can leave your presence once per day for up to half an hour. However, death does not leave people in their normal state of mind, so the ghost probably has some quirks that make it less than dependable — it might even encourage you to join it on the other side. The ghost has 300 experience points in various Abilities that it can use to advise you, and ghosts may take any Abilities. See page 457 for an example of a ghostly warder. This is a more specific version of Magical Warder (see later), and is an example of that Virtue."
        REFERENCES {
            "Second Sight" -> #tK3lWiuLQzp34S7lnZh3DDcI ^"Second Sight"
            "Magical Warder" -> #thWasAWRwjyVrWdYyi5TV04u ^"Magical Warder"
        }
    }
    #tMebeN5F0u5en9fBZctRtrnB ^"A Typical Giant" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 12
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Corpus"
            ^"Size" INTEGER 5
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -3
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER -3
                ^"Strength" INTEGER 12
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER -2
            }
            ^"Virtues and Flaws" LIST ["Tough", "Warrior", "Wrathful (minor)", "Weak-Willed"]
            ^"Soak" INTEGER 9
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–10), –3 (11–20), –5 (21–30), Incapacitated (31–40), Dead (41+)"
            ^"Vis" STRING "3 Corpus in skull"
            ^"Appearance" STRING "The common giant is an enormous, ugly man with bulging eyes, an oversized, squarish head, and a shapeless gash of a mouth full of crooked teeth. He stands about 20 feet tall and wears a crude garment stitched together from bear skins."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Oafish" +3
        }
        COMBAT {
            "Cudgel" INIT -2 ATTACK 12 DEFENSE 5 DAMAGE 19
            "Kick" INIT -3 ATTACK 6 DEFENSE 1 DAMAGE 15
            "Stone" INIT -3 ATTACK 7 DEFENSE 2 DAMAGE 14
        }
        ABILITIES {
            "Brawl" SCORE 4 SPECIALTY "kick"
            "Great Weapon" SCORE 5 SPECIALTY "cudgel"
            "Living Language" SCORE 4 SPECIALTY "coarse expressions"
            "Thrown Weapon" SCORE 3 SPECIALTY "stone"
        }
        DESCRIPTION "These statistics are for a typical giant of the sort found throughout the British Isles. Such giants have been known to form alliances with hedge wizards or faeries. Unlike many magical creatures, giants need to eat, drink, and breathe, and get old and die."
    }
    #tU9MV3x8k1tgkYk7apwrvHck ^"Sir Giles, a Ghostly Knight" DEF {
        EXTENDS #tkHQwIw27s2JEQNqDUseWeLJ ^"Magic Character"
        PROPERTIES {
            ^"Shape" STRING "character" FIXED
            ^"Page" INTEGER 117
            ^"Magic Might" STRING "16 (Mentem)"
            ^"Characteristics" STRING "Int –1, Per –1, Pre +1, Com 0, Str +2, Sta +1, Dex +2, Qik +2"
            ^"Size" STRING "0"
            ^"Season" STRING "Summer"
            ^"Confidence Score" STRING "2 (6)"
            ^"Virtues and Flaws" STRING "Magic Spirit; Magical Monster, Knight; Puissant Single Weapon, Self-Confident; Proud (Major); Baneful Circumstances (during the day)"
            ^"Magic Qualities and Inferiorities" STRING "Greater Power (x2); Improved Abilities (x2), Improved Might (x4), Lesser Power; Minor Flaw (x 1)"
            ^"Personality Trait" STRING "Proud +6, Belligerent +2, Brave +2"
            ^"Reputations" STRING "Proud 3 (local)"
            ^"Combat" STRING "Lance & Heater, mounted: Init +3, Attack +16, Defense +14, Damage +7 Lance, dismounted: Init +4, Attack +8, Defense +5, Damage +9 Long Sword & Heater, mounted: Init +3, Attack +17, Defense +16, Damage +8 Long Sword & Heater: Init +3, Attack +14, Defense +13, Damage +8 Long Sword only: Init +3, Attack +13, Defense +9, Damage +8"
            ^"Soak" STRING "+10"
            ^"Fatigue Levels" STRING "OK, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1(1–5), –3 (6–10), –5 (11–15), Incapacitated (16+)"
            ^"Abilities" STRING "(Area) Lore 3 (nobles), Animal Handling 3 (horses), Athletics 2 (running), Awareness 3 (in battle), Brawl 2 (fist), Concentration 1 (remaining invisible), Charm 1 (ladies), Etiquette 3 (nobles), Great Weapon 3 (long spear), Hunt 2 (deer), Intrigue 1 (noble courts), Leadership 3 (soldiers), Ride 5 (in battle), Single Weapon 5 (long sword and heater)"
            ^"Powers" STRING "Donning the Corporeal Veil, 5 points, Init –1, Corpus: Sir Giles can assume material form. (Lesser Power) Riding the Phantom Steed, 2 points, Init 0, Animal R: Touch, D: Sun, T: Ind When Sir Giles takes physical form, he can also materialize his war horse for an additional Might cost. He can dissolve the horse at will due to the Rego requisite. Use the statistics for a destrier from the Book of Mundane Beasts appendix. Cr(Re)An 40 (Base 15, +1 Touch, +2 Sun, +1 Rego requisite, +1 Size): Greater Power (40 levels, –2 Might cost) Invisibility, 1 point, Init 0, Imaginem R: Touch, D: Conc, T: Group Even in material form, Sir Giles and his horse can become invisible when he wishes (though they can still be seen by Second Sight). PeIm 20 (Base 4, +1 Touch, +1 Conc, +2 Group): Greater Power (partial: 20 levels, –1 Might cost, 5 xp Concentration) Ride in Dreams, 1 point, Init 0, Mentem R: Touch, D: Sun, T: Ind When in spirit form, Sir Giles can enter the dreams of a sleeping person whose name he knows, tormenting him with nightmares of a furious, dark knight. The victim must make a Stamina roll against an Ease Factor of Sir Giles’ Presence + Leadership or lose a Long-Term Fatigue Level. CrMe 15 (Base 4, +1 Touch, +2 Sun): Greater Power (partial: 15 levels, –1 Might cost)"
            ^"Equipment" STRING "Full chain mail, lance, heater, long sword, black destrier"
            ^"Encumbrance" STRING "2 (4)"
            ^"Vis" STRING "4 Mentem in lance"
            ^"Appearance" STRING "Sir Giles is a Magical apparition — a ghostly knight in black mail, riding a fearsome black destrier. His shield and surcoat are solid black without any heraldic device, and atop his helm is a crest shaped like a cockerel. If he removes his helm, he appears to be a rather handsome, well-groomed knight whose face shows an expression of fierce pride. Magic THings The power of magic touches inanimate objects as often as it touches the living. Sometimes that power becomes concentrated as raw vis. While all raw vis is valuable to magi, rare forms have additional powers that make them even more desirable. Some items are not vis, but are still imbued with power by the realm of Magic; these are the Herbs and Objects of Virtue. Items and plants can also be awakened, giving them a certain amount of consciousness, but generally no Might score. Finally, the power of Magic can fully animate pure substances, creating the elementals."
            ^"Source" STRING "Realms of Power: Magic"
        }
    }
    #tlfl7LrbAgffEppYBpnaFv0j ^"A Magical Wolf" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 20
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Animal"
            ^"Size" INTEGER -1
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER 2
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 2
            }
            ^"Virtues and Flaws" LIST ["None"]
            ^"Reputations" LIST ["None"]
            ^"Soak" INTEGER 7
            ^"Fatigue Levels" STRING "n/a (The magical wolf is tireless.)"
            ^"Wound Penalties" STRING "–1 (1–4), –3 (5–8), –5 (9–12), Incapacitated (13–16)"
            ^"Vis" STRING "4 pawns of Animal, in head."
            ^"Appearance" STRING "A gray male wolf, slightly larger than normal, but only slightly, and looking extremely healthy. His eyes, in particular, sparkle more brightly than should be possible."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Leader" +3
            "Loyal" +2
        }
        COMBAT {
            "Bite" INIT 12 ATTACK 10 DEFENSE 14 DAMAGE 9
        }
        ABILITIES {
            "Area Lore" SCORE 6 SPECIALTY "game trails"
            "Brawl" SCORE 6 SPECIALTY "biting"
            "Hunt" SCORE 7 SPECIALTY "in a pack"
            "Living Language" SCORE 5 SPECIALTY "hunting terminology"
            "Survival" SCORE 6 SPECIALTY "forests"
        }
        POWERS {
            ^"Pack of One" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "+10"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION "The wolf can create five duplicates of himself, who can then fight as a trained group. For these purposes, treat the wolf as having a Leadership score of 5, so that he can get the full +15 group bonus to his attacks. The power lasts until the pack brings down its opponent, which may be a group, or disengages from the fight. As the pack is really all one creature, the nomination of a vanguard is arbitrary. Further, the group does not need to disengage and reform when the vanguard is killed; it can seamlessly transfer the role to another wolf. Finally, the wolf only dies if all the copies are killed. When the duplicates vanish, the least wounded wolf remains."
            }
            ^"Terrifying Howl" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Anyone who hears the wolf's howl is struck with fear of the wolf and of wilderness places away from the haunts of men. Someone already in a house will merely not want to leave. Overcoming this fear completely requires a Brave roll against an Ease Factor of 12. Acting sensibly while responding to it, such as heading back to the village carefully, requires a Brave roll against an Ease Factor of 6. Those who fail the easier roll simply flee in panic."
                REFERENCES {
                    "Ease Factor" -> #tGQufzy8y8Qc3foo2n9p7nMU ^"Ease Factor"
                    "Ease Factor" -> #tGQufzy8y8Qc3foo2n9p7nMU ^"Ease Factor"
                }
            }
            ^"Wolf Lord" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION "Any wolf the magical wolf strikes in deadly combat dies instantly. In addition, the magical wolf can make mundane wolves follow his instructions even when he is not around, as long as the instructions are quite simple."
            }
        }
        DESCRIPTION "The magical wolf does not care for such human niceties as names, and isn't particularly interested in human beings. Instead, he watches over all the wolves in his range, doing what he can to ensure their safety, health, and food supply. Sometimes, this means hunting wolves down himself, to keep population down, and in that case he removes the weak from the packs. While he has no interest in human beings, he does see that they are important, and might be willing to negotiate with a village. On the other hand, he might decide to drive them out. This magical wolf has the same reactions to The Gift as a mundane animal, although other magical wolves may not."
        REFERENCES {
            "The Gift" -> #tl8PlKeRUtDRy1gIvS6afpp4 ^"The Gift"
        }
    }
    #t0htLqUvgNyGFeD2tyVRtZ6o ^"Adranus, the Spirit of Mount Etna" DEF {
        EXTENDS #tkHQwIw27s2JEQNqDUseWeLJ ^"Magic Character"
        PROPERTIES {
            ^"Shape" STRING "character" FIXED
            ^"Page" INTEGER 111
            ^"Magic Might" STRING "50 (Ignem)"
            ^"Season" STRING "Winter"
            ^"Characteristics" STRING "Int +3, Per +3, Pre +2, Com +2, Str +3, Sta +2, Dex –1, Qik –2"
            ^"Confidence Score" STRING "1 (3 points)"
            ^"Virtues and Flaws" STRING "Magic Spirit, Daimon; Ways of the Mountains; Improved Characteristics x5; Fury, Wrathful"
            ^"Magical Qualities and Inferiorities" STRING "Focus Power x12, Greater Power, Ritual Power x9; Minor Virtue x2; Reduced Abilities x18"
            ^"Personality Trait" STRING "Wrathful +6, Slumbering +3"
            ^"Reputations" STRING "Bringer of Death and Destruction 5 (Local)"
            ^"Abilities" STRING "Sicily Lore 6 (mountains), Magic Lore 8 (underworld)"
            ^"Powers" STRING "Crafter of Fire, variable points, Init –2 – Might cost, Ignem: duplicates any non-Ritual Creo Ignem or Rego Ignem spell no greater than 50th level at a cost of 1 Might point per magnitude of the effect. (Focus Power x 2) Crafter of Earth, variable points, Init –2 – Might cost, Terram: duplicates any nonRitual Creo Terram or Rego Terram spell no greater than 50th level at a cost of 1 Might point per magnitude of the effect. (Focus Power x 2) Grant Visions, 5 points, Init –12, Vim: see Grant (Minor Flaw) for more details. (Ritual Power) Grant Simple-Minded, 5 points, Init –12, Vim: see Grant (Minor Flaw) for more details. (Ritual Power) Grant Wrathful, 5 points, Init –12, Vim: see Grant (Minor Flaw) for more details. (Ritual Power) Hibernation, 15 points, Init –32, Vim: the spirit remains completely inactive for a year (spending no other Might points); the 15 points spent on this power are saved and added to the Might Pool for the first year out of hibernation. In this fashion, the Might Pool may exceed the permanent Might score (50). Using this power, the volcano can save up Might points over many years in succession and have a great amount to spend in the single year in which it awakens. No Hermetic Equivalent: Ritual Power x 3 Manifestation, 4 or more points, Init –2 – Might cost, Animal (Focus Power x 2) Master of Earth, variable points, Init –2 – Might cost, Terram: duplicates any non-Ritual Muto Terram or Perdo Terram spell no greater than 50th level at a cost of 1 Might point per magnitude of the effect. (Focus Power x 2) Presence, 0 points, constant, Mentem (Greater Power) Regio, 15 points, Init –32, Vim: by permanently spending Might, the spirit can add levels to the regio around the volcano’s crater. (Ritual Power x 3) Ruler of Lava, variable points, Init –2 – Might cost, Terram: duplicates any non-Ritual spell pertaining to lava no greater than 50th level, at a cost of 1 Might point per magnitude of the effect. (Focus Power x2) Ruler of Smoke, variable points, Init –2 – Might cost, Auram: duplicates any non-Ritual spell pertaining to smoke no greater than 50th level, at a cost of 1 Might point per magnitude of the effect. (Focus Power x2)"
            ^"Vis" STRING "10 pawns of Ignem vis; 5 pawns per year can also be harvested from the crater at the volcano’s summit."
            ^"Appearance" STRING "Mount Etna is a conical and blasted peak that rises ten thousand feet above the eastern end of the island of Sicily."
            ^"Source" STRING "Realms of Power: Magic"
        }
    }
    #tJMEUj1sEYbkziMROZhlsRNy ^"Revenant, Corpse-Like Form" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 9
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Corpus"
            ^"Size" INTEGER 0
