        }
        PERSONALITY_TRAITS {
            "Loves Forest"
            +5
        }
        COMBAT {
            "2 x Brawl (club): Init 1+(Size x –1), Attack 8, Defense 7+(Size x –1), Damage +9+(Size x 2)"
            ATTACK 8
        }
        ABILITIES {
