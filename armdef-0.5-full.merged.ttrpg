            ^"Level" INTEGER 25 FIXED
            ^"Range" STRING "Arcane Connection"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Room"
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 2
            MODIFIERS {
                +4 "Arc"
                +1 "Conc"
                +2 "Room"
            }
        }
        DESCRIPTION "You can see and hear what is happening in a distant place if you have some sort of Arcane Connection to either the location or a person there."
    }
    #tHlWD1XK3ZbaWiu2Sd0jF0c8 ^"Taste of the Spices and Herbs" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto" FIXED
            ^"Form" STRING "Imaginem" FIXED
