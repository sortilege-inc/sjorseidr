            ^"Modifiers" STRING "–3 General Quality."
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "The lab setup is incomplete, and not all the necessary equipment has been installed. This Flaw is acquired after the first season of lab construction (see The Standard Hermetic Laboratory, earlier). It is removed after the second season of work completes the lab."
    }
    #ttD7fbKxWevY7b2dC4pQiGyT ^"Damaged (Lab Flaw)" DEF {
