            ^"Group" STRING "Structure" FIXED
            ^"Repeatable" BOOLEAN false
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "The lab is underground. There is a lack of natural light, and so more candles are required for lighting. +1 Upkeep, –1 Health, –1 Aesthetics; +1 Te."
    }
    #tYTikfYmm1WbIOoiHuE4s5FH ^"Exposed" DEF {
        EXTENDS #tnHWjNQB23uTkH5AHDfh2ZER ^"Laboratory Flaw"
        PROPERTIES {
