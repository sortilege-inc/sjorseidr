                DESCRIPTION "As *Circle of Beast Warding*."
            }
            #t315492bca81dca2eabdcf0 ^"Curse the Sinful Foe" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "As *Spasms of the Uncontrolled Hand*."
            }
            #t49d0fb99448660710ee031 ^"Halo" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "As *Lamp Without Flame*, which manifests as a halo around Abbas’ head."
            }
            #t84d94c58c142015d07f40d ^"The Lord’s Terrifying Herald" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
