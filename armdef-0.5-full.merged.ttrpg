    #tMs18NEt7bBB3DvXTdTBSsgj ^"Grant (Minor Flaw)" DEF {
        EXTENDS #tbQ683ClGPQQ2UpLbIXsx7h3 ^"Common Magic Power"
        PROPERTIES {
