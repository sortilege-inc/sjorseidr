            "Shield, Infantry" "Single" "n/a" "n/a" "4" "n/a" "0" "3" "Std." "Ancient" "n/a" "2" "New"
            "Trident" "Single" "3" "3" "3" "5" "1" "3" "Exp." "Ancient" "P" "2" "Guardians of the Forest, page 134"
            "Whip*" "Single" "2" "1" "1" "–3" "–2" "2" "Inexp." "All" "C, S" "1" "New"
