EXTENSION "ARMDef_Bestiary_Magical" {
    NAME "Ars Magica Definitive Edition - Creatures of Magic"
    VERSION "0.4"
    SPEC_VERSION "0.4"
    RELEASE_DATE "2026-07-14"
    DEPENDS_ON "ARMDef_Core_Creature"

    #td7NwuKqsgmFME5TIQT9Bcvd ^"Baghl, an Earth Jinni" DEF {
        EXTENDS ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 15
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Terram"
            ^"Size" INTEGER 2
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -2
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER -1
                ^"Strength" INTEGER 3
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER -1
            }
            ^"Virtues and Flaws" LIST ["Jinn", "Greater Immunity: Fire", "Ways of the Mountains", "Second Sight", "Skinchanger", "Strong-Willed", "Tough", "Greater Malediction (honor bargains made)", "Magical Air", "Vulnerable Magic (mua'addhin's call)", "Reclusive"]
            ^"Soak" INTEGER 10
            ^"Wound Penalties" STRING "–1 (1–7), –3 (8–14), –5 (15–21), Incapacitated (22–28), Dead (29+)"
            ^"Vis" STRING "1 pawn of Terram vis can be collected every year from his haunt, in the form of a quartz-encrusted stalactite at the back of his cave. If slain in physical form, his body yields 3 pawns of Terram vis."
            ^"Appearance" STRING "Baghl is the jinni of a dark cave found in the Elbruz mountains that was once used as a quarry until he drove off the miners. He may be appeased mainly by being left alone to enjoy his beautiful cave formations, although he sometimes agrees to converse with theological scholars. He appears as an obese man with a mule's head, pupilless eyes of jetblack stone, and quartz-veined limbs that heft an oversized maul. In physical form he can also assume the shape of a large black mule."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Reclusive" +5
            "Immutable" +3
            "Proud" +2
        }
        COMBAT {
            "Maul (warhammer)" INIT -1 ATTACK 11 DEFENSE 3 DAMAGE 15
        }
        ABILITIES {
            "Arabic" SCORE 5 SPECIALTY "stone"
            "Athletics" SCORE 3 SPECIALTY "climbing"
            "Great Weapon" SCORE 4 SPECIALTY "maul"
            "Profession: Miner" SCORE 3 SPECIALTY "gemstones"
            "Second Sight" SCORE 4 SPECIALTY "jinn"
            "Theology: Islam" SCORE 3 SPECIALTY "jinn"
        }
        POWERS {
            ^"Flesh to Stone" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "-4"
                    ^"Form" STRING "Terram"
                    ^"Design" STRING "Base 20, +1 Touch, +2 Sun"
                }
                DESCRIPTION "Baghl can change any human he touches into stone until sunrise or until the morning call to prayer."
            }
            ^"Ruler of Earth" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1–3 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "Duplicates any non-Ritual Perdo Terram or Rego Terram spell less than or equal to 15th level at a cost of 1 Might point per magnitude of the effect."
            }
            ^"Incorporeal" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "Constant"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Baghl is naturally both invisible and intangible, and cannot be influenced by the physical world. Magic can only directly target him if the caster can sense his existence. In this form he has no physical statistics or combat scores. Without taking a corporeal form, Baghl's physical characteristics are only used when dealing with other incorporeal creatures."
            }
            ^"Donning the Corporeal Veil" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Baghl can form the physical body described under Appearance to house his spiritual form; when doing so he acquires the physical characteristics, size, combat statistics, and Wound levels listed earlier. His arms and armor are also created with this power. He cannot become fatigued. This body lasts until he decides he no longer needs it. Killing the body does not kill Baghl."
            }
            ^"Presence" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Baghl is aware of everything that goes on within his haunt. This power needs to Penetrate to perceive beings with a Magic Resistance."
            }
        }
    }

    #t2JtJs2YkNOwxMVRQTadOqYA ^"Caladrius" DEF {
        EXTENDS ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 14
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Animal"
            ^"Size" INTEGER -2
            ^"Characteristics" DEF {
                ^"Cunning" INTEGER -1
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER -2
                ^"Strength" INTEGER -4
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 2
            }
            ^"Virtues and Flaws" LIST ["Lesser Immunity (to non-lethal diseases)", "Unaffected by the Gift", "Compassionate (minor)", "Noncombatant"]
            ^"Soak" INTEGER 3
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–3), –3 (4–6), –5 (7–9), Incapacitated (10–12), Dead (13+)"
            ^"Vis" STRING "3 Corpus (1 in each eye, 1 in the wings)"
            ^"Appearance" STRING "The caladrius is a magnificent, all-white bird somewhat resembling a heron (but with shorter legs and beak). It has a long, gracefully curving neck and a short, slightly downward-curving beak."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Ibis" +3
            "Magnificent Appearance (Presence)" +3
        }
        COMBAT {
            "Dodge" INIT 2 DEFENSE 5
        }
        ABILITIES {
            "Athletics" SCORE 3 SPECIALTY "flying"
            "Awareness" SCORE 4 SPECIALTY "food"
            "Brawl" SCORE 2 SPECIALTY "dodging"
            "Ignem Resistance" SCORE 4 SPECIALTY "solar heat"
            "Survival" SCORE 3 SPECIALTY "wetlands"
        }
        POWERS {
            ^"Healing Gaze" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "-14"
                    ^"Form" STRING "Corpus"
                    ^"Range" STRING "Eye"
                    ^"Duration" STRING "Mom"
                    ^"Target" STRING "Ind"
                    ^"Spell Equivalent" STRING "CrCo 40"
                    ^"Design" STRING "Base 30, +1 Eye, +1 affect either disease or aging"
                }
                DESCRIPTION "By gazing into a person's eyes, the caladrius can draw out any non-fatal disease from a sick person into itself. This removes any disease of up to Incapacitating strength, or resolves a critical or lesser aging crisis. The caladrius must immediately fly up toward the sun or else the disease returns to the patient."
            }
            ^"Perceive the Afflictions of Mortal Flesh" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Corpus"
                    ^"Range" STRING "Per"
                    ^"Duration" STRING "Mom"
                    ^"Target" STRING "Sight"
                    ^"Spell Equivalent" STRING "InCo 25"
                    ^"Design" STRING "Base 5, +4 Sight"
                }
                DESCRIPTION "By sight, the caladrius can identify any diseases a person has and how serious they are."
            }
        }
        DESCRIPTION "\"If anyone is ill, the caladrius will tell whether the patient will live or die.\" — Pierre de Beauvais"
    }

    #tfbqDPgdPsXPwZuq0IrIe7OJ ^"Aneirin the Bard" DEF {
        EXTENDS ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 15
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Imaginem"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER 2
                ^"Communication" INTEGER 4
            }
            ^"Vis" STRING "If his spirit is somehow bottled rather than banished 2 Imaginem Vis remains."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Careful" +3
            "Observant" +2
        }
        ABILITIES {
            "Area Lore Stonehenge Tribunal" SCORE 10
            "Magic Lore" SCORE 8
            "Music" SCORE 12
            "Teaching" SCORE 5
        }
        POWERS {
            ^"Discorporate" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING ""
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Aneirin never physically manifests, save as a shadow and a melodic voice. He can only be harmed with magic."
            }
            ^"Names of Power" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING ""
                }
                DESCRIPTION "Aneirin knows many names of minor spirits and can teach them as a result of a Pact."
            }
        }
        DESCRIPTION "One of the five great Welsh poets believed by the Order to have left Daimons behind after their death (the other four being Taliesin, Talhaearn Tad Awen, Blwchbardd, and Cian). Famous for a single poem, Y Gododdin, Aneirin praises his fellows among the war band of Mynyddawg Mwynfawr (Mynyddawg the Wealthy) of Caereidyn (near Edinburgh), an army 300 strong sent on a doomed mission to recapture an old Roman stronghold from the Saxons. His tomb lies somewhere in the Cambrian Mountains. His spirit wanders across the entire mountain range, helping those who further his ideals and punishing those who go against them, but he is most powerful within his own tomb."
    }

    #tyvUuB9Eed9VGLXQu58I13IE ^"Chnoubis the Serpent" DEF {
        EXTENDS ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 30
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Mentem"
            ^"Size" INTEGER -1
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 6
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 5
            }
            ^"Soak" INTEGER 9
            ^"Wound Penalties" STRING "–1 (1–4), –3 (5–8), –5 (9–12), Banished (13+)"
            ^"Vis" STRING "On being banished his scales remain, containing 3 pawns of Intellego and 2 of Mentem vis"
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Curious" +4
            "Diplomatic" +3
            "Proud" +2
            "Noble" +1
        }
        COMBAT {
            "Bite" INIT 5 ATTACK 8 DEFENSE 8 DAMAGE 5
        }
        POWERS {
            ^"Augury" DEF {
                PROPERTIES {
                    ^"Cost" STRING "varies"
                    ^"Initiative" STRING "+5"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "By using this power Chnoubis is able to perform auguries as the Virtue Divination & Augury (see The Mysteries Revised Edition, page 58), with each Might Point allowing ten levels of success. If you do not have access to The Mysteries Revised Edition, this power allows Chnoubis to duplicate the effects of any Hermetic Intellego spell, and costs 1 point for every ten levels of the spell."
            }
            ^"Aura of Rightful Authority" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "+5"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Equivalent to the ReMe20 Hermetic spell."
            }
            ^"Discorporation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "varies, 1 point"
                    ^"Initiative" STRING "+7"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Becomes a discorporate spirit which can move as fast as lightning and is only visible to Intellego Vim magics or Second Sight. He sneaks up on victims invisibly and bites them, then listens to their secrets as the toxin takes effect."
            }
        }
        DESCRIPTION "On being bitten the victim must make a Fatigue test against Ease Factor 9 or lose a Fatigue level each round until he has succeeded for three consecutive rounds or fallen unconscious. While suffering these effects, the victim is unable to tell a lie (Penetration 25, Mentem), and is eager to talk to anyone present about anything on their mind, talking to themselves if necessary. Once the victim falls unconscious no further Fatigue is lost, but they awaken with a terrible headache and must make a Stamina stress roll (plus Art of Memory if they have that Ability) at Ease Factor 6 to recall what transpired. A lion-headed serpent called upon for his abilities to scry and ferret out secrets. He claims to be a native of the Nile, but theurgists across Europe may successfully summon him. True to his visage, Chnoubis is a powerful fighter, but is much more interested in the power of words."
    }

    #t3HslLZrgCPuZ1XkzJ7zlP1x ^"Dietrich von Bern" DEF {
        EXTENDS ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 35
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Corpus"
            ^"Size" INTEGER 2
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 2
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER 5
                ^"Communication" INTEGER 3
                ^"Strength" INTEGER 5
                ^"Stamina" INTEGER 5
                ^"Dexterity" INTEGER 5
                ^"Quickness" INTEGER 3
            }
            ^"Soak" INTEGER 22
            ^"Wound Penalties" STRING "–1 (1–7), –3 (8–14), –5 (15–21), Banished (22+)"
            ^"Vis" STRING "7 Rego"
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Proud" +3
            "Barbarous" +2
            "Crafty" +2
        }
        COMBAT {
            "Greatsword" INIT 5 ATTACK 19 DEFENSE 17 DAMAGE 15
        }
        ABILITIES {
            "Athletics" SCORE 6
            "Great Weapon" SCORE 10
            "Intrigue" SCORE 6
            "Leadership" SCORE 8
        }
        POWERS {
            ^"Sacred Kingship" DEF {
                PROPERTIES {
                    ^"Cost" STRING "10 points"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "By laying hands on another character, Dietrich can permanently increase the character's Perception, Presence, or Communication by 1 point. He can only do this once per person, and can only to a maximum of +3. Increasing Presence this way is a very useful aid to the aspiring Mystagogue."
            }
        }
        DESCRIPTION "Dietrich's sword has been dipped in dragon's blood. No magical spell of a level 40 or lower can deflect, harm, or control it. After being hit, the dragon's blood burns, causing an extra +5 damage per round (armor does not soak) unless an alchemist, herbalist, or healer can cure the wound. Soak +22 is from full chain mail drenched in dragon's blood. A hero in German poetry and song, Dietrich was the boy-king of Bern after the fall of Rome. During his reign, several great Nibelungen heroes, including Siegfried himself, were loyal members of his court. When his uncle Ermenrik, German ruler of Rome, conquered Bern, Dietrich fled to the court of Attila the Hun, where he went on many adventures and became one of the greatest warriors in history. He returned after his uncle died, retook Bern and captured Rome. He died in a quest for revenge against a friend who betrayed him, and was buried in an ornate tomb in the Lessini Mountains, where the Alps cross over into Italy. His tomb is a treasure trove of weapons and armor, enchanted by being dipped in the blood of a great dragon Dietrich slew. When anyone enters the tomb, however, the Daimon of Dietrich animates his hulking corpse. If you come seeking wisdom and prove yourself worthy, he will dispense kingly advice. If you come seeking power, you will face one of the greatest warriors on Earth, even in death. Another legend propagated by the Church says Dietrich, a heretic suspected of Arianism, was thrown into the volcanic Mount Etna. The legend of Dietrich appears in Das Heldenbuch (\"The Book of Heroes\") a collection of German romances published in the early 13th century, organizing the tales of the Ostrogoths and Franconians into two epic cycles."
    }

    #tM7NqFgx0UTGKFNMuFyve1lK ^"Gydryty-kom the Giant" DEF {
        EXTENDS ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 40
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Auram"
            ^"Size" INTEGER 3
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER -2
                ^"Strength" INTEGER 8
                ^"Stamina" INTEGER 6
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 3
            }
            ^"Soak" INTEGER 20
            ^"Wound Penalties" STRING "–1 (1–8), –3 (9–16), –5 (17–24), Banished (25+)"
            ^"Vis" STRING "When he is banished his tongue remains, and contains 8 pawns of Auram Vis."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Hates Being Interrupted" +4
            "Determined" +3
            "Protective" +2
        }
        COMBAT {
            "Brawl" INIT 3 ATTACK 10 DEFENSE 10 DAMAGE 8
        }
        POWERS {
            ^"Auram Magic" DEF {
                PROPERTIES {
                    ^"Cost" STRING "varies"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "May perform equivalent effects to any Auram magic at a cost of 1 point per magnitude, or for spells involving hail, 1 point per three magnitudes. Can perform Auram Ritual spells as if they were Formulaic spells; no extra time or vis is required."
            }
            ^"Swallow Spells" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Can swallow any magical spell or effect with a level of 50 or less, completely dispelling it."
            }
        }
        DESCRIPTION "Gydryty-kom is the master of hail, a giant who can stretch his mouth from the ground to the clouds. He swallows storms and lightning, but grows angry when summoned because it interrupts his eternal battle with a Daimonic snake of fog that threatens to swallow the world. Gydryty-kom was once highly regarded in the lands of the Albanians, but his power has faded thanks to Christianity."
    }

    #tn3IVX5xghATdkGnZ5YQDIfW ^"Hipta the Nurse" DEF {
        EXTENDS ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 15
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Animal"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 3
                ^"Communication" INTEGER 2
            }
            ^"Wound Penalties" STRING "Varies by form. Substitute Banished for Incapacitated"
            ^"Vis" STRING "Leaves 3 pawns of Animal Vis in the form of a white feather when banished."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Calm" +4
            "Protective" +2
        }
        POWERS {
            ^"Shapechange" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+5"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION "May change form into any natural or fantastic beast from size –5 to +2. The change is instantaneous, and she can always speak in any form."
            }
            ^"Dispel" DEF {
                PROPERTIES {
                    ^"Cost" STRING "varies"
                    ^"Initiative" STRING "+5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "May perform any Perdo Vim spell at will, for the cost of one Might point per magnitude. Hipta counts as familiar with all styles of magic for this purpose, and has a Penetration Score of 30, making invoking her a common way to end malevolent curses."
            }
        }
        DESCRIPTION "The nurse of Dionysus, Hipta is a powerful shapechanger but favors the form of a lovely dove. Her name and spells to summon her can be found in several ancient texts. She is invoked for forgiveness from curses and magical harm. Str, Sta, Dex, Qik vary; Size varies from –5 to +2; Combat and Soak vary with form."
    }

    #tWGtr6inQBW8sRmR8OpkKwAI ^"Honos" DEF {
        EXTENDS ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 30
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Corpus"
            ^"Size" INTEGER 0
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 2
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER 3
                ^"Stamina" INTEGER 5
                ^"Dexterity" INTEGER 4
                ^"Quickness" INTEGER 4
            }
            ^"Soak" INTEGER 14
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–20), Incapacitated (21–25), Banished (26+)"
            ^"Vis" STRING "Leaves 6 pawns of Corpus in his armor when banished."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Honorable" +6
            "Authoritarian" +3
            "Disciplined" +3
        }
        COMBAT {
            "Long Spear" INIT 7 ATTACK 14 DEFENSE 12 DAMAGE 10
        }
        ABILITIES {
            "Athletics" SCORE 4
            "Great Weapon" SCORE 6 SPECIALTY "long spear"
            "Leadership" SCORE 6
            "Teaching" SCORE 3 SPECIALTY "leadership"
        }
        POWERS {
            ^"Instill Leadership" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "+4"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "With a touch of his long spear, Honos can teach 17 experience points in the ability Leadership, to a maximum of Ability score 6. The Theurgist receives the insights immediately, but must then devote the season to study and reflecting upon them to gain the increase."
            }
            ^"Centurions’ Feast" DEF {
                PROPERTIES {
                    ^"Cost" STRING "30 points"
                    ^"Initiative" STRING "+4"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Produces a magical feast sufficient to feed one hundred people. All who partake of the feast who possess the Flaw Dutybound are instantly cured of any Light and Medium Wounds, and gain +10 on their next recovery checks. The food lasts for one hour, then dissipates, but the effects are permanent."
            }
        }
        DESCRIPTION "Honos is a Roman Daimon of morality and military honor, with several temples built in his name. Honos appears as a young warrior in ancient armor, carrying a lance and a cornucopia (“horn of plenty”). Honos’ temples in Rome have been destroyed or blanketed by the Dominion, although the Legion of Mithras are rumored to know the location of one surviving shrine where he can be invoked."
    }

    #tDt5QYWqZc7U7UunnDspJIev ^"Portunes, Spirit of Safe Harbor" DEF {
        EXTENDS ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 25
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Auram"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 1
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 0
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER 0
            }
            ^"Wound Penalties" STRING "n/a"
            ^"Vis" STRING "None."
            ^"Appearance" STRING "When summoned, he appears either as a ghostly serpent or the shadowy visage of a bearded man in a leather apron, but he never takes on a solid physical form."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Watchful" +3
        }
        POWERS {
            ^"Safe Harbor" DEF {
                PROPERTIES {
                    ^"Cost" STRING "12 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "Guarantees calm weather in the harbor of a port for an entire season, and resists all spells that would disrupt this with a Magic Resistance of 60."
            }
            ^"Opening Enchanted Locks" DEF {
                PROPERTIES {
                    ^"Cost" STRING "8 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Portunes can dispel any magical lock with a level of less then 40 with this power."
            }
        }
        DESCRIPTION "A Spirit charged with ports and harbors, the Greeks called him Palaemon and Melicertes. His purview also covers keys, locks, and domestic animals. In Rome he was worshipped as a god, with a temple located near the Forum Boarium. His feast, the Portunalia, is observed on August 17th. The rite to summon him involves throwing keys into a fire. He has no combat: he vanishes if attacked, and can only be harmed by Perdo Vim spells. He never materializes, so has no Soak."
    }

    #tk6pGOlDxW6a8pCfEBfNMT0Z ^"Pukis, Dragon of the Hearth" DEF {
        EXTENDS ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 10
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Ignem"
            ^"Size" INTEGER -2
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -1
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER -1
                ^"Stamina" INTEGER 4
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 6
            }
            ^"Soak" INTEGER 8
            ^"Wound Penalties" STRING "–1 (1–3), –3 (4–6), –5 (7–9), Banished (10+)"
            ^"Vis" STRING "2 Ignem, 1 Rego"
            ^"Appearance" STRING "This Daimon takes the form of a small dragon of fire that dwells in the hearth or a fireplace. Although small, Pukis is long and thin."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Mischievous" +3
            "Loyal" +3
            "Fickle" +2
        }
        COMBAT {
            "Bite" INIT 5 ATTACK 6 DEFENSE 9 DAMAGE 3
            "Lashing tail" INIT 6 ATTACK 10 DEFENSE 13 DAMAGE 0
        }
        POWERS {
            ^"Invisibility" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "+6"
                    ^"Form" STRING "Imaginem"
                }
                DESCRIPTION "Pukis can turn itself completely invisible and inaudible, for as long as it chooses, or until it touches a person or animal."
            }
            ^"Mischievous Flame" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "+6"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "With a glance, Pukis can set anything slightly flammable aflame."
            }
            ^"Sneak Thief" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "+6"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "By touching any object weighing less than 3 pounds, Pukis can instantly teleport the object to its home so that it appears at the edge of its master’s hearth."
            }
            ^"Sacred Fire" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+6"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "As long as Pukis lives in a particular hearth, and the fire is kept hot year round, the ashes from the fire can be collected for 1 pawn of Ignem per season."
            }
        }
        DESCRIPTION "Although small, Pukis is long and thin. It can engage 2 opponents without penalty, attacking one with its jaws and the other with its quick tail. It is also burning hot, and can ignite easily flammable materials on touch. First summoned by Baltic wizards, it enjoys napping amongst burning logs and coals, coiling its long-snake like body beneath the flames to conceal its presence. It will leave gifts for the master of the household, possibly stolen from somewhere else, and will attack strangers if they act destructively. If it is treated poorly, it will cause mischief before departing. The magus Andrilikes, a theurgist of the Novgorod tribunal, wrote a Hermetic ritual for summoning this lesser Daimon to his sanctum, and has given copies to several of his friends."
    }

    #t5jq4HYMMIAelp9lC3CCiyUU ^"An Earth Elemental" DEF {
        EXTENDS ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 15
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Terram"
            ^"Size" INTEGER 0
            ^"Characteristics" DEF {
                ^"Cunning" INTEGER 0
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER -2
                ^"Communication" INTEGER -4
                ^"Strength" INTEGER 3
                ^"Stamina" INTEGER 6
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 0
            }
            ^"Virtues and Flaws" LIST ["Berserk", "Great Stamina", "Tough", "Ways of the Cavern", "Poor Memory", "Short Attention Span", "Simple Minded"]
            ^"Soak" INTEGER 9
            ^"Wound Penalties" STRING "–1 & 1 Might point (1–5), –3 & 3 Might points (6–10), –5 & 5 Might points (11–15), Incapacitated & 5 Might points (16–20), Dead & all Might points (21+)"
            ^"Vis" STRING "3 pawns of Terram, in body"
            ^"Appearance" STRING "An earth elemental appears much like any other object of earth or rock, except it is made up of sharp edges and right-angled corners that form cubic corpuscles of different sizes."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Cave" +3
        }
        COMBAT {
            "Bludgeon (includes Ways of the Cavern)" INIT 3 ATTACK 11 DEFENSE 7 DAMAGE 9
            "Bludgeon when Berserk (includes Ways of the Cavern)" INIT 3 ATTACK 13 DEFENSE -5 DAMAGE 9
        }
        ABILITIES {
            "Athletics" SCORE 3 SPECIALTY "pursuit"
            "Awareness" SCORE 2 SPECIALTY "interlopers"
            "Brawl" SCORE 3 SPECIALTY "bludgeon"
            "Penetration" SCORE 3 SPECIALTY "Slake Thirst Power"
            "Stealth" SCORE 2 SPECIALTY "keeping still"
        }
        POWERS {
            ^"Crush" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "-2"
                    ^"Form" STRING "Terram"
                    ^"Range" STRING "Touch"
                    ^"Duration" STRING "Sun"
                    ^"Target" STRING "Ind"
                }
                DESCRIPTION "The elemental clubs at an opponent with its heavy limbs, requiring a normal Bludgeon melee attack, which does its own damage as normal. If the elemental is at least equal in Size to its opponent, a successful Crush attack can pin him to the ground, and the elemental adds its (Might/5, rounded up) to its Grapple Strength to prevent its victim escaping. If the elemental successfully grapples, then any equipment carried by its victim is damaged; fragile items are destroyed, robust items are broken (and are destroyed if affected again by this power), and metal items are damaged (and are broken if affected again by this power)."
            }
            ^"Slake Thirst" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+4"
                    ^"Form" STRING "Aquam"
                    ^"Range" STRING "Touch"
                    ^"Duration" STRING "Mom"
                    ^"Target" STRING "Part"
                }
                DESCRIPTION "Earth elementals are always thirsty, and direct contact with the elemental removes water from the target, inflicting a Fatigue level of damage. Once all Fatigue levels are gone, successive strikes (or rounds of contact) inflict a Light Wound, then a Medium Wound, then a Heavy Wound, and so forth. Fatigue levels may be restored by drinking at least two pints of water (for a Size 0 individual), while wounds are healed as normal."
            }
        }
        DESCRIPTION "This elemental was rarefied in a cavern with a Magic aura, and guards the vis source found therein with a furious passion."
    }

    #tBU63PmLvk3O6byDLfC5mnhk ^"A Water Elemental" DEF {
