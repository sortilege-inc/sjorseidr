        }
        ABILITIES {
            "Area Lore" SCORE 3 SPECIALTY "medicinal herbs"
            "Artes Liberales" SCORE 1 SPECIALTY "astronomy"
            "Athletics" SCORE 1 SPECIALTY "climbing"
            "Awareness" SCORE 1 SPECIALTY "animals"
            "Charm" SCORE 3 SPECIALTY "peasants"
            "Chirurgy" SCORE 4 SPECIALTY "farm accidents"
            "Divine Lore" SCORE 1 SPECIALTY "relics"
            "Faerie Lore" SCORE 2 SPECIALTY "curses"
            "Folk Ken" SCORE 3 SPECIALTY "peasants"
            "Guile" SCORE 3 SPECIALTY "clergy"
            "Infernal Lore" SCORE 1 SPECIALTY "diabolists"
            "Latin" SCORE 4 SPECIALTY "medical terms"
            "Magic Lore" SCORE 5 SPECIALTY "regiones"
            "Medicine" SCORE 5 SPECIALTY "accidental poisonings"
            "Native Language" SCORE 5 SPECIALTY "choosing words carefully"
            "Premonitions" SCORE 3 SPECIALTY "threats to others"
            "Second Sight" SCORE 3 SPECIALTY "ghosts"
            "Survival" SCORE 3 SPECIALTY "near farmland"
            "Wilderness Sense" SCORE 3 SPECIALTY "weather"
        }
        CHOICES {
            "The Witch's magical powers are far, far weaker than a Hermetic magus's, but she doesn't have The Gift. She's an excellent healer, and people might not believe that her healing abilities are purely mundane. Intolerant clergy make good enemies, as do magical or faerie beings she has annoyed, although in that case you might want to change the Flaw to Plagued by Supernatural Entity or Supernatural Nuisance. She can take another Major Flaw, or three more Minor ones, along with corresponding Virtues."
        }
    }
    #tbf2vEu3oJe6he5uB2EKmixi TEMPLATE "Bjornaer" DEF {
        EXTENDS #t9M2MUBwsZfdFqGgeXfkdR9f ^"Magus"
        PROPERTIES {
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER -1
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER 1
            }
            ^"Size" INTEGER 0
            ^"Age" INTEGER 25
            ^"Apparent Age" INTEGER 25
            ^"Decrepitude" INTEGER 0
            ^"Warping Score" INTEGER 0
            ^"Warping Points" INTEGER 0
            ^"Confidence Score" INTEGER 1
            ^"Confidence Points" INTEGER 3
            ^"Hermetic Arts" DEF {
                ^"Creo" INTEGER 0
                ^"Intellego" INTEGER 1
                ^"Muto" INTEGER 10
                ^"Perdo" INTEGER 3
                ^"Rego" INTEGER 1
                ^"Animal" INTEGER 8
                ^"Aquam" INTEGER 0
                ^"Auram" INTEGER 0
                ^"Corpus" INTEGER 8
                ^"Herbam" INTEGER 0
                ^"Ignem" INTEGER 0
                ^"Imaginem" INTEGER 0
                ^"Mentem" INTEGER 0
                ^"Terram" INTEGER 0
                ^"Vim" INTEGER 0
            }
            ^"Virtues" LIST [^"The Gift", ^"Hermetic Magus", ^"Ways of the"("Forest"), ^"Heartbeast", ^"Inoffensive to"("Animals"), ^"Quiet Magic", ^"Quiet Magic", ^"Subtle Magic"]
            ^"Free Virtue" LIST [^"Heartbeast"]
            ^"Flaws" LIST [^"Blatant Gift", ^"Tormenting Master", ^"Deficient Form"(^"Ignem")]
            ^"Soak" INTEGER 1
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Twilight Scars" STRING "None"
            ^"Equipment" LIST ["Wizardly robes"]
            ^"Encumbrance" STRING "0 (0)"
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Brave" +2
            "Status-seeking" +2
            "Obedient" +1
        }
        COMBAT {
            "Dodging" INIT 1 DEFENSE 4
        }
        ABILITIES {
            "Area Lore" SCORE 1 SPECIALTY "forests"
            "Artes Liberales" SCORE 1 SPECIALTY "grammar"
            "Athletics" SCORE 2 SPECIALTY "endurance"
            "Awareness" SCORE 2 SPECIALTY "people"
            "Brawl" SCORE 2 SPECIALTY "dodge"
            "Finesse" SCORE 1 SPECIALTY "targeting"
            "Folk Ken" SCORE 1 SPECIALTY "hunters"
            "Guile" SCORE 1 SPECIALTY "pretending to know less than you do"
            "Heartbeast" SCORE 2 SPECIALTY "changing into a wolf"
            "Hunt" SCORE 2 SPECIALTY "small animals"
            "Latin" SCORE 4 SPECIALTY "Hermetic terms"
            "Living Language" SCORE 5 SPECIALTY "talking about the wilderness"
            "Magic Theory" SCORE 3 SPECIALTY "Animal"
            "Parma Magica" SCORE 1 SPECIALTY "Animal"
            "Penetration" SCORE 1 SPECIALTY "Muto"
            "Order of Hermes Lore" SCORE 1 SPECIALTY "Bjornaer"
            "Second Area Lore" SCORE 1 SPECIALTY "forests"
            "Survival" SCORE 3 SPECIALTY "forests"
        }
        SPELLS_KNOWN {
            ^"Transformation of the Ravenous Beast to the Torpid Toad"
            TECHNIQUE "Muto" FORM "Animal" LEVEL 25 CASTING_TOTAL 19
            ^"Agony of the Beast"
            TECHNIQUE "Perdo" FORM "Animal" LEVEL 15 CASTING_TOTAL 12
            ^"Circle of Beast Warding"
            TECHNIQUE "Rego" FORM "Animal" LEVEL 5 CASTING_TOTAL 10
            ^"Viper's Gaze"
            TECHNIQUE "Rego" FORM "Animal" LEVEL 15 CASTING_TOTAL 10
            ^"Eyes of the Cat"
            TECHNIQUE "Muto" FORM "Corpus" REQUISITE "An" LEVEL 5 CASTING_TOTAL 19
            ^"Gift of the Bear's Fortitude"
            TECHNIQUE "Muto" FORM "Corpus" LEVEL 25 CASTING_TOTAL 19
            ^"The Wound that Weeps"
            TECHNIQUE "Perdo" FORM "Corpus" LEVEL 15 CASTING_TOTAL 12
            ^"Lifting the Dangling Puppet"
            TECHNIQUE "Rego" FORM "Corpus" LEVEL 15 CASTING_TOTAL 10
        }
        CHOICES {
            "The Bjornaer is much more comfortable with animals than with people, and may think of him or herself as just as much animal as human. The combination of Blatant Gift and Inoffensive to Animals means that she gets along better with animals than with people. Ways of the Forest should be changed to a terrain appropriate to the actual heartbeast; a wolf is assumed for the example. Both Major Flaws can be changed freely, and while Deficient Form (Ignem) is very common in House Bjornaer, there is no particular reason for your character to have it. Note that Quiet and Subtle Magic allow the magus to cast in his heartbeast form without any penalty."
        }
    }
    #tUnZgttBQe4Bptnpb965GVX9 TEMPLATE "Bonisagus" DEF {
        EXTENDS #t9M2MUBwsZfdFqGgeXfkdR9f ^"Magus"
        PROPERTIES {
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 5
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 0
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER 0
            }
            ^"Size" INTEGER 0
            ^"Age" INTEGER 25
            ^"Apparent Age" INTEGER 25
            ^"Decrepitude" INTEGER 0
            ^"Warping Score" INTEGER 0
            ^"Warping Points" INTEGER 0
            ^"Confidence Score" INTEGER 1
            ^"Confidence Points" INTEGER 3
            ^"Hermetic Arts" DEF {
                ^"Creo" INTEGER 12
                ^"Intellego" INTEGER 0
                ^"Muto" INTEGER 0
                ^"Perdo" INTEGER 0
                ^"Rego" INTEGER 3
                ^"Animal" INTEGER 0
                ^"Aquam" INTEGER 0
                ^"Auram" INTEGER 12
                ^"Corpus" INTEGER 4
                ^"Herbam" INTEGER 0
                ^"Ignem" INTEGER 0
                ^"Imaginem" INTEGER 0
                ^"Mentem" INTEGER 0
                ^"Terram" INTEGER 0
                ^"Vim" INTEGER 0
            }
            ^"Virtues" LIST [^"The Gift", ^"Hermetic Magus", ^"Affinity with Art"(^"Auram"), ^"Affinity with Art"(^"Creo"), ^"Book Learner", ^"Free Study", ^"Great"(^"Intelligence"), ^"Great"(^"Intelligence"), ^"Inventive Genius", ^"Puissant Ability"(^"Magic Theory"), ^"Secondary Insight"]
            ^"Free Virtue" LIST [^"Puissant Ability"(^"Magic Theory")]
            ^"Flaws" LIST [^"Favors", ^"Painful Magic", ^"Driven"("Minor"), ^"Weak Enchanter"]
            ^"Soak" INTEGER 0
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Twilight Scars" STRING "None"
            ^"Equipment" LIST ["Wizardly robes."]
            ^"Encumbrance" STRING "0 (0)"
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Brave" -1
            "Driven" +3
            "Studious" +2
        }
        COMBAT {
            "Dodging" INIT 0 DEFENSE 0
        }
        ABILITIES {
            "Artes Liberales" SCORE 1 SPECIALTY "logic"
            "Awareness" SCORE 2 SPECIALTY "when working"
            "Charm" SCORE 2 SPECIALTY "equals"
            "Concentration" SCORE 3 SPECIALTY "spell casting"
            "Folk Ken" SCORE 2 SPECIALTY "magi"
            "Latin" SCORE 4 SPECIALTY "Hermetic technical terms"
            "Magic Lore" SCORE 1 SPECIALTY "nonHermetic magic"
            "Magic Theory" SCORE 4 SPECIALTY "Creo"
            "Native Language" SCORE 5 SPECIALTY "educated talk"
            "Order of Hermes Lore" SCORE 2 SPECIALTY "great discoveries"
            "Parma Magica" SCORE 1 SPECIALTY "Mentem"
            "Penetration" SCORE 1 SPECIALTY "Auram"
            "Teaching" SCORE 3 SPECIALTY "Hermetic Arts"
        }
        SPELLS_KNOWN {
            ^"Charge of the Angry Winds"
            TECHNIQUE "Creo" FORM "Auram" LEVEL 15 CASTING_TOTAL 24
            ^"Clouds of Rain and Thunder"
            TECHNIQUE "Creo" FORM "Auram" LEVEL 25 CASTING_TOTAL 24
            ^"Clouds of Summer Snow"
            TECHNIQUE "Creo" FORM "Auram" LEVEL 25 CASTING_TOTAL 24
            ^"The Incantation of Lightning"
            TECHNIQUE "Creo" FORM "Auram" LEVEL 35 CASTING_TOTAL 24
            ^"Purification of the Festering Wounds"
            TECHNIQUE "Creo" FORM "Corpus" LEVEL 20 CASTING_TOTAL 16
        }
        CHOICES {
            "The Bonisagus is most likely Driven to make some great discovery in magic. He or she is a so-called 'lab rat', a magus happier in his laboratory than in the outside world. However, the favors he owes and his drive to discover are likely to push him out. Similarly, enchanted items are very useful to him, but he is bad at making them for himself. That also tends to drive him into stories. This concept is built around the Virtues and the Driven Flaw; the other Flaws can be changed easily. He can also take two additional Minor Flaws, or make Driven Major, and take two additional Minor Virtues to balance them. Similarly, the Arts in which the character has an Affinity can be changed, but that also requires changing the spells he knows."
        }
    }
