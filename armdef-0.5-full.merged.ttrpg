            "Civil and Canon Law" SCORE 4 SPECIALTY "local laws"
            "Folk Ken" SCORE 5 SPECIALTY "magi"
            "Guile" SCORE 3 SPECIALTY "keeping confessional secrets"
            "Latin" SCORE 5 SPECIALTY "church ceremonies"
            "Leadership" SCORE 5 SPECIALTY "inspiration"
            "Living Language" SCORE 5 SPECIALTY "local dialect"
            "Order of Hermes Lore" SCORE 3 SPECIALTY "practices"
            "Organization Lore: Church" SCORE 6 SPECIALTY "own diocese"
            "Organization Lore: Covenant" SCORE 4 SPECIALTY "personalities"
            "Stealth" SCORE 3 SPECIALTY "hide"
