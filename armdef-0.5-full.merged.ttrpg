                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Corpus or Animal"
                }
                DESCRIPTION "Are considered to naturally be Size +7, and use powers to live at a smaller Size."
            }
            ^"Transform into Animal" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "–3*"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION ""
            }
            ^"Transform into Bird or Fish" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "–3*"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION ""
            }
            ^"Transform into Human" DEF {
                PROPERTIES {
                    ^"Cost" STRING "varies"
                    ^"Initiative" STRING "varies"
                }
                DESCRIPTION "This power costs the Lezi whatever it cost to transform away from the human shape. For character creation purposes, its cost and Initiative must be equal to the most expensive the character will use it to reverse, in this case Transform into Object (Plant)."
                REFERENCES {
                    "Transform into Object (Plant)" -> #t2dd0f4e8465184904466db ^"Transform into Object (Plant)"
                }
            }
            #t2dd0f4e8465184904466db ^"Transform into Object (Plant)" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "–4*"
                    ^"Form" STRING "Herbam"
                }
                DESCRIPTION ""
            }
        }
        DESCRIPTION "** The lezi’s arms are made of solid wood, and do damage like a club. They are wielded with the Brawl Pretense, even if the lezi generates clubs to use in battle. * Add appropriate Quickness modifier, based on Size. ** Lezi are extraordinary in that they can change into any animal or plant from their woodland: they do not specify alternative forms as other creatures do. Equipment: Can fabricate an endless variety of material from the woodland. Size varies from –10 to +7. A Lezi may change size in increments of fractions of an inch, if it wishes."
    }
    #t8mN0td47adocQnElig6Gtjb ^"Lord Marsyne" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 50
            ^"Might Realm" STRING "Faerie" FIXED
            ^"Form" STRING "Aquam"
            ^"Size" INTEGER 0
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 2
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 4
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 0
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER 0
            }
            ^"Virtues and Flaws" LIST ["Great Characteristics", "Improved Characteristics x 2", "Narrowly Cognizant"]
            ^"Reputations" LIST ["Grants eternal youth 2 (local)"]
            ^"Soak" INTEGER 25
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Vis" STRING "10 Aquam, in his blood."
            ^"Appearance" STRING "Tall, well-built, and handsome, with white skin, pale blond hair, and eyes the clear gray of sea ice. He wears fine clothes in white and blue, and a crown of diamonds rests on his brow. He almost looks like a human being, but the authority in his voice belies that, as does the fact that literal ice water runs in his veins; when he bleeds, there are small crystals of ice in the water that flows out."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Proud" +3
            "Just" +1
            "Forgiving" -3
        }
        COMBAT {
            "Dodge" INIT 0 DEFENSE 0
        }
        ABILITIES {
            "[Area] Lore" SCORE 5 SPECIALTY "nobility"
            "Awareness" SCORE 3 SPECIALTY "in his castle"
            "Charm" SCORE 8 SPECIALTY "human women"
            "Etiquette" SCORE 10 SPECIALTY "courtly"
            "Faerie Lore" SCORE 6 SPECIALTY "cold faeries"
            "Folk Ken" SCORE 5 SPECIALTY "people making requests"
            "Guile" SCORE 5 SPECIALTY "pretending to grant requests"
            "Intrigue" SCORE 4 SPECIALTY "court politics"
            "Leadership" SCORE 7 SPECIALTY "servants"
            "Language (All)" SCORE 5 SPECIALTY "commands"
            "Magic Lore" SCORE 2 SPECIALTY "Hermetic magic"
            "Order of Hermes Lore" SCORE 1 SPECIALTY "Merinita"
        }
        POWERS {
            ^"Commanding Presence" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+10"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Anyone who can see Marsyne becomes awed by him, and gains a Personality Trait of Respectful to Lord Marsyne +3. Even magi must roll this Trait, if they fail to resist the spell. Disagreeing with him is Ease Factor 6, outright contradiction is Ease Factor 9, and attacking is Ease Factor 15. This power does not force obedience to the faerie's commands, but it does force you to be subtle about refusing."
                REFERENCES {
                    "Personality Trait" -> #tcBZnRedWJ5vEcmMkio8kULU ^"Personality Trait"
                    "Lord Marsyne" -> #t8mN0td47adocQnElig6Gtjb ^"Lord Marsyne"
                    "Ease Factor" -> #tGQufzy8y8Qc3foo2n9p7nMU ^"Ease Factor"
                    "Ease Factor" -> #tGQufzy8y8Qc3foo2n9p7nMU ^"Ease Factor"
                    "Ease Factor" -> #tGQufzy8y8Qc3foo2n9p7nMU ^"Ease Factor"
                }
            }
            ^"Entomb" DEF {
                PROPERTIES {
                    ^"Cost" STRING "10 points"
                    ^"Initiative" STRING "-10"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "A single human target is entombed in ice. The effect is Mentem because it also suspends the target's awareness, so that he or she does not need to eat, drink, or breathe, and does not think, dream, or remember while in the ice. Marsyne can break the effect at will, or it can be dispelled. If it is broken, the person returns to awareness without, immediately, realizing that they were unconscious. People do, normally, age while entombed, and can die of old age."
            }
            ^"Gift of Youth" DEF {
                PROPERTIES {
                    ^"Cost" STRING "10 points"
                    ^"Initiative" STRING "-10"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "This power targets a single woman, who stops aging. As long as she remains in Marsyne's castle, she does not age at all. If she leaves, she has the benefit of the Unaging Minor Virtue, so she might not realize that she is aging again. Once aging has restarted, it does not stop if the woman returns to the castle. The power only works on human women, and Marsyne normally only uses it on his wives."
            }
            ^"Inner Warmth" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "The recipient of this gift is unaffected by mundane cold until she (or he) enters an aura aligned with a realm other than Faerie. (Simply leaving a Faerie aura for an area with no aura doesn't end it, but entering a Magic, Infernal, or Divine aura does.) The gift provides no protection against magical cold."
            }
            ^"Lord of Ice" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 or more points"
                    ^"Initiative" STRING "+8"
                    ^"Form" STRING "Aquam"
                }
                DESCRIPTION "Marsyne can create any effect he wants involving ice, including effects that would require a Hermetic ritual. For every point he spends, up to a maximum of 5, the effect has three Hermetic magnitudes of power. Thus, if he spends 5 points, he can create a 15th magnitude effect."
            }
            ^"Lord of the Castle" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+15"
                    ^"Form" STRING "Mentem or Corpus"
                }
                DESCRIPTION "Marsyne can command any one of his servants to do anything, and the command is irresistible. He can also take control of the servant's body, and move it like a puppet, or even make it fly through the air. The only limits are that he can only target one servant at once, and can only target beings who have voluntarily agreed to serve him. Most are faeries, but his wives also qualify."
            }
        }
        DESCRIPTION "His Soak is increased by 5 against iron or steel weapons. He can conjure anything he wants, although particularly elaborate items gained particularly quickly will be faerie glamor rather than real. Lord Marsyne is the ruler of a faerie domain in the far north or in a range of high mountains. His home is a castle of fantastic beauty, made entirely of ice, and he has an extensive faerie retinue. Marsyne and his faeries act out an elaborate charade of the routines and festivals of mundane noble life, hunting strange creatures, holding tournaments, and even passing judgment on criminals within the court. Most of the time, the court has little direct contact with humans. However, Lord Marsyne always has a human wife, and every so often he needs to find a new one. He always chooses a beautiful, young woman, and looks for some spark of creativity, independence, and spirit. He is quite taken by The Gift, and any beautiful, young Gifted woman in the area he is searching is very likely to be wooed. The wooing is utterly sincere, as the wife must return of her own free will. Marsyne's wife plays an important role in the politics of the court, having her own set of faerie ladies-in-waiting and servants, and presiding over many of the tournaments. She also plays an important mystical role, as her presence and creativity allow the faeries to do new things. One thing she is not, is a physical wife to Lord Marsyne. As long as the wife follows the rules of the court, everything is fine. Marsyne makes her unaging, and protects her from the cold. If she breaks the rules, however, Marsyne judges her, entombs her in ice, and seeks out a new wife. He has many entombed wives, as some of the rules are along the lines of the classic \"Do not go into this room. Here is the key.\" It is also possible for a wife to win her freedom, either through a successful challenge by an external champion, or through her own wits. Lord Marsyne remains fond of any wife who wins her freedom fairly, because that is part of the rules, but any who simply flee are brought back and entombed in the ice."
        REFERENCES {
            "Lord Marsyne" -> #t8mN0td47adocQnElig6Gtjb ^"Lord Marsyne"
            "Lord Marsyne" -> #t8mN0td47adocQnElig6Gtjb ^"Lord Marsyne"
            "The Gift" -> #tl8PlKeRUtDRy1gIvS6afpp4 ^"The Gift"
            "Lord Marsyne" -> #t8mN0td47adocQnElig6Gtjb ^"Lord Marsyne"
            "Lord Marsyne" -> #t8mN0td47adocQnElig6Gtjb ^"Lord Marsyne"
        }
    }
    #t4b13c39cf1eefec3bfeb51 ^"Baal-Peor, Lord of Filth" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "False Gods"
            ^"Might" INTEGER 30
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 1
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER -5
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER 4
                ^"Stamina" INTEGER 5
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 1
            }
            ^"Size" INTEGER 2
            ^"Confidence Score" STRING "3 (9 points)"
            ^"Virtues and Flaws" STRING "Oversensitive (coitus), Obese"
            ^"Reputations" LIST ["Treasurer of Hell 6 (Infernal)", "Demon of Filth 5 (Infernal)"]
            ^"Hierarchy" INTEGER 6
            ^"Combat" STRING "Noxious Vomit: Init +9, Attack +12, Defense n/a, Damage +12 Claws: Init +4, Attack +5, Defense +6, Damage +6 See Power description Claws are coated in excrement. Unless injuries are cleaned carefully, they fester and never heal. A roll on the Recovery Table that results in an Improvement indicates stability, while a Stable result indicates that the wound worsens. Once the infection has set in, only Divine aid in healing cleanses the wounds."
            ^"Soak" INTEGER 8
            ^"Fatigue Levels" STRING "OK, 0/0, –1/–1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–7), –3 (8–14), –5 (15–21), Incapacitated (22–28)"
            ^"Weakness" STRING "Running water"
            ^"Vis" STRING "6 pawns of Perdo, in tongue"
            ^"Appearance" STRING "Baal-Peor appears as an immensely fat naked man, with rolls of flab cascading down his body. He is completely hairless, and has a repulsive, snake-like tongue. He wears a serpent wrapped around his girth like a belt, and its head is usually draped over his shoulder."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 50
        }
        PERSONALITY_TRAITS {
            "Proud" +6
            "Hungry" +3
            "Shame" -3
        }
        ABILITIES {
            "Artes Liberales" SCORE 4 SPECIALTY "arithmetic"
            "Brawl" SCORE 4 SPECIALTY "claws"
            "Civil and Canon Law" SCORE 4 SPECIALTY "trade"
            "Folk Ken" SCORE 6 SPECIALTY "fornication"
            "Infernal Lore" SCORE 5 SPECIALTY "wealth"
            "Intrigue" SCORE 7 SPECIALTY "envy"
            "Medicine" SCORE 4 SPECIALTY "poisons"
            "Profession: Merchant" SCORE 7 SPECIALTY "unfair deals"
        }
        POWERS {
            #tc49962d4fbd5f324a847cb ^"Form of Woman" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Baal-Peor can take the form of a woman, although he cannot use this Power to mimic a specific woman. He always chooses a form that will be considered beautiful by the target audience of his schemes."
            }
            #tab56d7973d85131d2d7666 ^"Noxious Vomit" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+9"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "This Power allows Baal-Peor to spray vast amounts of vomit (or, facing the other way, even less pleasant substances) through an area. His vomit is an expression of his spiritual vileness, and does the damage indicated in his combat statistic through corrosion, except to characters with True Faith, whom it cannot touch. The target must make a Strength + Size stress roll against an Ease Factor of 9 or be sent flying backwards. Anyone successfully struck by this vileness continues to suffer +3 damage in each round until it is washed off. This damage does not stack for multiple successful attacks."
            }
            #tb982219288861ea9a59453 ^"Swallow Assault" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "Baal-Peor may avoid injury from mundane objects by opening his maw so wide that the attack slides harmlessly down his throat."
            }
            #t09af1abc6de60fdb0c58fb ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t62d0f20be9935a4fd40f3a ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Shamelessness, Gluttony. See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t3180028219dfff5c7143c1 ^"Shroud the Stench of the Pit" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, False Gods."
            }
            #t74f83a6adce40664a180ba ^"The Wealth of Nations" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, False Gods."
            }
            #t65a7c74877aba6e2a027c8 ^"His Master’s Voice" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, False Gods."
            }
        }
        DESCRIPTION "Baal-Peor (or Belphegor) is a demon of wealth. He creates discord by moving mortal riches in disruptive ways (using the Wealth of Nations Power). He gives money to the vulnerable, so that the strong are tempted to take it. He gives the possessions of the powerful to others. This tempts the recipients to keep their stolen treasures, and rouses the powerful to recover them by force.

Baal-Peor was worshipped, in ancient times, less as a wealth-god than as an embodiment of the desire to consume everything and transform it into vileness. His title, “Lord of the Openings” describes him: an unfillable mouth leading to a ceaseless defecation. Priests and pilgrims used the space before his statue as a latrine, as a form of worship. Baal-Peor, it is said, was sent by his masters to seek the truth of rumors that humans lived in marital bliss. He tried to live as a woman, but was so disgusted by marital relations that he fled back to Hell."
    }
    #tiUiEW4gJ2U3oDA7pYWMqwXn ^"Bartholomew" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 50
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Form" STRING "Mentem"
            ^"Size" INTEGER 0
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER 3
                ^"Communication" INTEGER 5
                ^"Strength" INTEGER -1
                ^"Stamina" INTEGER 0
                ^"Dexterity" INTEGER -1
                ^"Quickness" INTEGER -1
            }
            ^"Virtues and Flaws" LIST ["Weakness: Ordering"]
            ^"Reputations" LIST ["Excellent adviser on money matters 5 (local)"]
            ^"Soak" INTEGER 8
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Vis" STRING "10 pawns of Mentem vis, one in each of his fingers. Infernally tainted."
            ^"Appearance" STRING "Bartholomew appears as an older, but still vigorous, merchant. He is plump, but not fat, and while he never appears positively cheerful, he also never seems angry, or impatient, at least not with other merchants. His clothes are of excellent quality and taste."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Slothful" +3
            "Gregarious" +2
            "Retiring" -2
        }
        COMBAT {
            "Fist" INIT -1 ATTACK -1 DEFENSE -1 DAMAGE -1
        }
        ABILITIES {
            "[Area] Lore (area where he lives)" SCORE 6 SPECIALTY "trade routes"
            "[Area] Lore (larger area including it)" SCORE 6 SPECIALTY "trade routes"
            "[Area] Lore (whole of Europe)" SCORE 6 SPECIALTY "trade routes"
            "Artes Liberales" SCORE 2 SPECIALTY "arithmetic"
            "Bargain" SCORE 10 SPECIALTY "trade goods"
            "Charm" SCORE 5 SPECIALTY "merchants"
            "Etiquette" SCORE 4 SPECIALTY "merchants"
            "Folk Ken" SCORE 8 SPECIALTY "merchants"
            "Guile" SCORE 10 SPECIALTY "trading"
            "Intrigue" SCORE 5 SPECIALTY "market politics"
            "Language" SCORE 6 SPECIALTY "trade talk"
            "Latin" SCORE 6 SPECIALTY "ecclesiastical"
            "Profession (merchant)" SCORE 10 SPECIALTY "cloth"
        }
        POWERS {
            #t54047da7f79130f2a3a4 ^"Merchant's Blessing" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "The recipient of this blessing seems trustworthy to most people, and gets a +3 bonus on all social rolls to do with trading. People react to him as if he has an excellent reputation for honesty, fair dealing, and getting high quality goods cheaply. The blessing lasts for a week, unless Bartholomew chooses to renew it."
            }
            ^"Merchant's Curse" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "The inverse of Merchant's Blessing, this curse makes people treat the victim as if he had a strong reputation for dishonesty, cheating and reneging on deals, and selling shoddy goods at inflated prices. He also has a –3 penalty to all social rolls to do with trading. The curse lasts for a week, unless Bartholomew chooses to renew it."
                REFERENCES {
                    "Merchant's Blessing" -> #t54047da7f79130f2a3a4 ^"Merchant's Blessing"
                }
            }
            ^"Merchant's Knowledge" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "automatic"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Bartholomew knows what someone in receipt of his curses or blessings is doing with their business."
            }
            #te44f3b5e59b71128e93a ^"Project Blessing" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Bartholomew can bless a particular commercial venture, so that chance favors it whenever possible. This results in a very successful trading venture. The blessing only lasts for one day, which isn't normally long enough to have an effect, but Bartholomew can renew the blessing every day, if he so chooses."
            }
            ^"Project Curse" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "The inverse of Project Blessing, this effect makes everything that could go wrong, go wrong. It takes at most a month to drive someone to bankruptcy through this power. As for the blessing, the curse only lasts for one day at a time."
                REFERENCES {
                    "Project Blessing" -> #te44f3b5e59b71128e93a ^"Project Blessing"
                }
            }
            ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION ""
            }
            ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Avarice"
            }
        }
        DESCRIPTION "Equipment: Fine clothes, a nice house, trade goods. Bartholomew is a well-established and moderately successful merchant in a trading city. He is known for being lazy, but still making an extremely comfortable living from his trade. He also willingly gives advice to other merchants, and they have noticed that following his advice makes them rich, while disregarding it makes them poor. Most people in the city also think that Bartholomew attends church regularly. In fact, being a demon, he has never set foot inside a consecrated building. He has, on the other hand, made substantial donations to the Church, and those donations are well known. The advice he gives is good business advice in itself, but he normally backs it up with his blessings, at least for a while. If his advice is ignored, he uses his curses to make sure that people suffer. The demonic features of his advice are very, very subtle. Merchants following them often find that they need to work on Sundays, although Bartholomew does not explicitly suggest that, and that they are often away from home on religious holidays, and thus unable to attend their local church. Further, he gives advice about charity, suggesting that the merchant give money away to reinforce his social standing. He also gives extensive advice on how to calculate how much to give, so that it doesn't cause the merchant financial problems. This has the effect of making the merchant feel that he is doing a lot of good by giving alms, while removing any actual virtue it has. Anyone following Bartholomew's advice gives only for their own glory, and thus earns no merit. They are sinners, but they don't realize that they are, and thus they do not see the need to repent and reform. Bartholomew's strategy is subtle, but it wins many souls for Hell."
    }
    #t04effd5d55b9c2a5831fe2 ^"Bomburkhan" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Tempters (Ruchin)"
            ^"Might" INTEGER 5
            ^"Form" STRING "Vim"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -2
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER -9
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 6
                ^"Quickness" INTEGER 7
            }
            ^"Size" INTEGER -9
            ^"Virtues and Flaws" STRING "Weak-Willed, Short Attention Span"
            ^"Reputations" LIST ["None"]
            ^"Hierarchy" INTEGER 0
            ^"Soak" INTEGER 1
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1), –3 (2), –5 (3), Incapacitated (4)"
            ^"Weakness" STRING "Vulnerability (salt)"
            ^"Vis" STRING "1 pawn of Vim, in wings"
            ^"Appearance" STRING "Bomburkhan appears as a jet–black bat, no bigger than a person’s hand, but with a pinched and twisted human face protruding from the black fur."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 51
        }
        PERSONALITY_TRAITS {
            "Resentment of Being Controlled" +5
            "Selfish" +5
            "Brave" -6
        }
        COMBAT {
            "Dodge" INIT 7 DEFENSE 14
        }
        ABILITIES {
            "Athletics" SCORE 5 SPECIALTY "flying"
            "Brawl" SCORE 6 SPECIALTY "dodge"
            "Guile" SCORE 6 SPECIALTY "boasts"
        }
        POWERS {
            #t10870eb223d13f4e17bc26 ^"Make a Liar of the Boastful" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "If this imp hears a boast and expends all of his Might Points, he can immediately grant someone nearby an Ability or Power that contradicts that boast, and cause them to use it immediately. Thus, if someone proclaims that she is the most beautiful woman in France, Bomburkhan can immediately make someone more beautiful than the boaster. This Power must penetrate Magic Resistance to grant the Ability or Power to the person, and that talent lasts for 1–10 rounds only (roll a simple die). A physical change, such as the example given above, lasts until the boaster and the target can no longer see each other."
            }
            #tf2e4b5a6479df5a7cab448 ^"Insignificance" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "No Magic, Infernal or Faerie Power can force Bomburkhan to use any of his Powers."
            }
            #t84a1c81f91f707bdb5416a ^"Misfortune" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "See Ruchin."
            }
            #t142131f8eaf9fc6c020fe2 ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t44785abc0a83ffe9866162 ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Boastful. See Chapter 4: Infernal Legions, Demonic Powers."
            }
        }
        DESCRIPTION "Bomburkhan was released from Hell after the false bravado of a crusader led to the capture of Jerusalem. Since then he has taken great delight in puncturing the over-inflated egos of the prideful. This ruach has an ability that could be exceedingly powerful, depending upon the magnitude of a speaker’s self-importance. For example, should a magus declaim “no one can breach my Parma Magica!”, a nearby grog might suddenly hurl a *Pilum of Fire* which slices straight through it! Fortunately for all concerned, this Power uses all of Bomburkhan’s Might Pool, and he grows bored very easily, wandering off once his mischief is done."
    }
    #t5699cbfc60932092c2a47c ^"Bordelon, a Personal Tormentor" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Accusers"
            ^"Might" INTEGER 15
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 2
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER -1
                ^"Stamina" INTEGER 0
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 4
            }
            ^"Size" INTEGER 0
            ^"Confidence Score" STRING "1 (3 points)"
            ^"Virtues and Flaws" STRING "Piercing Gaze, Puissant Leadership"
            ^"Reputations" LIST ["None"]
            ^"Hierarchy" INTEGER 0
            ^"Soak" INTEGER 2
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Weakness" STRING "Protected Group (red-haired women)"
            ^"Vis" STRING "3 pawns of Mentem, in hair"
            ^"Appearance" STRING "Bordelon appears as a stern-faced old woman, with hair tied back in such a tight bun that it distorts her face. Her small horns are hidden within this hair. Her skin is mottled with liver-spots, and she wears an austere gown which covers her cloven hooves and forked tail. She affects the demeanor of a stern governess. She carries a switch of willow bound with leather, which she wields with expert ability to inflict the most pain."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 60
        }
        PERSONALITY_TRAITS {
            "Cruel" +6
            "Stern" +5
            "Implacable" +3
        }
        COMBAT {
            "Switch" INIT 6 ATTACK 11 DEFENSE 10 DAMAGE 4
        }
        ABILITIES {
            "Leadership" SCORE 6 BONUS 2 SPECIALTY "children"
            "Single Weapon" SCORE 5 SPECIALTY "switch"
        }
        POWERS {
            #tf06b784452afe22dfc3ac7 ^"Crushing the Will" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "This Power saps the will and vitality of its target, leaving him listless, less energetic, and withdrawn. All Personality Trait rolls suffer a –3 modifier, and the target may not spend Confidence Points to increase other rolls. Each use of this Power lasts until the victim has slept for at least six hours."
            }
            #te7ea1756c12dd4fb9b8898 ^"Chastise the Disobedient" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Every strike of Bordelon’s switch inflicts a fearsome sting. Double the Wound Penalties inflicted by the weapon, although these extra penalties vanish after an hour. Wound Penalties caused by any actual wounds she inflicts are healed as normal."
            }
            #t5d641fcba43fd128e810cd ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t498a58a213b495cdba88e6 ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Shame. See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t7ff1c2fa8aeeeae092818f ^"Betrayal of the Heart" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Accusers."
            }
            #t6d614b4d65cb5c3d9401bc ^"Whispers Behind the Back" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Accusers."
            }
        }
        DESCRIPTION "Bordelon believes that meekness is a virtue, and that those who strive to better themselves are victims of pride. Her goal is to crush all ambition and prevent those whom she watches from committing the very sin of Satan himself. Bordelon chooses a child early on in his life and becomes his personal tormentor (granting the Story Flaw Plagued by a Demon). The child soon learns that the demon’s periodic appearances are more frequent whenever he tries to distinguish himself from his peers, so her victims tend to become withdrawn, unambitious, and meek. Whenever her victim acts in a way that would grant a Confidence Point due to increased self-worth, he can expect a visit from Bordelon to punish the presumption."
    }
    #tu0sr743Wg3FDZADIqGz0Ftz ^"The Buran of Yenghissar" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 25
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Form" STRING "Auram"
            ^"Size" INTEGER 4
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -5
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 3
                ^"Communication" INTEGER -2
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 6
            }
            ^"Virtues and Flaws" LIST ["Jinni", "Berserk", "Strong-Willed", "Wilderness Sense", "Fury (Major) (when summoned)", "Greater Malediction (bound by bargains)", "Mute", "Weakness: Protected Group (individuals that invoke the Bismillah invocation)"]
            ^"Reputations" LIST ["Scourge of Yenghissar 2 (local)"]
            ^"Wound Penalties" STRING "Not applicable, the buran is an insubstantial spirit"
            ^"Vis" STRING "5 pawns of Auram vis prava, left behind as black sand when dispersed."
            ^"Appearance" STRING "Usually manifests as a giant shapeless vortex of raging black sand using its Auram powers. To those with Second Sight, a giant humanoid shadow can be discerned within the sandstorm."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Untameable" +5
        }
        ABILITIES {
            "Arabic" SCORE 5 SPECIALTY "understanding"
            "Folk Ken" SCORE 3 SPECIALTY "travelers"
            "Theology: Islam" SCORE 3 SPECIALTY "jinn"
            "Survival" SCORE 5 SPECIALTY "desert"
            "Taklamakan Lore" SCORE 5 SPECIALTY "legends"
            "Wilderness Sense" SCORE 2 SPECIALTY "weather"
        }
        POWERS {
            ^"Delusion of the Desert" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 or 5 points"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Imaginem"
                }
                DESCRIPTION "This evil spirit can create illusions of a lost traveler's companions or a welcoming oasis, only to launch itself in fury at an unsuspecting victim. Alternatively it can create images of itself as a humanoid sandstorm with glowing fiery eyes in order to terrify its victims prior to their deaths. A minor illusion which affects an Individual amount of material (such as the demon itself) costs one point; a larger illusion which fills a room costs five points. These visions always have a flaw, however (they smell wrong, can only be seen by one target, etc.)."
            }
            ^"Elemental Control of Wind" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "The buran has control over the winds of nature, which it uses to wreak destruction on the desert fringes. It may create any Creo, Muto, or Rego effect appropriate to Auram, at a cost of 1 Might Point per magnitude of effect. The demon cannot create any effect with a level greater than its Infernal Might, nor duplicate Ritual effects."
            }
            ^"Recalcitrance" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Any attempt to control (but not destroy) the buran with any form of Supernatural Power (magical, Divine, or otherwise) treats the demon's Might as if it were 150% its actual Might, or otherwise has its Ease Factor increased by 50%. For example, a Circular Ward Against Demons of 38th level is needed to stop this demon."
                REFERENCES {
                    "Ease Factor" -> #tGQufzy8y8Qc3foo2n9p7nMU ^"Ease Factor"
                    "Circular Ward Against Demons" -> #t9t3nL9a8Dfy2RhrkuJpiLMj ^"Circular Ward Against Demons"
                }
            }
        }
        DESCRIPTION "Not applicable, the buran is an insubstantial spirit, with no Combat, Soak, or Wound Penalties, unable to affect the physical world except through its magic. Arabic represents level of understanding as the spirit is Mute. This wild desert storm spirit, or buran, once plagued the small village of Yenghissar along the route to Khashgar, bringing devastation to the crops and herd animals every seven years. It is now bound by an Infernally-aligned sahir using the Goetic Art of Binding. A speechless, destructive force of fury incarnate, it rages to be released and constantly strives to create elemental havoc around the thoughtless sahir who has trapped it within his ancestral sword. Unlike many other corrupt jinn, the buran lacks the Coagulation and Obsession powers common to most demons and is an insubstantial spirit. It is an example of an Infernal storm spirit likely to be found in the Taklamakan Desert. Many travelers' tales tell of companions fallen behind who are tempted off the track by the illusions created by these demons."
    }
    #t7c9356dc908f7a5e704110 ^"Fimus, Warrior Demon" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Aerial Powers"
            ^"Might" INTEGER 10
            ^"Form" STRING "Terram"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -2
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER -2
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 4
                ^"Stamina" INTEGER 4
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER -4
            }
            ^"Size" INTEGER 2
            ^"Virtues and Flaws" STRING "Puissant Great Weapon; Poor Eyesight, Simple-Minded"
            ^"Reputations" LIST ["Champion of Hell 1 (Infernal)"]
            ^"Hierarchy" INTEGER 1
            ^"Soak" INTEGER 15
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–7), –3 (8–14), –5 (15–21), Incapacitated (22–28)"
            ^"Weakness" STRING "Abhorrent Material (cinnamon)"
            ^"Vis" STRING "2 pawns of Terram, in eye"
            ^"Appearance" STRING "Fimus appears as an immense man apparently put together out of boulders. He has but one eye, in the center of his forehead. He carries an immense cudgel made out of a stalagmite."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 68
        }
        PERSONALITY_TRAITS {
            "Untamable" +5
            "Intimidating" +3
        }
        COMBAT {
            "Cudgel" INIT -3 ATTACK 13 DEFENSE 6 DAMAGE 11
            " Fist" INIT -4 ATTACK 6 DEFENSE 2 DAMAGE 4
        }
        ABILITIES {
            "Athletics" SCORE 3 SPECIALTY "pursuit"
            "Awareness" SCORE 4 SPECIALTY "foes"
            "Brawl" SCORE 5 SPECIALTY "fist"
            "Great Weapon" SCORE 6 BONUS 2 SPECIALTY "cudgel"
        }
        POWERS {
            #tec18e55beae12eaa58d2df ^"Elemental Control of Earth" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Aerial Powers. He prefers effects such as *Wielding the Invisible Sling* and *Rusted Decay of Ten-Score Years*."
            }
            #t4bb51f36fc13a109af3188 ^"Born of Rock" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "The body of this demon is made from solid rock. This makes it exceedingly heavy and almost impossible to harm by mundane means."
            }
            #tf1e22d310345ea433052f1 ^"Death’s Vengeance" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+10"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "Upon death, this demon’s body explodes, sending shards of debris up to 20 paces in all directions. Treat this as a physical attack against all within range, which can be dodged but not otherwise defended against. The Attack Bonus is +12, and the Damage is +15."
            }
            #t38238a047164841db02d92 ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t1c5e237d85908bcfff47f9 ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Cowardice. See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #tda4872a87479d1eaa6345f ^"Recalcitrance" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION ". See Chapter 4: Infernal Legions, Aerial Powers."
            }
        }
        DESCRIPTION "Fimus is but one of many brother-demons (all with the same name); their mother produces more every time she evacuates her bowels. He and his brothers are popular footsoldiers and shock troops used by other demons, because they are effective warriors, and too stupid to effectively entertain rebellious thoughts. Each of the brothers has a different Abhorrent Material, depending upon what their mother had been eating prior to their birth."
    }
    #tsbEcAtsnTGAWfFHV8UamTqr ^"Michael" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 10
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 2
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER -2
                ^"Communication" INTEGER -2
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 0
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 1
            }
            ^"Virtues and Flaws" LIST ["Abhorrent Material (salt)"]
            ^"Soak" INTEGER 0
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Vis" STRING "2 pawns of Muto in his heart (Infernally tainted)"
            ^"Appearance" STRING "Michael appears as he needs to for his latest role. As a demon, he doesn't need, nor does he have, a 'natural' form."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Cruel" +3
            "Wrathful" +3
        }
        ABILITIES {
            "Athletics" SCORE 5 SPECIALTY "running away"
            "Awareness" SCORE 4 SPECIALTY "victims"
            "Craft (practical jokes)" SCORE 8 SPECIALTY "painful and humiliating ones"
            "Folk Ken" SCORE 5 SPECIALTY "figuring out what will make someone most angry"
            "Guile" SCORE 10 SPECIALTY "pretending to be someone else"
            "Intrigue" SCORE 3 SPECIALTY "maneuvering people into his plots"
        }
        POWERS {
            ^"Change Form" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Michael can change his appearance to match that of any human being. The change includes clothes and other equipment, as necessary."
            }
            ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION ""
            }
            ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Sensitivity to Mockery"
            }
            ^"Working Material" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "Michael can create whatever he needs to set up a particular practical joke."
            }
        }
        DESCRIPTION "Michael does not normally fight, and if he does he uses whatever weapons are suitable for his current disguise (Michael always takes wounds as a Size 0 creature, even if his current Size is different). Michael (he likes taking the name of a famous angel) is a minor demon who tempts people to wrath. He sets up elaborate, painful, and humiliating practical jokes, and makes sure that he is seen in the form of one of the victim's friends while doing so. If possible, he ensures that the victim sees him, in the form of the friend, laughing at their misfortune before running away. He normally stays around to watch the resulting confrontation, because if it isn't heated enough he sets up another, even more hurtful, joke. He is especially happy if both friends become angry, and the friendship is ruined. Since both parties feel that the other was unreasonable, sometimes they can nurse their anger for years, which is exactly what Michael wants. While Michael's jokes are normally painful and humiliating, they are almost never fatal. He wants people to sin so that they damn their souls, not die and possibly go to Heaven."
    }
    #tPoxwkFeLKonDlz5xcjCrd5T ^"Polandrus" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 20
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Form" STRING "Animal"
            ^"Size" INTEGER 0
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 1
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 2
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 3
            }
            ^"Virtues and Flaws" LIST ["Vulnerability (Holly)"]
            ^"Soak" INTEGER 6
            ^"Fatigue Levels" STRING "OK, 0, –1/–1/–1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Vis" STRING "1 pawn of Animal in each of four large canine teeth, all Infernally tainted."
            ^"Appearance" STRING "An extremely large, jet black wolf, with red eyes."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Envious" +3
            "Proud" +2
            "Calculating" +2
        }
        COMBAT {
            "Bite" INIT 18 ATTACK 11 DEFENSE 9 DAMAGE 8
        }
        ABILITIES {
            "[Area] Lore" SCORE 3 SPECIALTY "livestock"
            "Bargain" SCORE 7 SPECIALTY "for sins"
            "Brawl" SCORE 5 SPECIALTY "bite"
            "Charm" SCORE 4 SPECIALTY "frightened people"
            "Folk Ken" SCORE 3 SPECIALTY "peasants"
            "Guile" SCORE 8 SPECIALTY "when making deals"
            "Hunt" SCORE 6 SPECIALTY "livestock"
            "Language" SCORE 6 SPECIALTY "making deals"
            "Leadership" SCORE 4 SPECIALTY "wolves"
            "Survival" SCORE 5 SPECIALTY "woods"
        }
        POWERS {
            ^"Calm Person" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+18"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Makes the target person unnaturally calm about talking to a large wolf. It doesn't lessen their fear, just the sense that it is something they should act on immediately."
            }
            ^"Dominate Wolves" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+18"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION "Polandrus can establish absolute control over any wolf. The wolf doesn't like it, but Polandrus doesn't care. This power applies to mundane wolves, wolves with Might scores, and to characters who can naturally take the form of a wolf, including shapechangers, lycanthropes, skinchangers, and Bjornaer with wolf heartbeasts, but not including magi who change using spells. Once established, the domination lasts until Polandrus decides to drop it, the dominated wolf enters a Dominion aura of level 3 or higher, or someone dispels the power."
            }
            ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION ""
            }
            ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Secrecy"
            }
        }
        DESCRIPTION "Polandrus targets livestock farmers. He dominates a few wolves, and then kills some livestock, making sure that someone sees the wolves do it. A little later, he confronts the peasant in question, offering to ensure that the wolves do not attack for a week if the farmer does something innocuous, such as not wear a particular tunic. Polandrus comes back every week, and the requirements gradually become sinful, and more and more heinous. By the end, the wolf relies more on the threat to expose the farmer's deeds than on the threat to the livestock. Polandrus is unnaturally fast in combat, much more so than in normal situations. However, he never attacks people unless he is attacked first."
    }
    #t718eb6e3101402137d50d5 ^"Demonic Steed" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Might" INTEGER 7
            ^"Form" STRING "Animal"
            ^"Characteristics" DEF {
                ^"Cunning" INTEGER -2
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER -6
                ^"Communication" INTEGER -4
                ^"Strength" INTEGER 4
                ^"Stamina" INTEGER 4
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 1
            }
            ^"Size" INTEGER 3
            ^"Virtues and Flaws" STRING "Enduring Constitution, Improved Characteristics, Lesser Infernal Power, Long Winded; Proud; Corrupted Beast These Virtues and Flaws are a result of its corruption."
            ^"Soak" INTEGER 4
            ^"Fatigue levels" STRING "OK, 0, 0, 0, 0, –2, –4, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–8), –3 (9–16), –5 (17–24), Incapacitated (25–32)"
            ^"Vis" STRING "2 pawns of Animal, in hooves"
            ^"Appearance" STRING "A fearsome black stallion with bloodshot eyes, fangs in its mouth, and hooves of iron."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 79
        }
        PERSONALITY_TRAITS {
            "Vain" +6
            "Brave" +1
        }
        COMBAT {
            "Kick" INIT 1 ATTACK 13 DEFENSE 5 DAMAGE 12
        }
        ABILITIES {
            "Athletics" SCORE 5 SPECIALTY "long-distance running"
            "Brawl" SCORE 3 SPECIALTY "hooves"
        }
        POWERS {
            #t1f461a9b127044bba723b0 ^"The Unimpeded Traveler" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION "This steed is not impeded by poor terrain and may move at maximum speed along even the poorest of roads, achieving 30 miles a day. It may even cross open water and chasms, unsupported by ground, but can do this only at a trotting pace."
            }
        }
        DESCRIPTION "This horse is one of three created by an Infernalist magus in a tribunal at the fringes of the Order by repeated applications of a tainted version of *Steed of Vengeance* (MuAn 35). There were many failures before he successfully created these three corrupted beasts. Because the untainted version of the spell is well-known, he is able to use the steeds in front of other magi with impunity."
    }
    #t4df99c0c8f6f10e2505ccd ^"Two-Headed Hound" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Might" INTEGER 10
            ^"Form" STRING "Animal"
            ^"Characteristics" DEF {
                ^"Cunning" INTEGER 0
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER -6
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 2
            }
            ^"Size" INTEGER 0
            ^"Ferocity Score" STRING "1 (3 points)"
            ^"Virtues and Flaws" STRING "Greater Infernal Power; Ferocity (against intruders), Improved Characteristics, Long Winded, Sharp Ears; Horrifying Appearance, Reckless; Corrupted Beast These Virtues and Flaws are a result of its corruption."
            ^"Soak" INTEGER 2
            ^"Fatigue levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Vis" STRING "2 pawns of Vim, 1 in each head"
            ^"Appearance" STRING "This huge dog has two slavering heads protruding from its massive shoulders. The two heads are cursed with independent minds that hate each other, and each would like nothing more than to bite the other; it is only because the hound’s necks are too short that it cannot. The dog is covered in gray fur in the few areas that are not affected by mange, which has left patches of puffy, purulent red flesh."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 79
        }
        PERSONALITY_TRAITS {
            "Hatred of Owner" +6
            "Hatred of Humans" +5
            "Hatred of Self" +3
            "Reckless" +3
            "Vigilant" +1
        }
        COMBAT {
            "Bite" INIT 2 ATTACK 11 DEFENSE 10 DAMAGE 5
        }
        ABILITIES {
            "Athletics" SCORE 4 SPECIALTY "pursuit"
            "Awareness" SCORE 4 SPECIALTY "keeping watch"
            "Brawl" SCORE 6 SPECIALTY "bite"
            "Hunt" SCORE 4 SPECIALTY "track by scent"
        }
        POWERS {
            #td1072571d67af31ca4e0f1 ^"Spit Fire" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "+6"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "The hound may spit a bolt of fire at its opponents; it does +15 damage to the individual it hits. The creature may bite one opponent and spit fire at another in the same round."
            }
        }
        DESCRIPTION "This corrupted beast was created by a diabolist to be a guard for his sanctum. He controls it with an Infernal charm, but is fearful of the day that this charm fails, for he knows that the dog hates him."
    }
    #td7NwuKqsgmFME5TIQT9Bcvd ^"Baghl, an Earth Jinni" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 15
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Terram"
            ^"Size" INTEGER 2
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -2
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER -1
                ^"Strength" INTEGER 3
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER -1
            }
            ^"Virtues and Flaws" LIST ["Jinn", "Greater Immunity: Fire", "Ways of the Mountains", "Second Sight", "Skinchanger", "Strong-Willed", "Tough", "Greater Malediction (honor bargains made)", "Magical Air", "Vulnerable Magic (mua'addhin's call)", "Reclusive"]
            ^"Soak" INTEGER 10
            ^"Wound Penalties" STRING "–1 (1–7), –3 (8–14), –5 (15–21), Incapacitated (22–28), Dead (29+)"
            ^"Vis" STRING "1 pawn of Terram vis can be collected every year from his haunt, in the form of a quartz-encrusted stalactite at the back of his cave. If slain in physical form, his body yields 3 pawns of Terram vis."
            ^"Appearance" STRING "Baghl is the jinni of a dark cave found in the Elbruz mountains that was once used as a quarry until he drove off the miners. He may be appeased mainly by being left alone to enjoy his beautiful cave formations, although he sometimes agrees to converse with theological scholars. He appears as an obese man with a mule's head, pupilless eyes of jetblack stone, and quartz-veined limbs that heft an oversized maul. In physical form he can also assume the shape of a large black mule."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Reclusive" +5
            "Immutable" +3
            "Proud" +2
        }
        COMBAT {
            "Maul (warhammer)" INIT -1 ATTACK 11 DEFENSE 3 DAMAGE 15
        }
        ABILITIES {
            "Arabic" SCORE 5 SPECIALTY "stone"
            "Athletics" SCORE 3 SPECIALTY "climbing"
            "Great Weapon" SCORE 4 SPECIALTY "maul"
            "Profession: Miner" SCORE 3 SPECIALTY "gemstones"
            "Second Sight" SCORE 4 SPECIALTY "jinn"
            "Theology: Islam" SCORE 3 SPECIALTY "jinn"
        }
        POWERS {
            ^"Flesh to Stone" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "-4"
                    ^"Form" STRING "Terram"
                    ^"Design" STRING "Base 20, +1 Touch, +2 Sun"
                }
                DESCRIPTION "Baghl can change any human he touches into stone until sunrise or until the morning call to prayer."
            }
            ^"Ruler of Earth" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1–3 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "Duplicates any non-Ritual Perdo Terram or Rego Terram spell less than or equal to 15th level at a cost of 1 Might point per magnitude of the effect."
            }
            ^"Incorporeal" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "Constant"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Baghl is naturally both invisible and intangible, and cannot be influenced by the physical world. Magic can only directly target him if the caster can sense his existence. In this form he has no physical statistics or combat scores. Without taking a corporeal form, Baghl's physical characteristics are only used when dealing with other incorporeal creatures."
            }
            ^"Donning the Corporeal Veil" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Baghl can form the physical body described under Appearance to house his spiritual form; when doing so he acquires the physical characteristics, size, combat statistics, and Wound levels listed earlier. His arms and armor are also created with this power. He cannot become fatigued. This body lasts until he decides he no longer needs it. Killing the body does not kill Baghl."
            }
            ^"Presence" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Baghl is aware of everything that goes on within his haunt. This power needs to Penetrate to perceive beings with a Magic Resistance."
                REFERENCES {
                    "Magic Resistance" -> #tmM1uJVBdvXpEsg4iImNPyjr ^"Magic Resistance"
                }
            }
        }
    }
    #tDIVT8nK9gMMQ3ll9IMxdM7y ^"Caladrius" DEF {
        EXTENDS #tkHQwIw27s2JEQNqDUseWeLJ ^"Magic Character"
        PROPERTIES {
            ^"Shape" STRING "character" FIXED
            ^"Page" INTEGER 58
            ^"Magic Might" STRING "14 (Animal)"
            ^"Characteristics" STRING "Cun –1, Per +2, Pre +1, Com –2, Str –4, Sta +3, Dex +1, Qik +2"
            ^"Size" STRING "–2"
            ^"Season" STRING "Spring"
            ^"Virtues and Flaws" STRING "Magic Animal; Magical Friend; Essential Virtue (magnificent appearance), Unaffected by the Gift, Lesser Immunity (to non-lethal diseases); Noncombatant, Compassionate (minor)"
            ^"Magic Qualities and Inferiorities" STRING "Ritual Power (x2); Improved Abilities, Improved Might (x2), Ignem Resistance, Improved Powers, Personal Power; Minor Flaw: Restricted Power, Susceptible to Deprivation"
            ^"Personality Trait" STRING "Ibis* +3, Magnificent Appearance* (Presence) +3"
            ^"Combat" STRING "Dodge: Init +2, Attack n/a, Defense +5, Damage n/a"
            ^"Soak" STRING "+3"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–3), –3 (4–6), –5 (7– 9), Incapacitated (10–12), Dead (13+)"
            ^"Abilities" STRING "Athletics 3 (flying), Awareness 4 (food), Brawl 2 (dodging), Ignem Resistance (solar heat) 4, Survival 3 (wetlands)"
            ^"Powers" STRING "Healing Gaze, 4 points, Init –14, Corpus R: Eye, D: Mom, T: Ind By gazing into a person’s eyes, the caladrius can draw out any non-fatal disease from a sick person into itself. This removes any disease of up to Incapacitating strength, or resolves a critical or lesser aging crisis. The caladrius must immediately fly up toward the sun or else the disease returns to the patient (this is a Restricted Power). CrCo 40 (Base 30, +1 Eye, +1 affect either disease or aging): Ritual Power x2 (40 levels, –2 Might cost), Improved Powers (–2 Might cost) Perceive the Afflictions of Mortal Flesh, 0 points, Init +1, Corpus R: Per, D: Mom, T: Sight By sight, the caladrius can identify any diseases a person has and how serious they are. InCo 25 (Base 5, +4 Sight): Personal Power (25 levels), Improved Powers (–3 Might cost)"
            ^"Vis" STRING "3 Corpus (1 in each eye, 1 in the wings)"
            ^"Appearance" STRING "The caladrius is a magnificent, all-white bird somewhat resembling a heron (but with shorter legs and beak). It has a long, gracefully curving neck and a short, slightly downward-curving beak. A caladrius is a mystical bird much sought by royal households. It can determine whether a sick person will live or die. If the patient is to die, the caladrius sadly turns away from him, but if he is to live, it gazes deeply into his eyes, drawing the sickness into itself. It then flies away toward the sun, going so high that the sun’s rays burn away the disease (but they do not harm the caladrius itself). A caladrius will not absorb a terminal illness (its Lesser Immunity would not protect it), but it will gladly heal any lesser ailment. It can heal either spontaneous diseases, which result from aging crises (see ArM5, page 168) or diseases due to an external cause (ArM5, page 180). As long as the crisis is not terminal or the disease does not cause a Lethal Wound, a caladrius can cure it. It can only heal wounds caused by disease, not those resulting from poison, combat, or other causes. It cannot remove Decrepitude. The eyes of a caladrius are Enriched by grinding them to a paste, which is then used to fill a hollow wing bone taken from the same bird. This must be soaked in the urine of a virgin girl for a season, after which time it grants the wielder the Puissant Medicine Virtue."
            ^"Source" STRING "Realms of Power: Magic"
        }
    }
    #tfbqDPgdPsXPwZuq0IrIe7OJ ^"Aneirin the Bard" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 15
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Imaginem"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER 2
                ^"Communication" INTEGER 4
            }
            ^"Vis" STRING "If his spirit is somehow bottled rather than banished 2 Imaginem Vis remains."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Careful" +3
            "Observant" +2
        }
        ABILITIES {
            "Area Lore Stonehenge Tribunal" SCORE 10
            "Magic Lore" SCORE 8
            "Music" SCORE 12
            "Teaching" SCORE 5
        }
        POWERS {
            ^"Discorporate" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Aneirin never physically manifests, save as a shadow and a melodic voice. He can only be harmed with magic."
            }
            ^"Names of Power" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING
                }
                DESCRIPTION "Aneirin knows many names of minor spirits and can teach them as a result of a Pact."
            }
        }
        DESCRIPTION "One of the five great Welsh poets believed by the Order to have left Daimons behind after their death (the other four being Taliesin, Talhaearn Tad Awen, Blwchbardd, and Cian). Famous for a single poem, Y Gododdin, Aneirin praises his fellows among the war band of Mynyddawg Mwynfawr (Mynyddawg the Wealthy) of Caereidyn (near Edinburgh), an army 300 strong sent on a doomed mission to recapture an old Roman stronghold from the Saxons. His tomb lies somewhere in the Cambrian Mountains. His spirit wanders across the entire mountain range, helping those who further his ideals and punishing those who go against them, but he is most powerful within his own tomb."
    }
    #tyvUuB9Eed9VGLXQu58I13IE ^"Chnoubis the Serpent" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 30
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Mentem"
            ^"Size" INTEGER -1
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 6
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 5
            }
            ^"Soak" INTEGER 9
            ^"Wound Penalties" STRING "–1 (1–4), –3 (5–8), –5 (9–12), Banished (13+)"
            ^"Vis" STRING "On being banished his scales remain, containing 3 pawns of Intellego and 2 of Mentem vis"
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Curious" +4
            "Diplomatic" +3
            "Proud" +2
            "Noble" +1
        }
        COMBAT {
            "Bite" INIT 5 ATTACK 8 DEFENSE 8 DAMAGE 5
        }
        POWERS {
            ^"Augury" DEF {
                PROPERTIES {
                    ^"Cost" STRING "varies"
                    ^"Initiative" STRING "+5"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "By using this power Chnoubis is able to perform auguries as the Virtue Divination & Augury (see The Mysteries Revised Edition, page 58), with each Might Point allowing ten levels of success. If you do not have access to The Mysteries Revised Edition, this power allows Chnoubis to duplicate the effects of any Hermetic Intellego spell, and costs 1 point for every ten levels of the spell."
            }
            ^"Aura of Rightful Authority" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "+5"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Equivalent to the ReMe20 Hermetic spell."
            }
            ^"Discorporation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "varies, 1 point"
                    ^"Initiative" STRING "+7"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Becomes a discorporate spirit which can move as fast as lightning and is only visible to Intellego Vim magics or Second Sight. He sneaks up on victims invisibly and bites them, then listens to their secrets as the toxin takes effect."
                REFERENCES {
                    "Second Sight" -> #tK3lWiuLQzp34S7lnZh3DDcI ^"Second Sight"
                }
            }
        }
        DESCRIPTION "On being bitten the victim must make a Fatigue test against Ease Factor 9 or lose a Fatigue level each round until he has succeeded for three consecutive rounds or fallen unconscious. While suffering these effects, the victim is unable to tell a lie (Penetration 25, Mentem), and is eager to talk to anyone present about anything on their mind, talking to themselves if necessary. Once the victim falls unconscious no further Fatigue is lost, but they awaken with a terrible headache and must make a Stamina stress roll (plus Art of Memory if they have that Ability) at Ease Factor 6 to recall what transpired. A lion-headed serpent called upon for his abilities to scry and ferret out secrets. He claims to be a native of the Nile, but theurgists across Europe may successfully summon him. True to his visage, Chnoubis is a powerful fighter, but is much more interested in the power of words."
        REFERENCES {
            "Ease Factor" -> #tGQufzy8y8Qc3foo2n9p7nMU ^"Ease Factor"
            "Art of Memory" -> #thybwauyoeKKUG8pltpGP2U0 ^"Art of Memory"
            "Ease Factor" -> #tGQufzy8y8Qc3foo2n9p7nMU ^"Ease Factor"
        }
    }
    #t3HslLZrgCPuZ1XkzJ7zlP1x ^"Dietrich von Bern" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 35
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Corpus"
            ^"Size" INTEGER 2
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 2
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER 5
                ^"Communication" INTEGER 3
                ^"Strength" INTEGER 5
                ^"Stamina" INTEGER 5
                ^"Dexterity" INTEGER 5
                ^"Quickness" INTEGER 3
            }
            ^"Soak" INTEGER 22
            ^"Wound Penalties" STRING "–1 (1–7), –3 (8–14), –5 (15–21), Banished (22+)"
            ^"Vis" STRING "7 Rego"
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Proud" +3
            "Barbarous" +2
            "Crafty" +2
        }
        COMBAT {
            "Greatsword" INIT 5 ATTACK 19 DEFENSE 17 DAMAGE 15
        }
        ABILITIES {
            "Athletics" SCORE 6
            "Great Weapon" SCORE 10
            "Intrigue" SCORE 6
            "Leadership" SCORE 8
        }
        POWERS {
            ^"Sacred Kingship" DEF {
                PROPERTIES {
                    ^"Cost" STRING "10 points"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "By laying hands on another character, Dietrich can permanently increase the character's Perception, Presence, or Communication by 1 point. He can only do this once per person, and can only to a maximum of +3. Increasing Presence this way is a very useful aid to the aspiring Mystagogue."
            }
        }
        DESCRIPTION "Dietrich's sword has been dipped in dragon's blood. No magical spell of a level 40 or lower can deflect, harm, or control it. After being hit, the dragon's blood burns, causing an extra +5 damage per round (armor does not soak) unless an alchemist, herbalist, or healer can cure the wound. Soak +22 is from full chain mail drenched in dragon's blood. A hero in German poetry and song, Dietrich was the boy-king of Bern after the fall of Rome. During his reign, several great Nibelungen heroes, including Siegfried himself, were loyal members of his court. When his uncle Ermenrik, German ruler of Rome, conquered Bern, Dietrich fled to the court of Attila the Hun, where he went on many adventures and became one of the greatest warriors in history. He returned after his uncle died, retook Bern and captured Rome. He died in a quest for revenge against a friend who betrayed him, and was buried in an ornate tomb in the Lessini Mountains, where the Alps cross over into Italy. His tomb is a treasure trove of weapons and armor, enchanted by being dipped in the blood of a great dragon Dietrich slew. When anyone enters the tomb, however, the Daimon of Dietrich animates his hulking corpse. If you come seeking wisdom and prove yourself worthy, he will dispense kingly advice. If you come seeking power, you will face one of the greatest warriors on Earth, even in death. Another legend propagated by the Church says Dietrich, a heretic suspected of Arianism, was thrown into the volcanic Mount Etna. The legend of Dietrich appears in Das Heldenbuch (\"The Book of Heroes\") a collection of German romances published in the early 13th century, organizing the tales of the Ostrogoths and Franconians into two epic cycles."
    }
    #tM7NqFgx0UTGKFNMuFyve1lK ^"Gydryty-kom the Giant" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 40
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Auram"
            ^"Size" INTEGER 3
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER -2
                ^"Strength" INTEGER 8
                ^"Stamina" INTEGER 6
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 3
            }
            ^"Soak" INTEGER 20
            ^"Wound Penalties" STRING "–1 (1–8), –3 (9–16), –5 (17–24), Banished (25+)"
            ^"Vis" STRING "When he is banished his tongue remains, and contains 8 pawns of Auram Vis."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Hates Being Interrupted" +4
            "Determined" +3
            "Protective" +2
        }
        COMBAT {
            "Brawl" INIT 3 ATTACK 10 DEFENSE 10 DAMAGE 8
        }
        POWERS {
            ^"Auram Magic" DEF {
                PROPERTIES {
                    ^"Cost" STRING "varies"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "May perform equivalent effects to any Auram magic at a cost of 1 point per magnitude, or for spells involving hail, 1 point per three magnitudes. Can perform Auram Ritual spells as if they were Formulaic spells; no extra time or vis is required."
            }
            ^"Swallow Spells" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Can swallow any magical spell or effect with a level of 50 or less, completely dispelling it."
            }
        }
        DESCRIPTION "Gydryty-kom is the master of hail, a giant who can stretch his mouth from the ground to the clouds. He swallows storms and lightning, but grows angry when summoned because it interrupts his eternal battle with a Daimonic snake of fog that threatens to swallow the world. Gydryty-kom was once highly regarded in the lands of the Albanians, but his power has faded thanks to Christianity."
    }
    #tn3IVX5xghATdkGnZ5YQDIfW ^"Hipta the Nurse" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 15
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Animal"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 3
                ^"Communication" INTEGER 2
            }
            ^"Wound Penalties" STRING "Varies by form. Substitute Banished for Incapacitated"
            ^"Vis" STRING "Leaves 3 pawns of Animal Vis in the form of a white feather when banished."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Calm" +4
            "Protective" +2
        }
        POWERS {
            ^"Shapechange" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+5"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION "May change form into any natural or fantastic beast from size –5 to +2. The change is instantaneous, and she can always speak in any form."
            }
            ^"Dispel" DEF {
                PROPERTIES {
                    ^"Cost" STRING "varies"
                    ^"Initiative" STRING "+5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "May perform any Perdo Vim spell at will, for the cost of one Might point per magnitude. Hipta counts as familiar with all styles of magic for this purpose, and has a Penetration Score of 30, making invoking her a common way to end malevolent curses."
            }
        }
        DESCRIPTION "The nurse of Dionysus, Hipta is a powerful shapechanger but favors the form of a lovely dove. Her name and spells to summon her can be found in several ancient texts. She is invoked for forgiveness from curses and magical harm. Str, Sta, Dex, Qik vary; Size varies from –5 to +2; Combat and Soak vary with form."
    }
    #tWGtr6inQBW8sRmR8OpkKwAI ^"Honos" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 30
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Corpus"
            ^"Size" INTEGER 0
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 2
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER 3
                ^"Stamina" INTEGER 5
                ^"Dexterity" INTEGER 4
                ^"Quickness" INTEGER 4
            }
            ^"Soak" INTEGER 14
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–20), Incapacitated (21–25), Banished (26+)"
            ^"Vis" STRING "Leaves 6 pawns of Corpus in his armor when banished."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Honorable" +6
            "Authoritarian" +3
            "Disciplined" +3
        }
        COMBAT {
            "Long Spear" INIT 7 ATTACK 14 DEFENSE 12 DAMAGE 10
        }
        ABILITIES {
            "Athletics" SCORE 4
            "Great Weapon" SCORE 6 SPECIALTY "long spear"
            "Leadership" SCORE 6
            "Teaching" SCORE 3 SPECIALTY "leadership"
        }
        POWERS {
            ^"Instill Leadership" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "+4"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "With a touch of his long spear, Honos can teach 17 experience points in the ability Leadership, to a maximum of Ability score 6. The Theurgist receives the insights immediately, but must then devote the season to study and reflecting upon them to gain the increase."
            }
            ^"Centurions’ Feast" DEF {
                PROPERTIES {
                    ^"Cost" STRING "30 points"
                    ^"Initiative" STRING "+4"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Produces a magical feast sufficient to feed one hundred people. All who partake of the feast who possess the Flaw Dutybound are instantly cured of any Light and Medium Wounds, and gain +10 on their next recovery checks. The food lasts for one hour, then dissipates, but the effects are permanent."
            }
        }
        DESCRIPTION "Honos is a Roman Daimon of morality and military honor, with several temples built in his name. Honos appears as a young warrior in ancient armor, carrying a lance and a cornucopia (“horn of plenty”). Honos’ temples in Rome have been destroyed or blanketed by the Dominion, although the Legion of Mithras are rumored to know the location of one surviving shrine where he can be invoked."
    }
    #tDt5QYWqZc7U7UunnDspJIev ^"Portunes, Spirit of Safe Harbor" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 25
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Auram"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 1
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 0
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER 0
            }
            ^"Wound Penalties" STRING "n/a"
            ^"Vis" STRING "None."
            ^"Appearance" STRING "When summoned, he appears either as a ghostly serpent or the shadowy visage of a bearded man in a leather apron, but he never takes on a solid physical form."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Watchful" +3
        }
        POWERS {
            ^"Safe Harbor" DEF {
                PROPERTIES {
                    ^"Cost" STRING "12 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "Guarantees calm weather in the harbor of a port for an entire season, and resists all spells that would disrupt this with a Magic Resistance of 60."
                REFERENCES {
                    "Magic Resistance" -> #tmM1uJVBdvXpEsg4iImNPyjr ^"Magic Resistance"
                }
            }
            ^"Opening Enchanted Locks" DEF {
                PROPERTIES {
                    ^"Cost" STRING "8 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Portunes can dispel any magical lock with a level of less then 40 with this power."
            }
        }
        DESCRIPTION "A Spirit charged with ports and harbors, the Greeks called him Palaemon and Melicertes. His purview also covers keys, locks, and domestic animals. In Rome he was worshipped as a god, with a temple located near the Forum Boarium. His feast, the Portunalia, is observed on August 17th. The rite to summon him involves throwing keys into a fire. He has no combat: he vanishes if attacked, and can only be harmed by Perdo Vim spells. He never materializes, so has no Soak."
    }
    #tk6pGOlDxW6a8pCfEBfNMT0Z ^"Pukis, Dragon of the Hearth" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 10
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Ignem"
            ^"Size" INTEGER -2
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -1
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER -1
                ^"Stamina" INTEGER 4
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 6
            }
            ^"Soak" INTEGER 8
            ^"Wound Penalties" STRING "–1 (1–3), –3 (4–6), –5 (7–9), Banished (10+)"
            ^"Vis" STRING "2 Ignem, 1 Rego"
            ^"Appearance" STRING "This Daimon takes the form of a small dragon of fire that dwells in the hearth or a fireplace. Although small, Pukis is long and thin."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Mischievous" +3
            "Loyal" +3
            "Fickle" +2
        }
        COMBAT {
            "Bite" INIT 5 ATTACK 6 DEFENSE 9 DAMAGE 3
            "Lashing tail" INIT 6 ATTACK 10 DEFENSE 13 DAMAGE 0
        }
        POWERS {
            ^"Invisibility" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "+6"
                    ^"Form" STRING "Imaginem"
                }
                DESCRIPTION "Pukis can turn itself completely invisible and inaudible, for as long as it chooses, or until it touches a person or animal."
            }
            ^"Mischievous Flame" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "+6"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "With a glance, Pukis can set anything slightly flammable aflame."
            }
            ^"Sneak Thief" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "+6"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "By touching any object weighing less than 3 pounds, Pukis can instantly teleport the object to its home so that it appears at the edge of its master’s hearth."
            }
            ^"Sacred Fire" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+6"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "As long as Pukis lives in a particular hearth, and the fire is kept hot year round, the ashes from the fire can be collected for 1 pawn of Ignem per season."
            }
        }
        DESCRIPTION "Although small, Pukis is long and thin. It can engage 2 opponents without penalty, attacking one with its jaws and the other with its quick tail. It is also burning hot, and can ignite easily flammable materials on touch. First summoned by Baltic wizards, it enjoys napping amongst burning logs and coals, coiling its long-snake like body beneath the flames to conceal its presence. It will leave gifts for the master of the household, possibly stolen from somewhere else, and will attack strangers if they act destructively. If it is treated poorly, it will cause mischief before departing. The magus Andrilikes, a theurgist of the Novgorod tribunal, wrote a Hermetic ritual for summoning this lesser Daimon to his sanctum, and has given copies to several of his friends."
    }
    #t5jq4HYMMIAelp9lC3CCiyUU ^"An Earth Elemental" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might" INTEGER 15
            ^"Might Realm" STRING "Magic" FIXED
            ^"Form" STRING "Terram"
            ^"Size" INTEGER 0
            ^"Characteristics" DEF {
                ^"Cunning" INTEGER 0
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER -2
                ^"Communication" INTEGER -4
                ^"Strength" INTEGER 3
                ^"Stamina" INTEGER 6
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 0
            }
            ^"Virtues and Flaws" LIST ["Berserk", "Great Stamina", "Tough", "Ways of the Cavern", "Poor Memory", "Short Attention Span", "Simple Minded"]
            ^"Soak" INTEGER 9
            ^"Wound Penalties" STRING "–1 & 1 Might point (1–5), –3 & 3 Might points (6–10), –5 & 5 Might points (11–15), Incapacitated & 5 Might points (16–20), Dead & all Might points (21+)"
            ^"Vis" STRING "3 pawns of Terram, in body"
            ^"Appearance" STRING "An earth elemental appears much like any other object of earth or rock, except it is made up of sharp edges and right-angled corners that form cubic corpuscles of different sizes."
            ^"Source" STRING "Core Rules"
        }
        PERSONALITY_TRAITS {
            "Cave" +3
        }
        COMBAT {
            "Bludgeon (includes Ways of the Cavern)" INIT 3 ATTACK 11 DEFENSE 7 DAMAGE 9
            "Bludgeon when Berserk (includes Ways of the Cavern)" INIT 3 ATTACK 13 DEFENSE -5 DAMAGE 9
        }
        ABILITIES {
            "Athletics" SCORE 3 SPECIALTY "pursuit"
            "Awareness" SCORE 2 SPECIALTY "interlopers"
            "Brawl" SCORE 3 SPECIALTY "bludgeon"
            "Penetration" SCORE 3 SPECIALTY "Slake Thirst Power"
            "Stealth" SCORE 2 SPECIALTY "keeping still"
        }
        POWERS {
            ^"Crush" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "-2"
                    ^"Form" STRING "Terram"
                    ^"Range" STRING "Touch"
                    ^"Duration" STRING "Sun"
                    ^"Target" STRING "Ind"
                }
                DESCRIPTION "The elemental clubs at an opponent with its heavy limbs, requiring a normal Bludgeon melee attack, which does its own damage as normal. If the elemental is at least equal in Size to its opponent, a successful Crush attack can pin him to the ground, and the elemental adds its (Might/5, rounded up) to its Grapple Strength to prevent its victim escaping. If the elemental successfully grapples, then any equipment carried by its victim is damaged; fragile items are destroyed, robust items are broken (and are destroyed if affected again by this power), and metal items are damaged (and are broken if affected again by this power)."
            }
            ^"Slake Thirst" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+4"
                    ^"Form" STRING "Aquam"
                    ^"Range" STRING "Touch"
                    ^"Duration" STRING "Mom"
                    ^"Target" STRING "Part"
                }
                DESCRIPTION "Earth elementals are always thirsty, and direct contact with the elemental removes water from the target, inflicting a Fatigue level of damage. Once all Fatigue levels are gone, successive strikes (or rounds of contact) inflict a Light Wound, then a Medium Wound, then a Heavy Wound, and so forth. Fatigue levels may be restored by drinking at least two pints of water (for a Size 0 individual), while wounds are healed as normal."
            }
        }
        DESCRIPTION "This elemental was rarefied in a cavern with a Magic aura, and guards the vis source found therein with a furious passion."
    }
