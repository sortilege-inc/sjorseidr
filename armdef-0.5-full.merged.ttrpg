            MODIFIERS {
                +1 "Touch"
                +2 "Sun"
            }
        }
        DESCRIPTION "A setting's worth of food or drink tastes and smells exactly as you designate."
    }
    #tz2aQ6PAHEEQZCGREHKqFqyI ^"Aura of Ennobled Presence" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto" FIXED
            ^"Form" STRING "Imaginem" FIXED
            ^"Level" INTEGER 10 FIXED
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 3
            MODIFIERS {
                +1 "Touch"
                +2 "Sun"
            }
        }
        DESCRIPTION "The target appears more forceful, authoritative, and believable. Numerous subtle changes in appearance bring about this change, including a slight supernatural illumination of the face, a more erect posture, and a louder and smoother voice. The character gets a +3 on rolls to influence, lead, or convince others."
    }
    #tJjbOUbzL52G5Tmaowo3mRXV ^"Notes of a Delightful Sound" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto" FIXED
            ^"Form" STRING "Imaginem" FIXED
            ^"Level" INTEGER 10 FIXED
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Room"
            ^"Source" STRING "Core Rules"
        }
        LEVEL_CALCULATION {
            BASE 1
            MODIFIERS {
                +1 "Touch"
                +2 "Sun"
                +2 "Room"
            }
        }
        DESCRIPTION "Causes all sounds in a room, particularly music, to be especially clear and sonorous. The notes are clearer, sharper, and more distinct."
    }
    #tUhEYXiNz10uFkBgamuJb5xv ^"Disguise of the Transformed Image" DEF {
