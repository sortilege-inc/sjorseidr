        REFERENCES {
            "Lab Total" -> #tARMDefConceptLabTotal ^"Lab Total"
        }
    }
    #t7Bva0Pzv25dqGg0LyfTQmHD ^"Inflexible Magic" DEF {
        EXTENDS ^"Flaw"
        PROPERTIES {
            ^"Size" STRING "Minor" FIXED
            ^"Category" STRING "Supernatural" FIXED
            ^"Source" STRING "Hedge Magic [Revised Edition]"
        }
        DESCRIPTION "The gruagach’s Formulaic spells are not as versatile as most. Instead of being able to vary the Range, Duration, and Target of a known spell by 10 levels, the gruagach is only able to vary his spells by 5 levels."
