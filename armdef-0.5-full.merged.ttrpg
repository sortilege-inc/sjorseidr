    GUIDANCE {
        ENTRY ^"A Muslim Library" #te8e4a0692eb68fe07c93c2 {
            TEXT "A Muslim Library

As implied above, many mediaeval Muslims are educated. Education is a requirement for members of the civil and religious elite, and many members of the military elite are as skilled with Arabic language and literature as they are with swords and bows. The following represents a selection of texts with which an educated Muslim might be familiar. All of these books were originally written in Arabic."
        }
    }
    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.
    #t091dad3a357e7c97d8a1df ^"Muslim Invocation Modifiers Table" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["SITUATION", "MODIFIER"]
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 103
        }
        TABLE {
            "Highest Muslim Personality Trait" "+ value of the Trait"
            "In a Divine Aura" "+1/aura*"
            "During the forbear’s feast day (normally birthday)" "+3"
            "Pilgrimage made specifically to the forbear’s tomb/shrine" "+2"
            "Touching forbear’s relic" "+1"
            "Owning a forbear’s relic" "+2"
            "Making a donation" "+1 to +3"
            "Imminent peril" "+2"
            "Recent sinful act" "–1 to –3"
            "No zakat paid within a year" "–3"
            "Received a miracle within a month" "–5"
            "Invoking an unfamiliar forbear" "–10"
            "Invoking a specific miracle of a forbear rather than general aid" "–5"
        }
        DESCRIPTION "* Remember that the aura may be temporarily raised if it is a Muslim holiday and/or the *salat* is taking place at the time."
    }
    # The chapter's characters rules, structured; each DESCRIPTION the source's text, verbatim.
    #tcb7b7e21392c3d80879114 ^"Astrological Magic" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "ASTROLOGICAL MAGIC"
            ^"Size" STRING "Minor"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 134
        }
        DESCRIPTION "Schooled both in astrology and in kabbalistic mysticism, this Virtue allows your character to add his Artes Liberales score to Kabbalah totals."
    }
    #t615ccd7c63d1b2e3bb90cc ^"Ba’al Shem" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "BA’AL SHEM"
            ^"Size" STRING "Free"
            ^"Category" STRING "Social"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 134
        }
        DESCRIPTION "Your character is a Ba’al Shem, a master of the Divine name, a folk healer and worker of wonders. He is a member of the Ba’al Shem Holy Tradition and treats Adjuration, Blessing, Craft Amulets, and Invocation as favored Abilities."
    }
    #tb67531afe4bdc9245e9e34 ^"Craft Amulets" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
