            #t99675ce30defc3590634aa ^"Endurance of the Enraged" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Furies."
            }
        }
        DESCRIPTION "Gavi was a greedy merchant in life who went to Hell for his sins. Desperate to rid himself of the sin of greed, thinking this will allow him to enter Heaven, Gavi forces his victims to carry out mad acts of charity. He gives all their money away, forces others to take their greatest possessions, and even force-feeds beggars."
    }
    #ta8e1f6d0a1b11d8df8232b ^"Golab, Foe of the Seraphim" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Vessels of Iniquity"
            ^"Might" INTEGER 30
            ^"Form" STRING "Vim"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 1
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 2
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 4
                ^"Stamina" INTEGER 4
                ^"Dexterity" INTEGER 4
                ^"Quickness" INTEGER 0
            }
            ^"Size" INTEGER 1
            ^"Confidence Score" STRING "1 (3 points)"
            ^"Reputations" LIST ["Foe of the Seraphim 3 (Infernal)"]
            ^"Hierarchy" INTEGER 3
            ^"Soak" INTEGER 6
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–6), –3 (7–12), –5 (13–18), Incapacitated (19–24)"
            ^"Weakness" STRING "Abhorrent Material (blessed objects)"
            ^"Vis" STRING "6 pawns of Vim, in genitalia"
            ^"Appearance" STRING "In common with all Vessels of Iniquity, his natural form is indescribable; it is hatred given solid form. Any who see it are driven to indulge in the desecration of those things they hold most sacred and spiritual. When appearing as a human, Golab takes the form of an obese member of the clergy, usually one from a group known in the region for hypocrisy or other moral failings."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 70
        }
        PERSONALITY_TRAITS {
            "Depraved" +6
            "Hateful" +6
            "Pious" -6
        }
        COMBAT {
            "Club" INIT 1 ATTACK 13 DEFENSE 7 DAMAGE 7
        }
        ABILITIES {
            "Church Lore" SCORE 5 SPECIALTY "sects"
            "Divine Lore" SCORE 5 SPECIALTY "heresy"
            "Islamic Lore" SCORE 5 SPECIALTY "sects"
            "Jewish Lore" SCORE 5 SPECIALTY "sects"
            "Leadership" SCORE 6 SPECIALTY "mobs"
            "Single Weapon" SCORE 6 SPECIALTY "club"
            "Theology" SCORE 6 SPECIALTY "errors in reasoning"
        }
        POWERS {
            #tb98ae851ced4163a3b521c ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Religious Intolerance. See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t6a327cb5248318a0f27265 ^"Form of Wickedness" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Vessels of Iniquity."
            }
            #t71760532a61797cda28424 ^"Form of Man" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Vessels of Iniquity."
            }
            #t7b931e5652c057f1409c1d ^"Contagious Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point per victim"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Vessels of Iniquity."
            }
        }
        DESCRIPTION "Golab is the self-declared adversary of the seraphim. He specializes in sedition against God, which he achieves through the emotion of hatred. He delights in causing riots on holy days, causing pilgrims to stampede innocents, and inciting his victims to murder the clergy."
    }
    #tfdb879361570f9984f9c25 ^"Gourmand the Sweet-Toothed" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Vessel of Iniquity"
            ^"Might" INTEGER 15
            ^"Form" STRING "Imaginem"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 1
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER 3
                ^"Stamina" INTEGER 0
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 2
            }
            ^"Size" INTEGER 1
            ^"Confidence Score" STRING "1 (3 points)"
            ^"Virtues and Flaws" STRING "Appears to have the Obese Flaw, but does not suffer any penalties."
            ^"Reputations" LIST ["Spice Trader 1 (Infernal)"]
            ^"Hierarchy" INTEGER 1
            ^"Soak" INTEGER 2
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–6), –3 (7–12), –5 (13–18), Incapacitated (19–24)"
            ^"Weakness" STRING "Vulnerability (salt) — He finds this extremely embarrassing."
            ^"Vis" STRING "3 pawns of Imaginem, in the stains on his clothing"
            ^"Appearance" STRING "Gourmand manifests the human form of a fleshy man of middle age. Food of vivid colors stains his sumptuous clothes, chubby fingers, and the corners of his mouth. His smell, of rotting fruit, is transmitted to anything he touches, and does not fade until sunrise. Gourmand looks unfit and flabby, but is surprisingly swift and strong if forced to engage in combat. He uses a double-handed, basalt pestle as his preferred weapon."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 70
        }
        PERSONALITY_TRAITS {
            "Depraved" +6
            "Hateful" +6
            "Gluttony" +3
        }
        COMBAT {
            "Pestle (Cudgel)" INIT 3 ATTACK 10 DEFENSE 6 DAMAGE 10
        }
        ABILITIES {
            "Bargain" SCORE 6 SPECIALTY "spices"
            "Craft: Confectionery" SCORE 5 SPECIALTY "sugar"
            "Great weapon" SCORE 3 SPECIALTY "cudgel"
            "Guile" SCORE 3 SPECIALTY "merchants"
        }
        POWERS {
            #t1bce12bd91adbf8d60bfba ^"Cloud of Pepper" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Herbam"
                }
                DESCRIPTION "This Power fills a room — or in unwalled areas, a circle 100 yards across — with a choking cloud of pepper dust, for one round. This irritates the lungs and eyes of humans, but does not cause any lasting damage. Characters within the cloud must make a Stamina roll against an Ease Factor of 9. Successful characters are unaffected by the dust. Those with lower totals are blinded for a round, and suffer a Fatigue level of choking damage. They may make a fresh Stamina roll each round, with the Ease Factor being reduced by one for each round since they were affected by the pepper. The pepper does not remove more than one Fatigue level form any victim. Gourmand uses this Power to inconvenience foes, either to make combat easier or to allow him to flee."
            }
            #t2065e9d67d41da612bba5c ^"Conjure Spices" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–3"
                    ^"Form" STRING "Herbam"
                }
                DESCRIPTION "Gourmand may summon a measure of spices, of any type, from another place so swiftly it appears he has created it. Most spices are extremely valuable, and are given to his servants as rewards. Gourmand can also summon herbs and plant-based poisons using this Power."
            }
            #tde8f41f0a728d22ae5f113 ^"Hide Flavor" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "–3"
                    ^"Form" STRING "Imaginem"
                }
                DESCRIPTION "The demon may alter the flavor and texture of one handful of any substance. These substances are usually used in poisoning, since Gourmand can make ground glass taste sweet and iron filings seem soft. This Power does not affect the appearance or smell of its target, which may give alter characters an opportunity to detect the adulteration."
            }
            #te7f91871d52fe3654ce1a3 ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Craving Sweet things. See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t1c33e84d799beb373cdb9d ^"Form of Wickedness" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Vessels of Iniquity."
            }
            #t232c30d858b85c4fa4c99d ^"Form of Man" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Vessels of Iniquity."
            }
            #tcb8a67cb63535c52f262cb ^"Contagious Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point per victim"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Vessels of Iniquity."
            }
        }
        DESCRIPTION "Gourmand seeks additional power over men through their sense of taste, and their greed for valuable spices. Gourmand favors many schemes, but those most dear to him are the propagation of trade along the Silk Road, and the introduction of sugar into the cuisines of Europe. He is not a particularly powerful demon, so he often works with others who are more suited to physical conflict."
    }
    #tccd951aa74f83df1d7172c ^"Hulikang, a Rabble Rouser" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Vessels of Iniquity (Merry Devil)"
            ^"Might" INTEGER 20
            ^"Form" STRING "Mentem"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER -1
                ^"Communication" INTEGER 3
                ^"Strength" INTEGER 1
                ^"Stamina" INTEGER 4
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 3
            }
            ^"Size" INTEGER 1
            ^"Confidence Score" STRING "2 (6 points)"
            ^"Virtues and Flaws" STRING "Improved Characteristics, Puissant Athletics"
            ^"Reputations" LIST ["Captain of the Red Devils 2 (Infernal)"]
            ^"Hierarchy" INTEGER 2
            ^"Combat" STRING "Punch: Init +3, Attack +4, Defense +4, Damage n/a Dodge: Init +3, Attack n/a, Defense +5, Damage n/a Hulikang never causes damage to people himself, he only appears to, to goad others on to sin."
            ^"Soak" INTEGER 9
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–6), –3 (7–12), –5 (13–18), Incapacitated (19–24)"
            ^"Weakness" STRING "Protected Group (solemn people)"
            ^"Vis" STRING "2 pawns of Corpus, in each hand (4 pawns total)"
            ^"Appearance" STRING "In human form, Hulikang takes the appearance of a hulking man with a bruised face and broken nose. He always wears a knitted cap and scarf, as a tribute to his greatest mischief ever."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 71
        }
        PERSONALITY_TRAITS {
            "Depraved" +6
            "Hateful" +6
            "Jolly" +6
        }
        ABILITIES {
            "Athletics" SCORE 6 BONUS 2 SPECIALTY "sport"
            "Brawl" SCORE 1 SPECIALTY "dodge"
            "Carouse" SCORE 6 SPECIALTY "quantity"
            "Folk Ken" SCORE 6 SPECIALTY "rivalries"
            "Intrigue" SCORE 4 SPECIALTY "encouraging fights"
        }
        POWERS {
            #t5513f3f47668fcbe851af0 ^"Shout" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Imaginem"
                }
                DESCRIPTION "Allows the demon to say a short sentence that is perfectly audible to every person in a crowd, although they cannot determine its source."
            }
            #t88820e5527e36aaac9a74b ^"Pleasant Clouds in the Mind" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Merry Devils."
            }
            #t40eff0c117805acec2118b ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Tribal Violence. See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #tecc82061fae96991245e21 ^"Form of Wickedness" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Vessels of Iniquity."
            }
            #te672cbabcbf2c89dc2361b ^"Form of Man" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Vessels of Iniquity."
            }
            #ta2e3eef4c1361930fa5d6b ^"Contagious Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point per victim"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Vessels of Iniquity."
            }
        }
        DESCRIPTION "Hulikang is a Merry Devil who specializes in destroying public celebrations, particularly those involving athletic contests. During the early part of the celebration, he encourages intoxication and rivalries in the crowd. Once the crowd has been prepared, he frightens them, in the hope that they will become a violent mob. He is particularly skilled at disrupting sporting events between rival villages. Hulikang often works with a partner, a female demon who names herself Nike after the ancient Greek goddess of victory. When operating as a pair, each claims the portion of the crowd supporting one team in a competition, and tries to outdo the violence the other provokes. He is also the captain of a sports team consisting entirely of demons, called the Red Devils."
    }
    #t7f0b82151e960eca307e64 ^"Mahonin" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Tempters (Maggots)"
            ^"Might" INTEGER 5
            ^"Form" STRING "Animal"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 2
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER -10
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 10
            }
            ^"Size" INTEGER -15
            ^"Virtues and Flaws" STRING "Weak Willed"
            ^"Reputations" LIST ["None"]
            ^"Hierarchy" INTEGER 0
            ^"Soak" INTEGER 1
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1), –3 (2), –5 (3), Incapacitated (4)"
            ^"Weakness" STRING "Abhorrent Material (fennel)"
            ^"Vis" STRING "1 pawn of Vim vis, in wings"
            ^"Appearance" STRING "Indistinguishable from other Maggots, Mahonin appears as a twisted mockery of a tailless monkey, with the iridescent wings of a greenbottle."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 72
        }
        PERSONALITY_TRAITS {
            "Selfish" +5
        }
        COMBAT {
            "Dodge" INIT 10 DEFENSE 21
        }
        ABILITIES {
            "Athletics" SCORE 10 SPECIALTY "flying"
            "Brawl" SCORE 10 SPECIALTY "dodge"
        }
        POWERS {
            #td15f05fb6111f447e21f62 ^"Endurance of the Gluttonous" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Any creature possessed by Mahonin is oblivious to pain caused while eating, or discomfort or damage caused by what they consume. They still suffer any Wound or Fatigue penalties caused by these injuries or malaises, but they are not aware of them."
            }
            #tcc3ae1821f2a4e0bd73784 ^"Possession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+2"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t5c9d37676ff469b42bce04 ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #td9a679c2313818b2e4dd35 ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Gluttony. See Chapter 4: Infernal Legions, Demonic Powers."
            }
        }
        DESCRIPTION "Mahonin is a demon who deludes his victims into believing that all kinds of inedible objects are luxurious food items. His hosts may be seen consuming filth from the night soil like it is the most delicious soup, or eating broken glass with relish while blood pours down their faces. Forcing his energumen to consume fennel seeds usually drives this demon away."
    }
    #t24ab53f1051a20458c7a60 ^"Morrighu, the Screech-Hag" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Aerial Powers"
            ^"Might" INTEGER 10
            ^"Form" STRING "Auram"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER -3
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER -2
                ^"Stamina" INTEGER -2
                ^"Dexterity" INTEGER 4
                ^"Quickness" INTEGER 3
            }
            ^"Size" INTEGER -1
            ^"Confidence Score" STRING "1 (3 points)"
            ^"Virtues and Flaws" STRING "Enchanting Music"
            ^"Reputations" LIST ["Bringer of Victory 2 (Infernal)"]
            ^"Hierarchy" INTEGER 2
            ^"Soak" INTEGER 0
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–4), –3 (5–8), –5 (9–12), Incapacitated (13–16)"
            ^"Weakness" STRING "Protected Group (virgins)"
            ^"Vis" STRING "2 pawns of Perdo, in wings"
            ^"Appearance" STRING "Morrighu appears with the body of a carrion crow, but the upper parts of an ancient woman. Huge black wings extend from her shoulders. She has long, pointed ears and is always accompanied by a strong wind."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 72
        }
        PERSONALITY_TRAITS {
            "Untameable" +5
            "Boastful" +4
            "Vindictive" +4
            "Peaceful" -6
        }
        COMBAT {
            "Claws" INIT 3 ATTACK 10 DEFENSE 8 DAMAGE 2
            " Dodge" INIT 3 DEFENSE 8
        }
        ABILITIES {
            "Athletics" SCORE 5 SPECIALTY "flying"
            "Brawl" SCORE 4 SPECIALTY "dodge"
            "Enchanting Music" SCORE 4 SPECIALTY "lulling to sleep"
            "Stealth" SCORE 5 SPECIALTY "sleeping enemies"
        }
        POWERS {
            #t015cfa2a42b4fee5ec1c60 ^"Elemental Control of Air" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Aerial Powers. She often employs effects similar to *Stench of Twenty Corpses* and *Charge of the Angry Winds*."
            }
            #t2d78e985ffc6fa9a24e603 ^"Grant Victory" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "+5"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Morrighu can grant a character a +3 bonus to all Attack and Damage totals for the duration of a single battle. She rarely does this without demanding some payment."
            }
            #t0dccdea2471300e0e6eea5 ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t744e9e8a785fc0ad09a24e ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Mercilessness. See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t03fe394c649695e4081778 ^"Recalcitrance" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION ". See Chapter 4: Infernal Legions, Aerial Powers."
            }
        }
        DESCRIPTION "Morrighu is a demon of warfare. In former times she was more powerful, and she claims she was a mighty goddess of Faerie who received worship in return for victory. Now she is forced to perform her services for those infernalists who know about her, for she is a useful spirit to have on one’s side, even though she is no great warrior herself. Note that Morrighu may not actually be the remnant of a pagan goddess, as she claims."
    }
    #t9fca24cc9fd686407ebda1 ^"Naonhaithya" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Lord of the Vessels of Iniquity"
            ^"Might" INTEGER 40
            ^"Form" STRING "Vim"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER 3
                ^"Strength" INTEGER 4
                ^"Stamina" INTEGER 6
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 3
            }
            ^"Size" INTEGER 2
            ^"Confidence Score" STRING "2 (6 points)"
            ^"Reputations" LIST ["Foe of Mankind 4 (Infernal)", "Lord of the Seraphim 5 (Infernal)"]
            ^"Hierarchy" INTEGER 5
            ^"Soak" INTEGER 11
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–7), –3 (8–14), –5 (15–21), Incapacitated (22–28)"
            ^"Weakness" STRING "Light"
            ^"Vis" STRING "8 pawns of Perdo, in the vermin that fill its body cavity"
            ^"Appearance" STRING "Naonhaithya’s true form is the indescribable visual embodiment of rebellion, which provokes those who witness its unveiling to react violently against civic restraint and perform acts of rebellion and anarchy. Naonhaithya can also take the form of an immense man, with the head of an eagle and two pairs of wings."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 73
        }
        PERSONALITY_TRAITS {
            "Depraved" +6
            "Hateful" +6
            "Rebellious" +6
        }
        COMBAT {
            "Claws" INIT 4 ATTACK 14 DEFENSE 11 DAMAGE 10
        }
        ABILITIES {
            "Brawl" SCORE 7 SPECIALTY "claws"
            "Europe Lore" SCORE 6 SPECIALTY "rulers"
            "Holy Land Lore" SCORE 8 SPECIALTY "rulers"
            "Persian Lore" SCORE 8 SPECIALTY "rulers"
            "Russian Lore" SCORE 4 SPECIALTY "rulers"
            "Theology" SCORE 6 SPECIALTY "dualism"
        }
        POWERS {
            #t784367cb4623b9bf927df5 ^"The Tempest’s Fury" DEF {
                PROPERTIES {
                    ^"Cost" STRING "8 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "This Power summons a huge storm out of pre-existing clouds. The storm covers the entire visible sky. The storm consists of rain, hail, powerful winds, thunder, and lightning, all under the direction of Naonhaithya."
            }
            #tdece8a0d359bf657ddd056 ^"Calling the Khrafstar" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION "By invoking this Power, Naonhaithya rips apart his body cavity and swarms of biting, poisonous, repulsive, and noxious creatures (called *khrafstar *in Persian) burst forth from within him. Up to ten targets are attacked by the swarms of scorpions, spiders, lizards, and snakes, who engulf them. Every round, a Stamina roll against an Ease Factor of 9 is required to avoid taking a Medium Wound. It is impossible to concentrate while being bitten and stung by the *khrafstar*."
            }
            #te17de0d3ff8879cbb164d8 ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Rebellion, Anarchy. See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t0e4d495399f08eea58fcb6 ^"Form of Wickedness" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Vessels of Iniquity."
            }
            #tabdce12257869462d99866 ^"Form of Man" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Vessels of Iniquity."
            }
            #te03c9d0b3af2b65dd30148 ^"Contagious Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point per victim"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Vessels of Iniquity."
            }
        }
        DESCRIPTION "Naonhaithya represents rebellion and irreverence in Zoroastrian belief; he is one of the seven *daevas* who oppose the seven *spentas* (Zoroastrian spirits of goodness). Wherever he goes, this filthy spirit spreads anarchy and the corruption of good rulership."
    }
    #tb21731749b754eb87431f6 ^"Rahab, Prince of the Primordial Sea" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Lord of the Aerial Powers"
            ^"Might" INTEGER 35
            ^"Form" STRING "Aquam"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 1
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER 2
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER 4
                ^"Stamina" INTEGER 4
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 2
            }
            ^"Size" INTEGER 3
            ^"Confidence Score" STRING "2 (6 points)"
            ^"Virtues and Flaws" STRING "Lesser Immunity to Drowning, Ways of the Ocean"
            ^"Reputations" LIST ["Prince of the Primordial Sea 9 (Infernal)", "Foe of the Jews 5 (Infernal)"]
            ^"Hierarchy" INTEGER 9
            ^"Soak" INTEGER 13
            ^"Fatigue Levels" STRING "OK, 0, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–8), –3 (9–16), –5 (17–24), Incapacitated (25–32)"
            ^"Weakness" STRING "Running water"
            ^"Vis" STRING "6 pawns of Aquam, in beard"
            ^"Appearance" STRING "Rahab appears as a mighty king, bare-chested and with skin of a blue-green hue. His hair and beard are curled with seaweed. His lower quarters — which rarely protrude above the surface of the sea — are similar to that of a fish or whale, but with stubby legs like those of a walrus."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 74
        }
        PERSONALITY_TRAITS {
            "Hatred for Jews" +6
            "Proud" +6
            "Untameable" +5
        }
        COMBAT {
            "Punch" INIT 0 ATTACK 14 DEFENSE 13 DAMAGE 10
        }
        ABILITIES {
            "Brawl" SCORE 10 SPECIALTY "punch"
            "Ocean Lore" SCORE 8 SPECIALTY "the Red Sea"
            "Survival" SCORE 8 SPECIALTY "in water"
            "Swim" SCORE 10 SPECIALTY "oceans"
            "Wilderness Sense" SCORE 9 SPECIALTY "oceans"
        }
        POWERS {
            #t23cc0ac52356d784ba1175 ^"Mastery of the Oceans" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Aquam"
                }
                DESCRIPTION "Rahab can create any Aquam-based effect, at a cost of 1 Might per two magnitudes. Ritual effects cost him twice as much, and an hour to summon up."
            }
            #tab7b31c84233c73990dfce ^"Wrath of the Oceans" DEF {
                PROPERTIES {
                    ^"Cost" STRING "10 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "Rahab can duplicate the effects of the ritual spell *Wrath of Whirling Winds and Water*, but the storm must begin at sea and head inland. It takes him two hours to summon up this Power."
            }
            #t1b7576dc0941ffc6fe270a ^"Waxing Size of the Swelling Ocean" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "While immersed in water, Rahab can swell his size to monstrous proportions. Every use of this Power increases his Size by 1 point, increasing his wound range by one as well as increasing his Strength (and therefore Damage) by two points and reducing his Quickness (and therefore Initiative and Defense) by one point for every point of increase in Size. This increase in Size lasts until the next low tide."
            }
            #t01ad942197b71c9312ddd9 ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #tb8f7a1a414c2547010000e ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Insolence. See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t9bc4f4474f652d611085f1 ^"Recalcitrance" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION ". See Chapter 4: Infernal Legions, Aerial Powers."
            }
        }
        DESCRIPTION "Rahab is known as *sar shel yam* (“prince of the primordial sea”) to the Hebrews. As an angel he was the authority of the world’s oceans, but had a nature that was as wild and rebellious as the element he represented. He refused to separate the upper and lower waters at the time of Creation, and was thus cast down by God and became a demon. When Moses was leading the Hebrew people from the tyranny of the Pharaoh of Egypt, it was Rahab whom Moses commanded to part the Red Sea. However, the power of Moses was insufficient for the mighty demon, so God struck down Rahab again and parted the sea himself. Rahab’s Infernal Might has never recovered from this miracle, which effectively demoted him from a Prince to a Lord, although he retains his former reputation."
    }
    #tabceb3888f361c99f9a41c ^"Sabaoth" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Furies"
            ^"Might" INTEGER 20
            ^"Form" STRING "Animal"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 1
                ^"Perception" INTEGER 4
                ^"Presence" INTEGER -3
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER -4
                ^"Stamina" INTEGER 0
                ^"Dexterity" INTEGER 5
                ^"Quickness" INTEGER 5
            }
            ^"Printed Size" STRING "–2 naturally, –4 in raven form"
            ^"Virtues and Flaws" STRING "Gossip"
            ^"Reputations" LIST ["None"]
            ^"Hierarchy" INTEGER 0
            ^"Combat" STRING "Claws: Init +5, Attack +13, Defense +5, Damage 0 Claws: Init +6, Attack +10, Defense +5, Damage –2 in splintered form"
            ^"Soak" INTEGER 1
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "Natural form: –1 (1–3), –3 (4–6), –5 (7–9), Incapacitated (10–12) Splintered form: –1 (1), –3 (2), –5 (3), Incapacitated (4)"
            ^"Weakness" STRING "Compulsiveness"
            ^"Vis" STRING "2 pawns of Perdo, in the red eye (or eyes); 2 pawns of Mentem, in the blue eye (or eyes)"
            ^"Appearance" STRING "In their natural form, Sabaoth appear as a single raven, the size of an eagle. Their eyes are always of different colors, the left one red, the right one blue. This feature is preserved when the demon exercises their Murder of Crows Power."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 75
        }
        PERSONALITY_TRAITS {
            "Wrathful" +4
            "Self- Controlled" -6
        }
        ABILITIES {
            "Awareness" SCORE 6 SPECIALTY "feuders"
            "Brawl" SCORE 2 SPECIALTY "claws"
            "Folk Ken" SCORE 4 SPECIALTY "gossip"
        }
        POWERS {
            #t7c5991d5df1b0b2ca99f46 ^"A Murder of Crows" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+5"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION "When in their gross physical form, Sabaoth is able to shatter this form into up to twenty ravens. Each bird carries a portion of the demon’s Might and every bird must have at least 1 Might Point. Each bird can act independently of each other and be an unlimited distance apart, and yet each is aware instantly of the actions of the others. Each raven has its own Might Pool equal to its Might; it cannot use any of its Powers that it has insufficient Might Pool to pay for. Individual ravens, if they meet, can combine together into a single bird with a Might equal to the sum of their Mights, and Sabaoth must recombine all living bodies before they can assume their natural discorporate form again. If a raven is killed, Sabaoth loses whatever Infernal Might was invested into that body."
            }
            #t19342da9291b43ef3c2a0a ^"Piercing Eye" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+5"
                    ^"Form" STRING "Imaginem"
                }
                DESCRIPTION "Sabaoth’s vision is not impeded by stone, wood, or metal."
            }
            #tc201d795fceeaf15704302 ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t1a08c317edd87135b076f5 ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Revenge. See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t7ce56e226998aaeace14d7 ^"Waxing Tide of Humors" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "+2"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Furies."
            }
            #t5154f667bc80eadd0d62ea ^"Berserker Rage" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Furies."
            }
            #te511fe40306ce7303cbd9f ^"Endurance of the Enraged" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Furies."
            }
        }
        DESCRIPTION "Sabaoth is always referred to in the plural, even when there is only one of them. They have the ability to break into a score of smaller birds, in which forms they cause all sorts of mischief. Their main purpose is to ensure that long-standing feuds are continued, and they ensure that key members of the feud are aware of the actions of the other side. Sabaoth uses their Envisioning Power to impart information to their intended victims."
    }
    #td69954430a8cedf2b4b3c9 ^"Thaphaboath" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Tempters (Mazzikim)"
            ^"Might" INTEGER 15
            ^"Form" STRING "Animal"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -2
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER 2
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER 4
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 1
            }
            ^"Size" INTEGER 2
            ^"Confidence Score" STRING "1 (3 points)"
            ^"Virtues and Flaws" STRING "Puissant Great Weapon, Tough; Weak Willed"
            ^"Reputations" LIST ["None"]
            ^"Hierarchy" INTEGER 0
            ^"Combat" STRING "Cudgel: Init +2, Attack +13, Defense +10. Damage +11 Teeth: Init +1, Attack +13, Defense +11, Damage +7 Grapple: Init +1, Attack +10, Defense +8, Damage n/a"
            ^"Soak" INTEGER 10
            ^"Fatigue Levels" STRING "OK, 0, 0, –1, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–7), –3 (8–14), –5 (15–21), Incapacitated (21–28)"
            ^"Weakness" STRING "Protected Group (members of the clergy)"
            ^"Vis" STRING "3 pawns of Animal, in heart"
            ^"Appearance" STRING "Thaphaboath appears as a huge man, with the head and hindquarters of a bear. The skin of his arms and torso, devoid of hair, is blotched and sun-burnt, while the coarse brown hair which clothes his body from the neck up and the waist down is matted with filth. He carries an immense cudgel."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 75
        }
        PERSONALITY_TRAITS {
            "Angry" +3
            "Sadistic +3; Peaceful" -5
        }
        ABILITIES {
            "Athletics" SCORE 3 SPECIALTY "sprinting"
            "Awareness" SCORE 3 SPECIALTY "prey"
            "Brawl" SCORE 5 SPECIALTY "teeth"
            "Great Weapon" SCORE 5 BONUS 2 SPECIALTY "cudgel"
            "Hunt" SCORE 4 SPECIALTY "men"
            "Survival" SCORE 5 SPECIALTY "foraging"
            "Swim" SCORE 3 SPECIALTY "against the current"
        }
        POWERS {
            #t86231abf49264de494f396 ^"Fear of the Wilderness" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Mazzikim."
            }
            #t787cd46bbc3bd851cb8093 ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #ta7718df6a7bf20d61004b6 ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Brutality. See Chapter 4: Infernal Legions, Demonic Powers."
            }
        }
        DESCRIPTION "Thaphaboath is typical of the sort of demon drafted to act as “muscle” in the plans of more powerful demons. He has few motives or ambitions other than a love of violence, and spends much of his time in his gross physical form enjoying the pleasures of the hunt and the kill. He attempts to use his Obsession Power on stronger-looking opponents before a fight; if they survive (and succumb to its power) then they are driven to oppress others with their clear superiority of strength."
    }
    #t003712e73a67ed1bb3e26c ^"Xaphan, Forge-man of Hell" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Aerial Powers"
            ^"Might" INTEGER 15
            ^"Form" STRING "Ignem"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 2
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 2
                ^"Stamina" INTEGER 0
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 3
            }
            ^"Size" INTEGER -1
            ^"Confidence Score" STRING "1 (3 points)"
            ^"Virtues and Flaws" STRING "Greater Immunity to Fire and Heat, Obsession (lighting fires)"
            ^"Reputations" LIST ["Chief Stoker of Hell’s Fires 5 (Infernal)"]
            ^"Hierarchy" INTEGER 5
            ^"Soak" INTEGER 0
            ^"Fatigue Levels" STRING "OK, 0, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–4), –3 (5–8), –5 (9–12), Inc. (13–16)"
            ^"Weakness" STRING "Abhorrent Material (horseshoes)"
            ^"Vis" STRING "3 pawns of Ignem, in bellows"
            ^"Appearance" STRING "Unusually for the Aerial Powers, Xaphan is of small stature. He appears as a sprightly man apparently made of polished brass, with swollen cheeks. A huge pair of horns, each almost a complete circle, spring from his temples. He carries an enormous set of brass bellows. When he speaks, sparks escape from his mouth."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 76
        }
        PERSONALITY_TRAITS {
            "Untameable" +5
        }
        COMBAT {
            "Claws" INIT 5 ATTACK 5 DEFENSE 6 DAMAGE 3
        }
        ABILITIES {
            "Athletics" SCORE 3 SPECIALTY "jumping"
            "Brawl" SCORE 1 SPECIALTY "Claws"
            "Craft: Blacksmithing" SCORE 8 SPECIALTY "copper"
            "Craft: Weaponsmithing" SCORE 8 SPECIALTY "swords"
            "Craft: Whitesmithing" SCORE 6 SPECIALTY "silver"
        }
        POWERS {
            #t7e3d4172b871d876aa8174 ^"Elemental Control of Fire" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Aerial Powers. He prefers to employ effects similar to *Show of Flames and Light* and *Blade of the Virulent Flame*."
            }
            #t9b3dddab964fb505fe1331 ^"Breath of the Desert" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–3"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "Xaphan can blow hot, dry smoke over an area a pace wide and 500 paces long. Everything on this line becomes tinder dry, and all flames struck by his breath triple in size. This makes fires more severe, and sets secondary fires. The smoke obscures sight and smells terrible. *Breath of the Bellows, *3 points, Init +3, Ignem. Xaphan’s breath can make a single metal item glow white-hot. These items do +9 damage per round to any exposed flesh they touch, and usually melt. *Burning Curse, *5 points, Init 0, Ignem. By placing his bellows in the mouth of a servant and pumping them once, Xaphan can grant the diabolist the ability to ignite a building with sulfurous flames. The diabolist sets fire to whichever building he is facing when he opens his mouth. The diabolist has the Tainted with Evil Flaw while he carries the curse on his tongue."
            }
            #td1e17c41fd82a13ad0b9d5 ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t8cbac5f2e118fcd01d8281 ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Arson. See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t494eb5abe4dcbe574a6495 ^"Recalcitrance" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "constant"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION ". See Chapter 4: Infernal Legions, Aerial Powers."
            }
        }
        DESCRIPTION "Xaphan claims he suggested to Satan that, given the rebellion had failed, he should burn Heaven to cover his escape. Although Xaphan was unable to incinerate Heaven, he is now chief stoker of the fires of Hell. Xaphan cannot burn churches himself, but it is the sin he most prizes in humans.

Xaphan avoids combat where possible, evading his enemies, and incinerate their homes while they sleep. Xaphan hates and fears smiths, who have stolen his invention, the bellows, and turned it to human use."
    }
    # The chapter's families, structured; each DESCRIPTION the source's text, verbatim.
    #tbb365f9256386e137359ed ^"Aethnici" DEF {
        EXTENDS #t8ab0f71b78642f7ff10696 ^"Demon Family"
        PROPERTIES {
            ^"Order" STRING "Aerial Powers"
            ^"Might" INTEGER 15
            ^"Form" STRING "Ignem"
            ^"Virtues and Flaws" STRING "Greater Immunity to Flame and Heat"
            ^"Weakness" STRING "Vulnerability (water)"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 67
        }
        POWERS {
            #t556d084164bd5f45e2926e ^"Form of the Serpent" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION "The aethnicus can adopt the form of any snake, lizard, or salamander. This Power lasts until the demon decides to turn back."
            }
            #t5edc32adb8e17f25b62c80 ^"Elemental Control of Fire" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "As the Power common to all Aerial Powers. The aethnici prefer effects such as Hornet Fire and Tremulous Vault of the Torch’s Flame."
            }
        }
        DESCRIPTION "In ancient times, the aethnici dwelt within the flames of the sacrificial fires; now any fire in profane regions, especially Infernal auras, may contain them. They naturally appear as vaguely human-shaped figures made purely out of flames, but often take the form of serpents or lizards. They cause mischief such as causing sparks to fly from a hearth and ignite nearby materials, although some have greater ambitions and promote the kinds of fires that can engulf entire towns."
    }
    #tfb1f025cf4a42f44ea4fc4 ^"Demons of the Fifth Trump" DEF {
        EXTENDS #t8ab0f71b78642f7ff10696 ^"Demon Family"
        PROPERTIES {
            ^"Order" STRING "Furies"
            ^"Might" INTEGER 20
            ^"Form" STRING "Animal"
            ^"Weakness" STRING "Abhorrent Material (the sound of a brass horn)"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 68
        }
        POWERS {
            #t8ae0ffd976e6c2fb9dec5f ^"Inescapable" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "If provided with the beginning of a trail of footprints, or an Arcane Connection to some target, these demons can unfailingly track down any prey. The tracker cannot be fooled by typical ruses, such as crossing water or doubling back, but should the pursued enter a Church, come into the presence of a relic with at least 2 Faith Points, or enter a magical ward which exceeds its Might (such as the *Aegis of the Hearth* or *Circular Ward against Demons*), then the demon loses track of its prey until he emerges."
            }
            #t8803eb595fc5c240f98662 ^"Scorpion’s Tail" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Their tails can strike at any opponent once per combat round, in addition to any other attack. The tail has the weapon statistics of a long spear, and if it hits it injects venom, even if all weapon damage is soaked. The venom has an Ease Factor of 9 to resist, and inflicts a Medium Wound. This venom also dissolves metal, stone, or weaker material as if the item had been struck by *Obliteration of the Metallic Barrier*."
            }
        }
        DESCRIPTION "These horrible demons are the elite force of the Furies, under the direct command of its chief, Abaddon. These demons will burst forth from Hell when the Fifth Trump is sounded at the End of Days, and consume all who remain on the earth (as detailed in the Book of Revelation). Until that day, these demons make occasional forays onto earth at the behest of their lord or at the request of an Infernal wizard who wishes to wreak destruction on his enemies.
These demons appear like horses, but with the faces of men. They are crowned with gold, have long hair, and the teeth of a lion. They sport a pair of bat-wings, and the tail of a scorpion. They are often mistaken for manticores by those who have studied bestiaries, however, manticores are not demons."
    }
    #tce1aee5724f8a72bfe0acf ^"Dibbukim" DEF {
        EXTENDS #t8ab0f71b78642f7ff10696 ^"Demon Family"
        PROPERTIES {
            ^"Order" STRING "Furies"
            ^"Might" INTEGER 15
            ^"Form" STRING "Mentem"
            ^"Weakness" STRING "Compulsiveness"
            ^"Example" STRING "Gavi"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 69
        }
        POWERS {
            #t2e4f7ff57c4b91386b7bca ^"Possession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+2"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
        }
        DESCRIPTION "A dibbuk is a disembodied human spirit from Jewish lore, that, because of former sins, wanders restlessly until it finds a haven in the body of a living person made vulnerable through sin. It can be driven out through exorcism, which causes it to leave the body by the little toe. Like other Infernal ghosts, a dibbuk has no ability to coagulate a material body, but instead must lurk about invisibly until it sees one of the living commit a sin. Dibbukim can be distinguished from the living in that they speak with the voice that they had in life, and always act in an erratic manner. To those who can see a dibbuk’s discorporate form, dibbukim appear as they did in life, except that their features are infused with those of predatory animals such as wolves, lions, bears, and vultures.
An example of a Dibbuk is **Gavi**."
    }
    #tdd67f01730268e2d175e73 ^"Fictiles" DEF {
        EXTENDS #t8ab0f71b78642f7ff10696 ^"Demon Family"
        PROPERTIES {
            ^"Order" STRING "Aerial Powers"
            ^"Might" INTEGER 10
            ^"Form" STRING "Terram"
            ^"Virtues and Flaws" STRING "Shapeshifter"
            ^"Weakness" STRING "Running water"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 69
        }
        POWERS {
            #t3725fdb142612db06e3b7f ^"Elemental Control of Earth" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "As the Power common to all Aerial Powers. They prefer effects such as *Earth That Breaks No More* and *Fist of Shattering*."
            }
            #t6dafe9fcda54eb34373bfc ^"Blight the Household" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Herbam"
                }
                DESCRIPTION "Fictiles can cause misfortune to a family by spoiling food, rotting foundations, and even blighting crops. Each use of this Power can destroy three portions of food or an Individual amount of plant material. Alternatively, if used daily throughout the spring growing season, it can halve the productivity of a field of crops or fodder."
            }
        }
        DESCRIPTION "In their natural form, the fictiles (singular fictilis) seem to be composed of wet clay. They are larger than a man in size, and have crudely formed limbs that are often mismatched as those of different animals. However, the fictiles are shapechangers who usually take the form of animals — particularly of domestic animals and pets — and dwell alongside man. They often remain with a family for a long period of time, subtly corrupting them in many minor ways, usually through the imposition of minor calamities."
    }
    #taa2da527cc2d1a5551b253 ^"Lilin" DEF {
        EXTENDS #t8ab0f71b78642f7ff10696 ^"Demon Family"
        PROPERTIES {
            ^"Order" STRING "Tempters"
            ^"Might" INTEGER 15
            ^"Form" STRING "Vim"
            ^"Weakness" STRING "Vulnerability (light)"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 71
        }
        POWERS {
            #t347fb6f0c2717881a7b456 ^"Steal Life" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+2"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "The touch of a lilim’s lips causes a withering blight. If a Stamina roll against an Ease Factor of 3 succeeds, the victim loses a Fatigue level, otherwise he takes a Light Wound."
            }
            #taae31386d5884655189025 ^"Mass Hallucination" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Imaginem"
                }
                DESCRIPTION "Lilin using their Envisioning Power to influence someone’s dreams can activate this Power so that other sleepers join the same dream. They can combine many dreams to make up to ten people experience the same nightmare, or they may involve other beings (usually other demons) as conscious agents in the victims’ dreams."
            }
        }
        DESCRIPTION "The lilin (singular lil) are the night spirits who give nightmares and smother children in their sleep. They are always female, and lilin are among the demons who can produce more demons through intercourse with a human man. Their male children are shedim, and their female children are lilin. The fully demonic lilin have the upper bodies of beautiful women and the lower bodies of serpents. Those lilin who have a human father have wholly human bodies, although their legs are hairy like those of a goat. When lilin use their Envisioning Power to inflict nightmares, they can, if the lilin wishes, be so horrific that the victim fails to recover any Fatigue levels for that night’s sleep."
    }
    #t6c2dccb12fd2cae3f36ca0 ^"Lucifuges" DEF {
        EXTENDS #t8ab0f71b78642f7ff10696 ^"Demon Family"
        PROPERTIES {
            ^"Order" STRING "Aerial Powers"
            ^"Might" INTEGER 20
            ^"Form" STRING "Ignem"
            ^"Weakness" STRING "Vulnerability (Light)"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 71
        }
        POWERS {
            #t545505d9ebfcc45cc334ac ^"Elemental Control of Fire" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "As the Power common to all Aerial Powers. However, Lucifuges can only affect light, not fire or heat, with this Power, and even then they cannot create light at all. They prefer effects such as *Gloom of Evening* and *Vision of Heat’s Light*."
            }
            #t08f8b8605b9f1c5ccc8e73 ^"Steal Blood" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+2"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "The touch of a lucifuge causes blood to be drawn from the victim’s body through the skin. If a Stamina roll against an Ease Factor of 3 succeeds, the target loses a Fatigue level, otherwise she takes a Light Wound. The wound appears as a bruise covered in blood."
            }
            #t4278fbaa8f9848552670c6 ^"Steal Thoughts" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "This demon may choose to take a single fact, memory, or desire from a person’s mind. This Power will only ever work once for the lucifuge on a given target. The stolen thought is gone forever, although a desire may naturally return, and facts may be re-learned."
            }
        }
        DESCRIPTION "The lucifuges are a breed of demon that naturally dwell deep in the earth and prefer to have no dealings with mankind. However, some sorcerers draw them forth for their ability to reveal secret thoughts. Lucifuges require absolute darkness (they are also known as “fly-the-lights”), and it is unknown what their true form is, if indeed they have one. Most assume they take the form of shadows or patches of darkness."
    }
    #t2dd1190d7ac2e8ec41fc54 ^"Maggots" DEF {
        EXTENDS #t8ab0f71b78642f7ff10696 ^"Demon Family"
        PROPERTIES {
            ^"Order" STRING "Tempters"
            ^"Might" INTEGER 5
            ^"Form" STRING "Animal"
            ^"Weakness" STRING "Abhorrent Material (fennel)"
            ^"Example" STRING "Mahonin"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 72
        }
        POWERS {
            #t7461da8171671dcabd258a ^"Possession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+2"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers. Maggots rarely have sufficient Might Pool to control their energumens effectively, but possession by a maggot is akin to acquiring the Delusion Flaw, as they may use their Envisioning Power to induce waking dreams without expending Might. Each maggot possessing a person inflicts a different Delusion."
            }
        }
        DESCRIPTION "The larvae of blowflies were named after these demons, rather than the other way around; the term “maggoty” is used to indicate someone who is deluded by the fantasies of one of these demons. Maggots are tiny demons, no bigger than a grain of wheat, and appear like grotesque apes with the wings of flies. They eat into the brains of their victims and bring about fantasy, madness, and dementia. Often, several of these demons simultaneously possess the same victim, each inducing a different Delusion (see Powers), and each must be exorcised separately. Maggots are also called by the Greek name *astasian* (meaning “unfixed”), as they swarm in the air like mosquitoes and are under the command of Beelzebub. They are particularly useful to diabolists in matters involving secret communication.
An example of a maggot is **Mahonin**."
    }
    #teb176223ec3c9baa86f0a5 ^"Mazzikim" DEF {
        EXTENDS #t8ab0f71b78642f7ff10696 ^"Demon Family"
        PROPERTIES {
            ^"Order" STRING "Tempters"
            ^"Might" INTEGER 15
            ^"Form" STRING "Animal"
            ^"Weakness" STRING "Protected Group (members of the clergy)"
            ^"Example" STRING "Thaphaboath"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 73
        }
        POWERS {
            #t3162e728e7cd8f06aa8502 ^"Fear of the Wilderness" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "The victim of this Power suffers an overwhelming dread, and if he fails a Brave stress die roll against an Ease Factor of 7, he runs in fear until exhausted, or (if unable to run) collapses in a quivering heap until the sun rises. If the mazzik uses this Power when it may be seen, then anyone who sees it (up to ten people) is affected; otherwise it can affect only one target."
            }
        }
        DESCRIPTION "The Mazzikim (singular mazzik) are the harmers of man, demons of the wilderness who lie in wait to waylay the innocent. Some of the spirits that the Islamic people call “jinn” — specifically the group known as shaitans — are undoubtedly of this family of demons, as they share many qualities in common with the mazzikim. However, most jinn are more similar to faeries than to demons, and one should take care before considering them all to be evil. Many travelers or merchants take a member of the clergy with them just to be on the safe side. Mazzikim are far from limited to the lands of the Arabs, however, and may be found lurking anywhere forsaken by man. Their shape is that of a wild animal standing upon two legs, with a naked human chest and arms.
An example of a mazzik is **Thaphaboath**."
    }
    #t05f79690eafb969a99ae88 ^"Merry Devils" DEF {
        EXTENDS #t8ab0f71b78642f7ff10696 ^"Demon Family"
        PROPERTIES {
            ^"Order" STRING "Vessels of Iniquity"
            ^"Might" INTEGER 20
            ^"Form" STRING "Mentem"
            ^"Weakness" STRING "Protected Group (the solemn)"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 73
        }
        POWERS {
            #tf59f5b954969bc4136f146 ^"Pleasant Clouds in the Mind" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "The Merry Devil uses this Power to create an illusion within the mind of his victim. Each use allows the demon to cloud one real object or person in illusion. For example, the demon may use this Power twice on two victims so that they do not recognize each other. The victims may be goaded into inappropriate activities, like violence or coitus. This Power is also used to make men think that urine is beer, or that a pig is a willing, young woman."
            }
        }
        DESCRIPTION "Merry devils are a family of demons that encourage humans, particularly young men, to seek pleasure without regard for the consequences. Some prefer to afflict a single victim at a time, using a mixture of intoxicants and illusions to encourage the young man to perform increasingly depraved acts. Others goad bands of revelers into bacchanalian mobs.
When they unveil their true form, those who witness it are driven into acts of debauchery and excess.
An example is Merry Devil is **Hulikang**"
    }
    #t3fa64dbeb5886253868d50 ^"Reveners" DEF {
        EXTENDS #t8ab0f71b78642f7ff10696 ^"Demon Family"
        PROPERTIES {
            ^"Order" STRING "Vessels of Iniquity"
            ^"Might" INTEGER 20
            ^"Form" STRING "Corpus"
            ^"Weakness" STRING "Abhorrent Material (garlic)"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 75
        }
        POWERS {
            #t82fcf4ec2c938a67dd6cbf ^"The Dead That Walk Again" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "–4"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "A Revener may animate any corpse or intact skeleton that has not been given a proper Divine burial (or buried with garlic, as some are wont to do). There is no limit to the freshness or age of a cadaver beyond this requirement. These corpses have physical Characteristics and Weapon Abilities equal to those of the demon, and a single Revener can animate and control as many corpses as he has the Might to do so. However, as this is a Supernatural Power, the physical attacks of the cadavers are blocked by Magic Resistance."
            }
        }
        DESCRIPTION "Literally “those who come again,” these demons have the capacity to reanimate a corpse, and use this Power to spread fear. Reveners often work together, in groups of three or more. Reveners lack the Form of Man Power, and very rarely use their Form of Wickedness Power, preferring instead to spread horror through having the dead walk again. However, if they do use Form of Wickedness — as a last defense — it causes an overpowering urge to desecrate the dead. All Reveners share the same Obsession Power of Fear, which they can spread using their Order’s Contagious Obsession Power."
    }
    # The chapter's non-record boxes as GUIDANCE with verbatim TEXT (story seeds, rules
    # notes, background boxes; list and sub-heading units included).
    GUIDANCE {
        ENTRY ^"Story Seed: The Demon’s Daughter" #tfd23c6d5dca934b1e71068 {
            TEXT "Story Seed: The Demon’s Daughter

Architectus raises children, partially as a hobby, but also as an extension of his grand schemes. He finds an orphaned girl with a strong Supernatural Talent and raises her as his own daughter in an Infernal regio. The girl always meets a heroic boy from the mundane world, always steals the whip that she thinks commands Architectus’s horde of demons, and always arranges for her swain to escape with her. She uses the horde, controlled by the whip, to build a great castle and fill its treasury with gold stolen as a dowry, and then tricks her wrathful father into acquiescence.

Architectus’s “daughters” always seem to attract heroes from small domains assailed by a slightly more powerful neighbor. The addition of a new fortress, and a pile of gold, always extends the war, by giving the advantage to the girl’s adopted nation, but only to a slight degree. The castles and palaces built by Architectus’s daughters are focuses of tragedy, and he maintains an interest in his grandchildren, since his daughters often pass on a few of their tricks to their descendants. This makes them vulnerable to further corruption."
        }
    }
    GUIDANCE {
        ENTRY ^"Story Seed: Demons of the Fifth Trump" #tf12d308961ccbc777a4db2 {
            TEXT "Story Seed: Demons of the Fifth Trump

A group of Luciferans (see Chapter 13: Infernal Traditions) have summoned some of these demons to confirm their own interpretations of the Last Days. However, they had not counted on the demons being so powerful, were unable to bind them, and were eaten. The demons still prowl the region, spreading fear and confusion. A priest has recognized their description from the Book of Revelations, and has convinced his flock that the Fifth Trump has already been sounded."
        }
    }
    GUIDANCE {
        ENTRY ^"Story Seed: Hulikang" #t0e2eefcd3bb91e143a1b41 {
            TEXT "Story Seed: Hulikang

A vis source takes the form of a yearly sporting contest between the covenant and a team of faeries. The winner of the contest receives the prize of vis. However, Hulikang has discovered the vis source, and if he is successful in influencing the winning team to violence, the prize becomes vis infesta (see Chapter 1: The Infernal Realm, Infernal Vis) instead. This situation can last for years before the characters realize that a demon is involved."
        }
    }
    # The chapter's beasts, structured; each DESCRIPTION the source's text, verbatim.
    # The chapter's non-record boxes as GUIDANCE with verbatim TEXT (story seeds, rules
    # notes, background boxes; list and sub-heading units included).
    GUIDANCE {
        ENTRY ^"Virtues & Flaws for Corrupted Beasts" #t997d5cae689e4b264d90ea {
            TEXT "Virtues & Flaws for Corrupted Beasts

**Compulsory Flaw: **Corrupted Beast **Virtues: **Greater Immunity, Greater

Infernal Power, Ferocity, Lesser Immunity, Lesser Infernal Power **Optional Flaws: ** Horrifying Appearance, Demonic Weakness, Lesser Malediction"
        }
    }
    GUIDANCE {
        ENTRY ^"Example Horrifying Appearances" #t37f47c6f4a2756c1fc0932 {
            TEXT "Example Horrifying Appearances

• The creature has a pair of huge but useless wings, which hang limply at the sides of its body. • The creature’s skin is transparent, so that its organs can be seen pulsating within its flesh. • The creature has a snake’s body instead of hindquarters, forcing it to move with a combined crawl and slither. • The creature lacks an internal skeleton. It can force itself into its original form for short periods, but soon collapses into a puddle of hair, teeth, and claws, oozing slowly along the ground. • There is a head at each end of the creature’s body, or in the center of its back."
        }
    }
    # The chapter's virtues flaws, structured; each DESCRIPTION the source's text, verbatim.
    #t27bd0ed6aa6108fd951ecc ^"Corrupted Beast" DEF {
        EXTENDS #tgA0K9vGShU1WKTibhCc4jXz ^"Flaw"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Supernatural"
            ^"Restriction" STRING "animals only"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 77
        }
        DESCRIPTION "The creature has been corrupted by Infernal power, and acquires an Infernal Might of 5. The negative side of its character is brought to the fore and it receives one sinful Personality Trait at +6, such as Violent, Gluttonous, or Lustful. As part of the corruption, the beast takes on some sort of disgusting or repellent appearance, decreasing its Presence to –6. However, should the animal make any attempt to scare or intimidate an opponent, this should be treated as a Presence of +6. Despite the creature’s deformity, it is possible (although difficult) to pass the animal off as a natural member of its species. Finally, the creature is afflicted with the Tainted with Evil Flaw, which affects the reactions of both humans and other animals towards it. Corrupted beasts do not react negatively to The Gift."
    }
    #te21b3eb1aac230d8592377 ^"Demonic Weakness" DEF {
        EXTENDS #tgA0K9vGShU1WKTibhCc4jXz ^"Flaw"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Supernatural"
            ^"Restriction" STRING "corrupted beasts only"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 77
        }
        DESCRIPTION "The beast has a weakness similar to those of demons. Choose an appropriate limitation from the list given in Chapter 4: The Infernal Legions, Demonic Weaknesses. Corrupted beasts cannot, however, have the Ordering or Compulsion weaknesses."
    }
    #tbc3cd857513ef9c34a38a3 ^"Ferocity (Realms of Power: The Infernal)" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "Ferocity"
            ^"Size" STRING "Minor"
            ^"Category" STRING "General"
            ^"Restriction" STRING "animals only"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 78
        }
        DESCRIPTION "Like companion and magus characters, the animal has a Confidence score of 1. However, it can only use Confidence in situations where its corrupt nature is triggered, such as when hunting children or attacking a priest. Describe a situation which activates the Confidence of the creature; in such circumstances the creature has 3 Confidence Points. Some creatures have this Virtue without it being derived from an Infernal source."
    }
    #tb5e4068536bc785f2101e2 ^"Horrifying Appearance" DEF {
        EXTENDS #tgA0K9vGShU1WKTibhCc4jXz ^"Flaw"
        PROPERTIES {
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural"
            ^"Restriction" STRING "corrupted beasts only"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 78
        }
        DESCRIPTION "The creature is hideously deformed in some waythat is a major hindrance in its life. Such a deformity may have some minor side benefit (a creature without a skeleton can seep through cracks, for example), but prevents the animal from ever being passed off as a member of its original species."
    }
    #t864aaf13eccafc895c2fa9 ^"Greater Infernal Power" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural"
            ^"Restriction" STRING "corrupted beasts only"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 78
        }
        DESCRIPTION "Choosing this Virtue adds 5 to the Infernal Might of the corrupted beast and gives the creature an Infernal Power, which it may activate by spending points from its Might Pool. Design the effect as an Infernal Power (see Chapter 10: Maleficia), with a level of effect that cannot exceed the corrupted beast’s (Infernal

Might + 10). Such a Power typically costs its magnitude in Might Points to activate, and has an Initiative bonus equal to Quickness + magnitude. A given Power is appropriate for this Virtue only if it requires a Penetration Total to work. (Otherwise, it is a Lesser Infernal Power.) To calculate a Penetration Total, see ArM5, page 191. Corrupted beasts may have this Virtue more than once, each for a different Power, and Infernal Might increases for each Power acquired."
    }
    #ta1c38fc46f3c6bbc3e3a3d ^"Lesser Infernal Power" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Supernatural"
            ^"Restriction" STRING "corrupted beasts only"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 78
        }
        DESCRIPTION "Choosing this Virtue adds 2 to the Infernal Might of the corrupted beast and gives the creature an Infernal Power, which either affects it constantly or may be activated by spending points from its Might Pool. Design the effect as an Infernal Power (see Chapter 10: Maleficia, making sure to adjust the level for constant effect or maintaining concentration if appropriate (and ignoring other effect modifications). The level of effect cannot exceed the corrupted beast’s Infernal Might. A Power granted by this Virtue typically costs 0–2 Might Points to activate and has an Initiative

bonus equal to magnitude. A given Power is only appropriate for this Virtue if it does not require a Penetration Total; if the Power would have to exceed the Magic Resistance of a target to operate (even if a given target might lack such), then it must be a Greater Infernal Power instead. Corrupted beasts may have this Virtue more than once, each for a different Power, and Infernal Might increases for each Power acquired."
    }
    # The chapter's abilities, structured; each DESCRIPTION the source's text, verbatim.
    #td5a70f1cdee08f0c0ba9cb ^"Ceremony (Ability)" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Printed Name" STRING "Ceremony*"
            ^"Ability Type" STRING "Supernatural" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Specialties" LIST OF STRING ["with a certain Power or Ability", "in particular circumstances", "with a specific group or leader"]
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "This Ability is used in conjunction with another Infernal Supernatural Ability or an Infernal Method and Power to produce a greater effect. The character must gather a group together and determine what effect they are going to enact. Since Ceremony increases the potency of Infernal power, at least one of the participants must possess the required Supernatural Ability (this character is called the **focus character**), and if it is a Power, whatever Method the character would normally use to activate it must be performed by each member of the group. Because of this, all of the participants are considered to be the caster when evaluating the effect.

The group may appoint a character to be their leader. The leader’s Ceremony score determines how many others may contribute to the effect. Additional characters may still participate, but their scores are not counted in the total and they are not treated as the caster. Characters with a Hierarchy Score greater than that of all the others in the group must always lead; they cannot participate unless led by a character with still higher rank.

Alternatively, a group may gather without a leader. In this case, the group generates a **group modifier** by determining the sum of all their Ceremony scores and subtracting the total number of participants, which for Infernal ceremonies must always number 13 (12 participants and the focus character). This group modifier is applied to the focus character’s total, and might be positive or negative depending upon how skilled the members of this group are at working together.

**Group Modifier: Total Ceremony scores – 13**

Whether or not there is a leader, all participants then add their scores in the appropriate (Characteristic + Ability) or (Characteristic + Method) to the focus character’s total. If a participating character does not have the relevant Ability or Method, only his score in the Characteristic is added. After this bonus has been applied, the focus character resolves the effect as normal.

Note that if every character in a coven has a score of at least 1 in Ceremony, it is always better for them to gather without a leader, but that since Ceremony is a Supernatural Ability, a group of thirteen who all possess it is very rare. More commonly, two or three infernalists with the Ability trick others into joining them in the unholy ritual."
    }
    #tad3682afd95ad49df361c9 ^"Chthonic Magic (Ability)" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Printed Name" STRING "Chthonic Magic*"
            ^"Ability Type" STRING "Supernatural" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Specialties" LIST OF STRING ["a particular sort of lab activity", "using infernal vis"]
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "This Supernatural Ability may only be learned by magi.

The character has the ability to draw upon the power of the Infernal with his magic, giving him many benefits, described in Chapter 12: Black Magic. You can substitute this Ability for Magic Theory when he is performing dark or sinister magic in the lab, and you can also add his score in this Ability to his Magic Theory or Arts when determining how much vis he may use, so long as all of that vis comes from an Infernal source."
    }
    #t83935e2cb6b9b99c9b80d9 ^"Consumption (Ability)" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Printed Name" STRING "Consumption*"
            ^"Ability Type" STRING "Supernatural" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Specialties" LIST OF STRING ["a specific target", "a particular effect", "in certain circumstances"]
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "Through dark rites the character can manipulate the energy of living things, channeling it through himself or another (see Chapter 10: The Maleficia)."
    }
    #ta5b60393fe696ed0a4cbeb ^"Corruption (Ability)" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Printed Name" STRING "Corruption*"
            ^"Ability Type" STRING "Supernatural" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "The character is skilled at leading others to evil, without their being aware of it. This allows her to communicate in ways that subvert her audience, teaching corrupted knowledge and influencing those who heed her message. These practices rely on ceremonial and personal influence (see Chapter 2: Sin and Temptation), and have three effects.

Firstly, she can exert ceremonial influence on anyone who listens to her, including strangers and player characters. By spending a Confidence Point, she can invoke a particular Personality Trait

in anyone who listens to her speak or watches her perform some sort of original work.

Secondly, she can exert personal influence through the written word. Her influence is so insidious that those who spend a season studying what she writes may acquire an appropriate Personality Trait, just as if she had spent a season corrupting them in person.

Thirdly, she can teach corrupted versions of Abilities or Arts, which gives her students the Corrupted Abilities or Corrupted Arts Flaws if they do not resist her instruction. You can apply this to any books she writes, or to Arts and Abilities in which she teaches or trains others in person.

When she uses Corruption, roll a die (stress or simple, depending on the situation) and add her Communication and Corruption scores. You should note this total somewhere in the description of a corrupted text. If another character suspects that he is being corrupted or tries to resist the effect, he may make a Perception + Infernal Lore roll against this total to avoid gaining the Flaw or Personality Trait while still gaining the experience. If he fails, the season is wasted. If he botches, he might gain the Flaw anyway.

**Specialties: **ceremonial influence, personal influence, teaching"
    }
    #t6aa4ab0e62c22ac4b554f7 ^"Debauchery (Ability)" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Printed Name" STRING "Debauchery*"
            ^"Ability Type" STRING "Supernatural" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Specialties" LIST OF STRING ["affecting a certain person", "a particular form of debauchery", "over long periods of time"]
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "The character focuses her will through a physical act, usually ceremonial in some way. This activity is strenuous enough to cause her to lose a long-term Fatigue level or suffer a Light Wound, and calls upon her Stamina for the maleficium roll (see Chapter 10: The Maleficia)."
    }
    #t23736156e45e86a2cc9696 ^"Diablerie (Ability)" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Printed Name" STRING "Diablerie*"
            ^"Ability Type" STRING "Supernatural" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Specialties" LIST OF STRING ["type of beings affected", "a specific effect", "in particular circumstances"]
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 92
        }
        DESCRIPTION "The character can exert control over spirits, demons, and the Infernal realm (see Chapter 10: The Maleficia)."
    }
    #t7ba9ca938db11c7d875ef5 ^"Effusion (Ability)" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Printed Name" STRING "Effusion*"
            ^"Ability Type" STRING "Supernatural" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Specialties" LIST OF STRING ["causing a specific effect", "a particular kind of material or phenomenon", "in specific circumstances"]
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 92
        }
        DESCRIPTION "The character wields power over the physical world through strife and malice, changing the properties of inorganic materials and controlling powerful forces of nature (see Chapter 10: The Maleficia)."
    }
    #t1ca694152776e87a3ec7c1 ^"Hex (Ability)" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Printed Name" STRING "Hex*"
            ^"Ability Type" STRING "Supernatural" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 92
        }
        DESCRIPTION "The character can bring injury or ruin upon her enemies. There are three ways for her to activate this Power: by making eye contact with her victim and proclaiming her purpose loud enough for him to hear, by tracing temporary occult signs and symbols on her target that indicate the dark fate she intends, or by acquiring an Arcane Connection to her target and fashioning a recognizable representation that can channel the effect through sympathetic magic.

To hex a target, the character must make clear her will for it: she must declare her wishes to the victim aloud, or indicate the specifics of the hex in writing on or very near the target, or do something to the representation that is similar to what she intends to happen to the target. There is always a physical component to the hex (common practices include tying knots in a line, spitting, or giving the target the “evil eye”).

You must also state a time frame for the hex, anywhere from an effect that occurs immediately to a hex that will affect the third generation of the victim’s descendants. Generally speaking, the sooner the effect manifests, the less potent it will be, and the longer the hex delays, the more powerful it will eventually become. For this reason you must always apply the delay modifier to the Hex total."
    }
    #tea4200cda739c67bd1c29a ^"Incantation (Ability)" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Printed Name" STRING "Incantation*"
            ^"Ability Type" STRING "Supernatural" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Specialties" LIST OF STRING ["when invoking names", "in writing", "affecting a particular kind of target"]
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 92
        }
        DESCRIPTION "Through blasphemous words, phrases, and prayers, the character invokes the power of the Infernal. He must chant his ritual in a loud voice, or detail the terms of the maleficium in writing (see Chapter 10: The Maleficia). This adds his Communication to your roll, and requires that he spend a point of Confidence to call the effect into being."
    }
    #td5ffd9d525fb4d57ee920a ^"Malediction (Ability)" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Printed Name" STRING "Malediction*"
            ^"Ability Type" STRING "Supernatural" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Specialties" LIST OF STRING ["a particular effect", "punishing a specific kind of sinner", "a particular kind of target"]
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "The character knows how to punish his enemies with diabolical curses that hinder and even destroy them using the power of the Infernal."
    }
    #t2338af15ccb2cc374e30f3 ^"Phantasm (Ability)" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Printed Name" STRING "Phantasm*"
            ^"Ability Type" STRING "Supernatural" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Specialties" LIST OF STRING ["causing a specific effect", "a particular image", "in specific circumstances"]
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "The character can create and control demonic illusions that appear to be quite substantial."
    }
    #t0c9ceb8b7cfb3d3f8850d7 ^"Psychomachia (Ability)" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Printed Name" STRING "Psychomachia*"
            ^"Ability Type" STRING "Supernatural" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Specialties" LIST OF STRING ["affecting a particular type of person", "in particular circumstances", "a specific emotion"]
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "The character can possess and distort the mind, causing people to see things that are not there, act on their base desires, and obey his commands."
    }
    #tc58a2ed5187d8378679450 ^"Sense Passions (Ability)" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Printed Name" STRING "Sense Passions*"
            ^"Ability Type" STRING "Supernatural" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Specialties" LIST OF STRING ["auras", "emotions", "Personality Traits", "in a general area"]
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "The character can sense the personality and desires of an intelligent being by recognizing and identifying the different shades of tarnish on its soul. A Perception + Sense Passions roll against an Ease Factor of 9 lets her sense the most powerful emotion currently being experienced by the person, and a roll against an Ease Factor of 15 allows her to identify the character’s most dominant Personality Trait. The effect must penetrate the target’s Magic Resistance if it has any kind of supernatural protection, and since this is a Supernatural Ability, it is affected by auras.

**Sense Passions: stress die + Perception **

**+ Sense Passions + aura**

Through careful examination, the character can also recognize passions in people within the general area, allowing her to hone in on the most powerful source of emotion within sight, usually the character with the highest (or lowest) Personality Trait. This requires a 12 or better on the Sense Passions roll.

The character can also tell when an aura has a tarnish (or temper, see *Realms *

*of Power: The Divine*, page 38) and its type or types by overcoming an Ease Factor of 6.

By sensing passions, the character can often recognize incorporeal spirits. You may treat Sense Passions as Second Sight when attempting to recognize the presence of invisible or bodiless beings. However, this does not allow her to see through illusions, even illusions of strong emotions, and she cannot actually see the spirits, merely sense their proximity.

In addition, this Ability allows the character to Sense Holiness and Unholiness in a limited fashion, much like the Sense Holiness and Unholiness Virtue (ArM5, page 67). She can tell that something is either holy or unholy, but she cannot distinguish between the two. She feels the emotional presence associated with the Divine or the Infernal, but cannot pinpoint its supernatural origin. Thus, she might mistake a demon with a fair shape for an angel, or a fearsome-looking angel for a demon. By identifying the target’s primary emotions or desires, however, you can usually get a good idea of which realm the target is associated with, assuming the character can penetrate its Magic Resistance.

Sense Passions is either a False Power (see False Powers, above), or is associated with the Infernal. The presence of Infernal taint allows the Sense Holiness and Unholiness aspect to work. If the troupe allows Divine Powers to be false, this may be the false version of Sense Holiness and Unholiness."
    }
    #t1e4c880b9a128f2c6a408f ^"True Name of (Being) (Ability)" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Printed Name" STRING "True Name of (Being)*"
            ^"Ability Type" STRING "Supernatural" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "This is not an actual Ability, but rather a placeholder for knowledge gained from studying Infernal Lore. By learning a being’s True Name, the character can affect it as if she had a permanent Arcane Connection to it. She learns this by studying the appropriate (Realm) Lore, which teaches her the True Name once she has gained 5 experience points, and also gives her a free experience point in that Arcane Ability. See Chapter 4: Infernal Legions, True Names for more information. (Special)"
    }
    # The chapter's blessings, structured; each DESCRIPTION the source's text, verbatim.
