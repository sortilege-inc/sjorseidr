    }
    #txbrf3XG4HvpZPcJLvMNrTOh ^"Summon Animals" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Major" FIXED
            ^"Category" STRING "Supernatural" FIXED
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "You are able to summon animals to your side. This Virtue grants a score of 1 in the Supernatural Ability Summon Animals."
    }
    #tEwR22I7HQvDMgqrQPcOWc5Q ^"Survival" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Ability Type" STRING "General" FIXED
            ^"Specialties" LIST OF STRING ["specific locales"]
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "Finding food, water, shelter, a direct route, and relative safety in the wilderness (a very dangerous place in Mythic Europe). This Ability covers such mundane tasks as building a fire and cooking food without implements."
    }
    #tXxNZkzvk8nTgwGsJJA6scxi ^"Swim" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Ability Type" STRING "General" FIXED
            ^"Specialties" LIST OF STRING ["long distances", "diving", "underwater maneuvering"]
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "The ability to propel yourself through water quickly and efficiently."
    }
    #t23foUX8grTBCnmKCj8C7472 ^"Teaching" DEF {
        APPLIES TO [^"Character"]
        PROPERTIES {
            ^"Source" STRING "Core Rules"
        }
        FORMULAS {
            "TEACHING SOURCE QUALITY" "Teacher's Communication + Teaching + 3 + bonus"
            "TEACHING GAIN LIMIT" "The teacher's score in the Art or Ability"
        }
        DESCRIPTION "Characters can be taught by other characters.

A character must have a score of at least two in an Ability, or at least five in an Art, before she can teach anyone. The teacher and the students must share a common language. The teacher must have a higher score in the Ability or Art than the student.

A character may teach several students. The maximum number of students is equal to the teacher's Teaching Ability times five, or one student if the teacher has a score of zero in Teaching. If a teacher has a single student, whether for an Art or an Ability, the Source Quality gets a +6 bonus. If she has two students, the bonus is +3. If there are more students, there is no bonus.

A teacher may gain exposure to Teaching or the language of instruction, but cannot do anything else in a season when she is teaching.

Hermetic Arts can be taught, but only one-on-one. The normal +6 bonus for having only a single student applies."
    }
    #tIMTi1yIZ0vGIF36yCXcX8CE ^"Theology: Christian" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Ability Type" STRING "Academic" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Specialties" LIST OF STRING ["biblical knowledge", "heresy", "history"]
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "Theology is the study of God and his work in the world. The auctores are the Bible and Peter the Lombard's Sententiae, the Bible having theoretical primacy, being infallible, and the Sentences being most studied. The speculations of theology are very abstruse, and many theologians are accused of heresy. Sometimes those accused recant, and sometimes they convince the Church that they were right after all."
    }
    #tABZOPAtqtUKaqL995MkQaYI ^"Theology: Islam" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Ability Type" STRING "Academic" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Specialties" LIST OF STRING ["the Qur'an", "debates", "history", "prophets"]
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "This is the Islamic equivalent of Theology: Christian. The major sources for Islamic theology are the Qur'an and the Sunna."
        REFERENCES {
            "Theology: Christian" -> #tIMTi1yIZ0vGIF36yCXcX8CE ^"Theology: Christian"
        }
    }
    #tywoELkx1nx86iHu5TOk242I ^"Theology: Judaism" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Ability Type" STRING "Academic" FIXED
            ^"Cannot Use Untrained" BOOLEAN true
            ^"Specialties" LIST OF STRING ["the Torah", "creation", "history", "prophecies"]
            ^"Source" STRING "Core Rules"
        }
        DESCRIPTION "This is the Jewish equivalent of Theology: Christian. The major sources for Jewish theology are the Torah, the Nevi'im, and the Kutuvim."
        REFERENCES {
            "Theology: Christian" -> #tIMTi1yIZ0vGIF36yCXcX8CE ^"Theology: Christian"
        }
    }
    #tpmPLk2mRewnvENg2qT8c9uC ^"Thrown Weapon" DEF {
